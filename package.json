{
  "name": "@ui8kit/codegen",
  "version": "0.1.0",
  "description": "Spec-driven codegen for UI8Kit primitives: 17 style-agnostic HTML primitives, one typed render contract, five JS runtimes (React, Svelte 5, Vue 3, SolidJS, vanilla Web Components).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate": "bun src/infrastructure/cli.ts generate --out generated",
    "build:specs": "bun src/infrastructure/cli.ts specs --out specs/primitives.json",
    "check": "bun src/infrastructure/cli.ts check",
    "list": "bun src/infrastructure/cli.ts list",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:generated": "bun run generate && bun x tsc -p tsconfig.generated.json",
    "verify": "bun run check && bun x tsc --noEmit && bun run typecheck:generated && bun test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@babel/core": "7",
    "@babel/preset-typescript": "7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vue/server-renderer": "^3.5.13",
    "babel-preset-solid": "^1.9.12",
    "bun-types": "^1.3.14",
    "happy-dom": "^21.0.4",
    "parse5": "^7.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "solid-js": "^1.9.5",
    "svelte": "^5.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vue": "^3.5.13"
  }
}
