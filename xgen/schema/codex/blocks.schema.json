{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui8kit.dev/xgen/codex/blocks.schema.json",
  "title": "Block data manifest",
  "description": "Which Codex v0.4 entry kinds every block, screen and template reads, by which field map, with which entry fields, settings and dictionary labels. Kinds and metadata fields are those of manifest.json; status done = checked by xgen/schema/test/blocks.test.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "contract",
    "fieldMaps",
    "blocks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "contract": {
      "type": "string"
    },
    "fieldMaps": {
      "type": "string",
      "description": "the module of the central field maps (CODEX_FIELDS)"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^[a-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
      "description": "an entry field: a core field (title, excerpt) or metadata.<field>.value"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prop",
        "kind"
      ],
      "properties": {
        "prop": {
          "type": "string",
          "description": "the block prop that carries the records"
        },
        "collection": {
          "type": "string",
          "description": "the fixture collection (xgen/fixtures/<collection>.json)"
        },
        "kind": {
          "type": "string",
          "description": "the entry kind (a resource of manifest.json)"
        },
        "record": {
          "type": "string",
          "description": "the record type of the kit (Product, Post, Plan)"
        },
        "map": {
          "type": "string",
          "description": "the key of CODEX_FIELDS that maps the entry to the record"
        },
        "list": {
          "type": "boolean",
          "description": "a list of records (true) or one record (false)"
        },
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "uniqueItems": true
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prop",
        "dictionary",
        "keys"
      ],
      "properties": {
        "prop": {
          "type": "string"
        },
        "dictionary": {
          "type": "string",
          "description": "dotted path in the dictionary of the locale (xgen/content/ui/<locale>.json)"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "the keys read (empty: the path is one string)"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "surface",
        "source",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "surface": {
          "enum": [
            "kit-block",
            "kit-organism",
            "kit-component",
            "xgen-screen",
            "magazine-template",
            "magazine-part",
            "taste-screen"
          ]
        },
        "spec": {
          "type": "string",
          "description": "the xgen spec id"
        },
        "source": {
          "type": "string",
          "description": "the file a person edits"
        },
        "status": {
          "enum": [
            "todo",
            "done"
          ]
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "settings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "props that are not data or labels"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/labels"
          }
        },
        "emptyState": {
          "type": "boolean",
          "description": "renders an empty state when it has no records"
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "blocks a screen or template composes"
        },
        "collections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "emptyMode": {
          "enum": [
            "label",
            "omit"
          ],
          "description": "label (default): an EmptyState with the dictionary text (labels key or prop `empty`); omit: the empty part is left out (a page head without breadcrumbs)"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "done"
          }
        }
      },
      "then": {
        "required": [
          "data",
          "settings",
          "labels",
          "emptyState"
        ]
      }
    }
  }
}
