{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xgen.dev/schemas/app.schema.json",
  "title": "xgen app",
  "description": "The one hand-written file of a host app: it serves screens by name (/<screen>/#/<route>); everything else in it is generated.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "specVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "runtime": {
      "enum": [
        "svelte",
        "react",
        "vue",
        "solid"
      ]
    },
    "screens": {
      "type": "array",
      "description": "screen spec ids the host serves; [\"*\"]: every screen portable to the runtime",
      "items": {
        "type": "string",
        "pattern": "^(\\*|screen\\.[a-z0-9-]+)$"
      },
      "minItems": 1
    },
    "title": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "locale": {
      "const": "en"
    },
    "theme": {
      "enum": [
        "light",
        "dark",
        "system"
      ]
    },
    "hand": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "extra handwritten paths the build must not overwrite"
    }
  },
  "required": [
    "specVersion",
    "name",
    "runtime",
    "screens",
    "title",
    "port",
    "locale",
    "theme"
  ],
  "additionalProperties": false
}
