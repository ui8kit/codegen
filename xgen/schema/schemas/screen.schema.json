{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xgen.dev/schemas/screen.schema.json",
  "title": "xgen screen",
  "type": "object",
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "object",
          "properties": {
            "$": {
              "type": "string"
            }
          },
          "required": [
            "$"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "a group of named values (a grouped prop)",
          "not": {
            "anyOf": [
              {
                "required": [
                  "$"
                ]
              },
              {
                "required": [
                  "op"
                ]
              }
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "use": {
              "type": "string"
            },
            "props": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            },
            "attrs": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            },
            "on": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "call": {
                    "type": "string"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/value"
                    }
                  }
                },
                "required": [
                  "call"
                ],
                "additionalProperties": false
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "use"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "$ref": "#/$defs/value"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/$defs/value"
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            },
            "else": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "when",
            "then"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "each": {
              "$ref": "#/$defs/value"
            },
            "as": {
              "type": "string"
            },
            "key": {
              "$ref": "#/$defs/value"
            },
            "do": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            },
            "index": {
              "type": "string"
            }
          },
          "required": [
            "each",
            "as",
            "key",
            "do"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "slot": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "slot"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "organism": {
              "type": "string"
            },
            "props": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            },
            "on": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "call": {
                    "type": "string"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/value"
                    }
                  }
                },
                "required": [
                  "call"
                ],
                "additionalProperties": false
              }
            },
            "slots": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "do": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/node"
                    }
                  },
                  "forward": {
                    "type": "string",
                    "description": "pass a slot of the enclosing organism on as this slot (args and do stay empty)"
                  }
                },
                "required": [
                  "args",
                  "do"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "organism"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "outlet": {
              "const": true
            }
          },
          "required": [
            "outlet"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "specVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^screen\\.[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "docs": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "collection": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "record": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "collection",
        "kind",
        "record",
        "fields"
      ],
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "text",
                  "money",
                  "number",
                  "badge",
                  "boolean"
                ]
              },
              "sortable": {
                "type": "boolean"
              },
              "align": {
                "enum": [
                  "start",
                  "end"
                ]
              }
            },
            "required": [
              "id",
              "label",
              "type"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "searchFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1
        },
        "defaultSort": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+:(asc|desc)$"
        }
      },
      "required": [
        "columns",
        "searchFields",
        "pageSize",
        "defaultSort"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string"
        },
        "sort": {
          "type": "string"
        },
        "page": {
          "type": "string"
        }
      },
      "required": [
        "q",
        "sort",
        "page"
      ],
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "area": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "area"
        ],
        "additionalProperties": false
      }
    },
    "nav": {
      "type": "boolean",
      "description": "the screen reads nav.links and nav.current, supplied by the app from its routes table"
    },
    "menu": {
      "type": "array",
      "description": "The menu of the screen: the links of its navigation bar, in order. Every path is a route of the screen; titleKey is a key of the dictionary.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9-]*$"
          },
          "titleKey": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$"
          },
          "icon": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "titleKey"
        ],
        "additionalProperties": false
      }
    },
    "organisms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layout": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "areas": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/node"
        }
      }
    },
    "portable": {
      "type": "object",
      "properties": {
        "svelte": {
          "oneOf": [
            {
              "const": true
            },
            {
              "type": "object",
              "properties": {
                "portable": {
                  "const": false
                },
                "reason": {
                  "type": "string",
                  "minLength": 8
                }
              },
              "required": [
                "portable",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        },
        "react": {
          "oneOf": [
            {
              "const": true
            },
            {
              "type": "object",
              "properties": {
                "portable": {
                  "const": false
                },
                "reason": {
                  "type": "string",
                  "minLength": 8
                }
              },
              "required": [
                "portable",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        },
        "vue": {
          "oneOf": [
            {
              "const": true
            },
            {
              "type": "object",
              "properties": {
                "portable": {
                  "const": false
                },
                "reason": {
                  "type": "string",
                  "minLength": 8
                }
              },
              "required": [
                "portable",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "svelte",
        "react"
      ],
      "additionalProperties": false
    },
    "kind": {
      "enum": [
        "collection",
        "page"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "record": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "as": {
            "type": "string"
          }
        },
        "required": [
          "collection",
          "kind",
          "record",
          "fields",
          "as"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "specVersion",
    "id",
    "name",
    "docs",
    "routes",
    "organisms",
    "layout",
    "areas",
    "portable"
  ],
  "additionalProperties": false
}
