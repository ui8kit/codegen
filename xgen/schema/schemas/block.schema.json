{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xgen.dev/schemas/block.schema.json",
  "title": "xgen block: an organism, its axes, named variants and the data it reads (no markup)",
  "type": "object",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "object",
          "properties": {
            "$": {
              "type": "string"
            }
          },
          "required": [
            "$"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "a group of named values (a grouped prop)",
          "not": {
            "anyOf": [
              {
                "required": [
                  "$"
                ]
              },
              {
                "required": [
                  "op"
                ]
              }
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "specVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^block\\.[a-z][A-Za-z0-9]*$"
    },
    "name": {
      "type": "string"
    },
    "docs": {
      "type": "string"
    },
    "theme": {
      "enum": [
        "marketing",
        "commerce",
        "promo",
        "content",
        "account",
        "dashboard",
        "onboarding",
        "support"
      ]
    },
    "group": {
      "type": "string"
    },
    "organism": {
      "type": "string"
    },
    "axes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 2,
        "uniqueItems": true
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "set": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "props": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/value"
            }
          }
        },
        "required": [
          "id",
          "set"
        ],
        "additionalProperties": false
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "as": {
            "type": "string"
          },
          "collection": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "record": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "as",
          "collection",
          "kind",
          "record",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    "sample": {
      "type": "object",
      "properties": {
        "props": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      },
      "required": [
        "props"
      ],
      "additionalProperties": false
    },
    "fit": {
      "enum": [
        "section",
        "card"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sel"
        ],
        "additionalProperties": false,
        "properties": {
          "sel": {
            "type": "string"
          },
          "n": {
            "type": [
              "number",
              "string"
            ]
          },
          "cols": {
            "type": [
              "number",
              "string"
            ]
          },
          "when": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        }
      }
    },
    "alt": {
      "type": "object",
      "description": "a second organism, drawn by the variants that set axis to values[1]",
      "properties": {
        "axis": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "organism": {
          "type": "string"
        }
      },
      "required": [
        "axis",
        "values",
        "organism"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "specVersion",
    "id",
    "name",
    "docs",
    "theme",
    "group",
    "organism",
    "axes",
    "defaults",
    "variants",
    "slots",
    "data",
    "sample"
  ],
  "additionalProperties": false
}
