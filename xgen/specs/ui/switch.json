      "recipeId": "switch",
      "classes": {
        "recipe": {
          "size": "Size"
        }
      },
      "props": [
        {
          "name": "Size",
          "type": "string",
          "cva": true,
          "docs": "sets density preset"
        },
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "Name",
          "type": "string",
          "cva": false,
          "passthrough": true
        },
        {
          "name": "Value",
          "type": "string",
          "cva": false,
          "passthrough": true
        },
        {
          "name": "Checked",
          "type": "bool",
          "cva": false
        },
        {
          "name": "Disabled",
