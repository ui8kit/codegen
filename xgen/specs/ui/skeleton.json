        },
        "attrs": [
          {
            "kind": "class"
          },
          {
            "kind": "static",
            "name": "aria-hidden",
            "value": "true"
          },
          {
            "kind": "static",
            "name": "data-slot",
            "value": "skeleton"
          },
          {
            "kind": "rest"
          }
        ],
        "children": []
      },
      "slots": [],
      "events": [],
      "a11y": {
        "roots": [
          "div"
        ],
        "roles": [],
        "aria": [
          {
            "name": "aria-hidden",
            "kind": "static",
            "value": "true"
          }
        ],
        "keyboard": []
      },
      "data": [
        {
          "name": "data-slot",
          "kind": "static",
          "value": "skeleton"
        }
      ],
      "tokens": [
        "--muted"
      ]
    }
  ],
  "examples": [
    {
      "id": "shape.line",
      "props": {
        "Shape": "line"
      }
    },
    {
      "id": "shape.block",
      "props": {
        "Shape": "block"
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
