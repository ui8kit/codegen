{
  "$schema": "../../schema/schemas/spec.schema.json",
  "specVersion": 1,
  "id": "ui.skeleton",
  "tier": "brick",
  "dir": "skeleton",
  "docs": "Skeleton renders a pulsing placeholder box (loading state). It is decorative: aria-hidden; the loading state is announced by the container (aria-busy).",
  "variants": {
    "skeleton": "skeleton.variants.json"
  },
  "parts": [
    {
      "name": "Skeleton",
      "docs": "Skeleton renders a decorative placeholder.",
      "recipeId": "skeleton",
      "classes": {
        "recipe": {
          "shape": "Shape"
        }
      },
      "props": [
        {
          "name": "Shape",
          "type": "string",
          "cva": true,
          "docs": "line, block or circle"
        },
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "Attrs",
          "type": "attrs",
          "cva": false
        }
      ],
      "render": {
        "kind": "element",
        "tag": {
          "kind": "static",
