{
  "$schema": "../../schema/schemas/spec.schema.json",
  "specVersion": 1,
  "id": "ui.button",
  "tier": "brick",
  "dir": "button",
  "docs": "Button triggers an action on click.\nOptional Href renders an anchor with button appearance (CTA navigation).\nFor exotic roots, use ButtonClasses (Templ/Svelte/Vue/Solid) or asChild (React).\nPrefer Link for prose/semantic navigation.",
  "variants": {
    "button": "button.variants.json"
  },
  "parts": [
    {
      "name": "Button",
      "docs": "Button renders a button element, or an anchor when Href is set.\nType/Form apply only in button mode; Disabled on anchors uses aria-disabled.",
      "recipeId": "button",
      "asChild": true,
      "classes": {
        "recipe": {
          "variant": "Variant",
          "size": "Size",
          "layout": "Layout"
        },
        "state": [
          {
            "test": {
              "kind": "prop",
              "name": "Disabled"
            },
            "classes": "pointer-events-none opacity-50"
          }
        ]
      },
      "derived": {
        "target": {
          "kind": "cond",
          "test": {
            "kind": "isSet",
            "expr": {
              "kind": "prop",
              "name": "Target"
            }
          },
          "then": {
            "kind": "prop",
            "name": "Target"
          },
          "else": {
            "kind": "cond",
            "test": {
              "kind": "prop",
              "name": "External"
            },
            "then": {
              "kind": "lit",
              "value": "_blank"
            },
            "else": {
              "kind": "lit",
              "value": ""
            }
          }
        },
        "rel": {
          "kind": "cond",
          "test": {
            "kind": "isSet",
            "expr": {
              "kind": "prop",
              "name": "Rel"
            }
          },
          "then": {
            "kind": "prop",
            "name": "Rel"
          },
          "else": {
            "kind": "cond",
            "test": {
              "kind": "or",
              "exprs": [
                {
                  "kind": "prop",
                  "name": "External"
                },
                {
                  "kind": "eq",
                  "left": {
                    "kind": "derivedRef",
                    "name": "target"
                  },
                  "right": {
                    "kind": "lit",
                    "value": "_blank"
                  }
                }
              ]
            },
            "then": {
              "kind": "lit",
              "value": "noopener noreferrer"
            },
            "else": {
              "kind": "lit",
              "value": ""
            }
          }
        }
      },
      "props": [
        {
          "name": "Variant",
          "type": "string",
          "cva": true,
          "docs": "appearance preset: default, secondary, destructive, outline, ghost, link"
        },
        {
          "name": "Size",
          "type": "string",
          "cva": true,
          "docs": "density preset: default, sm, lg, icon"
        },
        {
          "name": "Layout",
          "type": "string",
          "cva": true,
          "docs": "sets layout"
        },
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "Type",
          "type": "string",
          "cva": false,
          "docs": "button type: button, submit, reset (ignored when Href is set)"
        },
        {
          "name": "Form",
          "type": "string",
          "cva": false,
          "passthrough": true,
          "docs": "links button to a form id (ignored when Href is set)"
        },
        {
          "name": "Href",
          "type": "string",
          "cva": false,
          "docs": "when set, renders an anchor with button appearance"
        },
        {
          "name": "Target",
          "type": "string",
          "cva": false,
          "docs": "explicit target; External implies _blank (anchor mode)"
        },
        {
          "name": "Rel",
          "type": "string",
          "cva": false,
          "docs": "explicit rel; external links default to noopener noreferrer (anchor mode)"
        },
        {
          "name": "External",
          "type": "bool",
          "cva": false,
          "docs": "opens in a new tab with safe rel defaults (anchor mode)"
        },
        {
          "name": "Disabled",
          "type": "bool",
          "cva": false,
          "docs": "blocks interaction"
        },
        {
          "name": "ID",
          "type": "string",
          "cva": false,
          "passthrough": true,
          "docs": "element id"
        },
        {
          "name": "Role",
          "type": "string",
          "cva": false,
          "passthrough": true,
          "docs": "ARIA role override"
        },
        {
          "name": "TabIndex",
          "type": "string",
          "cva": false,
          "passthrough": true,
          "docs": "tab order override"
        },
        {
          "name": "AriaLabel",
          "type": "string",
          "cva": false,
          "passthrough": true,
          "docs": "accessible name for unlabeled controls"
        },
        {
          "name": "Attrs",
          "type": "attrs",
          "cva": false
        },
        {
          "name": "Children",
          "type": "children",
          "cva": false
        }
      ],
      "render": {
        "kind": "when",
        "test": {
          "kind": "isSet",
          "expr": {
            "kind": "prop",
            "name": "Href"
          }
        },
        "then": [
          {
            "kind": "element",
            "tag": {
              "kind": "static",
              "tag": "a"
            },
            "attrs": [
              {
                "kind": "expr",
                "name": "href",
                "expr": {
                  "kind": "prop",
                  "name": "Href"
                }
              },
              {
                "kind": "class"
              },
              {
                "kind": "static",
                "name": "data-slot",
                "value": "button"
              },
              {
                "kind": "expr",
                "name": "id",
                "expr": {
                  "kind": "prop",
                  "name": "ID"
                }
              },
              {
                "kind": "expr",
                "name": "target",
                "expr": {
                  "kind": "derivedRef",
                  "name": "target"
                }
              },
              {
                "kind": "expr",
                "name": "rel",
                "expr": {
                  "kind": "derivedRef",
                  "name": "rel"
                }
              },
              {
                "kind": "expr",
                "name": "role",
                "expr": {
                  "kind": "prop",
                  "name": "Role"
                }
              },
              {
                "kind": "expr",
                "name": "aria-label",
                "expr": {
                  "kind": "prop",
                  "name": "AriaLabel"
                }
              },
              {
                "kind": "expr",
                "name": "aria-disabled",
                "expr": {
                  "kind": "lit",
                  "value": "true"
                },
                "when": {
                  "kind": "prop",
                  "name": "Disabled"
                }
              },
              {
                "kind": "expr",
                "name": "tabindex",
                "expr": {
                  "kind": "lit",
                  "value": -1
                },
                "when": {
                  "kind": "prop",
                  "name": "Disabled"
                }
              },
              {
                "kind": "rest"
              }
            ],
            "children": [
              {
                "kind": "slot"
              }
            ]
          }
        ],
        "else": [
          {
            "kind": "element",
            "tag": {
              "kind": "static",
              "tag": "button"
            },
            "attrs": [
              {
                "kind": "expr",
                "name": "type",
                "expr": {
                  "kind": "mapOr",
                  "expr": {
                    "kind": "prop",
                    "name": "Type"
                  },
                  "mapping": {
                    "submit": "submit",
                    "reset": "reset"
                  },
                  "fallback": "button"
                }
              },
              {
                "kind": "class"
              },
              {
                "kind": "static",
                "name": "data-slot",
                "value": "button"
              },
              {
                "kind": "bool",
                "name": "disabled",
                "expr": {
                  "kind": "prop",
                  "name": "Disabled"
                }
              },
              {
                "kind": "expr",
                "name": "id",
                "expr": {
                  "kind": "prop",
                  "name": "ID"
                }
              },
              {
                "kind": "expr",
                "name": "form",
                "expr": {
                  "kind": "prop",
                  "name": "Form"
                }
              },
              {
                "kind": "expr",
                "name": "role",
                "expr": {
                  "kind": "prop",
                  "name": "Role"
                }
              },
              {
                "kind": "expr",
                "name": "tabindex",
                "expr": {
                  "kind": "prop",
                  "name": "TabIndex"
                }
              },
              {
                "kind": "expr",
                "name": "aria-label",
                "expr": {
                  "kind": "prop",
                  "name": "AriaLabel"
                }
              },
              {
                "kind": "rest"
              }
            ],
            "children": [
              {
                "kind": "slot"
              }
            ]
          }
        ]
      },
      "slots": [
        {
          "name": "children"
        }
      ],
      "events": [],
      "a11y": {
        "roots": [
          "a",
          "button"
        ],
        "roles": [],
        "aria": [
          {
            "name": "aria-disabled",
            "kind": "expr"
          },
          {
            "name": "aria-label",
            "kind": "expr"
          },
          {
            "name": "role",
            "kind": "expr"
          },
          {
            "name": "tabindex",
            "kind": "expr"
          }
        ],
        "keyboard": []
      },
      "data": [
        {
          "name": "data-slot",
          "kind": "static",
          "value": "button"
        },
        {
          "name": "data-slot",
          "kind": "static",
          "value": "button"
        }
      ],
      "tokens": [
        "--background",
        "--border",
        "--card",
        "--destructive",
        "--foreground",
        "--muted-foreground",
        "--primary",
        "--primary-foreground",
        "--secondary",
        "--secondary-foreground"
      ]
    }
  ],
  "examples": [
    {
      "id": "size.lg",
      "props": {
        "Size": "lg",
        "Variant": "default"
      }
    },
    {
      "id": "size.sm",
      "props": {
        "Size": "sm",
        "Variant": "default"
      }
    },
    {
      "id": "state.disabled",
      "props": {
        "Disabled": true,
        "Variant": "default"
      }
    },
    {
      "id": "state.reset",
      "props": {
        "Type": "reset",
        "Variant": "outline"
      }
    },
    {
      "id": "state.submit",
      "props": {
        "Type": "submit",
        "Variant": "default"
      }
    },
    {
      "id": "variant.default",
      "props": {
        "Size": "default",
        "Variant": "default"
      }
    },
    {
      "id": "variant.destructive",
      "props": {
        "Size": "default",
        "Variant": "destructive"
      }
    },
    {
      "id": "variant.ghost",
      "props": {
        "Size": "sm",
        "Variant": "ghost"
      }
    },
    {
      "id": "variant.link",
      "props": {
        "Variant": "link"
      }
    },
    {
      "id": "variant.outline",
      "props": {
        "Size": "sm",
        "Variant": "outline"
      }
    },
    {
      "id": "variant.secondary",
      "props": {
        "Size": "default",
        "Variant": "secondary"
      }
    },
    {
      "id": "composition.aschild-link",
      "props": {
        "AsChild": true,
        "Variant": "outline",
        "Size": "sm"
      }
    },
    {
      "id": "composition.href",
      "props": {
        "Href": "/cart",
        "Variant": "default",
        "Size": "default"
      }
    },
    {
      "id": "composition.href-external",
      "props": {
        "Href": "https://example.com",
        "External": true,
        "Variant": "outline",
        "Size": "sm"
      }
    },
    {
      "id": "composition.href-disabled",
      "props": {
        "Href": "/cart",
        "Disabled": true,
        "Variant": "secondary"
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
