{
  "$schema": "../../schema/schemas/spec.schema.json",
  "specVersion": 1,
  "id": "ui.dialog",
  "tier": "brick",
  "dir": "dialog",
  "docs": "Dialog renders a native dialog root with an optional behavior hook.\nThe data-ui8kit hook defaults off; the registry ships no client JS.",
  "variants": {
    "dialog": "dialog.variants.json"
  },
  "parts": [
    {
      "name": "Dialog",
      "docs": "Dialog renders a native dialog element.",
      "recipeId": "dialog",
      "classes": {
        "recipe": {
          "size": "Size",
          "variant": "Variant"
        }
      },
      "props": [
        {
          "name": "Variant",
          "type": "string",
          "cva": true,
          "docs": "sets appearance preset"
        },
        {
          "name": "Size",
          "type": "string",
          "cva": true,
          "docs": "sets density preset"
        },
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "ID",
          "type": "string",
          "cva": false,
          "passthrough": true
        },
        {
          "name": "Open",
          "type": "bool",
          "cva": false,
          "docs": "initial open state (static attribute only)"
        },
        {
          "name": "DataUI8Kit",
          "type": "string",
          "cva": false,
          "passthrough": true,
          "docs": "opt-in behavior hook; empty emits nothing"
        },
        {
          "name": "AriaLabel",
          "type": "string",
          "cva": false,
          "passthrough": true
        },
        {
          "name": "AriaLabelledBy",
          "type": "string",
          "cva": false,
          "passthrough": true
        },
        {
          "name": "AriaDescribedBy",
          "type": "string",
          "cva": false,
          "passthrough": true
        },
        {
          "name": "Attrs",
          "type": "attrs",
          "cva": false
        },
        {
          "name": "Children",
          "type": "children",
          "cva": false
        }
      ],
      "render": {
        "kind": "element",
        "tag": {
          "kind": "static",
          "tag": "dialog"
        },
        "attrs": [
          {
            "kind": "class"
          },
          {
            "kind": "bool",
            "name": "open",
            "expr": {
              "kind": "prop",
              "name": "Open"
            }
          },
          {
            "kind": "expr",
            "name": "id",
            "expr": {
              "kind": "prop",
              "name": "ID"
            }
          },
          {
            "kind": "expr",
            "name": "data-ui8kit",
            "expr": {
              "kind": "prop",
              "name": "DataUI8Kit"
            }
          },
          {
            "kind": "expr",
            "name": "aria-label",
            "expr": {
              "kind": "prop",
              "name": "AriaLabel"
            }
          },
          {
            "kind": "expr",
            "name": "aria-labelledby",
            "expr": {
              "kind": "prop",
              "name": "AriaLabelledBy"
            }
          },
          {
            "kind": "expr",
            "name": "aria-describedby",
            "expr": {
              "kind": "prop",
              "name": "AriaDescribedBy"
            }
          },
          {
            "kind": "rest"
          }
        ],
        "children": [
          {
            "kind": "slot"
          }
        ]
      },
      "slots": [
        {
          "name": "children"
        }
      ],
      "events": [],
      "a11y": {
        "roots": [
          "dialog"
        ],
        "roles": [],
        "aria": [
          {
            "name": "aria-describedby",
            "kind": "expr"
          },
          {
            "name": "aria-label",
            "kind": "expr"
          },
          {
            "name": "aria-labelledby",
            "kind": "expr"
          }
        ],
        "keyboard": []
      },
      "data": [
        {
          "name": "data-ui8kit",
          "kind": "expr"
        }
      ],
      "tokens": [
        "--background",
        "--border",
        "--card",
        "--card-foreground",
        "--foreground"
      ]
    }
  ],
  "examples": [
    {
      "id": "variant.default",
      "props": {
        "AriaLabel": "Dialog",
        "Size": "default",
        "Variant": "default"
      }
    },
    {
      "id": "variant.sheet",
      "props": {
        "AriaLabel": "Panel",
        "Size": "full",
        "Variant": "sheet"
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
