{
  "$schema": "../../schema/schemas/spec.schema.json",
  "specVersion": 1,
  "id": "ui.text",
  "tier": "brick",
  "dir": "text",
  "docs": "Text renders body copy: a paragraph by default; Tag picks another text element (blockquote, figcaption, address, pre, or an\ninline element). Title (as 1–6) is for headings.",
  "variants": {
    "text": "text.variants.json"
  },
  "parts": [
    {
      "name": "Text",
      "docs": "Text renders a p element with body copy classes, or the block or inline text element of `Tag`.",
      "recipeId": "text",
      "asChild": true,
      "classes": {
        "recipe": {
          "size": "Size",
          "weight": "Weight"
        }
      },
      "props": [
        {
          "name": "Size",
          "type": "string",
          "cva": true,
          "docs": "sets size"
        },
        {
          "name": "Weight",
          "type": "string",
          "cva": true,
          "docs": "sets weight"
        },
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "Tag",
          "type": "string",
          "cva": false,
          "docs": "p (default), blockquote, figcaption, address, pre, or an inline element (span, strong, em, ...)"
        },
        {
          "name": "Attrs",
          "type": "attrs",
          "cva": false
        },
        {
          "name": "Children",
          "type": "children",
          "cva": false
        }
      ],
      "render": {
        "kind": "element",
        "tag": {
          "kind": "resolved",
          "fromProp": "Tag",
          "fallback": "p",
          "group": "Text"
        },
        "attrs": [
          {
            "kind": "class"
          },
          {
            "kind": "rest"
          }
        ],
        "children": [
          {
            "kind": "slot"
          }
        ]
      },
      "slots": [
        {
          "name": "children"
        }
      ],
      "events": [],
      "a11y": {
        "roots": [
          "p",
          "(Text)"
        ],
        "roles": [],
        "aria": [],
        "keyboard": []
      },
      "data": [],
      "tokens": []
    }
  ],
  "examples": [
    {
      "id": "default",
      "props": {}
    },
    {
      "id": "muted",
      "props": {
        "Class": "text-muted-foreground"
      }
    },
    {
      "id": "code",
      "props": {
        "Class": "text-sm font-mono"
      }
    },
    {
      "id": "tag.blockquote",
      "props": {
        "Tag": "blockquote",
        "Class": "border-l border-border pl-4"
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
