{
  "$schema": "../../schema/schemas/spec.schema.json",
  "specVersion": 1,
  "id": "ui.container",
  "tier": "brick",
  "dir": "container",
  "docs": "Container wraps page content with a constrained width shell.\nOptional main or section tag for inner layout regions.",
  "variants": {
    "container": "container.variants.json"
  },
  "parts": [
    {
      "name": "Container",
      "docs": "Container renders the outer content shell.",
      "recipeId": "container",
      "asChild": true,
      "classes": {
        "recipe": {}
      },
      "props": [
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "Tag",
          "type": "string",
          "cva": false,
          "docs": "div, main, or section"
        },
        {
          "name": "Attrs",
          "type": "attrs",
          "cva": false
        },
        {
          "name": "Children",
          "type": "children",
          "cva": false
        }
      ],
      "render": {
        "kind": "element",
        "tag": {
          "kind": "resolved",
          "fromProp": "Tag",
          "fallback": "div",
          "group": "Container"
        },
        "attrs": [
          {
            "kind": "class"
          },
          {
            "kind": "rest"
          }
        ],
        "children": [
          {
            "kind": "slot"
          }
        ]
      },
      "slots": [
        {
          "name": "children"
        }
      ],
      "events": [],
      "a11y": {
        "roots": [
          "div",
          "(Container)"
        ],
        "roles": [],
        "aria": [],
        "keyboard": []
      },
      "data": [],
      "tokens": []
    }
  ],
  "examples": [
    {
      "id": "tag.default",
      "props": {
        "Class": "mx-auto max-w-5xl px-6",
        "Tag": "div"
      }
    },
    {
      "id": "tag.main",
      "props": {
        "Class": "mx-auto max-w-5xl px-6",
        "Tag": "main"
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
