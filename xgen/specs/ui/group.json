{
  "$schema": "../../schema/schemas/spec.schema.json",
  "specVersion": 1,
  "id": "ui.group",
  "tier": "brick",
  "dir": "group",
  "docs": "Group arranges children in a horizontal flex row.\nSupports fieldset for related form controls.",
  "variants": {
    "group": "group.variants.json"
  },
  "parts": [
    {
      "name": "Group",
      "docs": "Group renders a horizontal flex container.",
      "recipeId": "group",
      "asChild": true,
      "classes": {
        "recipe": {
          "gap": "Gap",
          "align": "Align",
          "justify": "Justify"
        }
      },
      "props": [
        {
          "name": "Gap",
          "type": "string",
          "cva": true,
          "docs": "sets gap: a Tailwind spacing step (0, 2, 4, 6, 8, 10, 12 = gap-N) or auto"
        },
        {
          "name": "Align",
          "type": "string",
          "cva": true,
          "docs": "sets align"
        },
        {
          "name": "Justify",
          "type": "string",
          "cva": true,
          "docs": "sets justify"
        },
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "Tag",
          "type": "string",
          "cva": false,
          "docs": "div, fieldset, or dl. Use fieldset for related form controls."
        },
        {
          "name": "Attrs",
          "type": "attrs",
          "cva": false
        },
        {
          "name": "Children",
          "type": "children",
          "cva": false
        }
      ],
      "render": {
        "kind": "element",
        "tag": {
          "kind": "resolved",
          "fromProp": "Tag",
          "fallback": "div",
          "group": "Group"
        },
        "attrs": [
          {
            "kind": "class"
          },
          {
            "kind": "rest"
          }
        ],
        "children": [
          {
            "kind": "slot"
          }
        ]
      },
      "slots": [
        {
          "name": "children"
        }
      ],
      "events": [],
      "a11y": {
        "roots": [
          "div",
          "(Group)"
        ],
        "roles": [],
        "aria": [],
        "keyboard": []
      },
      "data": [],
      "tokens": []
    }
  ],
  "examples": [
    {
      "id": "tag.default",
      "props": {
        "Class": "gap-2",
        "Tag": "div"
      }
    },
    {
      "id": "tag.fieldset",
      "props": {
        "Class": "gap-2",
        "Tag": "fieldset"
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
