{
  "$schema": "../../schema/schemas/spec.schema.json",
  "specVersion": 1,
  "id": "ui.icon",
  "tier": "brick",
  "dir": "icon",
  "docs": "Icon renders a class-based span, svg use reference, or text fallback.\nDecorative icons are hidden from assistive technology by default.",
  "variants": {
    "icon": "icon.variants.json"
  },
  "parts": [
    {
      "name": "Icon",
      "docs": "Icon renders a class-based span, svg use, or text fallback host.",
      "recipeId": "icon",
      "classes": {
        "recipe": {
          "size": "Size",
          "type": {
            "kind": "mapOr",
            "expr": {
              "kind": "prop",
              "name": "Type"
            },
            "mapping": {
              "svg": "svg",
              "text": "text"
            },
            "fallback": "class"
          }
        },
        "extra": [
          {
            "kind": "cond",
            "test": {
              "kind": "eq",
              "left": {
                "kind": "mapOr",
                "expr": {
                  "kind": "prop",
                  "name": "Type"
                },
                "mapping": {
                  "svg": "svg",
                  "text": "text"
                },
                "fallback": "class"
              },
              "right": {
                "kind": "lit",
                "value": "class"
              }
            },
            "then": {
              "kind": "prop",
              "name": "BaseClass"
            },
            "else": {
              "kind": "lit",
              "value": ""
            }
          },
          {
            "kind": "cond",
            "test": {
              "kind": "and",
              "exprs": [
                {
                  "kind": "eq",
                  "left": {
                    "kind": "mapOr",
                    "expr": {
                      "kind": "prop",
                      "name": "Type"
                    },
                    "mapping": {
                      "svg": "svg",
                      "text": "text"
                    },
                    "fallback": "class"
                  },
                  "right": {
                    "kind": "lit",
                    "value": "class"
                  }
                },
                {
                  "kind": "isSet",
                  "expr": {
                    "kind": "prop",
                    "name": "Name"
                  }
                }
              ]
            },
            "then": {
              "kind": "concat",
              "parts": [
                {
                  "kind": "prop",
                  "name": "Prefix"
                },
                {
                  "kind": "prop",
                  "name": "Name"
                }
              ]
            },
            "else": {
              "kind": "lit",
              "value": ""
            }
          }
        ]
      },
      "derived": {
        "iconKind": {
          "kind": "mapOr",
          "expr": {
            "kind": "prop",
            "name": "Type"
          },
          "mapping": {
            "svg": "svg",
            "text": "text"
          },
          "fallback": "class"
        },
        "isDecorative": {
          "kind": "or",
          "exprs": [
            {
              "kind": "prop",
              "name": "Decorative"
            },
            {
              "kind": "and",
              "exprs": [
                {
                  "kind": "not",
                  "expr": {
                    "kind": "isSet",
                    "expr": {
                      "kind": "prop",
                      "name": "Title"
                    }
                  }
                },
                {
                  "kind": "not",
                  "expr": {
                    "kind": "isSet",
                    "expr": {
                      "kind": "prop",
                      "name": "AriaLabel"
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      "props": [
        {
          "name": "Name",
          "type": "string",
          "cva": false,
          "docs": "icon name appended to Prefix in class mode"
        },
        {
          "name": "Type",
          "type": "string",
          "cva": false,
          "docs": "svg, text, or class (default)"
        },
        {
          "name": "BaseClass",
          "type": "string",
          "cva": false,
          "docs": "base icon font class in class mode"
        },
        {
          "name": "Prefix",
          "type": "string",
          "cva": false,
          "docs": "icon font prefix in class mode"
        },
        {
          "name": "Size",
          "type": "string",
          "cva": true,
          "docs": "sets density preset"
        },
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "Href",
          "type": "string",
          "cva": false,
          "docs": "svg use href in svg mode"
        },
        {
          "name": "Title",
          "type": "string",
          "cva": false,
          "docs": "svg title / accessible name"
        },
        {
          "name": "AriaLabel",
          "type": "string",
          "cva": false,
          "docs": "accessible name for non-decorative icons"
        },
        {
          "name": "Decorative",
          "type": "bool",
          "cva": false,
          "docs": "hides the icon from assistive technology"
        },
        {
          "name": "Attrs",
          "type": "attrs",
          "cva": false
        },
        {
          "name": "Children",
          "type": "children",
          "cva": false
        }
      ],
      "render": {
        "kind": "when",
        "test": {
          "kind": "eq",
          "left": {
            "kind": "derivedRef",
            "name": "iconKind"
          },
          "right": {
            "kind": "lit",
            "value": "svg"
          }
        },
        "then": [
          {
            "kind": "element",
            "tag": {
              "kind": "static",
              "tag": "svg"
            },
            "attrs": [
              {
                "kind": "class"
              },
              {
                "kind": "expr",
                "name": "aria-hidden",
                "expr": {
                  "kind": "lit",
                  "value": "true"
                },
                "when": {
                  "kind": "derivedRef",
                  "name": "isDecorative"
                }
              },
              {
                "kind": "expr",
                "name": "role",
                "expr": {
                  "kind": "lit",
                  "value": "img"
                },
                "when": {
                  "kind": "not",
                  "expr": {
                    "kind": "derivedRef",
                    "name": "isDecorative"
                  }
                }
              },
              {
                "kind": "expr",
                "name": "aria-label",
                "expr": {
                  "kind": "prop",
                  "name": "AriaLabel"
                },
                "when": {
                  "kind": "and",
                  "exprs": [
                    {
                      "kind": "not",
                      "expr": {
                        "kind": "derivedRef",
                        "name": "isDecorative"
                      }
                    },
                    {
                      "kind": "isSet",
                      "expr": {
                        "kind": "prop",
                        "name": "AriaLabel"
                      }
                    }
                  ]
                }
              },
              {
                "kind": "rest"
              }
            ],
            "children": [
              {
                "kind": "when",
                "test": {
                  "kind": "isSet",
                  "expr": {
                    "kind": "prop",
                    "name": "Title"
                  }
                },
                "then": [
                  {
                    "kind": "element",
                    "tag": {
                      "kind": "static",
                      "tag": "title"
                    },
                    "attrs": [],
                    "children": [
                      {
                        "kind": "text",
                        "expr": {
                          "kind": "prop",
                          "name": "Title"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "when",
                "test": {
                  "kind": "isSet",
                  "expr": {
                    "kind": "prop",
                    "name": "Href"
                  }
                },
                "then": [
                  {
                    "kind": "element",
                    "tag": {
                      "kind": "static",
                      "tag": "use"
                    },
                    "attrs": [
                      {
                        "kind": "expr",
                        "name": "href",
                        "expr": {
                          "kind": "prop",
                          "name": "Href"
                        }
                      }
                    ],
                    "children": []
                  }
                ]
              },
              {
                "kind": "slot"
              }
            ]
          }
        ],
        "else": [
          {
            "kind": "when",
            "test": {
              "kind": "eq",
              "left": {
                "kind": "derivedRef",
                "name": "iconKind"
              },
              "right": {
                "kind": "lit",
                "value": "text"
              }
            },
            "then": [
              {
                "kind": "element",
                "tag": {
                  "kind": "static",
                  "tag": "span"
                },
                "attrs": [
                  {
                    "kind": "class"
                  },
                  {
                    "kind": "expr",
                    "name": "aria-hidden",
                    "expr": {
                      "kind": "lit",
                      "value": "true"
                    },
                    "when": {
                      "kind": "derivedRef",
                      "name": "isDecorative"
                    }
                  },
                  {
                    "kind": "expr",
                    "name": "role",
                    "expr": {
                      "kind": "lit",
                      "value": "img"
                    },
                    "when": {
                      "kind": "not",
                      "expr": {
                        "kind": "derivedRef",
                        "name": "isDecorative"
                      }
                    }
                  },
                  {
                    "kind": "expr",
                    "name": "aria-label",
                    "expr": {
                      "kind": "prop",
                      "name": "AriaLabel"
                    },
                    "when": {
                      "kind": "and",
                      "exprs": [
                        {
                          "kind": "not",
                          "expr": {
                            "kind": "derivedRef",
                            "name": "isDecorative"
                          }
                        },
                        {
                          "kind": "isSet",
                          "expr": {
                            "kind": "prop",
                            "name": "AriaLabel"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "kind": "rest"
                  }
                ],
                "children": [
                  {
                    "kind": "slot"
                  }
                ]
              }
            ],
            "else": [
              {
                "kind": "element",
                "tag": {
                  "kind": "static",
                  "tag": "span"
                },
                "attrs": [
                  {
                    "kind": "class"
                  },
                  {
                    "kind": "expr",
                    "name": "aria-hidden",
                    "expr": {
                      "kind": "lit",
                      "value": "true"
                    },
                    "when": {
                      "kind": "derivedRef",
                      "name": "isDecorative"
                    }
                  },
                  {
                    "kind": "expr",
                    "name": "role",
                    "expr": {
                      "kind": "lit",
                      "value": "img"
                    },
                    "when": {
                      "kind": "not",
                      "expr": {
                        "kind": "derivedRef",
                        "name": "isDecorative"
                      }
                    }
                  },
                  {
                    "kind": "expr",
                    "name": "aria-label",
                    "expr": {
                      "kind": "prop",
                      "name": "AriaLabel"
                    },
                    "when": {
                      "kind": "and",
                      "exprs": [
                        {
                          "kind": "not",
                          "expr": {
                            "kind": "derivedRef",
                            "name": "isDecorative"
                          }
                        },
                        {
                          "kind": "isSet",
                          "expr": {
                            "kind": "prop",
                            "name": "AriaLabel"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "kind": "rest"
                  }
                ],
                "children": []
              }
            ]
          }
        ]
      },
      "slots": [
        {
          "name": "children"
        }
      ],
      "events": [],
      "a11y": {
        "roots": [
          "svg",
          "span"
        ],
        "roles": [],
        "aria": [
          {
            "name": "aria-hidden",
            "kind": "expr"
          },
          {
            "name": "aria-label",
            "kind": "expr"
          },
          {
            "name": "role",
            "kind": "expr"
          }
        ],
        "keyboard": []
      },
      "data": [],
      "tokens": []
    }
  ],
  "examples": [
    {
      "id": "type.class",
      "props": {
        "BaseClass": "icon",
        "Name": "home",
        "Prefix": "icon-",
        "Size": "md",
        "Type": "class"
      }
    },
    {
      "id": "type.svg",
      "props": {
        "Href": "#check",
        "Title": "Done",
        "Type": "svg"
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
