{
  "$schema": "../../schema/schemas/spec.schema.json",
  "specVersion": 1,
  "id": "ui.title",
  "tier": "brick",
  "dir": "title",
  "docs": "Title renders a heading (h1–h6) from As (1–6). Defaults to h2 when As is 0\nor out of range.",
  "variants": {
    "title": "title.variants.json"
  },
  "parts": [
    {
      "name": "Title",
      "docs": "Title renders the resolved heading element.",
      "recipeId": "title",
      "asChild": true,
      "classes": {
        "recipe": {
          "size": "Size",
          "weight": "Weight"
        }
      },
      "props": [
        {
          "name": "Size",
          "type": "string",
          "cva": true,
          "docs": "sets size"
        },
        {
          "name": "Weight",
          "type": "string",
          "cva": true,
          "docs": "sets weight"
        },
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "As",
          "type": "int",
          "cva": false,
          "enumValues": [
            "1",
            "2",
            "3",
            "4",
            "5",
            "6"
          ],
          "goType": "uiutils.HeadingLevel",
          "docs": "maps to h1–h6; 0 and 2 default to h2"
        },
        {
          "name": "Attrs",
          "type": "attrs",
          "cva": false
        },
        {
          "name": "Children",
          "type": "children",
          "cva": false
        }
      ],
      "render": {
        "kind": "element",
        "tag": {
          "kind": "heading",
          "fromProp": "As"
        },
        "attrs": [
          {
            "kind": "class"
          },
          {
            "kind": "rest"
          }
        ],
        "children": [
          {
            "kind": "slot"
          }
        ]
      },
      "slots": [
        {
          "name": "children"
        }
      ],
      "events": [],
      "a11y": {
        "roots": [
          "h1",
          "h2",
          "h3",
          "h4",
          "h5",
          "h6"
        ],
        "roles": [],
        "aria": [],
        "keyboard": []
      },
      "data": [],
      "tokens": [
        "--foreground"
      ]
    }
  ],
  "examples": [
    {
      "id": "as.h1",
      "props": {
        "As": 1
      }
    },
    {
      "id": "as.h2",
      "props": {
        "As": 2
      }
    },
    {
      "id": "as.h3",
      "props": {
        "As": 3,
        "Class": "text-lg"
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
