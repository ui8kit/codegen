{
  "$schema": "../../schema/schemas/spec.schema.json",
  "specVersion": 1,
  "id": "ui.range",
  "tier": "brick",
  "dir": "range",
  "docs": "Range renders a styled input[type=range] (single thumb slider). The value is controlled from outside: Value in, an input event out (canary used a bindable prop).",
  "variants": {
    "range": "range.variants.json"
  },
  "parts": [
    {
      "name": "Range",
      "docs": "Range renders input type=range.",
      "recipeId": "range",
      "classes": {
        "recipe": {}
      },
      "props": [
        {
          "name": "Value",
          "type": "string",
          "cva": false,
          "docs": "current value as a string, controlled by the caller",
          "passthrough": true
        },
        {
          "name": "Min",
          "type": "int",
          "cva": false,
          "docs": "lowest value, 0 by default"
        },
        {
          "name": "Max",
          "type": "int",
          "cva": false,
          "docs": "highest value, 100 by default"
        },
        {
          "name": "Step",
          "type": "int",
          "cva": false,
          "docs": "step, 1 by default"
        },
        {
          "name": "Disabled",
          "type": "bool",
          "cva": false,
          "docs": "disables the slider"
        },
        {
          "name": "AriaLabel",
          "type": "string",
          "cva": false,
          "docs": "accessible name"
        },
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "Attrs",
          "type": "attrs",
          "cva": false
        }
      ],
      "render": {
        "kind": "element",
        "tag": {
          "kind": "static",
          "tag": "input"
        },
        "attrs": [
          {
            "kind": "static",
            "name": "type",
            "value": "range"
          },
          {
            "kind": "class"
          },
          {
            "kind": "expr",
            "name": "min",
            "expr": {
              "kind": "cond",
              "test": {
                "kind": "isSet",
                "expr": {
                  "kind": "prop",
                  "name": "Min"
                }
              },
              "then": {
                "kind": "intToString",
                "expr": {
                  "kind": "prop",
                  "name": "Min"
                }
              },
              "else": {
                "kind": "lit",
                "value": "0"
              }
            }
          },
          {
            "kind": "expr",
            "name": "max",
            "expr": {
              "kind": "cond",
              "test": {
                "kind": "isSet",
                "expr": {
                  "kind": "prop",
                  "name": "Max"
                }
              },
              "then": {
                "kind": "intToString",
                "expr": {
                  "kind": "prop",
                  "name": "Max"
                }
              },
              "else": {
                "kind": "lit",
                "value": "100"
              }
            }
          },
          {
            "kind": "expr",
            "name": "step",
            "expr": {
              "kind": "cond",
              "test": {
                "kind": "isSet",
                "expr": {
                  "kind": "prop",
                  "name": "Step"
                }
              },
              "then": {
                "kind": "intToString",
                "expr": {
                  "kind": "prop",
                  "name": "Step"
                }
              },
              "else": {
                "kind": "lit",
                "value": "1"
              }
            }
          },
          {
            "kind": "expr",
            "name": "value",
            "expr": {
              "kind": "prop",
              "name": "Value"
            }
          },
          {
            "kind": "bool",
            "name": "disabled",
            "expr": {
              "kind": "prop",
              "name": "Disabled"
            }
          },
          {
            "kind": "expr",
            "name": "aria-label",
            "expr": {
              "kind": "prop",
              "name": "AriaLabel"
            }
          },
          {
            "kind": "rest"
          }
        ],
        "children": [],
        "void": true
      },
      "slots": [],
      "events": [],
      "a11y": {
        "roots": [
          "input"
        ],
        "roles": [],
        "aria": [
          {
            "name": "aria-label",
            "kind": "expr"
          }
        ],
        "keyboard": []
      },
      "data": [],
      "tokens": [
        "--muted",
        "--primary"
      ]
    }
  ],
  "examples": [
    {
      "id": "value.default",
      "props": {
        "Value": "30",
        "AriaLabel": "Volume"
      }
    },
    {
      "id": "state.disabled",
      "props": {
        "Disabled": true,
        "AriaLabel": "Volume"
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "runtimeNotes": [
    {
      "runtime": "svelte",
      "part": "Range",
      "note": "canary binds the value with $bindable; the contract here is Value + the input event (the caller owns the state)"
    }
  ]
}
