{
  "$schema": "../../schema/schemas/spec.schema.json",
  "specVersion": 1,
  "id": "ui.select",
  "tier": "brick",
  "dir": "select",
  "docs": "Select is a native dropdown built from Option items.",
  "variants": {
    "select": "select.variants.json"
  },
  "recordTypes": [
    {
      "name": "SelectOptionItem",
      "fields": [
        {
          "name": "Value",
          "type": "string"
        },
        {
          "name": "Label",
          "type": "string"
        }
      ]
    }
  ],
  "parts": [
    {
      "name": "Select",
      "docs": "Select renders option children from the Options list plus manual children.",
      "recipeId": "select",
      "classes": {
        "recipe": {
          "size": "Size",
          "variant": "Variant"
        }
      },
      "props": [
        {
          "name": "Variant",
          "type": "string",
          "cva": true,
          "docs": "sets appearance preset"
        },
        {
          "name": "Size",
          "type": "string",
          "cva": true,
          "docs": "sets density preset"
        },
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "Name",
          "type": "string",
          "cva": false,
          "passthrough": true
        },
        {
          "name": "Value",
          "type": "string",
          "cva": false,
