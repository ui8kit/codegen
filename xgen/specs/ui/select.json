          "docs": "ARIA role override"
        },
        {
          "name": "TabIndex",
          "type": "string",
          "cva": false,
          "passthrough": true,
          "docs": "tab order override"
        },
        {
          "name": "AriaLabel",
          "type": "string",
          "cva": false,
          "passthrough": true,
          "docs": "accessible name for unlabeled controls"
        },
        {
          "name": "Attrs",
          "type": "attrs",
          "cva": false
        },
        {
          "name": "Children",
          "type": "children",
          "cva": false
        }
      ],
