          {
            "kind": "expr",
            "name": "id",
            "expr": {
              "kind": "prop",
              "name": "ID"
            }
          },
          {
            "kind": "expr",
            "name": "name",
            "expr": {
              "kind": "prop",
              "name": "Name"
            }
          },
          {
            "kind": "class"
          },
          {
            "kind": "bool",
            "name": "disabled",
            "expr": {
              "kind": "prop",
              "name": "Disabled"
            }
          },
          {
            "kind": "bool",
            "name": "required",
            "expr": {
              "kind": "prop",
              "name": "Required"
            }
          },
          {
            "kind": "expr",
            "name": "role",
            "expr": {
              "kind": "prop",
              "name": "Role"
            }
          },
          {
            "kind": "expr",
            "name": "tabindex",
            "expr": {
              "kind": "prop",
              "name": "TabIndex"
            }
          },
          {
            "kind": "expr",
            "name": "aria-label",
            "expr": {
              "kind": "prop",
              "name": "AriaLabel"
            }
          },
          {
            "kind": "rest"
          }
        ],
        "children": [
          {
            "kind": "forEach",
            "itemsProp": "Options",
            "body": [
              {
                "kind": "element",
                "tag": {
                  "kind": "static",
                  "tag": "option"
                },
                "attrs": [
                  {
                    "kind": "expr",
                    "name": "value",
                    "expr": {
                      "kind": "item",
                      "field": "Value"
                    },
                    "keepEmpty": true
                  },
                  {
                    "kind": "bool",
                    "name": "selected",
                    "expr": {
                      "kind": "eq",
                      "left": {
                        "kind": "item",
                        "field": "Value"
                      },
                      "right": {
                        "kind": "prop",
                        "name": "Value"
                      }
                    }
                  }
                ],
                "children": [
                  {
                    "kind": "text",
                    "expr": {
                      "kind": "item",
                      "field": "Label"
                    }
                  }
                ]
              }
            ]
          },
          {
            "kind": "slot"
          }
        ]
      },
      "slots": [
        {
          "name": "children"
        }
      ],
      "events": [],
      "a11y": {
