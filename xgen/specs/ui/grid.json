{
  "$schema": "../../schema/schemas/spec.schema.json",
  "specVersion": 1,
  "id": "ui.grid",
  "tier": "brick",
  "dir": "grid",
  "docs": "Grid lays out children in a CSS grid with optional column wrappers.",
  "variants": {
    "grid": "grid.variants.json"
  },
  "parts": [
    {
      "name": "Grid",
      "docs": "Grid renders a display:grid container.",
      "recipeId": "grid",
      "asChild": true,
      "classes": {
        "recipe": {},
        "extra": [
          {
            "kind": "cond",
            "test": {
              "kind": "contains",
              "expr": {
                "kind": "prop",
                "name": "Class"
              },
              "substring": "grid-cols-"
            },
            "then": {
              "kind": "lit",
              "value": ""
            },
            "else": {
              "kind": "mapOr",
              "expr": {
                "kind": "defaultIfEmpty",
                "expr": {
                  "kind": "prop",
                  "name": "Cols"
                },
                "fallback": "1"
              },
              "mapping": {
                "1": "grid-cols-1",
                "2": "grid-cols-2",
                "3": "grid-cols-3",
                "4": "grid-cols-4",
                "5": "grid-cols-5",
                "6": "grid-cols-6",
                "7": "grid-cols-7",
                "8": "grid-cols-8",
                "9": "grid-cols-9",
                "10": "grid-cols-10",
                "11": "grid-cols-11",
                "12": "grid-cols-12",
                "1-2": "grid-cols-1 md:grid-cols-2",
                "1-3": "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
                "1-4": "grid-cols-1 sm:grid-cols-2 md:grid-cols-4",
                "2-3": "grid-cols-2 md:grid-cols-3",
                "2-4": "grid-cols-2 md:grid-cols-4",
                "2-6": "grid-cols-2 md:grid-cols-6",
                "3-6": "grid-cols-3 md:grid-cols-6"
              },
              "fallback": ""
            }
          }
        ]
      },
      "props": [
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "Cols",
          "type": "string",
          "cva": false,
          "docs": "column preset: 1–12 or responsive 1-2, 1-3, 1-4"
        },
        {
          "name": "Attrs",
          "type": "attrs",
          "cva": false
        },
        {
          "name": "Children",
          "type": "children",
          "cva": false
        }
      ],
      "render": {
        "kind": "element",
        "tag": {
          "kind": "static",
          "tag": "div"
        },
        "attrs": [
          {
            "kind": "class"
          },
          {
            "kind": "rest"
          }
        ],
        "children": [
          {
            "kind": "slot"
          }
        ]
      },
      "slots": [
        {
          "name": "children"
        }
      ],
      "events": [],
      "a11y": {
        "roots": [
          "div"
        ],
        "roles": [],
        "aria": [],
        "keyboard": []
      },
      "data": [],
      "tokens": []
    },
