{
  "$schema": "../../schema/schemas/spec.schema.json",
  "specVersion": 1,
  "id": "ui.lucide-icon",
  "tier": "brick",
  "dir": "lucide-icon",
  "docs": "LucideIcon renders a Lucide glyph (ISC license) by kebab-case name from the generated registry specs/assets/lucide-icons.json. Decorative (aria-hidden) unless a Label is given.",
  "variants": {
    "lucide-icon": "lucide-icon.variants.json"
  },
  "parts": [
    {
      "name": "LucideIcon",
      "docs": "LucideIcon renders an svg glyph by name.",
      "recipeId": "lucide-icon",
      "classes": {
        "recipe": {}
      },
      "props": [
        {
          "name": "Name",
          "type": "string",
          "cva": false,
          "docs": "kebab-case Lucide name; an unknown name draws a circle"
        },
        {
          "name": "Size",
          "type": "int",
          "cva": false,
          "docs": "width and height in px, 16 by default"
        },
        {
          "name": "StrokeWidth",
          "type": "int",
          "cva": false,
          "docs": "stroke width, 2 by default"
        },
        {
          "name": "Label",
          "type": "string",
          "cva": false,
          "docs": "accessible name; without it the icon is decorative"
        },
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "Attrs",
          "type": "attrs",
          "cva": false
        }
      ],
      "render": {
        "kind": "element",
        "tag": {
          "kind": "static",
          "tag": "svg"
        },
        "attrs": [
          {
            "kind": "class"
          },
          {
            "kind": "static",
            "name": "data-slot",
            "value": "icon"
          },
          {
            "kind": "rest"
          }
        ],
        "children": []
      },
      "slots": [],
      "events": [],
      "a11y": {
        "roots": [
          "svg"
        ],
        "roles": [],
        "aria": [],
        "keyboard": []
      },
      "data": [
        {
          "name": "data-slot",
          "kind": "static",
          "value": "icon"
        }
      ],
      "tokens": []
    }
  ],
  "examples": [],
  "portable": {
    "svelte": true,
    "react": true
  },
  "runtimeNotes": [
    {
      "runtime": "svelte",
      "part": "LucideIcon",
      "note": "the svg children are the nodes of the registry (an asset component of the runtime); the markup above is the frame"
    },
    {
      "runtime": "react",
      "part": "LucideIcon",
      "note": "the svg children are the nodes of the registry (an asset component of the runtime); the markup above is the frame"
    }
  ]
}
