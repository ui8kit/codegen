      "asChild": true,
      "classes": {
        "recipe": {}
      },
      "props": [
        {
          "name": "Class",
          "type": "string",
          "cva": false,
          "docs": "adds Tailwind utilities"
        },
        {
          "name": "Tag",
          "type": "string",
          "cva": false,
          "docs": "div only. Use Block for landmarks (aside, section, header, nav)."
        },
        {
          "name": "Attrs",
          "type": "attrs",
          "cva": false
        },
        {
          "name": "Children",
