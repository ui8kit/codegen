          {
            "kind": "rest"
          }
        ],
        "children": [
          {
            "kind": "slot"
          }
        ]
      },
      "slots": [
        {
          "name": "children"
        }
      ],
      "events": [],
      "a11y": {
        "roots": [
          "div",
          "(BoxAllowed)"
        ],
        "roles": [],
        "aria": [],
        "keyboard": []
      },
      "data": [],
      "tokens": []
    }
  ],
  "examples": [
    {
      "id": "tag.default",
      "props": {
        "Tag": "div"
      }
    },
    {
      "id": "class.padded",
      "props": {
        "Class": "p-4 rounded border border-border"
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
