{
  "$schema": "../../schema/schemas/spec.schema.json",
  "specVersion": 1,
  "id": "ui.box",
  "tier": "brick",
  "dir": "box",
  "docs": "Box is a generic layout wrapper for internal sections.\nNot for top-level landmarks — use Block for page regions.",
  "variants": {
    "box": "box.variants.json"
  },
  "parts": [
    {
      "name": "Box",
