{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.product-info",
  "name": "ProductInfo",
  "docs": "The details of a product under its buy box: texts in an accordion (native details) beside a card with the specs. Axes: layout (split: the specs beside the texts, stacked: below them), expand (first: the first text open, none), tone.",
  "records": {
    "Detail": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "text",
        "type": "string"
      }
    ],
    "Spec": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "label",
        "type": "string"
      },
      {
        "name": "value",
        "type": "string"
      }
    ],
    "ProductInfoLabels": [
      {
        "name": "specs",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "details",
      "type": {
        "ts": "Detail[]"
      },
      "required": true
    },
    {
      "name": "specs",
      "type": {
        "ts": "Spec[]"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "record": "ProductInfoLabels"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"split\" | \"stacked\""
      },
      "default": "split"
    },
    {
      "name": "expand",
      "type": {
        "ts": "\"first\" | \"none\""
      },
      "default": "first"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "use": "Box",
              "props": {
                "Class": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "layout"
                        },
                        "split"
                      ]
                    },
                    "grid grid-cols-1 items-start gap-8 lg:grid-cols-3",
                    "grid grid-cols-1 gap-8"
                  ]
                }
              },
              "children": [
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "details"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "0",
                        "Align": "stretch",
                        "Class": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "split"
                              ]
                            },
                            "lg:col-span-2",
                            ""
                          ]
                        }
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "details"
                          },
                          "as": "d",
                          "key": {
                            "$": "d.id"
                          },
                          "do": [
                            {
                              "use": "Disclosure",
                              "props": {
                                "Variant": "item",
                                "Open": {
                                  "op": "and",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "expand"
                                        },
                                        "first"
                                      ]
                                    },
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "i"
                                        },
                                        0
                                      ]
                                    }
                                  ]
                                }
                              },
                              "attrs": {
                                "data-testid": "item"
                              },
                              "children": [
                                {
                                  "use": "Summary",
                                  "props": {
                                    "Variant": "item"
                                  },
                                  "children": [
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "text-base font-semibold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "d.title"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Class": "pb-4 text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "d.text"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ],
                          "index": "i"
                        }
                      ]
                    }
                  ]
                },
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "specs"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "4",
                        "Align": "stretch",
                        "Class": "rounded bg-card inset-ring inset-ring-border p-6"
                      },
                      "attrs": {
                        "data-testid": "specs"
                      },
                      "children": [
                        {
                          "use": "Title",
                          "props": {
                            "As": 3,
                            "Size": "lg",
                            "Weight": "bold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "labels.specs"
                              }
                            }
                          ]
                        },
                        {
                          "use": "List",
                          "props": {
                            "Tag": "ul",
                            "Class": "flex flex-col"
                          },
                          "children": [
                            {
                              "each": {
                                "$": "specs"
                              },
                              "as": "s",
                              "key": {
                                "$": "s.id"
                              },
                              "do": [
                                {
                                  "use": "ListItem",
                                  "props": {
                                    "Class": "flex items-center justify-between gap-4 border-b border-border py-2 text-sm last:border-b-0"
                                  },
                                  "attrs": {
                                    "data-testid": "spec"
                                  },
                                  "children": [
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "text-muted-foreground"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "s.label"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "font-medium"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "s.value"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
