{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.video-grid",
  "name": "VideoGrid",
  "docs": "Video testimonials as thumbnails: a picture, a play button, the name and the company. The player is a port contract (VideoEmbed); here the button emits `play`. Axes: columns (2, 3), caption (below, overlay), tone, density.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "quotes",
      "type": {
        "ts": "Quote[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "playLabel",
      "type": "string",
      "required": true,
      "docs": "template of the play button's name, e.g. `Play the video from {0}`"
    },
    {
      "name": "byLine",
      "type": "string",
      "required": true,
      "docs": "template of the line under the name: `{0}, {1}` (role, company)"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"1-2\" | \"1-3\""
      },
      "default": "1-3"
    },
    {
      "name": "caption",
      "type": {
        "ts": "\"below\" | \"overlay\""
      },
      "default": "below"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "play",
      "args": [
        {
          "name": "id",
          "type": "string"
        }
      ],
      "docs": "a play button was pressed"
    }
  ],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "quotes"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "video",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Grid",
                  "props": {
                    "Cols": {
                      "$": "cols"
                    },
                    "Class": "gap-4"
                  },
                  "attrs": {
                    "data-testid": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "quotes"
                      },
                      "as": "q",
                      "key": {
                        "$": "q.id"
                      },
                      "do": [
                        {
                          "organism": "FigureBlock",
                          "props": {
                            "className": "m-0 flex flex-col gap-4",
                            "testid": "item"
                          },
                          "slots": {
                            "children": {
                              "args": [],
                              "do": [
                                {
                                  "use": "Box",
                                  "props": {
                                    "Class": "relative"
                                  },
                                  "children": [
                                    {
                                      "organism": "MediaFrame",
                                      "props": {
                                        "alt": {
                                          "$": "q.author"
                                        }
                                      }
                                    },
                                    {
                                      "use": "Button",
                                      "props": {
                                        "Variant": "default",
                                        "Size": "default",
                                        "Type": "button",
                                        "Class": "absolute top-1/2 left-1/2 size-12 -translate-x-1/2 -translate-y-1/2 rounded p-0"
                                      },
                                      "attrs": {
                                        "aria-label": {
                                          "op": "tpl",
                                          "args": [
                                            {
                                              "$": "playLabel"
                                            },
                                            {
                                              "$": "q.author"
                                            }
                                          ]
                                        },
                                        "data-testid": "play"
                                      },
                                      "on": {
                                        "click": {
                                          "call": "emit.play",
                                          "args": [
                                            {
                                              "$": "q.id"
                                            }
                                          ]
                                        }
                                      },
                                      "children": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": "play",
                                            "Size": 20
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "when": {
                                        "op": "eq",
                                        "args": [
                                          {
                                            "$": "caption"
                                          },
                                          "overlay"
                                        ]
                                      },
                                      "then": [
                                        {
                                          "use": "Box",
                                          "props": {
                                            "Class": "absolute inset-x-0 bottom-0 rounded bg-background p-4"
                                          },
                                          "attrs": {
                                            "data-testid": "caption"
                                          },
                                          "children": [
                                            {
                                              "use": "Text",
                                              "props": {
                                                "Size": "sm",
                                                "Weight": "semibold"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "q.author"
                                                  }
                                                }
                                              ]
                                            },
                                            {
                                              "use": "Text",
                                              "props": {
                                                "Size": "xs",
                                                "Class": "text-muted-foreground"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "op": "tpl",
                                                    "args": [
                                                      {
                                                        "$": "byLine"
                                                      },
                                                      {
                                                        "$": "q.role"
                                                      },
                                                      {
                                                        "$": "q.company"
                                                      }
                                                    ]
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "when": {
                                    "op": "eq",
                                    "args": [
                                      {
                                        "$": "caption"
                                      },
                                      "below"
                                    ]
                                  },
                                  "then": [
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Tag": "figcaption"
                                      },
                                      "attrs": {
                                        "data-testid": "caption"
                                      },
                                      "children": [
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "sm",
                                            "Weight": "semibold"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "q.author"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "xs",
                                            "Class": "text-muted-foreground"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "op": "tpl",
                                                "args": [
                                                  {
                                                    "$": "byLine"
                                                  },
                                                  {
                                                    "$": "q.role"
                                                  },
                                                  {
                                                    "$": "q.company"
                                                  }
                                                ]
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "TestimonialGrid",
      "names": [
        "Quote"
      ]
    }
  ]
}
