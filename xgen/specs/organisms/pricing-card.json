{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.pricing-card",
  "name": "PricingCard",
  "docs": "A plan as a card: name, tagline, price per month, the features, a call to action and an optional slot for more actions. Text comes in through `labels`; the plan is data.",
  "records": {
    "Plan": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "tagline",
        "type": "string"
      },
      {
        "name": "price",
        "type": "number"
      },
      {
        "name": "currency",
        "type": "string"
      },
      {
        "name": "seats",
        "type": "number"
      },
      {
        "name": "storage",
        "type": "number"
      },
      {
        "name": "highlighted",
        "type": "boolean"
      },
      {
        "name": "status",
        "type": "string",
        "optional": true
      },
      {
        "name": "features",
        "type": "string[]"
      },
      {
        "name": "yearly",
        "type": "number"
      }
    ],
    "PricingCardLabels": [
      {
        "name": "popular",
        "type": "string"
      },
      {
        "name": "perMonth",
        "type": "string"
      },
      {
        "name": "seats",
        "type": "string"
      },
      {
        "name": "storage",
        "type": "string"
      },
      {
        "name": "cta",
        "type": "string"
      },
      {
        "name": "free",
        "type": "string"
      },
      {
        "name": "perYear",
        "type": "string"
      },
      {
        "name": "empty",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "plan",
      "type": {
        "record": "Plan"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "record": "PricingCardLabels"
      },
      "required": true
    },
    {
      "name": "current",
      "type": "boolean",
      "docs": "marks the plan as the chosen one"
    },
    {
      "name": "emphasis",
      "type": {
        "ts": "\"auto\" | \"off\""
      },
      "default": "auto",
      "docs": "auto: the highlighted plan stands out; off: all plans alike"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default",
      "docs": "compact: tighter content"
    },
    {
      "name": "billing",
      "type": {
        "ts": "\"monthly\" | \"annual\""
      },
      "default": "monthly",
      "docs": "annual: the yearly price of the plan, when it has one"
    }
  ],
  "derived": [
    {
      "name": "stand",
      "value": {
        "op": "and",
        "args": [
          {
            "$": "plan.highlighted"
          },
          {
            "op": "eq",
            "args": [
              {
                "$": "emphasis"
              },
              "auto"
            ]
          }
        ]
      }
    },
    {
      "name": "yearlyOn",
      "value": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "billing"
              },
              "annual"
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "$": "plan.yearly"
              },
              0
            ]
          }
        ]
      }
    },
    {
      "name": "amount",
      "value": {
        "op": "cond",
        "args": [
          {
            "$": "yearlyOn"
          },
          {
            "$": "plan.yearly"
          },
          {
            "$": "plan.price"
          }
        ]
      }
    }
  ],
  "slots": [
    {
      "name": "footer",
      "args": [
        {
          "name": "plan",
          "type": {
            "record": "Plan"
          }
        }
      ],
      "docs": "more content in the footer; receives the plan"
    }
  ],
  "events": [
    {
      "name": "select",
      "args": [
        {
          "name": "id",
          "type": "string"
        }
      ],
      "docs": "the call to action was pressed"
    }
  ],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "article",
        "Class": {
          "op": "cn",
          "args": [
            "flex flex-col gap-8 bg-card p-6 text-card-foreground inset-ring inset-ring-border rounded",
            "flex h-full flex-col"
          ]
        }
      },
      "attrs": {
        "data-slot": "card",
        "data-highlighted": {
          "op": "cond",
          "args": [
            {
              "$": "stand"
            },
            "true",
            "false"
          ]
        },
        "data-current": {
          "op": "cond",
          "args": [
            {
              "$": "current"
            },
            "true",
            "false"
          ]
        }
      },
      "children": [
        {
          "use": "CardHeader",
          "props": {
            "Class": "flex flex-col gap-2"
          },
          "children": [
            {
              "use": "Box",
              "props": {
                "Class": "flex min-h-6 items-center"
              },
              "attrs": {
                "data-slot": "badge-slot"
              },
              "children": [
                {
                  "when": {
                    "$": "stand"
                  },
                  "then": [
                    {
                      "use": "Badge",
                      "props": {
                        "Variant": "default",
                        "Size": "default"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "labels.popular"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "use": "CardTitle",
              "props": {
                "As": 3
              },
              "children": [
                {
                  "text": {
                    "$": "plan.name"
                  }
                }
              ]
            },
            {
              "use": "CardDescription",
              "children": [
                {
                  "text": {
                    "$": "plan.tagline"
                  }
                }
              ]
            }
          ]
        },
        {
          "use": "CardContent",
          "props": {
            "Class": {
              "op": "cn",
              "args": [
                "flex flex-1 flex-col",
                {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "density"
                        },
                        "compact"
                      ]
                    },
                    "gap-2",
                    "gap-4"
                  ]
                }
              ]
            }
          },
          "children": [
            {
              "use": "Group",
              "props": {
                "Gap": "2",
                "Align": "baseline"
              },
              "children": [
                {
                  "use": "Title",
                  "props": {
                    "As": 2,
                    "Size": "4xl",
                    "Weight": "bold"
                  },
                  "children": [
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "amount"
                          },
                          0
                        ]
                      },
                      "then": [
                        {
                          "text": {
                            "$": "labels.free"
                          }
                        }
                      ],
                      "else": [
                        {
                          "text": {
                            "op": "money",
                            "args": [
                              {
                                "$": "amount"
                              },
                              {
                                "$": "plan.currency"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "$": "amount"
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "use": "Text",
                      "props": {
                        "Size": "sm",
                        "Class": "text-muted-foreground"
                      },
                      "children": [
                        {
                          "text": {
                            "op": "cond",
                            "args": [
                              {
                                "$": "yearlyOn"
                              },
                              {
                                "$": "labels.perYear"
                              },
                              {
                                "$": "labels.perMonth"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "use": "Text",
              "props": {
                "Size": "sm",
                "Weight": "medium"
              },
              "children": [
                {
                  "text": {
                    "op": "tpl",
                    "args": [
                      {
                        "$": "labels.seats"
                      },
                      {
                        "$": "plan.seats"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "use": "Text",
              "props": {
                "Size": "sm",
                "Class": "text-muted-foreground"
              },
              "children": [
                {
                  "text": {
                    "op": "tpl",
                    "args": [
                      {
                        "$": "labels.storage"
                      },
                      {
                        "$": "plan.storage"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "use": "List",
              "props": {
                "Tag": "ul",
                "Class": "flex flex-col gap-2 text-sm"
              },
              "children": [
                {
                  "each": {
                    "$": "plan.features"
                  },
                  "as": "feature",
                  "key": {
                    "$": "feature"
                  },
                  "do": [
                    {
                      "use": "ListItem",
                      "props": {
                        "Class": "flex gap-2"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "feature"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "use": "CardFooter",
          "props": {
            "Class": "flex flex-wrap items-center gap-2"
          },
          "children": [
            {
              "use": "Button",
              "props": {
                "Variant": {
                  "op": "cond",
                  "args": [
                    {
                      "$": "stand"
                    },
                    "default",
                    "outline"
                  ]
                },
                "Size": "default"
              },
              "attrs": {
                "data-testid": "plan-select"
              },
              "on": {
                "click": {
                  "call": "emit.select",
                  "args": [
                    {
                      "$": "plan.id"
                    }
                  ]
                }
              },
              "children": [
                {
                  "text": {
                    "$": "labels.cta"
                  }
                }
              ]
            },
            {
              "slot": "footer",
              "args": [
                {
                  "$": "plan"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
