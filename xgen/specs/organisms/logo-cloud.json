{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.logo-cloud",
  "name": "LogoCloud",
  "docs": "A heading and the names of customers or partners as Lucide glyphs with a name. Axes: layout (grid, row), columns (2, 3, 4), item (name, icon only, tile), density, tone.",
  "records": {
    "Logo": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "icon",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "logos",
      "type": {
        "ts": "Logo[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"grid\" | \"row\""
      },
      "default": "grid"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"2\" | \"3\" | \"4\""
      },
      "default": "4"
    },
    {
      "name": "item",
      "type": {
        "ts": "\"name\" | \"icon\" | \"tile\""
      },
      "default": "name"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"roomy\" | \"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "op": "len",
            "args": [
              {
                "$": "logos"
              }
            ]
          },
          0
        ]
      },
      "then": [
        {
          "organism": "SectionFrame",
          "props": {
            "id": {
              "$": "id"
            },
            "title": {
              "$": "title"
            },
            "tone": {
              "$": "tone"
            },
            "density": {
              "$": "density"
            },
            "align": "center",
            "landmarkLabel": {
              "$": "landmarkLabel"
            }
          },
          "slots": {
            "children": {
              "args": [],
              "do": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "building-2",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ]
            }
          }
        }
      ],
      "else": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "row"
            ]
          },
          "then": [
            {
              "organism": "LogoRibbon",
              "props": {
                "id": {
                  "$": "id"
                },
                "title": {
                  "$": "title"
                },
                "logos": {
                  "$": "logos"
                },
                "tone": {
                  "$": "tone"
                },
                "density": {
                  "$": "density"
                },
                "landmarkLabel": {
                  "$": "landmarkLabel"
                }
              }
            }
          ],
          "else": [
            {
              "organism": "SectionFrame",
              "props": {
                "id": {
                  "$": "id"
                },
                "title": {
                  "$": "title"
                },
                "tone": {
                  "$": "tone"
                },
                "density": {
                  "$": "density"
                },
                "align": "center",
                "landmarkLabel": {
                  "$": "landmarkLabel"
                }
              },
              "slots": {
                "children": {
                  "args": [],
                  "do": [
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "cols"
                                },
                                "2"
                              ]
                            },
                            "2",
                            {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "cols"
                                    },
                                    "3"
                                  ]
                                },
                                "2-3",
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "cols"
                                        },
                                        "4"
                                      ]
                                    },
                                    "2-4",
                                    "3-6"
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        "Class": "gap-4"
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "logos"
                          },
                          "as": "logo",
                          "key": {
                            "$": "logo.id"
                          },
                          "do": [
                            {
                              "use": "Group",
                              "props": {
                                "Gap": "2",
                                "Align": "center",
                                "Justify": "center",
                                "Class": {
                                  "op": "cn",
                                  "args": [
                                    "text-muted-foreground",
                                    {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "item"
                                            },
                                            "tile"
                                          ]
                                        },
                                        "flex-col rounded p-4 inset-ring inset-ring-border",
                                        ""
                                      ]
                                    }
                                  ]
                                }
                              },
                              "attrs": {
                                "data-testid": "item"
                              },
                              "children": [
                                {
                                  "use": "LucideIcon",
                                  "props": {
                                    "Name": {
                                      "$": "logo.icon"
                                    },
                                    "Size": 24
                                  }
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Weight": "semibold",
                                    "Class": {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "item"
                                            },
                                            "icon"
                                          ]
                                        },
                                        "sr-only",
                                        ""
                                      ]
                                    }
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "logo.name"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
