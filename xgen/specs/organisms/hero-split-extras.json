{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.hero-split-extras",
  "name": "HeroSplitExtras",
  "docs": "What HeroSplit shows under the lead: three figures in cards, a row of faces with a proof line, two small feature cards, or a quote with its author over three figures.",
  "records": {},
  "props": [
    {
      "name": "content",
      "type": {
        "ts": "HeroContent"
      },
      "required": true,
      "docs": "the figures, small cards, people, proof line and floating card of the hero"
    },
    {
      "name": "extra",
      "type": {
        "ts": "\"stats\" | \"avatars\" | \"minis\" | \"quote\" | \"none\""
      },
      "default": "none"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "extra"
              },
              "stats"
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "op": "len",
                "args": [
                  {
                    "$": "content.stats"
                  }
                ]
              },
              0
            ]
          }
        ]
      },
      "then": [
        {
          "use": "Box",
          "props": {
            "Class": "grid grid-cols-3 gap-4"
          },
          "attrs": {
            "data-testid": "hero-stats"
          },
          "children": [
            {
              "each": {
                "$": "content.stats"
              },
              "as": "s",
              "key": {
                "$": "s.id"
              },
              "do": [
                {
                  "when": {
                    "op": "lt",
                    "args": [
                      {
                        "$": "i"
                      },
                      3
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "0",
                        "Class": "rounded bg-card inset-ring inset-ring-border p-4"
                      },
                      "attrs": {
                        "data-testid": "hero-stat"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "2xl",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "s.value"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "s.label"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "index": "i"
            }
          ]
        }
      ]
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "extra"
              },
              "avatars"
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "op": "len",
                "args": [
                  {
                    "$": "content.people"
                  }
                ]
              },
              0
            ]
          }
        ]
      },
      "then": [
        {
          "use": "Group",
          "props": {
            "Gap": "4",
            "Align": "center",
            "Class": "flex-wrap"
          },
          "attrs": {
            "data-testid": "hero-proof"
          },
          "children": [
            {
              "use": "Group",
              "props": {
                "Gap": "2",
                "Align": "center"
              },
              "children": [
                {
                  "each": {
                    "$": "content.people"
                  },
                  "as": "p",
                  "key": {
                    "$": "p.id"
                  },
                  "do": [
                    {
                      "when": {
                        "op": "lt",
                        "args": [
                          {
                            "$": "i"
                          },
                          4
                        ]
                      },
                      "then": [
                        {
                          "organism": "MediaFrame",
                          "props": {
                            "alt": {
                              "$": "p.author"
                            },
                            "ratio": "1/1",
                            "className": "size-10 shrink-0 rounded-full"
                          }
                        }
                      ]
                    }
                  ],
                  "index": "i"
                }
              ]
            },
            {
              "use": "Text",
              "props": {
                "Size": "sm",
                "Class": "text-muted-foreground"
              },
              "children": [
                {
                  "text": {
                    "$": "content.proof"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "extra"
              },
              "minis"
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "op": "len",
                "args": [
                  {
                    "$": "content.features"
                  }
                ]
              },
              0
            ]
          }
        ]
      },
      "then": [
        {
          "use": "Box",
          "props": {
            "Class": "grid grid-cols-1 gap-4 sm:grid-cols-2"
          },
          "attrs": {
            "data-testid": "hero-minis"
          },
          "children": [
            {
              "each": {
                "$": "content.features"
              },
              "as": "f",
              "key": {
                "$": "f.id"
              },
              "do": [
                {
                  "when": {
                    "op": "lt",
                    "args": [
                      {
                        "$": "i"
                      },
                      2
                    ]
                  },
                  "then": [
                    {
                      "use": "Group",
                      "props": {
                        "Gap": "4",
                        "Align": "start",
                        "Class": "rounded bg-card inset-ring inset-ring-border p-4"
                      },
                      "attrs": {
                        "data-testid": "hero-mini"
                      },
                      "children": [
                        {
                          "use": "Box",
                          "props": {
                            "Class": "flex size-10 shrink-0 items-center justify-center rounded bg-muted"
                          },
                          "children": [
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": {
                                  "$": "f.icon"
                                },
                                "Size": 20
                              }
                            }
                          ]
                        },
                        {
                          "use": "Stack",
                          "props": {
                            "Gap": "0"
                          },
                          "children": [
                            {
                              "use": "Text",
                              "props": {
                                "Size": "sm",
                                "Weight": "semibold"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "f.title"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "xs",
                                "Class": "text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "f.text"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "index": "i"
            }
          ]
        }
      ]
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "extra"
              },
              "quote"
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "op": "len",
                "args": [
                  {
                    "$": "content.people"
                  }
                ]
              },
              0
            ]
          }
        ]
      },
      "then": [
        {
          "use": "Stack",
          "props": {
            "Gap": "6",
            "Align": "stretch"
          },
          "children": [
            {
              "each": {
                "$": "content.people"
              },
              "as": "p",
              "key": {
                "$": "p.id"
              },
              "do": [
                {
                  "when": {
                    "op": "lt",
                    "args": [
                      {
                        "$": "i"
                      },
                      1
                    ]
                  },
                  "then": [
                    {
                      "organism": "FigureBlock",
                      "props": {
                        "className": "flex flex-col gap-4",
                        "testid": "hero-quote"
                      },
                      "slots": {
                        "children": {
                          "args": [],
                          "do": [
                            {
                              "use": "Text",
                              "props": {
                                "Tag": "blockquote",
                                "Class": "text-lg font-medium"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "p.quote"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Group",
                              "props": {
                                "Gap": "4",
                                "Align": "center"
                              },
                              "children": [
                                {
                                  "organism": "MediaFrame",
                                  "props": {
                                    "alt": {
                                      "$": "p.author"
                                    },
                                    "ratio": "1/1",
                                    "className": "size-10 shrink-0 rounded-full"
                                  }
                                },
                                {
                                  "use": "Stack",
                                  "props": {
                                    "Gap": "0"
                                  },
                                  "children": [
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "sm",
                                        "Weight": "semibold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "p.author"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "xs",
                                        "Class": "text-muted-foreground"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "p.role"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              ],
              "index": "i"
            },
            {
              "use": "Box",
              "props": {
                "Class": "grid grid-cols-3 gap-4"
              },
              "attrs": {
                "data-testid": "hero-stats"
              },
              "children": [
                {
                  "each": {
                    "$": "content.stats"
                  },
                  "as": "s",
                  "key": {
                    "$": "s.id"
                  },
                  "do": [
                    {
                      "when": {
                        "op": "lt",
                        "args": [
                          {
                            "$": "i"
                          },
                          3
                        ]
                      },
                      "then": [
                        {
                          "use": "Stack",
                          "props": {
                            "Gap": "0",
                            "Class": "rounded bg-card inset-ring inset-ring-border p-4"
                          },
                          "attrs": {
                            "data-testid": "hero-stat"
                          },
                          "children": [
                            {
                              "use": "Text",
                              "props": {
                                "Size": "2xl",
                                "Weight": "semibold"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "s.value"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "xs",
                                "Class": "text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "s.label"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "index": "i"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "HeroSplit",
      "names": [
        "HeroContent"
      ]
    }
  ]
}
