{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.topic-chips",
  "name": "TopicChips",
  "docs": "A centered row of topic pills: links where a topic has an address, else buttons. tone inverse: on a dark band with an icon per topic; default: outlined.",
  "records": {
    "Topic": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "icon",
        "type": "string"
      },
      {
        "name": "href",
        "type": "string",
        "optional": true
      }
    ]
  },
  "props": [
    {
      "name": "topics",
      "type": {
        "ts": "Topic[]"
      },
      "required": true
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"inverse\""
      },
      "default": "default"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Group",
      "props": {
        "Gap": "2",
        "Align": "center",
        "Justify": "center",
        "Class": "flex-wrap"
      },
      "attrs": {
        "data-testid": "hero-topics"
      },
      "children": [
        {
          "each": {
            "$": "topics"
          },
          "as": "topic",
          "key": {
            "$": "topic.id"
          },
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "tone"
                  },
                  "inverse"
                ]
              },
              "then": [
                {
                  "use": "Button",
                  "props": {
                    "Href": {
                      "$": "topic.href"
                    },
                    "Variant": "ghost",
                    "Size": "sm",
                    "Class": "gap-2 text-background inset-ring-background/30 hover:bg-background/10"
                  },
                  "attrs": {
                    "data-testid": "hero-topic"
                  },
                  "children": [
                    {
                      "when": {
                        "$": "topic.icon"
                      },
                      "then": [
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": {
                              "$": "topic.icon"
                            },
                            "Size": 16
                          }
                        }
                      ]
                    },
                    {
                      "text": {
                        "$": "topic.name"
                      }
                    }
                  ]
                }
              ],
              "else": [
                {
                  "use": "Button",
                  "props": {
                    "Href": {
                      "$": "topic.href"
                    },
                    "Variant": "outline",
                    "Size": "sm"
                  },
                  "attrs": {
                    "data-testid": "hero-topic"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "topic.name"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
