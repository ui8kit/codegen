{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.about-company",
  "name": "AboutCompany",
  "docs": "The culture of a company: a strip of three pictures, the heading, a few figures and the values. Axes: layout (split: the pictures beside the text, stacked: the pictures under it), tone, density.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "stats",
      "type": {
        "ts": "Stat[]"
      },
      "required": true
    },
    {
      "name": "values",
      "type": {
        "ts": "Feature[]"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"split\" | \"stacked\""
      },
      "default": "split"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "layout": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "layout"
                },
                "split"
              ]
            },
            "split",
            "stack"
          ]
        },
        "media": {
          "show": true,
          "side": "start"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "gt",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "stats"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "use": "Grid",
                  "props": {
                    "Cols": "2-4",
                    "Class": "gap-4"
                  },
                  "attrs": {
                    "data-testid": "stats"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "stats"
                      },
                      "as": "s",
                      "key": {
                        "$": "s.id"
                      },
                      "do": [
                        {
                          "use": "Stack",
                          "props": {
                            "Gap": "0"
                          },
                          "attrs": {
                            "data-testid": "stat"
                          },
                          "children": [
                            {
                              "use": "Text",
                              "props": {
                                "Size": "3xl",
                                "Weight": "bold"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "s.value"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "xs",
                                "Class": "text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "s.label"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "gt",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "values"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "use": "Box",
                  "props": {
                    "Class": {
                      "op": "cn",
                      "args": [
                        "grid grid-cols-1 gap-4",
                        {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "stacked"
                              ]
                            },
                            "md:grid-cols-3",
                            ""
                          ]
                        }
                      ]
                    }
                  },
                  "attrs": {
                    "data-testid": "values"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "values"
                      },
                      "as": "v",
                      "key": {
                        "$": "v.id"
                      },
                      "do": [
                        {
                          "use": "Group",
                          "props": {
                            "Gap": "4",
                            "Align": "start",
                            "Class": "border-t border-border pt-4"
                          },
                          "attrs": {
                            "data-testid": "value"
                          },
                          "children": [
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": {
                                  "$": "v.icon"
                                },
                                "Size": 20
                              }
                            },
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "2"
                              },
                              "children": [
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Weight": "semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "v.title"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Class": "text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "v.text"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "aside": {
          "args": [],
          "do": [
            {
              "use": "Box",
              "props": {
                "Class": "grid grid-cols-3 gap-4"
              },
              "attrs": {
                "data-testid": "strip"
              },
              "children": [
                {
                  "organism": "MediaFrame",
                  "props": {
                    "alt": {
                      "$": "title"
                    },
                    "ratio": "3/4"
                  }
                },
                {
                  "organism": "MediaFrame",
                  "props": {
                    "alt": {
                      "$": "title"
                    },
                    "ratio": "3/4",
                    "className": "mt-8"
                  }
                },
                {
                  "organism": "MediaFrame",
                  "props": {
                    "alt": {
                      "$": "title"
                    },
                    "ratio": "3/4"
                  }
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "StatsBand",
      "names": [
        "Stat"
      ]
    },
    {
      "from": "FeatureGrid",
      "names": [
        "Feature"
      ]
    }
  ]
}
