{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.product-grid",
  "name": "ProductGrid",
  "docs": "A section with a heading and the products as cards in a grid, as a list of horizontal cards, or as a rail that scrolls sideways; an empty state when there are none. Axes: layout (grid, list, rail), columns, ratio, rating, action, tone, density.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "products",
      "type": {
        "ts": "Product[]"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "ProductLabels"
      },
      "required": true
    },
    {
      "name": "badges",
      "type": {
        "ts": "Record<string, string>"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"grid\" | \"list\" | \"rail\""
      },
      "default": "grid"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"1-2\" | \"1-3\" | \"1-4\""
      },
      "default": "1-3"
    },
    {
      "name": "ratio",
      "type": {
        "ts": "\"4/3\" | \"1/1\" | \"3/4\""
      },
      "default": "4/3"
    },
    {
      "name": "rating",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "action",
      "type": {
        "ts": "\"button\" | \"none\""
      },
      "default": "button"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"roomy\" | \"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "add",
      "args": [
        {
          "name": "id",
          "type": "string"
        }
      ],
      "docs": "the add button of a product was pressed"
    }
  ],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "products"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "package",
                    "title": {
                      "$": "labels.empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "rail"
                    ]
                  },
                  "then": [
                    {
                      "use": "Box",
                      "props": {
                        "Class": "flex snap-x gap-4 overflow-x-auto pb-4"
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "products"
                          },
                          "as": "p",
                          "key": {
                            "$": "p.id"
                          },
                          "do": [
                            {
                              "use": "Box",
                              "props": {
                                "Class": "w-64 shrink-0 snap-start"
                              },
                              "children": [
                                {
                                  "organism": "ProductCard",
                                  "props": {
                                    "product": {
                                      "$": "p"
                                    },
                                    "labels": {
                                      "$": "labels"
                                    },
                                    "badges": {
                                      "$": "badges"
                                    },
                                    "layout": {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "layout"
                                            },
                                            "list"
                                          ]
                                        },
                                        "horizontal",
                                        "vertical"
                                      ]
                                    },
                                    "ratio": {
                                      "$": "ratio"
                                    },
                                    "rating": {
                                      "$": "rating"
                                    },
                                    "action": {
                                      "$": "action"
                                    },
                                    "density": {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "density"
                                            },
                                            "compact"
                                          ]
                                        },
                                        "compact",
                                        "default"
                                      ]
                                    }
                                  },
                                  "on": {
                                    "add": {
                                      "call": "emit.add",
                                      "args": [
                                        {
                                          "$": "p.id"
                                        }
                                      ]
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "list"
                              ]
                            },
                            "1",
                            {
                              "$": "cols"
                            }
                          ]
                        },
                        "Class": "gap-4"
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "products"
                          },
                          "as": "p",
                          "key": {
                            "$": "p.id"
                          },
                          "do": [
                            {
                              "organism": "ProductCard",
                              "props": {
                                "product": {
                                  "$": "p"
                                },
                                "labels": {
                                  "$": "labels"
                                },
                                "badges": {
                                  "$": "badges"
                                },
                                "layout": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "layout"
                                        },
                                        "list"
                                      ]
                                    },
                                    "horizontal",
                                    "vertical"
                                  ]
                                },
                                "ratio": {
                                  "$": "ratio"
                                },
                                "rating": {
                                  "$": "rating"
                                },
                                "action": {
                                  "$": "action"
                                },
                                "density": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "density"
                                        },
                                        "compact"
                                      ]
                                    },
                                    "compact",
                                    "default"
                                  ]
                                }
                              },
                              "on": {
                                "add": {
                                  "call": "emit.add",
                                  "args": [
                                    {
                                      "$": "p.id"
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "ProductCard",
      "names": [
        "Product",
        "ProductLabels"
      ]
    }
  ]
}
