{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.auth-card",
  "name": "AuthCard",
  "docs": "A sign-in, sign-up or password reset card: heading, one sentence, the fields of the mode, a submit button, optional alternative sign-in buttons and a link to the other mode. Axes: mode (signin, signup, reset), layout (card, plain), social (none, show).",
  "records": {
    "AuthLabels": [
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "email",
        "type": "string"
      },
      {
        "name": "password",
        "type": "string"
      },
      {
        "name": "remember",
        "type": "string"
      },
      {
        "name": "forgot",
        "type": "string"
      },
      {
        "name": "terms",
        "type": "string"
      },
      {
        "name": "divider",
        "type": "string"
      },
      {
        "name": "passkey",
        "type": "string"
      },
      {
        "name": "magic",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "text",
      "type": "string",
      "required": true
    },
    {
      "name": "submit",
      "type": "string",
      "required": true
    },
    {
      "name": "switchText",
      "type": "string",
      "required": true,
      "docs": "the question before the link to the other mode"
    },
    {
      "name": "switchLink",
      "type": "string",
      "required": true
    },
    {
      "name": "switchHref",
      "type": "string"
    },
    {
      "name": "labels",
      "type": {
        "record": "AuthLabels"
      },
      "required": true
    },
    {
      "name": "mode",
      "type": {
        "ts": "\"signin\" | \"signup\" | \"reset\" | \"magic\""
      },
      "default": "signin"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"card\" | \"plain\""
      },
      "default": "card"
    },
    {
      "name": "social",
      "type": {
        "ts": "\"none\" | \"show\" | \"first\""
      },
      "default": "none",
      "docs": "first: the other sign-in buttons come before the fields"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2"
      },
      "default": 2
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": {
          "op": "cn",
          "args": [
            "flex w-full flex-col gap-6",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "layout"
                    },
                    "card"
                  ]
                },
                "rounded bg-card p-6 inset-ring inset-ring-border",
                ""
              ]
            }
          ]
        }
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            {
              "op": "tpl",
              "args": [
                "{0}-title",
                {
                  "$": "id"
                }
              ]
            }
          ]
        },
        "data-testid": "auth-card",
        "data-mode": {
          "$": "mode"
        },
        "aria-label": {
          "$": "landmarkLabel"
        }
      },
      "children": [
        {
          "use": "Stack",
          "props": {
            "Gap": "2"
          },
          "children": [
            {
              "use": "Title",
              "props": {
                "As": {
                  "$": "level"
                },
                "Size": "2xl",
                "Weight": "bold"
              },
              "attrs": {
                "id": {
                  "op": "tpl",
                  "args": [
                    "{0}-title",
                    {
                      "$": "id"
                    }
                  ]
                }
              },
              "children": [
                {
                  "text": {
                    "$": "title"
                  }
                }
              ]
            },
            {
              "use": "Text",
              "props": {
                "Size": "sm",
                "Class": "text-muted-foreground"
              },
              "children": [
                {
                  "text": {
                    "$": "text"
                  }
                }
              ]
            }
          ]
        },
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "social"
                  },
                  "first"
                ]
              },
              {
                "op": "ne",
                "args": [
                  {
                    "$": "social"
                  },
                  "none"
                ]
              },
              {
                "op": "ne",
                "args": [
                  {
                    "$": "mode"
                  },
                  "reset"
                ]
              },
              {
                "op": "ne",
                "args": [
                  {
                    "$": "mode"
                  },
                  "magic"
                ]
              }
            ]
          },
          "then": [
            {
              "use": "Stack",
              "props": {
                "Gap": "4"
              },
              "attrs": {
                "data-testid": "social"
              },
              "children": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "4",
                    "Align": "center"
                  },
                  "children": [
                    {
                      "use": "Separator",
                      "props": {
                        "Class": "flex-1"
                      }
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "xs",
                        "Class": "text-muted-foreground"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "labels.divider"
                          }
                        }
                      ]
                    },
                    {
                      "use": "Separator",
                      "props": {
                        "Class": "flex-1"
                      }
                    }
                  ]
                },
                {
                  "use": "Button",
                  "props": {
                    "Variant": "outline",
                    "Size": "default",
                    "Type": "button",
                    "Class": "w-full"
                  },
                  "children": [
                    {
                      "use": "LucideIcon",
                      "props": {
                        "Name": "key-round",
                        "Size": 16
                      }
                    },
                    {
                      "text": {
                        "$": "labels.passkey"
                      }
                    }
                  ]
                },
                {
                  "use": "Button",
                  "props": {
                    "Variant": "outline",
                    "Size": "default",
                    "Type": "button",
                    "Class": "w-full"
                  },
                  "children": [
                    {
                      "use": "LucideIcon",
                      "props": {
                        "Name": "mail",
                        "Size": 16
                      }
                    },
                    {
                      "text": {
                        "$": "labels.magic"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "organism": "AuthForm",
          "props": {
            "id": {
              "$": "id"
            },
            "mode": {
              "$": "mode"
            },
            "labels": {
              "$": "labels"
            },
            "submit": {
              "$": "submit"
            }
          }
        },
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "ne",
                "args": [
                  {
                    "$": "social"
                  },
                  "first"
                ]
              },
              {
                "op": "ne",
                "args": [
                  {
                    "$": "social"
                  },
                  "none"
                ]
              },
              {
                "op": "ne",
                "args": [
                  {
                    "$": "mode"
                  },
                  "reset"
                ]
              },
              {
                "op": "ne",
                "args": [
                  {
                    "$": "mode"
                  },
                  "magic"
                ]
              }
            ]
          },
          "then": [
            {
              "use": "Stack",
              "props": {
                "Gap": "4"
              },
              "attrs": {
                "data-testid": "social"
              },
              "children": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "4",
                    "Align": "center"
                  },
                  "children": [
                    {
                      "use": "Separator",
                      "props": {
                        "Class": "flex-1"
                      }
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "xs",
                        "Class": "text-muted-foreground"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "labels.divider"
                          }
                        }
                      ]
                    },
                    {
                      "use": "Separator",
                      "props": {
                        "Class": "flex-1"
                      }
                    }
                  ]
                },
                {
                  "use": "Button",
                  "props": {
                    "Variant": "outline",
                    "Size": "default",
                    "Type": "button",
                    "Class": "w-full"
                  },
                  "children": [
                    {
                      "use": "LucideIcon",
                      "props": {
                        "Name": "key-round",
                        "Size": 16
                      }
                    },
                    {
                      "text": {
                        "$": "labels.passkey"
                      }
                    }
                  ]
                },
                {
                  "use": "Button",
                  "props": {
                    "Variant": "outline",
                    "Size": "default",
                    "Type": "button",
                    "Class": "w-full"
                  },
                  "children": [
                    {
                      "use": "LucideIcon",
                      "props": {
                        "Name": "mail",
                        "Size": 16
                      }
                    },
                    {
                      "text": {
                        "$": "labels.magic"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "use": "Text",
          "props": {
            "Size": "sm",
            "Class": "text-center text-muted-foreground"
          },
          "children": [
            {
              "text": {
                "$": "switchText"
              }
            },
            {
              "text": " "
            },
            {
              "use": "Link",
              "props": {
                "Href": {
                  "$": "switchHref"
                },
                "Variant": "default"
              },
              "attrs": {
                "data-testid": "switch"
              },
              "children": [
                {
                  "text": {
                    "$": "switchLink"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
