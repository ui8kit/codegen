{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.media-figures",
  "name": "MediaFigures",
  "docs": "The figures of MediaList: four in two columns, centered, or three in a row.",
  "records": {},
  "props": [
    {
      "name": "extras",
      "type": {
        "ts": "MediaExtras"
      },
      "required": true
    },
    {
      "name": "mode",
      "type": {
        "ts": "\"grid\" | \"row\""
      },
      "default": "grid"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "mode"
                },
                "grid"
              ]
            },
            "grid grid-cols-2 gap-6 text-center",
            "grid grid-cols-3 gap-6"
          ]
        }
      },
      "children": [
        {
          "each": {
            "$": "extras.stats"
          },
          "as": "s",
          "key": {
            "$": "s.id"
          },
          "do": [
            {
              "when": {
                "op": "lt",
                "args": [
                  {
                    "$": "i"
                  },
                  {
                    "op": "cond",
                    "args": [
                      {
                        "op": "eq",
                        "args": [
                          {
                            "$": "mode"
                          },
                          "grid"
                        ]
                      },
                      4,
                      3
                    ]
                  }
                ]
              },
              "then": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "0",
                    "Align": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "mode"
                            },
                            "grid"
                          ]
                        },
                        "center",
                        "start"
                      ]
                    }
                  },
                  "attrs": {
                    "data-testid": "media-stat"
                  },
                  "children": [
                    {
                      "use": "Text",
                      "props": {
                        "Size": "3xl",
                        "Weight": "bold"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "s.value"
                          }
                        }
                      ]
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "sm",
                        "Class": "text-muted-foreground"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "s.label"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "index": "i"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "MediaList",
      "names": [
        "MediaExtras",
        "MediaListLabels"
      ]
    }
  ]
}
