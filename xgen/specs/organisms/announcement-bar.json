{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.announcement-bar",
  "name": "AnnouncementBar",
  "docs": "A thin strip above the page: an icon, one sentence, a link and an optional close button. Axes: tone (default, muted), layout (center, split), dismiss (show, hide).",
  "records": {},
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": true,
      "docs": "accessible name of the strip"
    },
    {
      "name": "text",
      "type": "string",
      "required": true
    },
    {
      "name": "cta",
      "type": "string",
      "docs": "text of the link"
    },
    {
      "name": "ctaHref",
      "type": "string"
    },
    {
      "name": "icon",
      "type": "string",
      "default": "megaphone",
      "docs": "Lucide name"
    },
    {
      "name": "dismissLabel",
      "type": "string",
      "required": true,
      "docs": "accessible name of the close button"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"center\" | \"split\""
      },
      "default": "center"
    },
    {
      "name": "dismiss",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "hide"
    },
    {
      "name": "badgeLabel",
      "type": "string",
      "docs": "the tag before the sentence, e.g. New"
    },
    {
      "name": "badge",
      "type": {
        "ts": "\"none\" | \"show\""
      },
      "default": "none"
    },
    {
      "name": "position",
      "type": {
        "ts": "\"top\" | \"bottom\""
      },
      "default": "top",
      "docs": "bottom: stays at the bottom edge of the page while it scrolls"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "aside",
        "Class": {
          "op": "cn",
          "args": [
            "w-full",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "position"
                    },
                    "bottom"
                  ]
                },
                "sticky bottom-0 z-40 border-t border-border",
                ""
              ]
            },
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "tone"
                    },
                    "muted"
                  ]
                },
                "bg-muted text-foreground",
                "bg-primary text-primary-foreground"
              ]
            }
          ]
        }
      },
      "attrs": {
        "aria-label": {
          "op": "coalesce",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "$": "label"
            }
          ]
        },
        "data-testid": "announcement",
        "data-layout": {
          "$": "layout"
        }
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": {
              "op": "cn",
              "args": [
                "mx-auto w-full max-w-6xl px-4",
                "flex items-center gap-4 py-2",
                {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "layout"
                        },
                        "split"
                      ]
                    },
                    "justify-between",
                    "justify-center"
                  ]
                }
              ]
            }
          },
          "attrs": {
            "data-slot": "container"
          },
          "children": [
            {
              "use": "Group",
              "props": {
                "Gap": "4",
                "Align": "center",
                "Class": {
                  "op": "cn",
                  "args": [
                    "min-w-0 flex-wrap",
                    {
                      "op": "cond",
                      "args": [
                        {
                          "op": "and",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "center"
                              ]
                            },
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "dismiss"
                                },
                                "show"
                              ]
                            }
                          ]
                        },
                        "ml-auto",
                        ""
                      ]
                    }
                  ]
                }
              },
              "children": [
                {
                  "use": "LucideIcon",
                  "props": {
                    "Name": {
                      "$": "icon"
                    },
                    "Size": 16
                  }
                },
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "badge"
                      },
                      "show"
                    ]
                  },
                  "then": [
                    {
                      "use": "Inline",
                      "props": {
                        "Class": "rounded px-2 py-0 text-xs font-semibold inset-ring inset-ring-current"
                      },
                      "attrs": {
                        "data-testid": "announcement-badge"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "badgeLabel"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "Text",
                  "props": {
                    "Size": "sm"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "text"
                      }
                    }
                  ]
                },
                {
                  "when": {
                    "$": "cta"
                  },
                  "then": [
                    {
                      "use": "LinkPlain",
                      "props": {
                        "Href": {
                          "$": "ctaHref"
                        },
                        "Class": "inline-flex items-center gap-2 text-sm font-semibold underline underline-offset-4"
                      },
                      "attrs": {
                        "data-testid": "announcement-cta"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "cta"
                          }
                        },
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": "arrow-right",
                            "Size": 16
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "dismiss"
                  },
                  "show"
                ]
              },
              "then": [
                {
                  "use": "Button",
                  "props": {
                    "Variant": "ghost",
                    "Size": "sm",
                    "Class": "ml-auto shrink-0 text-current",
                    "Type": "button"
                  },
                  "attrs": {
                    "aria-label": {
                      "$": "dismissLabel"
                    },
                    "data-testid": "dismiss"
                  },
                  "children": [
                    {
                      "use": "LucideIcon",
                      "props": {
                        "Name": "x",
                        "Size": 16
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
