{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.cart-drawer",
  "name": "CartDrawer",
  "docs": "The cart drawer in its open state, over a faded page: the head with a close button, the lines with a quantity field, the free-delivery bar, the totals and the button. The empty state shows an icon, a line and the way back. Static markup: opening and closing are the page's. Axes: state (filled, empty), media (image, none).",
  "records": {
    "DrawerLabels": [
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "close",
        "type": "string"
      },
      {
        "name": "progress",
        "type": "string"
      },
      {
        "name": "empty",
        "type": "string"
      },
      {
        "name": "emptyText",
        "type": "string"
      },
      {
        "name": "browse",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "lines",
      "type": {
        "ts": "CartLine[]"
      },
      "required": true
    },
    {
      "name": "rows",
      "type": {
        "ts": "SummaryRow[]"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "CartLabels"
      },
      "required": true
    },
    {
      "name": "drawer",
      "type": {
        "record": "DrawerLabels"
      },
      "required": true,
      "docs": "labels of the drawer"
    },
    {
      "name": "state",
      "type": {
        "ts": "\"filled\" | \"empty\""
      },
      "default": "filled"
    },
    {
      "name": "media",
      "type": {
        "ts": "\"image\" | \"none\""
      },
      "default": "image"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": "py-8"
      },
      "attrs": {
        "aria-label": {
          "op": "coalesce",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "$": "drawer.title"
            }
          ]
        },
        "data-testid": "section"
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": "mx-auto w-full max-w-6xl px-4"
          },
          "attrs": {
            "data-slot": "container"
          },
          "children": [
            {
              "use": "Box",
              "props": {
                "Class": "flex min-h-160 overflow-hidden rounded bg-muted inset-ring inset-ring-border"
              },
              "children": [
                {
                  "use": "Box",
                  "props": {
                    "Class": "hidden flex-1 flex-col gap-4 p-8 sm:flex"
                  },
                  "attrs": {
                    "aria-hidden": "true"
                  },
                  "children": [
                    {
                      "use": "Box",
                      "props": {
                        "Class": "h-8 w-48 rounded bg-background"
                      }
                    },
                    {
                      "use": "Box",
                      "props": {
                        "Class": "h-40 rounded bg-background"
                      }
                    },
                    {
                      "use": "Box",
                      "props": {
                        "Class": "h-40 rounded bg-background"
                      }
                    }
                  ]
                },
                {
                  "use": "Box",
                  "props": {
                    "Class": "flex w-full flex-col bg-background shadow-lg sm:max-w-sm"
                  },
                  "attrs": {
                    "role": "group",
                    "aria-label": {
                      "$": "drawer.title"
                    },
                    "data-testid": "drawer"
                  },
                  "children": [
                    {
                      "use": "Group",
                      "props": {
                        "Gap": "4",
                        "Align": "center",
                        "Justify": "between",
                        "Class": "border-b border-border p-4"
                      },
                      "children": [
                        {
                          "use": "Title",
                          "props": {
                            "As": 2,
                            "Size": "lg",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "drawer.title"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Button",
                          "props": {
                            "Variant": "ghost",
                            "Size": "sm",
                            "Layout": "icon",
                            "AriaLabel": {
                              "$": "drawer.close"
                            }
                          },
                          "children": [
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": "x",
                                "Size": 16
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "when": {
                        "op": "or",
                        "args": [
                          {
                            "op": "eq",
                            "args": [
                              {
                                "$": "state"
                              },
                              "empty"
                            ]
                          },
                          {
                            "op": "eq",
                            "args": [
                              {
                                "op": "len",
                                "args": [
                                  {
                                    "$": "lines"
                                  }
                                ]
                              },
                              0
                            ]
                          }
                        ]
                      },
                      "then": [
                        {
                          "use": "Box",
                          "props": {
                            "Class": "flex flex-1 flex-col justify-center p-4"
                          },
                          "attrs": {
                            "data-testid": "empty"
                          },
                          "children": [
                            {
                              "organism": "EmptyState",
                              "props": {
                                "icon": "shopping-bag",
                                "title": {
                                  "$": "drawer.empty"
                                },
                                "text": {
                                  "$": "drawer.emptyText"
                                }
                              },
                              "slots": {
                                "action": {
                                  "args": [],
                                  "do": [
                                    {
                                      "use": "Button",
                                      "props": {
                                        "Variant": "outline",
                                        "Size": "default"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "drawer.browse"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      ],
                      "else": [
                        {
                          "organism": "DrawerLines",
                          "props": {
                            "field": {
                              "op": "tpl",
                              "args": [
                                "{0}-qty",
                                {
                                  "$": "id"
                                }
                              ]
                            },
                            "lines": {
                              "$": "lines"
                            },
                            "rows": {
                              "$": "rows"
                            },
                            "labels": {
                              "$": "labels"
                            },
                            "drawer": {
                              "$": "drawer"
                            },
                            "media": {
                              "$": "media"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "CartList",
      "names": [
        "CartLine",
        "CartLabels"
      ]
    },
    {
      "from": "OrderSummary",
      "names": [
        "SummaryRow"
      ]
    }
  ]
}
