{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.auth-form",
  "name": "AuthForm",
  "docs": "The form of AuthCard: the fields of the mode (sign-in, sign-up, reset, magic link), remember me and the forgot link, the terms, the submit button.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "docs": "the id of the card: field ids are <id>-email, <id>-password, ..."
    },
    {
      "name": "mode",
      "type": {
        "ts": "\"signin\" | \"signup\" | \"reset\" | \"magic\""
      },
      "default": "signin"
    },
    {
      "name": "labels",
      "type": {
        "ts": "AuthLabels"
      },
      "required": true
    },
    {
      "name": "submit",
      "type": "string",
      "required": true,
      "docs": "text of the submit button"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Form",
      "props": {
        "Method": "dialog",
        "Class": "gap-4"
      },
      "attrs": {
        "data-testid": "auth-form"
      },
      "children": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "mode"
              },
              "signup"
            ]
          },
          "then": [
            {
              "organism": "Field",
              "props": {
                "label": {
                  "$": "labels.name"
                },
                "htmlFor": {
                  "op": "tpl",
                  "args": [
                    "{0}-name",
                    {
                      "$": "id"
                    }
                  ]
                }
              },
              "slots": {
                "children": {
                  "args": [],
                  "do": [
                    {
                      "use": "Input",
                      "props": {
                        "Type": "text",
                        "Name": "name",
                        "Autocomplete": "name"
                      },
                      "attrs": {
                        "id": {
                          "op": "tpl",
                          "args": [
                            "{0}-name",
                            {
                              "$": "id"
                            }
                          ]
                        },
                        "data-testid": "field"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "organism": "Field",
          "props": {
            "label": {
              "$": "labels.email"
            },
            "htmlFor": {
              "op": "tpl",
              "args": [
                "{0}-email",
                {
                  "$": "id"
                }
              ]
            }
          },
          "slots": {
            "children": {
              "args": [],
              "do": [
                {
                  "use": "Input",
                  "props": {
                    "Type": "email",
                    "Name": "email",
                    "Autocomplete": "email"
                  },
                  "attrs": {
                    "id": {
                      "op": "tpl",
                      "args": [
                        "{0}-email",
                        {
                          "$": "id"
                        }
                      ]
                    },
                    "data-testid": "field"
                  }
                }
              ]
            }
          }
        },
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "ne",
                "args": [
                  {
                    "$": "mode"
                  },
                  "reset"
                ]
              },
              {
                "op": "ne",
                "args": [
                  {
                    "$": "mode"
                  },
                  "magic"
                ]
              }
            ]
          },
          "then": [
            {
              "organism": "Field",
              "props": {
                "label": {
                  "$": "labels.password"
                },
                "htmlFor": {
                  "op": "tpl",
                  "args": [
                    "{0}-password",
                    {
                      "$": "id"
                    }
                  ]
                }
              },
              "slots": {
                "children": {
                  "args": [],
                  "do": [
                    {
                      "use": "Input",
                      "props": {
                        "Type": "password",
                        "Name": "password",
                        "Autocomplete": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "mode"
                                },
                                "signup"
                              ]
                            },
                            "new-password",
                            "current-password"
                          ]
                        }
                      },
                      "attrs": {
                        "id": {
                          "op": "tpl",
                          "args": [
                            "{0}-password",
                            {
                              "$": "id"
                            }
                          ]
                        },
                        "data-testid": "field"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "mode"
              },
              "signin"
            ]
          },
          "then": [
            {
              "use": "Group",
              "props": {
                "Justify": "between",
                "Align": "center",
                "Class": "flex-wrap gap-2"
              },
              "children": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "2",
                    "Align": "center",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "w-fit",
                        ""
                      ]
                    }
                  },
                  "children": [
                    {
                      "use": "Checkbox",
                      "props": {
                        "Name": "remember"
                      },
                      "attrs": {
                        "id": {
                          "op": "tpl",
                          "args": [
                            "{0}-remember",
                            {
                              "$": "id"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "use": "Label",
                      "props": {
                        "HTMLFor": {
                          "op": "tpl",
                          "args": [
                            "{0}-remember",
                            {
                              "$": "id"
                            }
                          ]
                        },
                        "Class": "text-sm"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "labels.remember"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "Button",
                  "props": {
                    "Variant": "link",
                    "Size": "sm",
                    "Class": "px-0"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "labels.forgot"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "mode"
              },
              "signup"
            ]
          },
          "then": [
            {
              "use": "Group",
              "props": {
                "Gap": "2",
                "Align": "center",
                "Class": {
                  "op": "cn",
                  "args": [
                    "w-fit",
                    ""
                  ]
                }
              },
              "children": [
                {
                  "use": "Checkbox",
                  "props": {
                    "Name": "terms"
                  },
                  "attrs": {
                    "id": {
                      "op": "tpl",
                      "args": [
                        "{0}-terms",
                        {
                          "$": "id"
                        }
                      ]
                    }
                  }
                },
                {
                  "use": "Label",
                  "props": {
                    "HTMLFor": {
                      "op": "tpl",
                      "args": [
                        "{0}-terms",
                        {
                          "$": "id"
                        }
                      ]
                    },
                    "Class": "text-sm"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "labels.terms"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "use": "Button",
          "props": {
            "Variant": "default",
            "Size": "default",
            "Type": "submit",
            "Class": "w-full"
          },
          "attrs": {
            "data-testid": "submit"
          },
          "children": [
            {
              "text": {
                "$": "submit"
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "AuthCard",
      "names": [
        "AuthLabels"
      ]
    }
  ]
}
