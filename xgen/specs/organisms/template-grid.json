{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.template-grid",
  "name": "TemplateGrid",
  "docs": "Template gallery: a heading, outline filter pills, a grid of template cards and a full-width browse-all button.",
  "records": {
    "Template": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "views",
        "type": "string"
      },
      {
        "name": "likes",
        "type": "string"
      },
      {
        "name": "topic",
        "type": "string"
      }
    ],
    "Filter": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "value",
        "type": "string"
      },
      {
        "name": "icon",
        "type": "string",
        "optional": true
      }
    ],
    "TemplateLabels": [
      {
        "name": "filters",
        "type": "string"
      },
      {
        "name": "browse",
        "type": "string"
      },
      {
        "name": "views",
        "type": "string"
      },
      {
        "name": "likes",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "templates",
      "type": {
        "ts": "Template[]"
      },
      "required": true
    },
    {
      "name": "filters",
      "type": {
        "ts": "Filter[]"
      },
      "required": true
    },
    {
      "name": "browseHref",
      "type": "string",
      "docs": "the address of the full list; none: a button"
    },
    {
      "name": "labels",
      "type": {
        "record": "TemplateLabels"
      },
      "required": true,
      "docs": "the name of the filter row, the browse-all text, the hidden names of the counts"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"1-3\" | \"1-4\""
      },
      "default": "1-4"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"roomy\" | \"default\" | \"compact\""
      },
      "default": "compact"
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "measure": "fill",
        "className": "py-0",
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "use": "Stack",
              "props": {
                "Gap": "8",
                "Align": "stretch"
              },
              "children": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "4",
                    "Align": "center",
                    "Justify": "between",
                    "Class": "h-8 w-full flex-wrap"
                  },
                  "children": [
                    {
                      "use": "Title",
                      "props": {
                        "As": 2,
                        "Size": "2xl",
                        "Weight": "semibold",
                        "Class": "leading-9"
                      },
                      "attrs": {
                        "id": {
                          "op": "add",
                          "args": [
                            {
                              "$": "id"
                            },
                            "-title"
                          ]
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "title"
                          }
                        }
                      ]
                    },
                    {
                      "when": {
                        "op": "gt",
                        "args": [
                          {
                            "op": "len",
                            "args": [
                              {
                                "$": "filters"
                              }
                            ]
                          },
                          0
                        ]
                      },
                      "then": [
                        {
                          "use": "Group",
                          "props": {
                            "Gap": "4",
                            "Align": "center",
                            "Class": "flex-wrap"
                          },
                          "attrs": {
                            "role": "group",
                            "aria-label": {
                              "$": "labels.filters"
                            },
                            "data-testid": "template-filters"
                          },
                          "children": [
                            {
                              "each": {
                                "$": "filters"
                              },
                              "as": "f",
                              "key": {
                                "$": "f.id"
                              },
                              "do": [
                                {
                                  "use": "Button",
                                  "props": {
                                    "Variant": "outline",
                                    "Size": "sm",
                                    "Type": "button",
                                    "Class": "gap-2"
                                  },
                                  "attrs": {
                                    "data-testid": "template-filter"
                                  },
                                  "children": [
                                    {
                                      "when": {
                                        "$": "f.icon"
                                      },
                                      "then": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": {
                                              "$": "f.icon"
                                            },
                                            "Size": 16
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "text": {
                                        "$": "f.title"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "templates"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "organism": "EmptyState",
                      "props": {
                        "icon": "layout-template",
                        "title": {
                          "$": "empty"
                        }
                      }
                    }
                  ],
                  "else": [
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": {
                          "$": "cols"
                        },
                        "Class": "w-full gap-6"
                      },
                      "attrs": {
                        "data-testid": "template-grid"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "templates"
                          },
                          "as": "t",
                          "key": {
                            "$": "t.id"
                          },
                          "do": [
                            {
                              "use": "Box",
                              "props": {
                                "Class": {
                                  "op": "cn",
                                  "args": [
                                    "flex flex-col gap-2 overflow-hidden rounded p-4 inset-ring inset-ring-border",
                                    {
                                      "op": "preset",
                                      "args": [
                                        "defaults",
                                        "templates.card"
                                      ]
                                    }
                                  ]
                                }
                              },
                              "attrs": {
                                "data-testid": "template-card"
                              },
                              "children": [
                                {
                                  "use": "Box",
                                  "props": {
                                    "Class": {
                                      "op": "cn",
                                      "args": [
                                        "shrink-0 overflow-hidden",
                                        {
                                          "op": "preset",
                                          "args": [
                                            "defaults",
                                            "templates.image"
                                          ]
                                        }
                                      ]
                                    }
                                  },
                                  "children": [
                                    {
                                      "organism": "MediaFrame",
                                      "props": {
                                        "alt": {
                                          "$": "t.title"
                                        },
                                        "className": {
                                          "op": "cn",
                                          "args": [
                                            "size-full",
                                            {
                                              "op": "preset",
                                              "args": [
                                                "defaults",
                                                "media.rounded"
                                              ]
                                            }
                                          ]
                                        }
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "4",
                                    "Align": "center",
                                    "Class": {
                                      "op": "cn",
                                      "args": [
                                        "w-full",
                                        {
                                          "op": "preset",
                                          "args": [
                                            "defaults",
                                            "templates.footer"
                                          ]
                                        }
                                      ]
                                    }
                                  },
                                  "attrs": {
                                    "data-testid": "template-footer"
                                  },
                                  "children": [
                                    {
                                      "use": "IconBadge",
                                      "props": {
                                        "Size": "sm",
                                        "Class": "overflow-hidden"
                                      },
                                      "attrs": {
                                        "data-testid": "template-avatar"
                                      },
                                      "children": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": "layout-template",
                                            "Size": 16
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Stack",
                                      "props": {
                                        "Gap": "0",
                                        "Class": "min-w-0 flex-1"
                                      },
                                      "children": [
                                        {
                                          "use": "Title",
                                          "props": {
                                            "As": 3,
                                            "Size": "base",
                                            "Weight": "semibold",
                                            "Class": "truncate leading-6"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "t.title"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Group",
                                          "props": {
                                            "Gap": "4",
                                            "Align": "center",
                                            "Class": "h-4 text-muted-foreground"
                                          },
                                          "children": [
                                            {
                                              "use": "Group",
                                              "props": {
                                                "Gap": "2",
                                                "Align": "center"
                                              },
                                              "children": [
                                                {
                                                  "use": "LucideIcon",
                                                  "props": {
                                                    "Name": "eye",
                                                    "Size": 16
                                                  }
                                                },
                                                {
                                                  "use": "Inline",
                                                  "props": {
                                                    "Class": "sr-only"
                                                  },
                                                  "children": [
                                                    {
                                                      "text": {
                                                        "$": "labels.views"
                                                      }
                                                    }
                                                  ]
                                                },
                                                {
                                                  "use": "Text",
                                                  "props": {
                                                    "Size": "xs",
                                                    "Weight": "bold",
                                                    "Class": "leading-4"
                                                  },
                                                  "children": [
                                                    {
                                                      "text": {
                                                        "$": "t.views"
                                                      }
                                                    }
                                                  ]
                                                }
                                              ]
                                            },
                                            {
                                              "use": "Group",
                                              "props": {
                                                "Gap": "2",
                                                "Align": "center"
                                              },
                                              "children": [
                                                {
                                                  "use": "LucideIcon",
                                                  "props": {
                                                    "Name": "heart",
                                                    "Size": 16
                                                  }
                                                },
                                                {
                                                  "use": "Inline",
                                                  "props": {
                                                    "Class": "sr-only"
                                                  },
                                                  "children": [
                                                    {
                                                      "text": {
                                                        "$": "labels.likes"
                                                      }
                                                    }
                                                  ]
                                                },
                                                {
                                                  "use": "Text",
                                                  "props": {
                                                    "Size": "xs",
                                                    "Weight": "bold",
                                                    "Class": "leading-4"
                                                  },
                                                  "children": [
                                                    {
                                                      "text": {
                                                        "$": "t.likes"
                                                      }
                                                    }
                                                  ]
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "Button",
                  "props": {
                    "Variant": "outline",
                    "Size": "sm",
                    "Href": {
                      "$": "browseHref"
                    },
                    "Class": "w-full"
                  },
                  "attrs": {
                    "data-testid": "template-browse"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "labels.browse"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
