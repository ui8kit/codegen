{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.cart-list",
  "name": "CartList",
  "docs": "The lines of a cart as a table or as cards: product, variant, price, quantity, line total and a remove button. Axes: layout (table, cards), media (image, none), density, tone.",
  "records": {
    "CartLine": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "variant",
        "type": "string"
      },
      {
        "name": "price",
        "type": "number"
      },
      {
        "name": "currency",
        "type": "string"
      },
      {
        "name": "qty",
        "type": "number"
      }
    ],
    "CartLabels": [
      {
        "name": "caption",
        "type": "string"
      },
      {
        "name": "product",
        "type": "string"
      },
      {
        "name": "price",
        "type": "string"
      },
      {
        "name": "qty",
        "type": "string"
      },
      {
        "name": "total",
        "type": "string"
      },
      {
        "name": "remove",
        "type": "string"
      },
      {
        "name": "subtotal",
        "type": "string"
      },
      {
        "name": "checkout",
        "type": "string"
      },
      {
        "name": "decrease",
        "type": "string"
      },
      {
        "name": "increase",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lines",
      "type": {
        "ts": "CartLine[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "record": "CartLabels"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"table\" | \"cards\""
      },
      "default": "table"
    },
    {
      "name": "media",
      "type": {
        "ts": "\"image\" | \"none\""
      },
      "default": "image"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "remove",
      "args": [
        {
          "name": "id",
          "type": "string"
        }
      ],
      "docs": "the remove button of a line was pressed"
    }
  ],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "lines"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "shopping-cart",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "table"
                    ]
                  },
                  "then": [
                    {
                      "organism": "CartTable",
                      "props": {
                        "field": {
                          "op": "tpl",
                          "args": [
                            "{0}-qty",
                            {
                              "$": "id"
                            }
                          ]
                        },
                        "lines": {
                          "$": "lines"
                        },
                        "labels": {
                          "$": "labels"
                        },
                        "media": {
                          "$": "media"
                        },
                        "density": {
                          "$": "density"
                        }
                      },
                      "on": {
                        "remove": {
                          "call": "emit.remove",
                          "args": [
                            {
                              "$": "arg"
                            }
                          ]
                        }
                      }
                    }
                  ],
                  "else": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "4",
                        "Align": "stretch"
                      },
                      "attrs": {
                        "data-testid": "cart-cards"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "lines"
                          },
                          "as": "line",
                          "key": {
                            "$": "line.id"
                          },
                          "do": [
                            {
                              "use": "Card",
                              "props": {
                                "Variant": "default"
                              },
                              "attrs": {
                                "data-testid": "item"
                              },
                              "children": [
                                {
                                  "use": "CardContent",
                                  "props": {
                                    "Class": "flex flex-wrap items-center gap-4"
                                  },
                                  "children": [
                                    {
                                      "when": {
                                        "op": "eq",
                                        "args": [
                                          {
                                            "$": "media"
                                          },
                                          "image"
                                        ]
                                      },
                                      "then": [
                                        {
                                          "organism": "MediaFrame",
                                          "props": {
                                            "alt": {
                                              "$": "line.name"
                                            },
                                            "ratio": "1/1",
                                            "className": "size-16 shrink-0"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Stack",
                                      "props": {
                                        "Gap": "0",
                                        "Class": "min-w-40 flex-1"
                                      },
                                      "children": [
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "sm",
                                            "Weight": "semibold"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "line.name"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "xs",
                                            "Class": "text-muted-foreground"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "line.variant"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "sm"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "op": "money",
                                                "args": [
                                                  {
                                                    "$": "line.price"
                                                  },
                                                  {
                                                    "$": "line.currency"
                                                  }
                                                ]
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "organism": "NumberField",
                                      "props": {
                                        "value": {
                                          "op": "str",
                                          "args": [
                                            {
                                              "$": "line.qty"
                                            }
                                          ]
                                        },
                                        "name": {
                                          "op": "tpl",
                                          "args": [
                                            "{0}-qty-{1}",
                                            {
                                              "$": "id"
                                            },
                                            {
                                              "$": "line.id"
                                            }
                                          ]
                                        },
                                        "min": "1",
                                        "label": {
                                          "$": "labels.qty"
                                        },
                                        "decrease": {
                                          "$": "labels.decrease"
                                        },
                                        "increase": {
                                          "$": "labels.increase"
                                        }
                                      }
                                    },
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "base",
                                        "Weight": "bold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "op": "money",
                                            "args": [
                                              {
                                                "op": "mul",
                                                "args": [
                                                  {
                                                    "$": "line.price"
                                                  },
                                                  {
                                                    "$": "line.qty"
                                                  }
                                                ]
                                              },
                                              {
                                                "$": "line.currency"
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Button",
                                      "props": {
                                        "Variant": "ghost",
                                        "Size": "sm",
                                        "Layout": "icon",
                                        "AriaLabel": {
                                          "$": "labels.remove"
                                        }
                                      },
                                      "attrs": {
                                        "data-testid": "remove"
                                      },
                                      "on": {
                                        "click": {
                                          "call": "emit.remove",
                                          "args": [
                                            {
                                              "$": "line.id"
                                            }
                                          ]
                                        }
                                      },
                                      "children": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": "x",
                                            "Size": 16
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
