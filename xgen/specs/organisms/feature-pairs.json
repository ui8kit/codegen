{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.feature-pairs",
  "name": "FeaturePairs",
  "docs": "Four features of FeatureSplit in two columns: a glyph tile beside the title and text, without cards.",
  "records": {},
  "props": [
    {
      "name": "features",
      "type": {
        "ts": "Feature[]"
      },
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": "grid grid-cols-1 gap-6 sm:grid-cols-2"
      },
      "children": [
        {
          "each": {
            "$": "features"
          },
          "as": "f",
          "key": {
            "$": "f.id"
          },
          "do": [
            {
              "when": {
                "op": "lt",
                "args": [
                  {
                    "$": "i"
                  },
                  4
                ]
              },
              "then": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "4",
                    "Align": "start"
                  },
                  "attrs": {
                    "data-testid": "feature-item"
                  },
                  "children": [
                    {
                      "use": "Inline",
                      "props": {
                        "Class": "flex size-8 shrink-0 items-center justify-center rounded bg-primary text-primary-foreground"
                      },
                      "children": [
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": {
                              "$": "f.icon"
                            },
                            "Size": 16
                          }
                        }
                      ]
                    },
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "2",
                        "Class": "min-w-0"
                      },
                      "children": [
                        {
                          "use": "Title",
                          "props": {
                            "As": 3,
                            "Size": "sm",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "f.title"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "f.text"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "index": "i"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "FeatureGrid",
      "names": [
        "Feature"
      ]
    }
  ]
}
