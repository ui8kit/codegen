{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.post-overlay-card",
  "name": "PostOverlayCard",
  "docs": "A post card of PostShowcase with the text on a panel over the lower part of the picture: the category and date, the title, the excerpt and a read link.",
  "records": {},
  "props": [
    {
      "name": "p",
      "type": {
        "ts": "Post"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "PostLabels"
      },
      "required": true,
      "docs": "templates: minutes `{0} min read`, by `By {0}`; and the word of the read link"
    },
    {
      "name": "ratio",
      "type": {
        "ts": "\"4/3\" | \"16/9\""
      },
      "default": "4/3"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": "relative overflow-hidden rounded"
      },
      "attrs": {
        "data-testid": "post-overlay"
      },
      "children": [
        {
          "organism": "MediaFrame",
          "props": {
            "alt": {
              "$": "p.title"
            },
            "ratio": {
              "$": "ratio"
            },
            "className": {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "ratio"
                    },
                    "4/3"
                  ]
                },
                "min-h-80",
                "min-h-64"
              ]
            }
          }
        },
        {
          "use": "Stack",
          "props": {
            "Gap": "2",
            "Align": "start",
            "Class": "absolute bottom-4 left-4 right-4 rounded bg-background p-4"
          },
          "children": [
            {
              "use": "Group",
              "props": {
                "Gap": "2",
                "Align": "center"
              },
              "children": [
                {
                  "use": "Badge",
                  "props": {
                    "Variant": "secondary",
                    "Size": "sm"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "p.category"
                      }
                    }
                  ]
                },
                {
                  "use": "Text",
                  "props": {
                    "Size": "xs",
                    "Class": "text-muted-foreground"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "p.date"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "use": "Title",
              "props": {
                "As": 3,
                "Size": "base",
                "Weight": "semibold"
              },
              "children": [
                {
                  "text": {
                    "$": "p.title"
                  }
                }
              ]
            },
            {
              "use": "Text",
              "props": {
                "Size": "sm",
                "Class": {
                  "op": "cn",
                  "args": [
                    "text-muted-foreground",
                    "line-clamp-2"
                  ]
                }
              },
              "children": [
                {
                  "text": {
                    "$": "p.excerpt"
                  }
                }
              ]
            },
            {
              "organism": "MenuEntry",
              "props": {
                "href": {
                  "$": "p.href"
                },
                "className": "gap-2 text-sm font-medium",
                "size": "sm",
                "testid": "read"
              },
              "slots": {
                "children": {
                  "args": [],
                  "do": [
                    {
                      "text": {
                        "$": "labels.read"
                      }
                    },
                    {
                      "use": "LucideIcon",
                      "props": {
                        "Name": "arrow-right",
                        "Size": 16
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "PostCard",
      "names": [
        "Post",
        "PostLabels"
      ]
    }
  ]
}
