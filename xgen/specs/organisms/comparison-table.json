{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.comparison-table",
  "name": "ComparisonTable",
  "docs": "Plans, or a product and its competitors, as three columns and the features as rows. A value of yes shows a check, no a dash (both with a hidden word), anything else is shown as text. Axes: highlight (none, middle column), tone, density.",
  "records": {
    "CompareRow": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "label",
        "type": "string"
      },
      {
        "name": "a",
        "type": "string"
      },
      {
        "name": "b",
        "type": "string"
      },
      {
        "name": "c",
        "type": "string"
      }
    ],
    "CompareLabels": [
      {
        "name": "caption",
        "type": "string"
      },
      {
        "name": "feature",
        "type": "string"
      },
      {
        "name": "a",
        "type": "string"
      },
      {
        "name": "b",
        "type": "string"
      },
      {
        "name": "c",
        "type": "string"
      },
      {
        "name": "yes",
        "type": "string"
      },
      {
        "name": "no",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "rows",
      "type": {
        "ts": "CompareRow[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "record": "CompareLabels"
      },
      "required": true
    },
    {
      "name": "highlight",
      "type": {
        "ts": "\"none\" | \"middle\""
      },
      "default": "none",
      "docs": "middle: the second column stands out"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "rows"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "table",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Box",
                  "props": {
                    "Class": "relative w-full overflow-x-auto"
                  },
                  "children": [
                    {
                      "use": "Table",
                      "props": {
                        "Class": "w-full text-left text-sm"
                      },
                      "attrs": {
                        "data-testid": "compare"
                      },
                      "children": [
                        {
                          "use": "TableCaption",
                          "props": {
                            "Class": "sr-only"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "labels.caption"
                              }
                            }
                          ]
                        },
                        {
                          "use": "TableHead",
                          "children": [
                            {
                              "use": "TableRow",
                              "children": [
                                {
                                  "use": "TableHeadCell",
                                  "props": {
                                    "Scope": "col",
                                    "Class": "py-4"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "labels.feature"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "TableHeadCell",
                                  "props": {
                                    "Scope": "col",
                                    "Class": "py-4"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "labels.a"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "TableHeadCell",
                                  "props": {
                                    "Scope": "col",
                                    "Class": {
                                      "op": "cn",
                                      "args": [
                                        "py-4",
                                        {
                                          "op": "cond",
                                          "args": [
                                            {
                                              "op": "eq",
                                              "args": [
                                                {
                                                  "$": "highlight"
                                                },
                                                "middle"
                                              ]
                                            },
                                            "bg-muted",
                                            ""
                                          ]
                                        }
                                      ]
                                    }
                                  },
                                  "attrs": {
                                    "data-highlight": {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "highlight"
                                            },
                                            "middle"
                                          ]
                                        },
                                        "true",
                                        "false"
                                      ]
                                    }
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "labels.b"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "TableHeadCell",
                                  "props": {
                                    "Scope": "col",
                                    "Class": "py-4"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "labels.c"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "use": "TableBody",
                          "children": [
                            {
                              "each": {
                                "$": "rows"
                              },
                              "as": "row",
                              "key": {
                                "$": "row.id"
                              },
                              "do": [
                                {
                                  "use": "TableRow",
                                  "props": {
                                    "Class": "border-t border-border"
                                  },
                                  "attrs": {
                                    "data-testid": "item"
                                  },
                                  "children": [
                                    {
                                      "use": "TableHeadCell",
                                      "props": {
                                        "Scope": "row",
                                        "Class": {
                                          "op": "cn",
                                          "args": [
                                            "font-medium",
                                            {
                                              "op": "cond",
                                              "args": [
                                                {
                                                  "op": "eq",
                                                  "args": [
                                                    {
                                                      "$": "density"
                                                    },
                                                    "compact"
                                                  ]
                                                },
                                                "py-2",
                                                "py-4"
                                              ]
                                            }
                                          ]
                                        }
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "row.label"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "TableCell",
                                      "props": {
                                        "Class": {
                                          "op": "cn",
                                          "args": [
                                            {
                                              "op": "cond",
                                              "args": [
                                                {
                                                  "op": "eq",
                                                  "args": [
                                                    {
                                                      "$": "density"
                                                    },
                                                    "compact"
                                                  ]
                                                },
                                                "py-2",
                                                "py-4"
                                              ]
                                            }
                                          ]
                                        }
                                      },
                                      "children": [
                                        {
                                          "organism": "CompareMark",
                                          "props": {
                                            "value": {
                                              "$": "row.a"
                                            },
                                            "yes": {
                                              "$": "labels.yes"
                                            },
                                            "no": {
                                              "$": "labels.no"
                                            }
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "TableCell",
                                      "props": {
                                        "Class": {
                                          "op": "cn",
                                          "args": [
                                            {
                                              "op": "cond",
                                              "args": [
                                                {
                                                  "op": "eq",
                                                  "args": [
                                                    {
                                                      "$": "density"
                                                    },
                                                    "compact"
                                                  ]
                                                },
                                                "py-2",
                                                "py-4"
                                              ]
                                            },
                                            {
                                              "op": "cond",
                                              "args": [
                                                {
                                                  "op": "eq",
                                                  "args": [
                                                    {
                                                      "$": "highlight"
                                                    },
                                                    "middle"
                                                  ]
                                                },
                                                "bg-muted font-semibold",
                                                ""
                                              ]
                                            }
                                          ]
                                        }
                                      },
                                      "children": [
                                        {
                                          "organism": "CompareMark",
                                          "props": {
                                            "value": {
                                              "$": "row.b"
                                            },
                                            "yes": {
                                              "$": "labels.yes"
                                            },
                                            "no": {
                                              "$": "labels.no"
                                            }
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "TableCell",
                                      "props": {
                                        "Class": {
                                          "op": "cond",
                                          "args": [
                                            {
                                              "op": "eq",
                                              "args": [
                                                {
                                                  "$": "density"
                                                },
                                                "compact"
                                              ]
                                            },
                                            "py-2",
                                            "py-4"
                                          ]
                                        }
                                      },
                                      "children": [
                                        {
                                          "organism": "CompareMark",
                                          "props": {
                                            "value": {
                                              "$": "row.c"
                                            },
                                            "yes": {
                                              "$": "labels.yes"
                                            },
                                            "no": {
                                              "$": "labels.no"
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
