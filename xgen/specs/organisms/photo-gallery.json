{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.photo-gallery",
  "name": "PhotoGallery",
  "docs": "Photos in a grid, a masonry of mixed heights, a mosaic with one big tile, a featured picture over a strip of thumbnails, or cards with a title and a tag. Static markup: the featured layout's arrows are the page's. Axes: layout (grid, masonry, mosaic, featured, cards), captions (show, hide), tone, density.",
  "records": {
    "Photo": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "tag",
        "type": "string"
      },
      {
        "name": "size",
        "type": "string"
      }
    ],
    "PhotoLabels": [
      {
        "name": "previous",
        "type": "string"
      },
      {
        "name": "next",
        "type": "string"
      },
      {
        "name": "counter",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "photos",
      "type": {
        "ts": "Photo[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "record": "PhotoLabels"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"grid\" | \"masonry\" | \"mosaic\" | \"featured\" | \"cards\""
      },
      "default": "grid"
    },
    {
      "name": "captions",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "photos"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "image",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "featured"
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "4",
                        "Align": "stretch"
                      },
                      "attrs": {
                        "data-testid": "featured"
                      },
                      "children": [
                        {
                          "organism": "MediaFrame",
                          "props": {
                            "alt": {
                              "$": "title"
                            }
                          }
                        },
                        {
                          "use": "Group",
                          "props": {
                            "Gap": "4",
                            "Align": "center",
                            "Justify": "between"
                          },
                          "children": [
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "0"
                              },
                              "children": [
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "base",
                                    "Weight": "semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "op": "firstOf",
                                        "args": [
                                          {
                                            "$": "photos"
                                          },
                                          "title"
                                        ]
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "xs",
                                    "Class": "text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "op": "tpl",
                                        "args": [
                                          {
                                            "$": "labels.counter"
                                          },
                                          1,
                                          {
                                            "op": "len",
                                            "args": [
                                              {
                                                "$": "photos"
                                              }
                                            ]
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "use": "Group",
                              "props": {
                                "Gap": "2"
                              },
                              "children": [
                                {
                                  "use": "Button",
                                  "props": {
                                    "Variant": "outline",
                                    "Size": "sm",
                                    "Layout": "icon",
                                    "AriaLabel": {
                                      "$": "labels.previous"
                                    }
                                  },
                                  "children": [
                                    {
                                      "use": "LucideIcon",
                                      "props": {
                                        "Name": "chevron-left",
                                        "Size": 16
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Button",
                                  "props": {
                                    "Variant": "outline",
                                    "Size": "sm",
                                    "Layout": "icon",
                                    "AriaLabel": {
                                      "$": "labels.next"
                                    }
                                  },
                                  "children": [
                                    {
                                      "use": "LucideIcon",
                                      "props": {
                                        "Name": "chevron-right",
                                        "Size": 16
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "use": "Box",
                          "props": {
                            "Class": "grid grid-cols-3 gap-2 sm:grid-cols-9"
                          },
                          "attrs": {
                            "data-testid": "thumbs"
                          },
                          "children": [
                            {
                              "each": {
                                "$": "photos"
                              },
                              "as": "p",
                              "key": {
                                "$": "p.id"
                              },
                              "do": [
                                {
                                  "organism": "MediaFrame",
                                  "props": {
                                    "alt": {
                                      "$": "p.title"
                                    },
                                    "ratio": "1/1",
                                    "className": {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "i"
                                            },
                                            0
                                          ]
                                        },
                                        "ring-2 ring-foreground",
                                        ""
                                      ]
                                    }
                                  }
                                }
                              ],
                              "index": "i"
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "use": "Box",
                      "props": {
                        "Class": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "masonry"
                              ]
                            },
                            "columns-1 gap-4 sm:columns-2 lg:columns-3",
                            {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "layout"
                                    },
                                    "mosaic"
                                  ]
                                },
                                "grid grid-cols-2 gap-4 md:grid-cols-4",
                                "grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
                              ]
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "photos"
                          },
                          "as": "p",
                          "key": {
                            "$": "p.id"
                          },
                          "do": [
                            {
                              "organism": "FigureBlock",
                              "props": {
                                "className": {
                                  "op": "cn",
                                  "args": [
                                    "flex flex-col gap-2",
                                    {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "layout"
                                            },
                                            "masonry"
                                          ]
                                        },
                                        "mb-4 break-inside-avoid",
                                        ""
                                      ]
                                    },
                                    {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "and",
                                          "args": [
                                            {
                                              "op": "eq",
                                              "args": [
                                                {
                                                  "$": "layout"
                                                },
                                                "mosaic"
                                              ]
                                            },
                                            {
                                              "op": "eq",
                                              "args": [
                                                {
                                                  "$": "i"
                                                },
                                                0
                                              ]
                                            }
                                          ]
                                        },
                                        "col-span-2 row-span-2",
                                        ""
                                      ]
                                    },
                                    {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "layout"
                                            },
                                            "cards"
                                          ]
                                        },
                                        "rounded bg-card inset-ring inset-ring-border p-4",
                                        ""
                                      ]
                                    }
                                  ]
                                },
                                "testid": "item"
                              },
                              "slots": {
                                "children": {
                                  "args": [],
                                  "do": [
                                    {
                                      "organism": "MediaFrame",
                                      "props": {
                                        "alt": {
                                          "$": "p.title"
                                        },
                                        "ratio": {
                                          "op": "cond",
                                          "args": [
                                            {
                                              "op": "eq",
                                              "args": [
                                                {
                                                  "$": "layout"
                                                },
                                                "masonry"
                                              ]
                                            },
                                            {
                                              "op": "cond",
                                              "args": [
                                                {
                                                  "op": "eq",
                                                  "args": [
                                                    {
                                                      "$": "p.size"
                                                    },
                                                    "tall"
                                                  ]
                                                },
                                                "3/4",
                                                {
                                                  "op": "cond",
                                                  "args": [
                                                    {
                                                      "op": "eq",
                                                      "args": [
                                                        {
                                                          "$": "p.size"
                                                        },
                                                        "wide"
                                                      ]
                                                    },
                                                    "16/9",
                                                    {
                                                      "op": "cond",
                                                      "args": [
                                                        {
                                                          "op": "eq",
                                                          "args": [
                                                            {
                                                              "$": "p.size"
                                                            },
                                                            "large"
                                                          ]
                                                        },
                                                        "4/3",
                                                        "1/1"
                                                      ]
                                                    }
                                                  ]
                                                }
                                              ]
                                            },
                                            {
                                              "op": "cond",
                                              "args": [
                                                {
                                                  "op": "eq",
                                                  "args": [
                                                    {
                                                      "$": "layout"
                                                    },
                                                    "grid"
                                                  ]
                                                },
                                                "4/3",
                                                "1/1"
                                              ]
                                            }
                                          ]
                                        },
                                        "className": {
                                          "op": "cond",
                                          "args": [
                                            {
                                              "op": "eq",
                                              "args": [
                                                {
                                                  "$": "layout"
                                                },
                                                "mosaic"
                                              ]
                                            },
                                            "h-full",
                                            ""
                                          ]
                                        }
                                      }
                                    },
                                    {
                                      "when": {
                                        "op": "and",
                                        "args": [
                                          {
                                            "op": "eq",
                                            "args": [
                                              {
                                                "$": "captions"
                                              },
                                              "show"
                                            ]
                                          },
                                          {
                                            "op": "eq",
                                            "args": [
                                              {
                                                "$": "layout"
                                              },
                                              "cards"
                                            ]
                                          }
                                        ]
                                      },
                                      "then": [
                                        {
                                          "use": "Group",
                                          "props": {
                                            "Gap": "4",
                                            "Align": "center",
                                            "Justify": "between"
                                          },
                                          "children": [
                                            {
                                              "use": "Text",
                                              "props": {
                                                "Size": "sm",
                                                "Weight": "semibold"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "p.title"
                                                  }
                                                }
                                              ]
                                            },
                                            {
                                              "use": "Badge",
                                              "props": {
                                                "Variant": "secondary",
                                                "Size": "sm"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "p.tag"
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "when": {
                                        "op": "and",
                                        "args": [
                                          {
                                            "op": "eq",
                                            "args": [
                                              {
                                                "$": "captions"
                                              },
                                              "show"
                                            ]
                                          },
                                          {
                                            "op": "or",
                                            "args": [
                                              {
                                                "op": "eq",
                                                "args": [
                                                  {
                                                    "$": "layout"
                                                  },
                                                  "grid"
                                                ]
                                              },
                                              {
                                                "op": "eq",
                                                "args": [
                                                  {
                                                    "$": "layout"
                                                  },
                                                  "masonry"
                                                ]
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      "then": [
                                        {
                                          "use": "Box",
                                          "props": {
                                            "Class": "text-sm text-muted-foreground"
                                          },
                                          "attrs": {
                                            "data-testid": "caption"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "p.title"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              }
                            }
                          ],
                          "index": "i"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
