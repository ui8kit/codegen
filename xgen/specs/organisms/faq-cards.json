{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.faq-cards",
  "name": "FaqCards",
  "docs": "The questions of FaqSplit as cards: the topic, the question, the answer and a read-more link; with an icon square on top in the icons shape. Shapes: grid3, grid4, icons (three columns).",
  "records": {},
  "props": [
    {
      "name": "items",
      "type": {
        "ts": "Question[]"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "FaqSplitLabels"
      },
      "required": true
    },
    {
      "name": "cards",
      "type": {
        "ts": "\"grid3\" | \"grid4\" | \"icons\""
      },
      "default": "grid3"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "cards"
                },
                "grid4"
              ]
            },
            "grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4",
            "grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
          ]
        }
      },
      "attrs": {
        "data-testid": "faq"
      },
      "children": [
        {
          "each": {
            "$": "items"
          },
          "as": "q",
          "key": {
            "$": "q.id"
          },
          "do": [
            {
              "organism": "ArticleBlock",
              "props": {
                "className": "rounded bg-card inset-ring inset-ring-border flex flex-col gap-4 p-6",
                "testid": "faq-card"
              },
              "slots": {
                "children": {
                  "args": [],
                  "do": [
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "cards"
                          },
                          "icons"
                        ]
                      },
                      "then": [
                        {
                          "use": "Box",
                          "props": {
                            "Class": "flex size-10 shrink-0 items-center justify-center rounded bg-muted"
                          },
                          "children": [
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": {
                                  "$": "q.icon"
                                },
                                "Size": 20
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "2"
                      },
                      "children": [
                        {
                          "use": "Badge",
                          "props": {
                            "Variant": "secondary",
                            "Size": "sm",
                            "Class": "w-fit"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "q.category"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Title",
                          "props": {
                            "As": 3,
                            "Size": "base",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "q.question"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "q.answer"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "use": "Box",
                      "props": {
                        "Class": "mt-auto"
                      },
                      "children": [
                        {
                          "use": "Button",
                          "props": {
                            "Variant": "link",
                            "Size": "sm",
                            "Class": "gap-2 px-0 font-medium"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "labels.more"
                              }
                            },
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": "arrow-right",
                                "Size": 16
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "FaqSplit",
      "names": [
        "Question",
        "FaqSplitLabels"
      ]
    }
  ]
}
