{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.stepper",
  "name": "Stepper",
  "docs": "A multi-step form header: the steps with the current one marked (aria-current step), and the current step's text with back and next buttons. Axes: layout (horizontal, vertical), marker (number, icon), summary (show, hide).",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "steps",
      "type": {
        "ts": "Step[]"
      },
      "required": true
    },
    {
      "name": "current",
      "type": "number",
      "default": 2,
      "docs": "the number of the current step, from 1"
    },
    {
      "name": "stepLabel",
      "type": "string",
      "required": true,
      "docs": "template of the progress line, e.g. `Step {0} of {1}`"
    },
    {
      "name": "back",
      "type": "string",
      "required": true
    },
    {
      "name": "next",
      "type": "string",
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"horizontal\" | \"vertical\""
      },
      "default": "horizontal"
    },
    {
      "name": "marker",
      "type": {
        "ts": "\"number\" | \"icon\""
      },
      "default": "number"
    },
    {
      "name": "summary",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "measure": "3xl",
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "gt",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "steps"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "6",
                    "Align": "stretch"
                  },
                  "attrs": {
                    "data-testid": "stepper"
                  },
                  "children": [
                    {
                      "use": "Text",
                      "props": {
                        "Size": "sm",
                        "Class": "text-muted-foreground"
                      },
                      "children": [
                        {
                          "text": {
                            "op": "tpl",
                            "args": [
                              {
                                "$": "stepLabel"
                              },
                              {
                                "$": "current"
                              },
                              {
                                "op": "len",
                                "args": [
                                  {
                                    "$": "steps"
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "use": "List",
                      "props": {
                        "Tag": "ol",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "m-0 flex list-none gap-4 p-0",
                            {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "layout"
                                    },
                                    "vertical"
                                  ]
                                },
                                "flex-col",
                                "flex-col sm:flex-row"
                              ]
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "steps"
                          },
                          "as": "s",
                          "key": {
                            "$": "s.id"
                          },
                          "do": [
                            {
                              "use": "ListItem",
                              "props": {
                                "Class": "flex flex-1 items-center gap-4"
                              },
                              "attrs": {
                                "data-testid": "item",
                                "aria-current": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "op": "add",
                                          "args": [
                                            {
                                              "$": "i"
                                            },
                                            1
                                          ]
                                        },
                                        {
                                          "$": "current"
                                        }
                                      ]
                                    },
                                    "step",
                                    {
                                      "op": "undef",
                                      "args": []
                                    }
                                  ]
                                }
                              },
                              "children": [
                                {
                                  "use": "IconBadge",
                                  "props": {
                                    "Variant": {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "lt",
                                          "args": [
                                            {
                                              "op": "add",
                                              "args": [
                                                {
                                                  "$": "i"
                                                },
                                                1
                                              ]
                                            },
                                            {
                                              "op": "add",
                                              "args": [
                                                {
                                                  "$": "current"
                                                },
                                                1
                                              ]
                                            }
                                          ]
                                        },
                                        "primary",
                                        "outline"
                                      ]
                                    },
                                    "Size": "sm",
                                    "Class": {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "lt",
                                          "args": [
                                            {
                                              "op": "add",
                                              "args": [
                                                {
                                                  "$": "i"
                                                },
                                                1
                                              ]
                                            },
                                            {
                                              "op": "add",
                                              "args": [
                                                {
                                                  "$": "current"
                                                },
                                                1
                                              ]
                                            }
                                          ]
                                        },
                                        "text-sm",
                                        "text-sm text-muted-foreground"
                                      ]
                                    }
                                  },
                                  "children": [
                                    {
                                      "when": {
                                        "op": "eq",
                                        "args": [
                                          {
                                            "$": "marker"
                                          },
                                          "icon"
                                        ]
                                      },
                                      "then": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": {
                                              "$": "s.icon"
                                            },
                                            "Size": 16
                                          }
                                        }
                                      ],
                                      "else": [
                                        {
                                          "use": "Inline",
                                          "props": {
                                            "Class": "text-sm font-bold"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "op": "str",
                                                "args": [
                                                  {
                                                    "op": "add",
                                                    "args": [
                                                      {
                                                        "$": "i"
                                                      },
                                                      1
                                                    ]
                                                  }
                                                ]
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Weight": {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "op": "add",
                                              "args": [
                                                {
                                                  "$": "i"
                                                },
                                                1
                                              ]
                                            },
                                            {
                                              "$": "current"
                                            }
                                          ]
                                        },
                                        "bold",
                                        "semibold"
                                      ]
                                    }
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "s.title"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ],
                          "index": "i"
                        }
                      ]
                    },
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "summary"
                          },
                          "show"
                        ]
                      },
                      "then": [
                        {
                          "each": {
                            "$": "steps"
                          },
                          "as": "s",
                          "key": {
                            "$": "s.id"
                          },
                          "do": [
                            {
                              "when": {
                                "op": "eq",
                                "args": [
                                  {
                                    "op": "add",
                                    "args": [
                                      {
                                        "$": "i"
                                      },
                                      1
                                    ]
                                  },
                                  {
                                    "$": "current"
                                  }
                                ]
                              },
                              "then": [
                                {
                                  "use": "Stack",
                                  "props": {
                                    "Gap": "2",
                                    "Class": "rounded bg-card p-6 inset-ring inset-ring-border"
                                  },
                                  "attrs": {
                                    "data-testid": "step-summary"
                                  },
                                  "children": [
                                    {
                                      "use": "Title",
                                      "props": {
                                        "As": 3,
                                        "Size": "xl",
                                        "Weight": "bold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "s.title"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "sm",
                                        "Class": "text-muted-foreground"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "s.text"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Group",
                                      "props": {
                                        "Gap": "2",
                                        "Class": "pt-2"
                                      },
                                      "children": [
                                        {
                                          "use": "Button",
                                          "props": {
                                            "Variant": "outline",
                                            "Size": "sm",
                                            "Type": "button"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "back"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Button",
                                          "props": {
                                            "Variant": "default",
                                            "Size": "sm",
                                            "Type": "button"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "next"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ],
                          "index": "i"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "StepsList",
      "names": [
        "Step"
      ]
    }
  ]
}
