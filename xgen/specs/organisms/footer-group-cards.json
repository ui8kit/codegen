{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.footer-group-cards",
  "name": "FooterGroupCards",
  "docs": "The link groups of FooterSplit as cards: a glyph and the group title over its links, four across on wide screens.",
  "records": {},
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": true,
      "docs": "accessible name of the link groups"
    },
    {
      "name": "groups",
      "type": {
        "ts": "MegaGroup[]"
      },
      "required": true
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "gt",
        "args": [
          {
            "op": "len",
            "args": [
              {
                "$": "groups"
              }
            ]
          },
          0
        ]
      },
      "then": [
        {
          "use": "Block",
          "props": {
            "Tag": "nav"
          },
          "attrs": {
            "aria-label": {
              "op": "coalesce",
              "args": [
                {
                  "$": "landmarkLabel"
                },
                {
                  "$": "label"
                }
              ]
            }
          },
          "children": [
            {
              "use": "Box",
              "props": {
                "Class": "grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4"
              },
              "children": [
                {
                  "each": {
                    "$": "groups"
                  },
                  "as": "g",
                  "key": {
                    "$": "g.id"
                  },
                  "do": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "4",
                        "Align": "stretch",
                        "Class": "rounded bg-card inset-ring inset-ring-border p-6"
                      },
                      "attrs": {
                        "data-testid": "group"
                      },
                      "children": [
                        {
                          "use": "Group",
                          "props": {
                            "Gap": "2",
                            "Align": "center"
                          },
                          "children": [
                            {
                              "use": "Inline",
                              "props": {
                                "Class": "flex size-10 shrink-0 items-center justify-center rounded bg-muted text-foreground"
                              },
                              "children": [
                                {
                                  "use": "LucideIcon",
                                  "props": {
                                    "Name": {
                                      "$": "g.icon"
                                    },
                                    "Size": 20
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "sm",
                                "Weight": "semibold"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "g.title"
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "use": "List",
                          "props": {
                            "Class": "m-0 flex list-none flex-col gap-2 p-0"
                          },
                          "children": [
                            {
                              "each": {
                                "$": "g.links"
                              },
                              "as": "item",
                              "key": {
                                "$": "item.id"
                              },
                              "do": [
                                {
                                  "use": "ListItem",
                                  "children": [
                                    {
                                      "organism": "MenuEntry",
                                      "props": {
                                        "href": {
                                          "$": "item.href"
                                        },
                                        "className": "text-sm text-muted-foreground",
                                        "variant": "muted",
                                        "size": "sm"
                                      },
                                      "slots": {
                                        "children": {
                                          "args": [],
                                          "do": [
                                            {
                                              "text": {
                                                "$": "item.name"
                                              }
                                            }
                                          ]
                                        }
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "MegaMenu",
      "names": [
        "MegaGroup"
      ]
    }
  ]
}
