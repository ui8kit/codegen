{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.story-dots",
  "name": "StoryDots",
  "docs": "One dot per step of StoryTabs; the dot of the active step is filled.",
  "records": {},
  "props": [
    {
      "name": "steps",
      "type": {
        "ts": "Milestone[]"
      },
      "required": true
    },
    {
      "name": "active",
      "type": "string",
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Group",
      "props": {
        "Gap": "2",
        "Align": "center"
      },
      "children": [
        {
          "each": {
            "$": "steps"
          },
          "as": "s",
          "key": {
            "$": "s.id"
          },
          "do": [
            {
              "use": "Inline",
              "props": {
                "Class": {
                  "op": "cn",
                  "args": [
                    "size-2 rounded-full",
                    {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "s.id"
                            },
                            {
                              "$": "active"
                            }
                          ]
                        },
                        "bg-primary",
                        "bg-border"
                      ]
                    }
                  ]
                }
              },
              "attrs": {
                "data-testid": "story-dot"
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "MilestoneTimeline",
      "names": [
        "Milestone"
      ]
    },
    {
      "from": "StoryTabs",
      "names": [
        "StoryLabels"
      ]
    }
  ]
}
