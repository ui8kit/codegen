{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.footer-brand",
  "name": "FooterBrand",
  "docs": "The brand of FooterSplit: a mark and the brand word over the tagline.",
  "records": {},
  "props": [
    {
      "name": "brand",
      "type": "string",
      "required": true
    },
    {
      "name": "tagline",
      "type": "string",
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Stack",
      "props": {
        "Gap": "2",
        "Align": "start"
      },
      "attrs": {
        "data-testid": "footer-brand"
      },
      "children": [
        {
          "use": "Group",
          "props": {
            "Gap": "2",
            "Align": "center"
          },
          "children": [
            {
              "use": "Inline",
              "props": {
                "Class": "flex size-8 items-center justify-center rounded bg-foreground text-background"
              },
              "children": [
                {
                  "use": "LucideIcon",
                  "props": {
                    "Name": "layers",
                    "Size": 16
                  }
                }
              ]
            },
            {
              "use": "Text",
              "props": {
                "Size": "xl",
                "Weight": "bold"
              },
              "children": [
                {
                  "text": {
                    "$": "brand"
                  }
                }
              ]
            }
          ]
        },
        {
          "use": "Text",
          "props": {
            "Size": "sm",
            "Class": "text-muted-foreground"
          },
          "children": [
            {
              "text": {
                "$": "tagline"
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
