{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.nav-bar",
  "name": "NavBar",
  "docs": "A top bar in four shapes. Axes: layout (inline: brand left, links, button right; split: the brand in the middle with the links on both sides; search: a search field with its shortcut in the middle), over (none, media: the bar sits over a picture, transparent), actions mode (none, cta), tone (default, inverse: on a dark hero band). Turning solid on scroll is a port contract.",
  "records": {
    "NavLink": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "icon",
        "type": "string"
      },
      {
        "name": "href",
        "type": "string",
        "optional": true
      }
    ],
    "NavBarActions": [
      {
        "name": "mode",
        "type": "\"none\" | \"cta\"",
        "optional": true,
        "docs": "cta: show the call to action",
        "default": "cta"
      },
      {
        "name": "cta",
        "type": "string",
        "optional": true,
        "docs": "text of the call to action"
      },
      {
        "name": "href",
        "type": "string",
        "optional": true,
        "docs": "href of the call to action"
      },
      {
        "name": "login",
        "type": "string",
        "optional": true,
        "docs": "text of the login link; none: no login"
      },
      {
        "name": "loginHref",
        "type": "string",
        "optional": true,
        "docs": "href of the login link; none: a button with no address"
      },
      {
        "name": "themeLabel",
        "type": "string",
        "optional": true,
        "docs": "text of the theme button; none: no button"
      }
    ],
    "NavSearch": [
      {
        "name": "label",
        "type": "string",
        "optional": false,
        "docs": "name and placeholder of the search field (layout search)"
      },
      {
        "name": "shortcut",
        "type": "string",
        "optional": false,
        "docs": "the keys that open the search, shown in the field"
      }
    ]
  },
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": true,
      "docs": "accessible name of the navigation"
    },
    {
      "name": "brand",
      "type": "string",
      "required": true
    },
    {
      "name": "brandHref",
      "type": "string",
      "docs": "the address of the home page; none: the brand is text, not a link"
    },
    {
      "name": "links",
      "type": {
        "ts": "NavLink[]"
      },
      "required": true
    },
    {
      "name": "current",
      "type": "string",
      "default": "",
      "docs": "id of the current link"
    },
    {
      "name": "actions",
      "type": {
        "record": "NavBarActions"
      },
      "docs": "the buttons at the end of the bar"
    },
    {
      "name": "search",
      "type": {
        "record": "NavSearch"
      },
      "required": true,
      "docs": "the search field of layout search"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"inverse\""
      },
      "default": "default",
      "docs": "inverse: sits on a dark hero band"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"inline\" | \"split\" | \"search\""
      },
      "default": "inline"
    },
    {
      "name": "over",
      "type": {
        "ts": "\"none\" | \"media\""
      },
      "default": "none"
    },
    {
      "name": "skip",
      "type": "string",
      "docs": "text of the skip link to the main content; none: no link"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "theme",
      "args": [],
      "docs": "the theme button was pressed"
    }
  ],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "header",
        "Class": {
          "op": "cn",
          "args": [
            "relative",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "tone"
                    },
                    "inverse"
                  ]
                },
                "border-b border-transparent bg-foreground text-background [&_a]:text-background [&_button]:text-background",
                "border-b border-border bg-background"
              ]
            },
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "over"
                    },
                    "media"
                  ]
                },
                "isolate overflow-hidden border-0 bg-transparent",
                ""
              ]
            }
          ]
        }
      },
      "attrs": {
        "data-testid": "nav-bar",
        "data-layout": {
          "$": "layout"
        },
        "data-tone": {
          "$": "tone"
        },
        "aria-label": {
          "$": "landmarkLabel"
        }
      },
      "children": [
        {
          "organism": "OverMedia",
          "props": {
            "on": {
              "op": "eq",
              "args": [
                {
                  "$": "over"
                },
                "media"
              ]
            },
            "alt": {
              "$": "brand"
            }
          }
        },
        {
          "when": {
            "$": "skip"
          },
          "then": [
            {
              "use": "LinkPlain",
              "props": {
                "Href": "#main-content",
                "Class": "sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-background focus:px-4 focus:py-2 focus:text-sm focus:inset-ring focus:inset-ring-border"
              },
              "attrs": {
                "data-testid": "skip-link"
              },
              "children": [
                {
                  "text": {
                    "$": "skip"
                  }
                }
              ]
            }
          ]
        },
        {
          "use": "Container",
          "props": {
            "Class": "mx-auto w-full max-w-6xl px-4"
          },
          "attrs": {
            "data-slot": "container"
          },
          "children": [
            {
              "use": "Box",
              "props": {
                "Class": {
                  "op": "cn",
                  "args": [
                    "flex flex-wrap items-center justify-between gap-4",
                    "py-4"
                  ]
                }
              },
              "children": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "split"
                    ]
                  },
                  "then": [
                    {
                      "organism": "NavBlock",
                      "props": {
                        "label": {
                          "op": "cond",
                          "args": [
                            {
                              "$": "landmarkLabel"
                            },
                            {
                              "op": "uniq",
                              "args": [
                                {
                                  "op": "tpl",
                                  "args": [
                                    "{0}, {1}",
                                    {
                                      "$": "label"
                                    },
                                    {
                                      "$": "landmarkLabel"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "$": "label"
                            }
                          ]
                        },
                        "className": "w-full",
                        "testid": "site-nav"
                      },
                      "slots": {
                        "children": {
                          "args": [],
                          "do": [
                            {
                              "use": "Grid",
                              "props": {
                                "Cols": "1-3",
                                "Class": "w-full items-center gap-4"
                              },
                              "children": [
                                {
                                  "use": "Box",
                                  "props": {
                                    "Class": "md:justify-self-start"
                                  },
                                  "children": [
                                    {
                                      "organism": "NavLinks",
                                      "props": {
                                        "links": {
                                          "$": "links"
                                        },
                                        "current": {
                                          "$": "current"
                                        },
                                        "side": "left"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Box",
                                  "props": {
                                    "Class": "text-center"
                                  },
                                  "children": [
                                    {
                                      "organism": "MenuEntry",
                                      "props": {
                                        "href": {
                                          "$": "brandHref"
                                        },
                                        "className": "text-lg font-medium",
                                        "testid": "brand"
                                      },
                                      "slots": {
                                        "children": {
                                          "args": [],
                                          "do": [
                                            {
                                              "text": {
                                                "$": "brand"
                                              }
                                            }
                                          ]
                                        }
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "4",
                                    "Align": "center",
                                    "Justify": "end",
                                    "Class": "flex-wrap md:justify-self-end"
                                  },
                                  "children": [
                                    {
                                      "use": "Box",
                                      "children": [
                                        {
                                          "organism": "NavLinks",
                                          "props": {
                                            "links": {
                                              "$": "links"
                                            },
                                            "current": {
                                              "$": "current"
                                            },
                                            "side": "right"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "organism": "NavActions",
                                      "props": {
                                        "login": {
                                          "$": "actions.login"
                                        },
                                        "loginHref": {
                                          "$": "actions.loginHref"
                                        },
                                        "cta": {
                                          "$": "actions.cta"
                                        },
                                        "ctaHref": {
                                          "$": "actions.href"
                                        },
                                        "actions": {
                                          "$": "actions.mode"
                                        },
                                        "tone": {
                                          "$": "tone"
                                        },
                                        "themeLabel": {
                                          "$": "actions.themeLabel"
                                        }
                                      },
                                      "on": {
                                        "theme": {
                                          "call": "emit.theme",
                                          "args": []
                                        }
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      }
                    }
                  ],
                  "else": [
                    {
                      "organism": "MenuEntry",
                      "props": {
                        "href": {
                          "$": "brandHref"
                        },
                        "className": "text-lg font-medium",
                        "testid": "brand"
                      },
                      "slots": {
                        "children": {
                          "args": [],
                          "do": [
                            {
                              "text": {
                                "$": "brand"
                              }
                            }
                          ]
                        }
                      }
                    },
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "layout"
                          },
                          "search"
                        ]
                      },
                      "then": [
                        {
                          "organism": "SearchPalette",
                          "props": {
                            "label": {
                              "$": "search.label"
                            },
                            "shortcut": {
                              "$": "search.shortcut"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "organism": "NavBarMenu",
                      "props": {
                        "label": {
                          "$": "label"
                        },
                        "links": {
                          "$": "links"
                        },
                        "current": {
                          "$": "current"
                        },
                        "landmarkLabel": {
                          "$": "landmarkLabel"
                        }
                      }
                    },
                    {
                      "organism": "NavActions",
                      "props": {
                        "login": {
                          "$": "actions.login"
                        },
                        "loginHref": {
                          "$": "actions.loginHref"
                        },
                        "cta": {
                          "$": "actions.cta"
                        },
                        "ctaHref": {
                          "$": "actions.href"
                        },
                        "actions": {
                          "$": "actions.mode"
                        },
                        "tone": {
                          "$": "tone"
                        },
                        "themeLabel": {
                          "$": "actions.themeLabel"
                        }
                      },
                      "on": {
                        "theme": {
                          "call": "emit.theme",
                          "args": []
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
