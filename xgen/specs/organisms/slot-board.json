{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.slot-board",
  "name": "SlotBoard",
  "docs": "Pick a delivery window: the days with their windows as radio chips, beside a card with the zone, its price and the buttons. Static markup. Axes: layout (split: the card beside the days, stacked: the days only), item (card, plain), tone.",
  "records": {
    "SlotLabels": [
      {
        "name": "zone",
        "type": "string"
      },
      {
        "name": "price",
        "type": "string"
      },
      {
        "name": "freeFrom",
        "type": "string"
      },
      {
        "name": "time",
        "type": "string"
      },
      {
        "name": "primary",
        "type": "string"
      },
      {
        "name": "secondary",
        "type": "string"
      },
      {
        "name": "note",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "days",
      "type": {
        "ts": "Day[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "zone",
      "type": {
        "ts": "Zone"
      },
      "required": true,
      "docs": "the zone of the address"
    },
    {
      "name": "labels",
      "type": {
        "record": "SlotLabels"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"split\" | \"stacked\""
      },
      "default": "split"
    },
    {
      "name": "item",
      "type": {
        "ts": "\"card\" | \"plain\""
      },
      "default": "card"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "days"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "calendar",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Box",
                  "props": {
                    "Class": "grid grid-cols-1 items-start gap-8 lg:grid-cols-3"
                  },
                  "children": [
                    {
                      "use": "Box",
                      "props": {
                        "Class": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "split"
                              ]
                            },
                            "lg:col-span-2",
                            "lg:col-span-3"
                          ]
                        }
                      },
                      "children": [
                        {
                          "organism": "SlotGrid",
                          "props": {
                            "days": {
                              "$": "days"
                            },
                            "name": {
                              "op": "tpl",
                              "args": [
                                "{0}-slot",
                                {
                                  "$": "id"
                                }
                              ]
                            },
                            "item": {
                              "$": "item"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "layout"
                          },
                          "split"
                        ]
                      },
                      "then": [
                        {
                          "use": "Stack",
                          "props": {
                            "Gap": "4",
                            "Align": "stretch",
                            "Class": "rounded bg-card inset-ring inset-ring-border p-6"
                          },
                          "attrs": {
                            "data-testid": "aside"
                          },
                          "children": [
                            {
                              "organism": "Field",
                              "props": {
                                "label": {
                                  "$": "labels.zone"
                                },
                                "htmlFor": {
                                  "op": "tpl",
                                  "args": [
                                    "{0}-zone",
                                    {
                                      "$": "id"
                                    }
                                  ]
                                }
                              },
                              "slots": {
                                "children": {
                                  "args": [],
                                  "do": [
                                    {
                                      "use": "Select",
                                      "props": {
                                        "Name": {
                                          "op": "tpl",
                                          "args": [
                                            "{0}-zone",
                                            {
                                              "$": "id"
                                            }
                                          ]
                                        }
                                      },
                                      "attrs": {
                                        "id": {
                                          "op": "tpl",
                                          "args": [
                                            "{0}-zone",
                                            {
                                              "$": "id"
                                            }
                                          ]
                                        }
                                      },
                                      "children": [
                                        {
                                          "use": "SelectOption",
                                          "props": {
                                            "Value": {
                                              "$": "zone.id"
                                            },
                                            "Label": {
                                              "$": "zone.name"
                                            },
                                            "Selected": true
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "use": "List",
                              "props": {
                                "Tag": "ul",
                                "Class": "flex flex-col gap-2"
                              },
                              "children": [
                                {
                                  "use": "ListItem",
                                  "props": {
                                    "Class": "flex items-center justify-between gap-4 text-sm"
                                  },
                                  "children": [
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "text-muted-foreground"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "labels.price"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "font-medium"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "op": "money",
                                            "args": [
                                              {
                                                "$": "zone.price"
                                              },
                                              {
                                                "$": "zone.currency"
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "ListItem",
                                  "props": {
                                    "Class": "flex items-center justify-between gap-4 text-sm"
                                  },
                                  "children": [
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "text-muted-foreground"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "labels.freeFrom"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "font-medium"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "op": "money",
                                            "args": [
                                              {
                                                "$": "zone.freeFrom"
                                              },
                                              {
                                                "$": "zone.currency"
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "ListItem",
                                  "props": {
                                    "Class": "flex items-center justify-between gap-4 text-sm"
                                  },
                                  "children": [
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "text-muted-foreground"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "labels.time"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Inline",
                                      "props": {
                                        "Class": "font-medium"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "zone.time"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "use": "Button",
                              "props": {
                                "Variant": "default",
                                "Size": "default",
                                "Class": "w-full"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "labels.primary"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Button",
                              "props": {
                                "Variant": "outline",
                                "Size": "default",
                                "Class": "w-full"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "labels.secondary"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "xs",
                                "Class": "text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "labels.note"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "SlotGrid",
      "names": [
        "Day"
      ]
    },
    {
      "from": "ZoneTable",
      "names": [
        "Zone"
      ]
    }
  ]
}
