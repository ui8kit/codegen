{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.auth-layout",
  "name": "AuthLayout",
  "docs": "A whole sign-in page: the AuthCard placed in the page. Axes: layout (split: a picture panel beside the card, centered: the card on a tinted page, minimal: the card alone in a narrow column), side (end, start: the side of the picture), mode, social. The page's heading is the card's title.",
  "records": {
    "AuthSwitch": [
      {
        "name": "text",
        "type": "string",
        "optional": false,
        "docs": "the sentence before the link"
      },
      {
        "name": "link",
        "type": "string",
        "optional": false,
        "docs": "text of the link"
      },
      {
        "name": "href",
        "type": "string",
        "optional": true
      }
    ],
    "AuthVisual": [
      {
        "name": "title",
        "type": "string",
        "optional": false,
        "docs": "the line on the picture panel"
      },
      {
        "name": "text",
        "type": "string",
        "optional": false
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "text",
      "type": "string",
      "required": true
    },
    {
      "name": "submit",
      "type": "string",
      "required": true
    },
    {
      "name": "switchTo",
      "type": {
        "record": "AuthSwitch"
      },
      "required": true,
      "docs": "the way to the other mode (sign up instead, sign in instead)"
    },
    {
      "name": "labels",
      "type": {
        "ts": "AuthLabels"
      },
      "required": true
    },
    {
      "name": "visual",
      "type": {
        "record": "AuthVisual"
      },
      "required": true,
      "docs": "the picture panel of layout split"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2"
      },
      "default": 1
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"split\" | \"centered\" | \"minimal\""
      },
      "default": "split"
    },
    {
      "name": "side",
      "type": {
        "ts": "\"end\" | \"start\""
      },
      "default": "end"
    },
    {
      "name": "mode",
      "type": {
        "ts": "\"signin\" | \"signup\" | \"reset\" | \"magic\""
      },
      "default": "signin"
    },
    {
      "name": "social",
      "type": {
        "ts": "\"none\" | \"show\" | \"first\""
      },
      "default": "none"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "div",
        "Class": "w-full"
      },
      "attrs": {
        "data-testid": "auth-layout",
        "data-layout": {
          "$": "layout"
        }
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": {
              "op": "cn",
              "args": [
                "mx-auto w-full max-w-6xl px-4",
                "py-12"
              ]
            }
          },
          "attrs": {
            "data-slot": "container"
          },
          "children": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "split"
                ]
              },
              "then": [
                {
                  "use": "Grid",
                  "props": {
                    "Cols": "1-2",
                    "Class": "items-stretch gap-8"
                  },
                  "children": [
                    {
                      "use": "Box",
                      "props": {
                        "Class": "mx-auto flex w-full max-w-sm items-center"
                      },
                      "children": [
                        {
                          "organism": "AuthCard",
                          "props": {
                            "id": {
                              "$": "id"
                            },
                            "title": {
                              "$": "title"
                            },
                            "text": {
                              "$": "text"
                            },
                            "submit": {
                              "$": "submit"
                            },
                            "switchText": {
                              "$": "switchTo.text"
                            },
                            "switchLink": {
                              "$": "switchTo.link"
                            },
                            "switchHref": {
                              "$": "switchTo.href"
                            },
                            "labels": {
                              "$": "labels"
                            },
                            "mode": {
                              "$": "mode"
                            },
                            "layout": "plain",
                            "social": {
                              "$": "social"
                            },
                            "level": {
                              "$": "level"
                            },
                            "landmarkLabel": {
                              "$": "landmarkLabel"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "4",
                        "Align": "stretch",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "justify-end rounded bg-muted p-8",
                            {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "side"
                                    },
                                    "start"
                                  ]
                                },
                                "md:order-first",
                                "md:order-last"
                              ]
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "data-testid": "visual"
                      },
                      "children": [
                        {
                          "organism": "MediaFrame",
                          "props": {
                            "alt": {
                              "$": "visual.title"
                            },
                            "ratio": "4/3"
                          }
                        },
                        {
                          "use": "Title",
                          "props": {
                            "As": 2,
                            "Size": "2xl",
                            "Weight": "bold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "visual.title"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "visual.text"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "else": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "centered"
                    ]
                  },
                  "then": [
                    {
                      "use": "Box",
                      "props": {
                        "Class": "mx-auto w-full max-w-md rounded bg-muted p-6"
                      },
                      "children": [
                        {
                          "organism": "AuthCard",
                          "props": {
                            "id": {
                              "$": "id"
                            },
                            "title": {
                              "$": "title"
                            },
                            "text": {
                              "$": "text"
                            },
                            "submit": {
                              "$": "submit"
                            },
                            "switchText": {
                              "$": "switchTo.text"
                            },
                            "switchLink": {
                              "$": "switchTo.link"
                            },
                            "switchHref": {
                              "$": "switchTo.href"
                            },
                            "labels": {
                              "$": "labels"
                            },
                            "mode": {
                              "$": "mode"
                            },
                            "social": {
                              "$": "social"
                            },
                            "level": {
                              "$": "level"
                            },
                            "landmarkLabel": {
                              "$": "landmarkLabel"
                            }
                          }
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "use": "Box",
                      "props": {
                        "Class": "mx-auto w-full max-w-sm"
                      },
                      "children": [
                        {
                          "organism": "AuthCard",
                          "props": {
                            "id": {
                              "$": "id"
                            },
                            "title": {
                              "$": "title"
                            },
                            "text": {
                              "$": "text"
                            },
                            "submit": {
                              "$": "submit"
                            },
                            "switchText": {
                              "$": "switchTo.text"
                            },
                            "switchLink": {
                              "$": "switchTo.link"
                            },
                            "switchHref": {
                              "$": "switchTo.href"
                            },
                            "labels": {
                              "$": "labels"
                            },
                            "mode": {
                              "$": "mode"
                            },
                            "layout": "plain",
                            "social": {
                              "$": "social"
                            },
                            "level": {
                              "$": "level"
                            },
                            "landmarkLabel": {
                              "$": "landmarkLabel"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "AuthCard",
      "names": [
        "AuthLabels"
      ]
    }
  ]
}
