{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.team-grid",
  "name": "TeamGrid",
  "docs": "The people of a team: portrait cards, a minimal grid of small portraits, detailed cards with skills, rows beside a picture, or a directory of two columns. Axes: layout (cards, minimal, detailed, list, directory), cols, tone, density.",
  "records": {
    "Member": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "role",
        "type": "string"
      },
      {
        "name": "dept",
        "type": "string"
      },
      {
        "name": "location",
        "type": "string"
      },
      {
        "name": "bio",
        "type": "string"
      },
      {
        "name": "skills",
        "type": "string[]"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "members",
      "type": {
        "ts": "Member[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "depts",
      "type": {
        "ts": "Record<string, string>"
      },
      "required": true,
      "docs": "the name of each department"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"cards\" | \"minimal\" | \"detailed\" | \"list\" | \"directory\""
      },
      "default": "cards"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"1-3\" | \"1-4\""
      },
      "default": "1-4"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "layout": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "layout"
                },
                "list"
              ]
            },
            "split",
            "stack"
          ]
        },
        "media": {
          "show": {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "list"
            ]
          },
          "side": "start",
          "align": "start"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "members"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "users",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Box",
                  "props": {
                    "Class": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "layout"
                            },
                            "minimal"
                          ]
                        },
                        "grid grid-cols-2 gap-8 md:grid-cols-4",
                        {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "directory"
                              ]
                            },
                            "grid grid-cols-1 gap-4 md:grid-cols-2",
                            {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "layout"
                                    },
                                    "list"
                                  ]
                                },
                                "flex flex-col gap-4",
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "cols"
                                        },
                                        "1-3"
                                      ]
                                    },
                                    "grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3",
                                    "grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-4"
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  },
                  "attrs": {
                    "data-testid": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "members"
                      },
                      "as": "m",
                      "key": {
                        "$": "m.id"
                      },
                      "do": [
                        {
                          "when": {
                            "op": "eq",
                            "args": [
                              {
                                "$": "layout"
                              },
                              "minimal"
                            ]
                          },
                          "then": [
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "2",
                                "Align": "center",
                                "Class": "text-center"
                              },
                              "attrs": {
                                "data-testid": "item"
                              },
                              "children": [
                                {
                                  "organism": "MediaFrame",
                                  "props": {
                                    "alt": {
                                      "$": "m.name"
                                    },
                                    "ratio": "1/1",
                                    "className": {
                                      "op": "cn",
                                      "args": [
                                        "size-16",
                                        "shrink-0"
                                      ]
                                    }
                                  }
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Weight": "semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "m.name"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "xs",
                                    "Class": "text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "m.role"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ],
                          "else": [
                            {
                              "when": {
                                "op": "eq",
                                "args": [
                                  {
                                    "$": "layout"
                                  },
                                  "cards"
                                ]
                              },
                              "then": [
                                {
                                  "use": "Stack",
                                  "props": {
                                    "Gap": "4",
                                    "Class": "rounded bg-card inset-ring inset-ring-border p-4"
                                  },
                                  "attrs": {
                                    "data-testid": "item"
                                  },
                                  "children": [
                                    {
                                      "organism": "MediaFrame",
                                      "props": {
                                        "alt": {
                                          "$": "m.name"
                                        },
                                        "ratio": "1/1"
                                      }
                                    },
                                    {
                                      "use": "Stack",
                                      "props": {
                                        "Gap": "2"
                                      },
                                      "children": [
                                        {
                                          "use": "Stack",
                                          "props": {
                                            "Gap": "0"
                                          },
                                          "children": [
                                            {
                                              "use": "Text",
                                              "props": {
                                                "Size": "base",
                                                "Weight": "semibold"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "m.name"
                                                  }
                                                }
                                              ]
                                            },
                                            {
                                              "use": "Text",
                                              "props": {
                                                "Size": "sm",
                                                "Class": "text-muted-foreground"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "m.role"
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "sm",
                                            "Class": "text-muted-foreground"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "m.bio"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ],
                              "else": [
                                {
                                  "organism": "MemberRow",
                                  "props": {
                                    "member": {
                                      "$": "m"
                                    },
                                    "depts": {
                                      "$": "depts"
                                    },
                                    "layout": {
                                      "$": "layout"
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "aside": {
          "args": [],
          "do": [
            {
              "organism": "MediaFrame",
              "props": {
                "alt": {
                  "$": "title"
                },
                "ratio": "3/4"
              }
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
