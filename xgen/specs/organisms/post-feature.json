{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.post-feature",
  "name": "PostFeature",
  "docs": "The featured post of PostShowcase: the category, the title, the excerpt, the author with the date and reading time, and a wide read button.",
  "records": {},
  "props": [
    {
      "name": "p",
      "type": {
        "ts": "Post"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "PostLabels"
      },
      "required": true,
      "docs": "templates: minutes `{0} min read`, by `By {0}`; and the word of the read link"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Stack",
      "props": {
        "Gap": "4",
        "Align": "stretch",
        "Class": "border-t border-border pt-6"
      },
      "attrs": {
        "data-testid": "post-feature"
      },
      "children": [
        {
          "use": "Badge",
          "props": {
            "Variant": "secondary",
            "Size": "sm",
            "Class": "w-fit"
          },
          "children": [
            {
              "text": {
                "$": "p.category"
              }
            }
          ]
        },
        {
          "use": "Title",
          "props": {
            "As": 3,
            "Size": "xl",
            "Weight": "semibold"
          },
          "children": [
            {
              "text": {
                "$": "p.title"
              }
            }
          ]
        },
        {
          "use": "Text",
          "props": {
            "Size": "sm",
            "Class": "text-muted-foreground"
          },
          "children": [
            {
              "text": {
                "$": "p.excerpt"
              }
            }
          ]
        },
        {
          "use": "Group",
          "props": {
            "Gap": "4",
            "Align": "center"
          },
          "children": [
            {
              "organism": "MediaFrame",
              "props": {
                "alt": {
                  "$": "p.author"
                },
                "ratio": "1/1",
                "className": "size-10 shrink-0 rounded-full"
              }
            },
            {
              "use": "Stack",
              "props": {
                "Gap": "0"
              },
              "children": [
                {
                  "use": "Text",
                  "props": {
                    "Size": "sm",
                    "Weight": "semibold"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "p.author"
                      }
                    }
                  ]
                },
                {
                  "use": "Text",
                  "props": {
                    "Size": "xs",
                    "Class": "text-muted-foreground"
                  },
                  "children": [
                    {
                      "text": {
                        "op": "tpl",
                        "args": [
                          "{0} · {1}",
                          {
                            "$": "p.date"
                          },
                          {
                            "op": "tpl",
                            "args": [
                              {
                                "$": "labels.minutes"
                              },
                              {
                                "$": "p.minutes"
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "use": "Button",
          "props": {
            "Variant": "default",
            "Size": "default",
            "Href": {
              "$": "p.href"
            },
            "Class": "w-full gap-2"
          },
          "attrs": {
            "data-testid": "action-primary"
          },
          "children": [
            {
              "text": {
                "$": "labels.read"
              }
            },
            {
              "use": "LucideIcon",
              "props": {
                "Name": "arrow-right",
                "Size": 16
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "PostCard",
      "names": [
        "Post",
        "PostLabels"
      ]
    }
  ]
}
