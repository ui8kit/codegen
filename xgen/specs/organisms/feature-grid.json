{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.feature-grid",
  "name": "FeatureGrid",
  "docs": "A section with a heading and the features as a grid of cards or tiles, or as rows with a picture. Icons are Lucide names. Axes: layout (grid, rows), columns, item (card, tile, cell: bordered tile with a round icon), media side (rows), density, tone.",
  "records": {
    "Feature": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "text",
        "type": "string"
      },
      {
        "name": "icon",
        "type": "string"
      },
      {
        "name": "href",
        "type": "string",
        "optional": true
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "features",
      "type": {
        "ts": "Feature[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "action",
      "type": {
        "ts": "HeadLink"
      },
      "docs": "optional link opposite the heading"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"grid\" | \"rows\""
      },
      "default": "grid"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"1-2\" | \"1-3\" | \"1-4\""
      },
      "default": "1-3",
      "docs": "columns of the grid layout (responsive)"
    },
    {
      "name": "item",
      "type": {
        "ts": "\"card\" | \"tile\" | \"cell\""
      },
      "default": "card",
      "docs": "card: icon, title and text stacked; tile: compact icon beside title and text; cell: bordered cell with a round icon"
    },
    {
      "name": "mediaSide",
      "type": {
        "ts": "\"end\" | \"start\" | \"alternate\""
      },
      "default": "end",
      "docs": "rows layout: side of the picture; alternate swaps it every row"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"roomy\" | \"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "$": "item"
          },
          "cell"
        ]
      },
      "then": [
        {
          "organism": "SectionFrame",
          "props": {
            "id": {
              "$": "id"
            },
            "tone": {
              "$": "tone"
            },
            "density": {
              "$": "density"
            },
            "measure": "fill",
            "className": "py-0",
            "landmarkLabel": {
              "$": "landmarkLabel"
            }
          },
          "slots": {
            "children": {
              "args": [],
              "do": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "4",
                    "Align": "center",
                    "Justify": "between",
                    "Class": "w-full"
                  },
                  "children": [
                    {
                      "use": "Title",
                      "props": {
                        "As": 2,
                        "Size": "sm",
                        "Weight": "semibold",
                        "Class": "leading-7"
                      },
                      "attrs": {
                        "id": {
                          "op": "add",
                          "args": [
                            {
                              "$": "id"
                            },
                            "-title"
                          ]
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "title"
                          }
                        }
                      ]
                    },
                    {
                      "when": {
                        "op": "and",
                        "args": [
                          {
                            "$": "action.label"
                          },
                          {
                            "$": "action.href"
                          }
                        ]
                      },
                      "then": [
                        {
                          "use": "Link",
                          "props": {
                            "Href": {
                              "$": "action.href"
                            },
                            "Variant": "default",
                            "Class": {
                              "op": "cn",
                              "args": [
                                {
                                  "op": "preset",
                                  "args": [
                                    "defaults",
                                    "text.tiny"
                                  ]
                                },
                                "shrink-0 font-medium leading-5"
                              ]
                            }
                          },
                          "attrs": {
                            "data-testid": "section-action"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "action.label"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "features"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "organism": "EmptyState",
                      "props": {
                        "icon": "layout-grid",
                        "title": {
                          "$": "empty"
                        }
                      }
                    }
                  ],
                  "else": [
                    {
                      "organism": "FeatureCards",
                      "props": {
                        "features": {
                          "$": "features"
                        },
                        "cols": {
                          "$": "cols"
                        },
                        "item": {
                          "$": "item"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      ],
      "else": [
        {
          "organism": "SectionFrame",
          "props": {
            "id": {
              "$": "id"
            },
            "title": {
              "$": "title"
            },
            "action": {
              "$": "action"
            },
            "tone": {
              "$": "tone"
            },
            "density": {
              "$": "density"
            },
            "landmarkLabel": {
              "$": "landmarkLabel"
            }
          },
          "slots": {
            "children": {
              "args": [],
              "do": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "features"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "organism": "EmptyState",
                      "props": {
                        "icon": "layout-grid",
                        "title": {
                          "$": "empty"
                        }
                      }
                    }
                  ],
                  "else": [
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "layout"
                          },
                          "rows"
                        ]
                      },
                      "then": [
                        {
                          "organism": "FeatureRows",
                          "props": {
                            "features": {
                              "$": "features"
                            },
                            "mediaSide": {
                              "$": "mediaSide"
                            }
                          }
                        }
                      ],
                      "else": [
                        {
                          "organism": "FeatureCards",
                          "props": {
                            "features": {
                              "$": "features"
                            },
                            "cols": {
                              "$": "cols"
                            },
                            "item": {
                              "$": "item"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "SectionFrame",
      "names": [
        "HeadLink"
      ]
    }
  ]
}
