{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.checklist",
  "name": "Checklist",
  "docs": "An onboarding checklist: the tasks with a done mark, a progress bar or a count. Axes: layout (card, plain), progress (bar, text, none), marker (check, number), tone (default, muted).",
  "records": {
    "Task": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "text",
        "type": "string"
      },
      {
        "name": "done",
        "type": "boolean"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "tasks",
      "type": {
        "ts": "Task[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "progressLabel",
      "type": "string",
      "required": true,
      "docs": "template of the count, e.g. `{0} of {1} done`"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"card\" | \"plain\""
      },
      "default": "card"
    },
    {
      "name": "progress",
      "type": {
        "ts": "\"bar\" | \"text\" | \"none\""
      },
      "default": "bar"
    },
    {
      "name": "marker",
      "type": {
        "ts": "\"check\" | \"number\""
      },
      "default": "check"
    },
    {
      "name": "detail",
      "type": {
        "ts": "\"always\" | \"expand\""
      },
      "default": "always",
      "docs": "expand: the sentence of a task opens under its title"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "measure": "2xl",
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "tasks"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "list-checks",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Align": "stretch",
                    "Class": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "layout"
                            },
                            "card"
                          ]
                        },
                        "rounded bg-card p-6 inset-ring inset-ring-border",
                        ""
                      ]
                    }
                  },
                  "attrs": {
                    "data-testid": "checklist"
                  },
                  "children": [
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "progress"
                          },
                          "bar"
                        ]
                      },
                      "then": [
                        {
                          "use": "Progress",
                          "props": {
                            "Value": {
                              "op": "str",
                              "args": [
                                {
                                  "op": "round",
                                  "args": [
                                    {
                                      "op": "div",
                                      "args": [
                                        {
                                          "op": "mul",
                                          "args": [
                                            {
                                              "op": "count",
                                              "args": [
                                                {
                                                  "$": "tasks"
                                                },
                                                "done"
                                              ]
                                            },
                                            100
                                          ]
                                        },
                                        {
                                          "op": "len",
                                          "args": [
                                            {
                                              "$": "tasks"
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            "Max": "100"
                          },
                          "attrs": {
                            "aria-label": {
                              "op": "tpl",
                              "args": [
                                {
                                  "$": "progressLabel"
                                },
                                {
                                  "op": "count",
                                  "args": [
                                    {
                                      "$": "tasks"
                                    },
                                    "done"
                                  ]
                                },
                                {
                                  "op": "len",
                                  "args": [
                                    {
                                      "$": "tasks"
                                    }
                                  ]
                                }
                              ]
                            }
                          }
                        }
                      ]
                    },
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "progress"
                          },
                          "text"
                        ]
                      },
                      "then": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Class": "text-muted-foreground"
                          },
                          "attrs": {
                            "data-testid": "progress-text"
                          },
                          "children": [
                            {
                              "text": {
                                "op": "tpl",
                                "args": [
                                  {
                                    "$": "progressLabel"
                                  },
                                  {
                                    "op": "count",
                                    "args": [
                                      {
                                        "$": "tasks"
                                      },
                                      "done"
                                    ]
                                  },
                                  {
                                    "op": "len",
                                    "args": [
                                      {
                                        "$": "tasks"
                                      }
                                    ]
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "use": "List",
                      "props": {
                        "Class": "m-0 flex list-none flex-col gap-4 p-0"
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "tasks"
                          },
                          "as": "task",
                          "key": {
                            "$": "task.id"
                          },
                          "do": [
                            {
                              "use": "ListItem",
                              "props": {
                                "Class": "flex items-start gap-4"
                              },
                              "attrs": {
                                "data-testid": "item",
                                "data-done": {
                                  "op": "str",
                                  "args": [
                                    {
                                      "$": "task.done"
                                    }
                                  ]
                                }
                              },
                              "children": [
                                {
                                  "when": {
                                    "op": "eq",
                                    "args": [
                                      {
                                        "$": "marker"
                                      },
                                      "number"
                                    ]
                                  },
                                  "then": [
                                    {
                                      "use": "IconBadge",
                                      "props": {
                                        "Variant": {
                                          "op": "cond",
                                          "args": [
                                            {
                                              "$": "task.done"
                                            },
                                            "primary",
                                            "outline"
                                          ]
                                        },
                                        "Size": "xs"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "op": "str",
                                            "args": [
                                              {
                                                "op": "add",
                                                "args": [
                                                  {
                                                    "$": "i"
                                                  },
                                                  1
                                                ]
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    }
                                  ],
                                  "else": [
                                    {
                                      "use": "LucideIcon",
                                      "props": {
                                        "Name": {
                                          "op": "cond",
                                          "args": [
                                            {
                                              "$": "task.done"
                                            },
                                            "circle-check",
                                            "circle"
                                          ]
                                        },
                                        "Size": 24,
                                        "Class": {
                                          "op": "cond",
                                          "args": [
                                            {
                                              "$": "task.done"
                                            },
                                            "shrink-0 text-primary",
                                            "shrink-0 text-muted-foreground"
                                          ]
                                        }
                                      }
                                    }
                                  ]
                                },
                                {
                                  "when": {
                                    "op": "eq",
                                    "args": [
                                      {
                                        "$": "detail"
                                      },
                                      "expand"
                                    ]
                                  },
                                  "then": [
                                    {
                                      "use": "Disclosure",
                                      "props": {
                                        "Variant": "ghost",
                                        "Class": "flex-1"
                                      },
                                      "attrs": {
                                        "data-testid": "task-detail"
                                      },
                                      "children": [
                                        {
                                          "use": "Summary",
                                          "props": {
                                            "Variant": "ghost"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "task.title"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "sm",
                                            "Class": "pb-2 text-muted-foreground"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "task.text"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ],
                                  "else": [
                                    {
                                      "use": "Stack",
                                      "props": {
                                        "Gap": "0"
                                      },
                                      "children": [
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "base",
                                            "Weight": "semibold"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "task.title"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "sm",
                                            "Class": "text-muted-foreground"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "task.text"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ],
                          "index": "i"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
