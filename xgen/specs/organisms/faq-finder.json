{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.faq-finder",
  "name": "FaqFinder",
  "docs": "The finder of FaqSplit: a search field, the topics as a row of buttons, and the first three questions as popular links.",
  "records": {},
  "props": [
    {
      "name": "items",
      "type": {
        "ts": "Question[]"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "FaqSplitLabels"
      },
      "required": true
    },
    {
      "name": "topics",
      "type": {
        "ts": "FaqTab[]"
      },
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Stack",
      "props": {
        "Gap": "6",
        "Align": "stretch"
      },
      "attrs": {
        "data-testid": "faq-finder"
      },
      "children": [
        {
          "organism": "SearchField",
          "props": {
            "label": {
              "$": "labels.search"
            },
            "placeholder": {
              "$": "labels.search"
            },
            "value": {
              "op": "coalesce",
              "args": [
                {
                  "$": "labels.query"
                },
                ""
              ]
            }
          }
        },
        {
          "use": "Group",
          "props": {
            "Gap": "2",
            "Class": "flex-wrap"
          },
          "children": [
            {
              "each": {
                "$": "topics"
              },
              "as": "t",
              "key": {
                "$": "t.id"
              },
              "do": [
                {
                  "use": "Button",
                  "props": {
                    "Variant": "outline",
                    "Size": "sm"
                  },
                  "attrs": {
                    "data-testid": "faq-topic",
                    "data-value": {
                      "$": "t.value"
                    }
                  },
                  "children": [
                    {
                      "text": {
                        "$": "t.title"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "use": "Stack",
          "props": {
            "Gap": "2"
          },
          "children": [
            {
              "use": "Text",
              "props": {
                "Size": "sm",
                "Weight": "semibold"
              },
              "children": [
                {
                  "text": {
                    "$": "labels.popular"
                  }
                }
              ]
            },
            {
              "use": "List",
              "props": {
                "Class": "m-0 flex list-none flex-col gap-2 p-0"
              },
              "children": [
                {
                  "each": {
                    "$": "items"
                  },
                  "as": "q",
                  "key": {
                    "$": "q.id"
                  },
                  "do": [
                    {
                      "when": {
                        "op": "lt",
                        "args": [
                          {
                            "$": "i"
                          },
                          3
                        ]
                      },
                      "then": [
                        {
                          "use": "ListItem",
                          "attrs": {
                            "data-testid": "faq-popular"
                          },
                          "children": [
                            {
                              "organism": "MenuEntry",
                              "props": {
                                "href": {
                                  "$": "q.href"
                                },
                                "className": "text-sm font-medium",
                                "size": "sm"
                              },
                              "slots": {
                                "children": {
                                  "args": [],
                                  "do": [
                                    {
                                      "text": {
                                        "$": "q.question"
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "index": "i"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "FaqSplit",
      "names": [
        "Question",
        "FaqSplitLabels"
      ]
    },
    {
      "from": "FaqList",
      "names": [
        "FaqTab"
      ]
    }
  ]
}
