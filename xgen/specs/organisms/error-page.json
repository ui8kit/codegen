{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.error-page",
  "name": "ErrorPage",
  "docs": "A page that tells the visitor something went wrong: an icon or a big code, a heading, a sentence and the way back. Axes: layout (centered, split: the picture beside the text), code (show, hide), actions mode (one, two), tone.",
  "records": {
    "LinkActions": [
      {
        "name": "mode",
        "type": "\"one\" | \"two\"",
        "optional": true,
        "docs": "one or two links",
        "default": "one"
      },
      {
        "name": "cta",
        "type": "string",
        "optional": false,
        "docs": "primary action label"
      },
      {
        "name": "href",
        "type": "string",
        "optional": true,
        "docs": "the address of the primary action; none: a button, not a link"
      },
      {
        "name": "secondary",
        "type": "string",
        "optional": true
      },
      {
        "name": "secondaryHref",
        "type": "string",
        "optional": true
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "text",
      "type": "string",
      "required": true
    },
    {
      "name": "status",
      "type": "string",
      "required": true,
      "docs": "the status code, e.g. 404"
    },
    {
      "name": "actions",
      "type": {
        "record": "LinkActions"
      },
      "required": true,
      "docs": "the way back: one link, or two (mode two)"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2"
      },
      "default": 1
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"centered\" | \"split\""
      },
      "default": "centered"
    },
    {
      "name": "code",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "text"
        },
        "heading": {
          "level": {
            "$": "level"
          }
        },
        "layout": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "layout"
                },
                "split"
              ]
            },
            "split",
            "stack"
          ]
        },
        "media": {
          "show": {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "split"
            ]
          }
        },
        "align": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "layout"
                },
                "split"
              ]
            },
            "start",
            "center"
          ]
        },
        "tone": {
          "$": "tone"
        },
        "density": "roomy",
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "code"
                  },
                  "show"
                ]
              },
              "then": [
                {
                  "use": "Text",
                  "props": {
                    "Size": "4xl",
                    "Weight": "bold",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "text-8xl text-muted-foreground",
                        {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "split"
                              ]
                            },
                            "",
                            "text-center"
                          ]
                        }
                      ]
                    }
                  },
                  "attrs": {
                    "data-testid": "error-code"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "status"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "organism": "ActionGroup",
              "props": {
                "primary": {
                  "$": "actions.cta"
                },
                "primaryHref": {
                  "$": "actions.href"
                },
                "secondary": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "actions.mode"
                        },
                        "two"
                      ]
                    },
                    {
                      "$": "actions.secondary"
                    },
                    {
                      "op": "undef",
                      "args": []
                    }
                  ]
                },
                "secondaryHref": {
                  "$": "actions.secondaryHref"
                },
                "align": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "layout"
                        },
                        "split"
                      ]
                    },
                    "start",
                    "center"
                  ]
                }
              }
            }
          ]
        },
        "aside": {
          "args": [],
          "do": [
            {
              "organism": "MediaFrame",
              "props": {
                "alt": {
                  "$": "title"
                },
                "ratio": "4/3"
              }
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
