{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.signup-wizard",
  "name": "SignupWizard",
  "docs": "A sign-up in steps: the progress, the fields of the current step, back and next. `current` is the step shown, counted from 1. Axes: progress (bar, list: every step named), layout (card, plain). Keeping the typed values between steps is the page's job.",
  "records": {
    "WizardStep": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "text",
        "type": "string"
      },
      {
        "name": "icon",
        "type": "string"
      },
      {
        "name": "fieldA",
        "type": "string"
      },
      {
        "name": "fieldB",
        "type": "string"
      }
    ],
    "WizardLabels": [
      {
        "name": "stepOf",
        "type": "string"
      },
      {
        "name": "steps",
        "type": "string"
      },
      {
        "name": "back",
        "type": "string"
      },
      {
        "name": "next",
        "type": "string"
      },
      {
        "name": "finish",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "steps",
      "type": {
        "ts": "WizardStep[]"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "record": "WizardLabels"
      },
      "required": true
    },
    {
      "name": "current",
      "type": "number",
      "default": 1
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2"
      },
      "default": 2
    },
    {
      "name": "progress",
      "type": {
        "ts": "\"bar\" | \"list\""
      },
      "default": "bar"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"card\" | \"plain\""
      },
      "default": "card"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "go",
      "args": [
        {
          "name": "step",
          "type": "number"
        }
      ],
      "docs": "back or next was pressed"
    }
  ],
  "view": [
    {
      "when": {
        "op": "gt",
        "args": [
          {
            "op": "len",
            "args": [
              {
                "$": "steps"
              }
            ]
          },
          0
        ]
      },
      "then": [
        {
          "use": "Block",
          "props": {
            "Tag": "section",
            "Class": {
              "op": "cn",
              "args": [
                "mx-auto flex w-full max-w-lg flex-col gap-6 px-4 py-8",
                {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "layout"
                        },
                        "card"
                      ]
                    },
                    "rounded bg-card p-6 inset-ring inset-ring-border",
                    ""
                  ]
                }
              ]
            }
          },
          "attrs": {
            "aria-labelledby": {
              "op": "cond",
              "args": [
                {
                  "$": "landmarkLabel"
                },
                {
                  "op": "undef",
                  "args": []
                },
                {
                  "op": "tpl",
                  "args": [
                    "{0}-title",
                    {
                      "$": "id"
                    }
                  ]
                }
              ]
            },
            "data-testid": "wizard",
            "data-current": {
              "op": "str",
              "args": [
                {
                  "$": "current"
                }
              ]
            },
            "aria-label": {
              "$": "landmarkLabel"
            }
          },
          "children": [
            {
              "use": "Title",
              "props": {
                "As": {
                  "$": "level"
                },
                "Size": "2xl",
                "Weight": "bold"
              },
              "attrs": {
                "id": {
                  "op": "tpl",
                  "args": [
                    "{0}-title",
                    {
                      "$": "id"
                    }
                  ]
                }
              },
              "children": [
                {
                  "text": {
                    "$": "title"
                  }
                }
              ]
            },
            {
              "use": "Text",
              "props": {
                "Size": "sm",
                "Class": "text-muted-foreground"
              },
              "attrs": {
                "data-testid": "step-of"
              },
              "children": [
                {
                  "text": {
                    "op": "tpl",
                    "args": [
                      {
                        "$": "labels.stepOf"
                      },
                      {
                        "$": "current"
                      },
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "steps"
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "progress"
                  },
                  "bar"
                ]
              },
              "then": [
                {
                  "use": "Progress",
                  "props": {
                    "Value": {
                      "op": "str",
                      "args": [
                        {
                          "$": "current"
                        }
                      ]
                    },
                    "Max": {
                      "op": "str",
                      "args": [
                        {
                          "op": "len",
                          "args": [
                            {
                              "$": "steps"
                            }
                          ]
                        }
                      ]
                    }
                  },
                  "attrs": {
                    "aria-label": {
                      "$": "labels.steps"
                    }
                  }
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "progress"
                  },
                  "list"
                ]
              },
              "then": [
                {
                  "use": "List",
                  "props": {
                    "Class": "m-0 flex list-none flex-col gap-2 p-0"
                  },
                  "attrs": {
                    "aria-label": {
                      "$": "labels.steps"
                    },
                    "data-testid": "step-list"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "steps"
                      },
                      "as": "s",
                      "key": {
                        "$": "s.id"
                      },
                      "do": [
                        {
                          "use": "ListItem",
                          "props": {
                            "Class": {
                              "op": "cn",
                              "args": [
                                "flex items-center gap-4 text-sm",
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "op": "add",
                                          "args": [
                                            {
                                              "$": "i"
                                            },
                                            1
                                          ]
                                        },
                                        {
                                          "$": "current"
                                        }
                                      ]
                                    },
                                    "font-semibold",
                                    "text-muted-foreground"
                                  ]
                                }
                              ]
                            }
                          },
                          "attrs": {
                            "aria-current": {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "op": "add",
                                      "args": [
                                        {
                                          "$": "i"
                                        },
                                        1
                                      ]
                                    },
                                    {
                                      "$": "current"
                                    }
                                  ]
                                },
                                "step",
                                {
                                  "op": "undef",
                                  "args": []
                                }
                              ]
                            },
                            "data-testid": "step-item"
                          },
                          "children": [
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "lt",
                                      "args": [
                                        {
                                          "op": "add",
                                          "args": [
                                            {
                                              "$": "i"
                                            },
                                            1
                                          ]
                                        },
                                        {
                                          "$": "current"
                                        }
                                      ]
                                    },
                                    "circle-check",
                                    {
                                      "$": "s.icon"
                                    }
                                  ]
                                },
                                "Size": 16
                              }
                            },
                            {
                              "text": {
                                "$": "s.title"
                              }
                            }
                          ]
                        }
                      ],
                      "index": "i"
                    }
                  ]
                }
              ]
            },
            {
              "each": {
                "$": "steps"
              },
              "as": "s",
              "key": {
                "$": "s.id"
              },
              "do": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "op": "add",
                        "args": [
                          {
                            "$": "i"
                          },
                          1
                        ]
                      },
                      {
                        "$": "current"
                      }
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "4",
                        "Align": "stretch"
                      },
                      "attrs": {
                        "data-testid": "step"
                      },
                      "children": [
                        {
                          "use": "Title",
                          "props": {
                            "As": 3,
                            "Size": "xl",
                            "Weight": "bold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "s.title"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "s.text"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Box",
                          "props": {
                            "Class": "grid gap-4"
                          },
                          "children": [
                            {
                              "organism": "Field",
                              "props": {
                                "label": {
                                  "$": "s.fieldA"
                                },
                                "htmlFor": {
                                  "op": "tpl",
                                  "args": [
                                    "{0}-a",
                                    {
                                      "$": "id"
                                    }
                                  ]
                                }
                              },
                              "slots": {
                                "children": {
                                  "args": [],
                                  "do": [
                                    {
                                      "use": "Input",
                                      "props": {
                                        "Type": "text",
                                        "Name": {
                                          "op": "tpl",
                                          "args": [
                                            "{0}-a",
                                            {
                                              "$": "id"
                                            }
                                          ]
                                        }
                                      },
                                      "attrs": {
                                        "id": {
                                          "op": "tpl",
                                          "args": [
                                            "{0}-a",
                                            {
                                              "$": "id"
                                            }
                                          ]
                                        },
                                        "data-testid": "field"
                                      }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "organism": "Field",
                              "props": {
                                "label": {
                                  "$": "s.fieldB"
                                },
                                "htmlFor": {
                                  "op": "tpl",
                                  "args": [
                                    "{0}-b",
                                    {
                                      "$": "id"
                                    }
                                  ]
                                }
                              },
                              "slots": {
                                "children": {
                                  "args": [],
                                  "do": [
                                    {
                                      "use": "Input",
                                      "props": {
                                        "Type": "text",
                                        "Name": {
                                          "op": "tpl",
                                          "args": [
                                            "{0}-b",
                                            {
                                              "$": "id"
                                            }
                                          ]
                                        }
                                      },
                                      "attrs": {
                                        "id": {
                                          "op": "tpl",
                                          "args": [
                                            "{0}-b",
                                            {
                                              "$": "id"
                                            }
                                          ]
                                        },
                                        "data-testid": "field"
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "index": "i"
            },
            {
              "use": "Group",
              "props": {
                "Gap": "2",
                "Justify": "between"
              },
              "children": [
                {
                  "use": "Button",
                  "props": {
                    "Variant": "outline",
                    "Size": "default",
                    "Type": "button",
                    "Disabled": {
                      "op": "lt",
                      "args": [
                        {
                          "$": "current"
                        },
                        2
                      ]
                    }
                  },
                  "attrs": {
                    "data-testid": "wizard-back"
                  },
                  "on": {
                    "click": {
                      "call": "emit.go",
                      "args": [
                        {
                          "op": "sub",
                          "args": [
                            {
                              "$": "current"
                            },
                            1
                          ]
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "text": {
                        "$": "labels.back"
                      }
                    }
                  ]
                },
                {
                  "use": "Button",
                  "props": {
                    "Variant": "default",
                    "Size": "default",
                    "Type": "button"
                  },
                  "attrs": {
                    "data-testid": "wizard-next"
                  },
                  "on": {
                    "click": {
                      "call": "emit.go",
                      "args": [
                        {
                          "op": "add",
                          "args": [
                            {
                              "$": "current"
                            },
                            1
                          ]
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "text": {
                        "op": "cond",
                        "args": [
                          {
                            "op": "ge",
                            "args": [
                              {
                                "$": "current"
                              },
                              {
                                "op": "len",
                                "args": [
                                  {
                                    "$": "steps"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "$": "labels.finish"
                          },
                          {
                            "$": "labels.next"
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
