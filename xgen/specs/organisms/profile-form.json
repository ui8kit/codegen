{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.profile-form",
  "name": "ProfileForm",
  "docs": "An account settings form: a picture with a change button, name, email, bio and two notification switches, with save and cancel. Axes: layout (stacked, split), avatar (show, hide), prefs (show, hide), tone (default, muted).",
  "records": {
    "ProfileLabels": [
      {
        "name": "picture",
        "type": "string"
      },
      {
        "name": "change",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "email",
        "type": "string"
      },
      {
        "name": "bio",
        "type": "string"
      },
      {
        "name": "prefs",
        "type": "string"
      },
      {
        "name": "updates",
        "type": "string"
      },
      {
        "name": "alerts",
        "type": "string"
      },
      {
        "name": "save",
        "type": "string"
      },
      {
        "name": "cancel",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "text",
      "type": "string",
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "record": "ProfileLabels"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"stacked\" | \"split\""
      },
      "default": "stacked"
    },
    {
      "name": "avatar",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "prefs",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section"
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            {
              "op": "cond",
              "args": [
                {
                  "op": "and",
                  "args": [
                    {
                      "$": "title"
                    },
                    {
                      "$": "id"
                    }
                  ]
                },
                {
                  "op": "tpl",
                  "args": [
                    "{0}-t",
                    {
                      "$": "id"
                    }
                  ]
                },
                {
                  "op": "undef",
                  "args": []
                }
              ]
            }
          ]
        },
        "data-testid": "panel-section",
        "aria-label": {
          "$": "landmarkLabel"
        }
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": "mx-auto w-full max-w-6xl px-4 py-8"
          },
          "attrs": {
            "data-slot": "container"
          },
          "children": [
            {
              "organism": "Panel",
              "props": {
                "title": {
                  "$": "title"
                },
                "description": {
                  "$": "text"
                },
                "id": {
                  "$": "id"
                },
                "className": {
                  "op": "cn",
                  "args": [
                    {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "tone"
                            },
                            "muted"
                          ]
                        },
                        "bg-muted",
                        ""
                      ]
                    }
                  ]
                }
              },
              "slots": {
                "children": {
                  "args": [],
                  "do": [
                    {
                      "use": "Form",
                      "props": {
                        "Method": "dialog",
                        "Class": "gap-6"
                      },
                      "attrs": {
                        "data-testid": "profile-form"
                      },
                      "children": [
                        {
                          "use": "Grid",
                          "props": {
                            "Cols": {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "layout"
                                    },
                                    "split"
                                  ]
                                },
                                "1-2",
                                "1"
                              ]
                            },
                            "Class": "items-start gap-8"
                          },
                          "children": [
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "4",
                                "Align": "stretch"
                              },
                              "children": [
                                {
                                  "when": {
                                    "op": "eq",
                                    "args": [
                                      {
                                        "$": "avatar"
                                      },
                                      "show"
                                    ]
                                  },
                                  "then": [
                                    {
                                      "use": "Group",
                                      "props": {
                                        "Gap": "4",
                                        "Align": "center"
                                      },
                                      "attrs": {
                                        "data-testid": "avatar"
                                      },
                                      "children": [
                                        {
                                          "organism": "MediaFrame",
                                          "props": {
                                            "alt": {
                                              "$": "labels.picture"
                                            },
                                            "ratio": "1/1",
                                            "className": "size-16 shrink-0 rounded-full"
                                          }
                                        },
                                        {
                                          "use": "Button",
                                          "props": {
                                            "Variant": "outline",
                                            "Size": "sm",
                                            "Type": "button"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "labels.change"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "organism": "Field",
                                  "props": {
                                    "label": {
                                      "$": "labels.name"
                                    },
                                    "htmlFor": {
                                      "op": "tpl",
                                      "args": [
                                        "{0}-name",
                                        {
                                          "$": "id"
                                        }
                                      ]
                                    }
                                  },
                                  "slots": {
                                    "children": {
                                      "args": [],
                                      "do": [
                                        {
                                          "use": "Input",
                                          "props": {
                                            "Type": "text",
                                            "Name": "name",
                                            "Autocomplete": "name"
                                          },
                                          "attrs": {
                                            "id": {
                                              "op": "tpl",
                                              "args": [
                                                "{0}-name",
                                                {
                                                  "$": "id"
                                                }
                                              ]
                                            },
                                            "data-testid": "field"
                                          }
                                        }
                                      ]
                                    }
                                  }
                                },
                                {
                                  "organism": "Field",
                                  "props": {
                                    "label": {
                                      "$": "labels.email"
                                    },
                                    "htmlFor": {
                                      "op": "tpl",
                                      "args": [
                                        "{0}-email",
                                        {
                                          "$": "id"
                                        }
                                      ]
                                    }
                                  },
                                  "slots": {
                                    "children": {
                                      "args": [],
                                      "do": [
                                        {
                                          "use": "Input",
                                          "props": {
                                            "Type": "email",
                                            "Name": "email",
                                            "Autocomplete": "email"
                                          },
                                          "attrs": {
                                            "id": {
                                              "op": "tpl",
                                              "args": [
                                                "{0}-email",
                                                {
                                                  "$": "id"
                                                }
                                              ]
                                            },
                                            "data-testid": "field"
                                          }
                                        }
                                      ]
                                    }
                                  }
                                },
                                {
                                  "organism": "Field",
                                  "props": {
                                    "label": {
                                      "$": "labels.bio"
                                    },
                                    "htmlFor": {
                                      "op": "tpl",
                                      "args": [
                                        "{0}-bio",
                                        {
                                          "$": "id"
                                        }
                                      ]
                                    }
                                  },
                                  "slots": {
                                    "children": {
                                      "args": [],
                                      "do": [
                                        {
                                          "use": "Textarea",
                                          "props": {
                                            "Rows": 4,
                                            "Name": "bio"
                                          },
                                          "attrs": {
                                            "id": {
                                              "op": "tpl",
                                              "args": [
                                                "{0}-bio",
                                                {
                                                  "$": "id"
                                                }
                                              ]
                                            },
                                            "data-testid": "field"
                                          }
                                        }
                                      ]
                                    }
                                  }
                                }
                              ]
                            },
                            {
                              "when": {
                                "op": "eq",
                                "args": [
                                  {
                                    "$": "prefs"
                                  },
                                  "show"
                                ]
                              },
                              "then": [
                                {
                                  "use": "Stack",
                                  "props": {
                                    "Gap": "4",
                                    "Align": "stretch"
                                  },
                                  "attrs": {
                                    "data-testid": "prefs"
                                  },
                                  "children": [
                                    {
                                      "use": "Title",
                                      "props": {
                                        "As": 3,
                                        "Size": "base",
                                        "Weight": "bold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "labels.prefs"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Group",
                                      "props": {
                                        "Gap": "4",
                                        "Align": "center",
                                        "Justify": "between"
                                      },
                                      "children": [
                                        {
                                          "use": "Label",
                                          "props": {
                                            "HTMLFor": {
                                              "op": "tpl",
                                              "args": [
                                                "{0}-updates",
                                                {
                                                  "$": "id"
                                                }
                                              ]
                                            },
                                            "Class": "text-sm"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "labels.updates"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Switch",
                                          "props": {
                                            "Name": "updates"
                                          },
                                          "attrs": {
                                            "id": {
                                              "op": "tpl",
                                              "args": [
                                                "{0}-updates",
                                                {
                                                  "$": "id"
                                                }
                                              ]
                                            }
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Group",
                                      "props": {
                                        "Gap": "4",
                                        "Align": "center",
                                        "Justify": "between"
                                      },
                                      "children": [
                                        {
                                          "use": "Label",
                                          "props": {
                                            "HTMLFor": {
                                              "op": "tpl",
                                              "args": [
                                                "{0}-alerts",
                                                {
                                                  "$": "id"
                                                }
                                              ]
                                            },
                                            "Class": "text-sm"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "labels.alerts"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Switch",
                                          "props": {
                                            "Name": "alerts"
                                          },
                                          "attrs": {
                                            "id": {
                                              "op": "tpl",
                                              "args": [
                                                "{0}-alerts",
                                                {
                                                  "$": "id"
                                                }
                                              ]
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "use": "Group",
                          "props": {
                            "Gap": "2",
                            "Class": "flex-wrap"
                          },
                          "children": [
                            {
                              "use": "Button",
                              "props": {
                                "Variant": "default",
                                "Size": "default",
                                "Type": "submit"
                              },
                              "attrs": {
                                "data-testid": "submit"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "labels.save"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Button",
                              "props": {
                                "Variant": "outline",
                                "Size": "default",
                                "Type": "button"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "labels.cancel"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
