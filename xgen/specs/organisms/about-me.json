{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.about-me",
  "name": "AboutMe",
  "docs": "A personal about section beside a portrait: a badge, the heading, a lead, then key facts and a list of specialities, or skill chips and expertise bars, and one or two links. Axes: layout (facts, skills), mediaSide, tone.",
  "records": {
    "Skill": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "label",
        "type": "string"
      },
      {
        "name": "level",
        "type": "number"
      }
    ],
    "AboutMeLabels": [
      {
        "name": "level",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "badge",
      "type": "string",
      "default": ""
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2"
      },
      "default": 1
    },
    {
      "name": "facts",
      "type": {
        "ts": "Spec[]"
      },
      "required": true
    },
    {
      "name": "skills",
      "type": {
        "ts": "Skill[]"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "record": "AboutMeLabels"
      },
      "required": true
    },
    {
      "name": "actions",
      "type": {
        "ts": "LinkActions"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"facts\" | \"skills\""
      },
      "default": "facts"
    },
    {
      "name": "mediaSide",
      "type": {
        "ts": "\"start\" | \"end\""
      },
      "default": "start"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "heading": {
          "badge": {
            "$": "badge"
          },
          "level": {
            "$": "level"
          }
        },
        "layout": "split",
        "media": {
          "show": true,
          "side": {
            "$": "mediaSide"
          }
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "facts"
                ]
              },
              "then": [
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "facts"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "use": "List",
                      "props": {
                        "Tag": "ul",
                        "Class": "grid grid-cols-1 gap-4 sm:grid-cols-2"
                      },
                      "attrs": {
                        "data-testid": "facts"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "facts"
                          },
                          "as": "f",
                          "key": {
                            "$": "f.id"
                          },
                          "do": [
                            {
                              "use": "ListItem",
                              "props": {
                                "Class": "rounded bg-card inset-ring inset-ring-border flex flex-col gap-0 p-4"
                              },
                              "attrs": {
                                "data-testid": "fact"
                              },
                              "children": [
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "xs",
                                    "Class": "text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "f.label"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Weight": "semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "f.value"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "else": [
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "skills"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "4",
                        "Align": "stretch"
                      },
                      "attrs": {
                        "data-testid": "skills"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "skills"
                          },
                          "as": "s",
                          "key": {
                            "$": "s.id"
                          },
                          "do": [
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "2",
                                "Align": "stretch"
                              },
                              "attrs": {
                                "data-testid": "skill"
                              },
                              "children": [
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "4",
                                    "Justify": "between"
                                  },
                                  "children": [
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "sm",
                                        "Weight": "semibold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "s.label"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "xs",
                                        "Class": "text-muted-foreground"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "op": "tpl",
                                            "args": [
                                              {
                                                "$": "labels.level"
                                              },
                                              {
                                                "$": "s.level"
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "Progress",
                                  "props": {
                                    "Value": {
                                      "op": "str",
                                      "args": [
                                        {
                                          "$": "s.level"
                                        }
                                      ]
                                    },
                                    "Max": "100"
                                  },
                                  "attrs": {
                                    "aria-label": {
                                      "$": "s.label"
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "organism": "ActionGroup",
              "props": {
                "primary": {
                  "$": "actions.cta"
                },
                "primaryHref": {
                  "$": "actions.href"
                },
                "secondary": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "actions.mode"
                        },
                        "two"
                      ]
                    },
                    {
                      "$": "actions.secondary"
                    },
                    {
                      "op": "undef",
                      "args": []
                    }
                  ]
                },
                "secondaryHref": {
                  "$": "actions.secondaryHref"
                }
              }
            }
          ]
        },
        "aside": {
          "args": [],
          "do": [
            {
              "organism": "MediaFrame",
              "props": {
                "alt": {
                  "$": "title"
                },
                "ratio": "3/4"
              }
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "ProductInfo",
      "names": [
        "Spec"
      ]
    },
    {
      "from": "ErrorPage",
      "names": [
        "LinkActions"
      ]
    }
  ]
}
