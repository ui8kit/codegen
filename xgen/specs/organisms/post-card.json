{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.post-card",
  "name": "PostCard",
  "docs": "A post as a card: cover picture, category, title, excerpt, author line and a read link. Axes: layout (vertical, horizontal), media (image, none), meta (full, short: the date only, news: date and title only), density.",
  "records": {
    "Post": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "excerpt",
        "type": "string"
      },
      {
        "name": "category",
        "type": "string"
      },
      {
        "name": "author",
        "type": "string"
      },
      {
        "name": "date",
        "type": "string"
      },
      {
        "name": "minutes",
        "type": "number"
      },
      {
        "name": "icon",
        "type": "string"
      },
      {
        "name": "href",
        "type": "string",
        "optional": true
      },
      {
        "name": "image",
        "type": "string",
        "optional": true
      }
    ],
    "PostLabels": [
      {
        "name": "minutes",
        "type": "string"
      },
      {
        "name": "by",
        "type": "string"
      },
      {
        "name": "read",
        "type": "string"
      },
      {
        "name": "empty",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "post",
      "type": {
        "record": "Post"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "record": "PostLabels"
      },
      "required": true,
      "docs": "templates: minutes `{0} min read`, by `By {0}`; and the word of the read link"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"vertical\" | \"horizontal\""
      },
      "default": "vertical"
    },
    {
      "name": "media",
      "type": {
        "ts": "\"image\" | \"none\""
      },
      "default": "image"
    },
    {
      "name": "meta",
      "type": {
        "ts": "\"full\" | \"short\" | \"news\""
      },
      "default": "full"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "$": "meta"
          },
          "news"
        ]
      },
      "then": [
        {
          "use": "Block",
          "props": {
            "Tag": "article",
            "Class": {
              "op": "cn",
              "args": [
                "flex flex-col gap-2 overflow-hidden rounded p-0 inset-ring inset-ring-border",
                {
                  "op": "preset",
                  "args": [
                    "defaults",
                    "news.card"
                  ]
                }
              ]
            }
          },
          "attrs": {
            "data-testid": "item",
            "data-layout": {
              "$": "layout"
            },
            "data-meta": "news"
          },
          "children": [
            {
              "use": "Box",
              "props": {
                "Class": {
                  "op": "cn",
                  "args": [
                    "relative shrink-0 overflow-hidden",
                    {
                      "op": "preset",
                      "args": [
                        "defaults",
                        "news.cover"
                      ]
                    }
                  ]
                }
              },
              "attrs": {
                "data-testid": "news-cover"
              },
              "children": [
                {
                  "organism": "MediaFrame",
                  "props": {
                    "alt": {
                      "$": "post.title"
                    },
                    "src": {
                      "$": "post.image"
                    },
                    "className": {
                      "op": "cn",
                      "args": [
                        "size-full",
                        {
                          "op": "preset",
                          "args": [
                            "defaults",
                            "media.rounded"
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "use": "Title",
                  "props": {
                    "As": 3,
                    "Size": "xs",
                    "Weight": "semibold",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "pointer-events-none absolute inset-x-12 line-clamp-2 text-center leading-5 text-foreground",
                        {
                          "op": "preset",
                          "args": [
                            "defaults",
                            "news.title"
                          ]
                        }
                      ]
                    }
                  },
                  "attrs": {
                    "data-testid": "news-title"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "post.title"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "use": "Group",
              "props": {
                "Gap": "2",
                "Align": "center",
                "Class": {
                  "op": "cn",
                  "args": [
                    "w-full px-2 text-muted-foreground",
                    {
                      "op": "preset",
                      "args": [
                        "defaults",
                        "news.strip"
                      ]
                    }
                  ]
                }
              },
              "attrs": {
                "data-testid": "news-date"
              },
              "children": [
                {
                  "use": "LucideIcon",
                  "props": {
                    "Name": "calendar",
                    "Size": 16
                  }
                },
                {
                  "use": "Text",
                  "props": {
                    "Size": "xs",
                    "Weight": "bold",
                    "Class": "leading-4"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "post.date"
                      }
                    }
                  ]
                },
                {
                  "when": {
                    "$": "post.category"
                  },
                  "then": [
                    {
                      "use": "Text",
                      "props": {
                        "Size": "xs",
                        "Weight": "bold",
                        "Class": "leading-4"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "post.category"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "else": [
        {
          "use": "Block",
          "props": {
            "Tag": "article",
            "Class": {
              "op": "cn",
              "args": [
                "flex flex-col gap-8 bg-card p-6 text-card-foreground inset-ring inset-ring-border rounded",
                "h-full gap-4 overflow-hidden",
                {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "layout"
                        },
                        "horizontal"
                      ]
                    },
                    "flex flex-col sm:flex-row",
                    "flex flex-col"
                  ]
                }
              ]
            }
          },
          "attrs": {
            "data-slot": "card",
            "data-testid": "item",
            "data-layout": {
              "$": "layout"
            },
            "data-meta": {
              "$": "meta"
            }
          },
          "children": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "media"
                  },
                  "image"
                ]
              },
              "then": [
                {
                  "use": "Box",
                  "props": {
                    "Class": {
                      "op": "cn",
                      "args": [
                        "relative shrink-0",
                        {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "horizontal"
                              ]
                            },
                            "sm:w-64",
                            ""
                          ]
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "organism": "MediaFrame",
                      "props": {
                        "alt": {
                          "$": "post.title"
                        },
                        "src": {
                          "$": "post.image"
                        },
                        "className": "h-full"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "use": "CardContent",
              "props": {
                "Class": "flex flex-1 flex-col gap-2"
              },
              "children": [
                {
                  "when": {
                    "op": "ne",
                    "args": [
                      {
                        "$": "meta"
                      },
                      "news"
                    ]
                  },
                  "then": [
                    {
                      "use": "Group",
                      "props": {
                        "Gap": "2",
                        "Align": "center"
                      },
                      "children": [
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": {
                              "$": "post.icon"
                            },
                            "Size": 16
                          }
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "uppercase tracking-wide text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "post.category"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "Title",
                  "props": {
                    "As": 3,
                    "Size": "xl",
                    "Weight": "bold"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "post.title"
                      }
                    }
                  ]
                },
                {
                  "when": {
                    "op": "and",
                    "args": [
                      {
                        "op": "eq",
                        "args": [
                          {
                            "$": "density"
                          },
                          "default"
                        ]
                      },
                      {
                        "op": "ne",
                        "args": [
                          {
                            "$": "meta"
                          },
                          "news"
                        ]
                      }
                    ]
                  },
                  "then": [
                    {
                      "use": "Text",
                      "props": {
                        "Size": "sm",
                        "Class": "text-muted-foreground"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "post.excerpt"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "when": {
                    "op": "ne",
                    "args": [
                      {
                        "$": "meta"
                      },
                      "news"
                    ]
                  },
                  "then": [
                    {
                      "use": "Group",
                      "props": {
                        "Gap": "2",
                        "Class": "mt-auto flex-wrap pt-2 text-muted-foreground"
                      },
                      "children": [
                        {
                          "when": {
                            "op": "eq",
                            "args": [
                              {
                                "$": "meta"
                              },
                              "full"
                            ]
                          },
                          "then": [
                            {
                              "use": "Text",
                              "props": {
                                "Size": "xs"
                              },
                              "children": [
                                {
                                  "text": {
                                    "op": "tpl",
                                    "args": [
                                      {
                                        "$": "labels.by"
                                      },
                                      {
                                        "$": "post.author"
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "post.date"
                              }
                            }
                          ]
                        },
                        {
                          "when": {
                            "op": "eq",
                            "args": [
                              {
                                "$": "meta"
                              },
                              "full"
                            ]
                          },
                          "then": [
                            {
                              "use": "Text",
                              "props": {
                                "Size": "xs"
                              },
                              "children": [
                                {
                                  "text": {
                                    "op": "tpl",
                                    "args": [
                                      {
                                        "$": "labels.minutes"
                                      },
                                      {
                                        "$": "post.minutes"
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "when": {
                    "op": "and",
                    "args": [
                      {
                        "op": "ne",
                        "args": [
                          {
                            "$": "meta"
                          },
                          "news"
                        ]
                      },
                      {
                        "$": "post.href"
                      }
                    ]
                  },
                  "then": [
                    {
                      "use": "Link",
                      "props": {
                        "Href": {
                          "$": "post.href"
                        },
                        "Variant": "default"
                      },
                      "attrs": {
                        "data-testid": "read"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "labels.read"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
