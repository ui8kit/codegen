{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.job-board",
  "name": "JobBoard",
  "docs": "Open jobs as cards in two columns, grouped by department, or as a table: the title, the department, the place, the type, an optional salary and an apply link. Axes: layout (grid, grouped, table), salary (show, hide), tone.",
  "records": {
    "Job": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "dept",
        "type": "string"
      },
      {
        "name": "location",
        "type": "string"
      },
      {
        "name": "type",
        "type": "string"
      },
      {
        "name": "salary",
        "type": "string"
      },
      {
        "name": "posted",
        "type": "string"
      },
      {
        "name": "href",
        "type": "string",
        "optional": true
      }
    ],
    "Department": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      }
    ],
    "JobLabels": [
      {
        "name": "apply",
        "type": "string"
      },
      {
        "name": "caption",
        "type": "string"
      },
      {
        "name": "role",
        "type": "string"
      },
      {
        "name": "team",
        "type": "string"
      },
      {
        "name": "location",
        "type": "string"
      },
      {
        "name": "type",
        "type": "string"
      },
      {
        "name": "salary",
        "type": "string"
      },
      {
        "name": "count",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "jobs",
      "type": {
        "ts": "Job[]"
      },
      "required": true
    },
    {
      "name": "departments",
      "type": {
        "ts": "Department[]"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "record": "JobLabels"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"grid\" | \"grouped\" | \"table\""
      },
      "default": "grid"
    },
    {
      "name": "salary",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "hide"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "measure": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "layout"
                },
                "grouped"
              ]
            },
            "3xl",
            "default"
          ]
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "jobs"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "briefcase",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "grouped"
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "8",
                        "Align": "stretch"
                      },
                      "attrs": {
                        "data-testid": "groups"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "departments"
                          },
                          "as": "d",
                          "key": {
                            "$": "d.id"
                          },
                          "do": [
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "2",
                                "Align": "stretch"
                              },
                              "attrs": {
                                "data-testid": "group"
                              },
                              "children": [
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "4",
                                    "Align": "baseline",
                                    "Justify": "between"
                                  },
                                  "children": [
                                    {
                                      "use": "Title",
                                      "props": {
                                        "As": 3,
                                        "Size": "lg",
                                        "Weight": "bold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "d.name"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "xs",
                                        "Class": "text-muted-foreground"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "op": "tpl",
                                            "args": [
                                              {
                                                "$": "labels.count"
                                              },
                                              {
                                                "op": "len",
                                                "args": [
                                                  {
                                                    "op": "where",
                                                    "args": [
                                                      {
                                                        "$": "jobs"
                                                      },
                                                      "dept",
                                                      {
                                                        "$": "d.id"
                                                      }
                                                    ]
                                                  }
                                                ]
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "List",
                                  "props": {
                                    "Tag": "ul",
                                    "Class": "flex flex-col"
                                  },
                                  "children": [
                                    {
                                      "each": {
                                        "op": "where",
                                        "args": [
                                          {
                                            "$": "jobs"
                                          },
                                          "dept",
                                          {
                                            "$": "d.id"
                                          }
                                        ]
                                      },
                                      "as": "j",
                                      "key": {
                                        "$": "j.id"
                                      },
                                      "do": [
                                        {
                                          "use": "ListItem",
                                          "props": {
                                            "Class": "flex flex-wrap items-center justify-between gap-4 border-b border-border py-4"
                                          },
                                          "attrs": {
                                            "data-testid": "item"
                                          },
                                          "children": [
                                            {
                                              "use": "Stack",
                                              "props": {
                                                "Gap": "0"
                                              },
                                              "children": [
                                                {
                                                  "organism": "MenuEntry",
                                                  "props": {
                                                    "href": {
                                                      "$": "j.href"
                                                    },
                                                    "className": "font-medium"
                                                  },
                                                  "slots": {
                                                    "children": {
                                                      "args": [],
                                                      "do": [
                                                        {
                                                          "text": {
                                                            "$": "j.title"
                                                          }
                                                        }
                                                      ]
                                                    }
                                                  }
                                                },
                                                {
                                                  "use": "Text",
                                                  "props": {
                                                    "Size": "xs",
                                                    "Class": "text-muted-foreground"
                                                  },
                                                  "children": [
                                                    {
                                                      "text": {
                                                        "op": "tpl",
                                                        "args": [
                                                          "{0}, {1}",
                                                          {
                                                            "$": "j.location"
                                                          },
                                                          {
                                                            "$": "j.type"
                                                          }
                                                        ]
                                                      }
                                                    }
                                                  ]
                                                }
                                              ]
                                            },
                                            {
                                              "use": "Badge",
                                              "props": {
                                                "Variant": "outline",
                                                "Size": "default"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "j.type"
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "organism": "JobCards",
                      "props": {
                        "jobs": {
                          "$": "jobs"
                        },
                        "departments": {
                          "$": "departments"
                        },
                        "labels": {
                          "$": "labels"
                        },
                        "layout": {
                          "$": "layout"
                        },
                        "salary": {
                          "$": "salary"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
