{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.order-table",
  "name": "OrderTable",
  "docs": "The order history as a table or as cards: number, date, items, total and a status pill, with an optional pager. Axes: layout (table, cards), pager (show, hide), tone, density.",
  "records": {
    "Order": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "number",
        "type": "string"
      },
      {
        "name": "date",
        "type": "string"
      },
      {
        "name": "total",
        "type": "number"
      },
      {
        "name": "currency",
        "type": "string"
      },
      {
        "name": "status",
        "type": "string"
      },
      {
        "name": "items",
        "type": "number"
      }
    ],
    "OrderLabels": [
      {
        "name": "caption",
        "type": "string"
      },
      {
        "name": "number",
        "type": "string"
      },
      {
        "name": "date",
        "type": "string"
      },
      {
        "name": "items",
        "type": "string"
      },
      {
        "name": "total",
        "type": "string"
      },
      {
        "name": "status",
        "type": "string"
      },
      {
        "name": "itemsCount",
        "type": "string"
      },
      {
        "name": "summary",
        "type": "string"
      },
      {
        "name": "previous",
        "type": "string"
      },
      {
        "name": "next",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "orders",
      "type": {
        "ts": "Order[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "statuses",
      "type": {
        "ts": "Record<string, string>"
      },
      "required": true,
      "docs": "word by order status"
    },
    {
      "name": "labels",
      "type": {
        "record": "OrderLabels"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"table\" | \"cards\""
      },
      "default": "table"
    },
    {
      "name": "pager",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "orders"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "package",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Align": "stretch"
                  },
                  "children": [
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "layout"
                          },
                          "table"
                        ]
                      },
                      "then": [
                        {
                          "organism": "OrderRows",
                          "props": {
                            "orders": {
                              "$": "orders"
                            },
                            "statuses": {
                              "$": "statuses"
                            },
                            "labels": {
                              "$": "labels"
                            },
                            "density": {
                              "$": "density"
                            }
                          }
                        }
                      ],
                      "else": [
                        {
                          "use": "Stack",
                          "props": {
                            "Gap": "4",
                            "Align": "stretch"
                          },
                          "attrs": {
                            "data-testid": "order-cards"
                          },
                          "children": [
                            {
                              "each": {
                                "$": "orders"
                              },
                              "as": "o",
                              "key": {
                                "$": "o.id"
                              },
                              "do": [
                                {
                                  "use": "Card",
                                  "props": {
                                    "Variant": "default"
                                  },
                                  "attrs": {
                                    "data-testid": "item"
                                  },
                                  "children": [
                                    {
                                      "use": "CardContent",
                                      "props": {
                                        "Class": "flex flex-wrap items-center justify-between gap-4"
                                      },
                                      "children": [
                                        {
                                          "use": "Stack",
                                          "props": {
                                            "Gap": "0"
                                          },
                                          "children": [
                                            {
                                              "use": "Text",
                                              "props": {
                                                "Size": "sm",
                                                "Weight": "semibold"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "o.number"
                                                  }
                                                }
                                              ]
                                            },
                                            {
                                              "use": "Text",
                                              "props": {
                                                "Size": "xs",
                                                "Class": "text-muted-foreground"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "o.date"
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "sm"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "op": "tpl",
                                                "args": [
                                                  {
                                                    "$": "labels.itemsCount"
                                                  },
                                                  {
                                                    "$": "o.items"
                                                  }
                                                ]
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "sm",
                                            "Weight": "bold"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "op": "money",
                                                "args": [
                                                  {
                                                    "$": "o.total"
                                                  },
                                                  {
                                                    "$": "o.currency"
                                                  }
                                                ]
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "organism": "Pill",
                                          "props": {
                                            "tone": {
                                              "op": "cond",
                                              "args": [
                                                {
                                                  "op": "eq",
                                                  "args": [
                                                    {
                                                      "$": "o.status"
                                                    },
                                                    "paid"
                                                  ]
                                                },
                                                "green",
                                                {
                                                  "op": "cond",
                                                  "args": [
                                                    {
                                                      "op": "eq",
                                                      "args": [
                                                        {
                                                          "$": "o.status"
                                                        },
                                                        "shipped"
                                                      ]
                                                    },
                                                    "blue",
                                                    {
                                                      "op": "cond",
                                                      "args": [
                                                        {
                                                          "op": "eq",
                                                          "args": [
                                                            {
                                                              "$": "o.status"
                                                            },
                                                            "pending"
                                                          ]
                                                        },
                                                        "amber",
                                                        "gray"
                                                      ]
                                                    }
                                                  ]
                                                }
                                              ]
                                            }
                                          },
                                          "slots": {
                                            "children": {
                                              "args": [],
                                              "do": [
                                                {
                                                  "text": {
                                                    "op": "at",
                                                    "args": [
                                                      {
                                                        "$": "statuses"
                                                      },
                                                      {
                                                        "$": "o.status"
                                                      }
                                                    ]
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "pager"
                          },
                          "show"
                        ]
                      },
                      "then": [
                        {
                          "organism": "Pager",
                          "props": {
                            "page": 1,
                            "pages": 3,
                            "summary": {
                              "op": "tpl",
                              "args": [
                                {
                                  "$": "labels.summary"
                                },
                                1,
                                4,
                                12
                              ]
                            },
                            "previousLabel": {
                              "$": "labels.previous"
                            },
                            "nextLabel": {
                              "$": "labels.next"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
