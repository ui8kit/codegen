{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.member-row",
  "name": "MemberRow",
  "docs": "One member of TeamGrid beside a small portrait: the name, the role, then the department and the place (detailed, directory), the bio (detailed) and the skills (detailed, list).",
  "records": {},
  "props": [
    {
      "name": "member",
      "type": {
        "ts": "Member"
      },
      "required": true
    },
    {
      "name": "depts",
      "type": {
        "ts": "Record<string, string>"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"cards\" | \"minimal\" | \"detailed\" | \"list\" | \"directory\""
      },
      "default": "list",
      "docs": "the TeamGrid layout; cards and minimal draw as a list row"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Group",
      "props": {
        "Gap": "4",
        "Align": "start",
        "Class": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "layout"
                },
                "detailed"
              ]
            },
            "rounded bg-card inset-ring inset-ring-border flex-col p-6",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "layout"
                    },
                    "directory"
                  ]
                },
                "rounded bg-card inset-ring inset-ring-border p-4",
                "border-b border-border pb-4"
              ]
            }
          ]
        }
      },
      "attrs": {
        "data-testid": "item"
      },
      "children": [
        {
          "organism": "MediaFrame",
          "props": {
            "alt": {
              "$": "member.name"
            },
            "ratio": "1/1",
            "className": {
              "op": "cn",
              "args": [
                {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "layout"
                        },
                        "detailed"
                      ]
                    },
                    "size-16",
                    "size-12"
                  ]
                },
                "shrink-0"
              ]
            }
          }
        },
        {
          "use": "Stack",
          "props": {
            "Gap": "2",
            "Class": "min-w-0 flex-1"
          },
          "children": [
            {
              "use": "Stack",
              "props": {
                "Gap": "0"
              },
              "children": [
                {
                  "use": "Text",
                  "props": {
                    "Size": "base",
                    "Weight": "semibold"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "member.name"
                      }
                    }
                  ]
                },
                {
                  "use": "Text",
                  "props": {
                    "Size": "sm",
                    "Class": "text-muted-foreground"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "member.role"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "ne",
                "args": [
                  {
                    "$": "layout"
                  },
                  "list"
                ]
              },
              "then": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "2",
                    "Align": "center",
                    "Class": "flex-wrap text-xs text-muted-foreground"
                  },
                  "children": [
                    {
                      "use": "Badge",
                      "props": {
                        "Variant": "outline",
                        "Size": "sm"
                      },
                      "children": [
                        {
                          "text": {
                            "op": "at",
                            "args": [
                              {
                                "$": "depts"
                              },
                              {
                                "$": "member.dept"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "use": "LucideIcon",
                      "props": {
                        "Name": "map-pin",
                        "Size": 16
                      }
                    },
                    {
                      "use": "Inline",
                      "children": [
                        {
                          "text": {
                            "$": "member.location"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "detailed"
                ]
              },
              "then": [
                {
                  "use": "Text",
                  "props": {
                    "Size": "sm",
                    "Class": "text-muted-foreground"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "member.bio"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "ne",
                "args": [
                  {
                    "$": "layout"
                  },
                  "directory"
                ]
              },
              "then": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "2",
                    "Class": "flex-wrap"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "member.skills"
                      },
                      "as": "k",
                      "key": {
                        "$": "k"
                      },
                      "do": [
                        {
                          "use": "Badge",
                          "props": {
                            "Variant": "secondary",
                            "Size": "sm"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "k"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "TeamGrid",
      "names": [
        "Member"
      ]
    }
  ]
}
