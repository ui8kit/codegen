{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.post-grid",
  "name": "PostGrid",
  "docs": "A section with a heading and the posts as cards: a grid, a list of horizontal cards, or a magazine (the first post wide, the rest in a grid). Axes: layout (grid, list, magazine), columns, media, meta (full, short, news), filter mode (none, topics), tone, density.",
  "records": {
    "PostTopic": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "value",
        "type": "string"
      }
    ],
    "PostFilter": [
      {
        "name": "mode",
        "type": "\"none\" | \"topics\"",
        "optional": true,
        "docs": "topics: tabs above the posts; the page filters by `topic`",
        "default": "none"
      },
      {
        "name": "topics",
        "type": "PostTopic[]",
        "optional": true,
        "docs": "the topic tabs"
      },
      {
        "name": "label",
        "type": "string",
        "optional": true,
        "docs": "accessible name of the topic tabs"
      },
      {
        "name": "topic",
        "type": "string",
        "optional": true,
        "docs": "the value of the chosen topic; empty: all posts"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "posts",
      "type": {
        "ts": "Post[]"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "PostLabels"
      },
      "required": true
    },
    {
      "name": "action",
      "type": {
        "ts": "HeadLink"
      },
      "docs": "optional link opposite the heading (All posts)"
    },
    {
      "name": "filter",
      "type": {
        "record": "PostFilter"
      },
      "docs": "the topic tabs and the chosen topic"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"grid\" | \"list\" | \"magazine\""
      },
      "default": "grid"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"1-2\" | \"1-3\" | \"1-4\""
      },
      "default": "1-3"
    },
    {
      "name": "media",
      "type": {
        "ts": "\"image\" | \"none\""
      },
      "default": "image"
    },
    {
      "name": "meta",
      "type": {
        "ts": "\"full\" | \"short\" | \"news\""
      },
      "default": "full"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "topic",
      "args": [
        {
          "name": "value",
          "type": "string"
        }
      ],
      "docs": "a topic tab was chosen"
    }
  ],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "action": {
          "$": "action"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "density"
                },
                "compact"
              ]
            },
            "compact",
            "default"
          ]
        },
        "measure": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "meta"
                },
                "news"
              ]
            },
            "fill",
            "default"
          ]
        },
        "className": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "meta"
                },
                "news"
              ]
            },
            "py-0",
            ""
          ]
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "filter.mode"
                  },
                  "topics"
                ]
              },
              "then": [
                {
                  "organism": "Switcher",
                  "props": {
                    "label": {
                      "$": "filter.label"
                    }
                  },
                  "slots": {
                    "children": {
                      "args": [],
                      "do": [
                        {
                          "each": {
                            "$": "filter.topics"
                          },
                          "as": "tab",
                          "key": {
                            "$": "tab.id"
                          },
                          "do": [
                            {
                              "organism": "SwitcherItem",
                              "props": {
                                "active": {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "tab.value"
                                    },
                                    {
                                      "$": "filter.topic"
                                    }
                                  ]
                                }
                              },
                              "on": {
                                "click": {
                                  "call": "emit.topic",
                                  "args": [
                                    {
                                      "$": "tab.value"
                                    }
                                  ]
                                }
                              },
                              "slots": {
                                "children": {
                                  "args": [],
                                  "do": [
                                    {
                                      "text": {
                                        "$": "tab.title"
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "when": {
                "op": "gt",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "op": "where",
                        "args": [
                          {
                            "$": "posts"
                          },
                          "category",
                          {
                            "$": "filter.topic"
                          }
                        ]
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "magazine"
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "6",
                        "Align": "stretch"
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "op": "where",
                            "args": [
                              {
                                "$": "posts"
                              },
                              "category",
                              {
                                "$": "filter.topic"
                              }
                            ]
                          },
                          "as": "p",
                          "key": {
                            "$": "p.id"
                          },
                          "do": [
                            {
                              "when": {
                                "op": "eq",
                                "args": [
                                  {
                                    "$": "i"
                                  },
                                  0
                                ]
                              },
                              "then": [
                                {
                                  "organism": "PostCard",
                                  "props": {
                                    "post": {
                                      "$": "p"
                                    },
                                    "labels": {
                                      "$": "labels"
                                    },
                                    "layout": "horizontal",
                                    "media": {
                                      "$": "media"
                                    },
                                    "meta": {
                                      "$": "meta"
                                    },
                                    "density": {
                                      "$": "density"
                                    }
                                  }
                                }
                              ]
                            }
                          ],
                          "index": "i"
                        },
                        {
                          "use": "Grid",
                          "props": {
                            "Cols": {
                              "$": "cols"
                            },
                            "Class": "gap-6"
                          },
                          "children": [
                            {
                              "each": {
                                "op": "where",
                                "args": [
                                  {
                                    "$": "posts"
                                  },
                                  "category",
                                  {
                                    "$": "filter.topic"
                                  }
                                ]
                              },
                              "as": "p",
                              "key": {
                                "$": "p.id"
                              },
                              "do": [
                                {
                                  "when": {
                                    "op": "gt",
                                    "args": [
                                      {
                                        "$": "i"
                                      },
                                      0
                                    ]
                                  },
                                  "then": [
                                    {
                                      "organism": "PostCard",
                                      "props": {
                                        "post": {
                                          "$": "p"
                                        },
                                        "labels": {
                                          "$": "labels"
                                        },
                                        "media": {
                                          "$": "media"
                                        },
                                        "meta": {
                                          "$": "meta"
                                        },
                                        "density": {
                                          "$": "density"
                                        }
                                      }
                                    }
                                  ]
                                }
                              ],
                              "index": "i"
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "list"
                              ]
                            },
                            "1",
                            {
                              "op": "fitCols",
                              "args": [
                                {
                                  "$": "cols"
                                },
                                {
                                  "op": "len",
                                  "args": [
                                    {
                                      "op": "where",
                                      "args": [
                                        {
                                          "$": "posts"
                                        },
                                        "category",
                                        {
                                          "$": "filter.topic"
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        "Class": "w-full gap-6"
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "op": "where",
                            "args": [
                              {
                                "$": "posts"
                              },
                              "category",
                              {
                                "$": "filter.topic"
                              }
                            ]
                          },
                          "as": "p",
                          "key": {
                            "$": "p.id"
                          },
                          "do": [
                            {
                              "organism": "PostCard",
                              "props": {
                                "post": {
                                  "$": "p"
                                },
                                "labels": {
                                  "$": "labels"
                                },
                                "layout": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "layout"
                                        },
                                        "list"
                                      ]
                                    },
                                    "horizontal",
                                    "vertical"
                                  ]
                                },
                                "media": {
                                  "$": "media"
                                },
                                "meta": {
                                  "$": "meta"
                                },
                                "density": {
                                  "$": "density"
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "PostCard",
      "names": [
        "Post",
        "PostLabels"
      ]
    },
    {
      "from": "SectionFrame",
      "names": [
        "HeadLink"
      ]
    }
  ]
}
