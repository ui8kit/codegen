{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.stats-band",
  "name": "StatsBand",
  "docs": "Key numbers in a row or grid: plain figures, cards (StatTile) or figures with an icon. Axes: columns (2, 3, 4), item (plain, card, icon), surface (none, image, panel: one rounded card), align, density, tone. Title may be empty.",
  "records": {
    "Stat": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "label",
        "type": "string"
      },
      {
        "name": "value",
        "type": "string"
      },
      {
        "name": "icon",
        "type": "string"
      },
      {
        "name": "hint",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "default": ""
    },
    {
      "name": "stats",
      "type": {
        "ts": "Stat[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no figures), from the dictionary"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"2\" | \"3\" | \"4\""
      },
      "default": "4"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"row\" | \"stack\""
      },
      "default": "row",
      "docs": "stack: one narrow column of figures, for a sidebar"
    },
    {
      "name": "surface",
      "type": {
        "ts": "\"none\" | \"image\" | \"panel\""
      },
      "default": "none",
      "docs": "image: picture behind; panel: one rounded card"
    },
    {
      "name": "item",
      "type": {
        "ts": "\"plain\" | \"card\" | \"icon\""
      },
      "default": "plain"
    },
    {
      "name": "align",
      "type": {
        "ts": "\"start\" | \"center\""
      },
      "default": "center"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"roomy\" | \"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "align": {
          "$": "align"
        },
        "measure": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "surface"
                },
                "panel"
              ]
            },
            "fill",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "layout"
                    },
                    "stack"
                  ]
                },
                "xs",
                "default"
              ]
            }
          ]
        },
        "className": {
          "op": "cn",
          "args": [
            {
              "op": "cn",
              "args": [
                {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "surface"
                        },
                        "image"
                      ]
                    },
                    "bg-transparent",
                    ""
                  ]
                },
                {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "surface"
                        },
                        "panel"
                      ]
                    },
                    "py-0",
                    ""
                  ]
                }
              ]
            },
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "surface"
                            },
                            "image"
                          ]
                        },
                        "image",
                        "none"
                      ]
                    },
                    "image"
                  ]
                },
                "relative isolate overflow-hidden",
                ""
              ]
            }
          ]
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "organism": "Backdrop",
              "props": {
                "kind": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "surface"
                        },
                        "image"
                      ]
                    },
                    "image",
                    "none"
                  ]
                },
                "alt": {
                  "$": "title"
                }
              }
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "stats"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "chart-column",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "surface"
                      },
                      "panel"
                    ]
                  },
                  "then": [
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "cols"
                                },
                                "2"
                              ]
                            },
                            "2",
                            {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "cols"
                                    },
                                    "3"
                                  ]
                                },
                                "2-3",
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "cols"
                                        },
                                        "4"
                                      ]
                                    },
                                    "2-4",
                                    "3-6"
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        "Class": {
                          "op": "cn",
                          "args": [
                            "w-full items-center bg-muted px-6",
                            {
                              "op": "preset",
                              "args": [
                                "defaults",
                                "stats.panel"
                              ]
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "stats"
                          },
                          "as": "stat",
                          "key": {
                            "$": "stat.id"
                          },
                          "do": [
                            {
                              "organism": "StatFigure",
                              "props": {
                                "stat": {
                                  "$": "stat"
                                },
                                "item": {
                                  "$": "item"
                                },
                                "align": {
                                  "$": "align"
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "stack"
                              ]
                            },
                            "1",
                            {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "cols"
                                    },
                                    "2"
                                  ]
                                },
                                "2",
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "cols"
                                        },
                                        "3"
                                      ]
                                    },
                                    "2-3",
                                    {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "cols"
                                            },
                                            "4"
                                          ]
                                        },
                                        "2-4",
                                        "3-6"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        "Class": "gap-6"
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "stats"
                          },
                          "as": "stat",
                          "key": {
                            "$": "stat.id"
                          },
                          "do": [
                            {
                              "organism": "StatFigure",
                              "props": {
                                "stat": {
                                  "$": "stat"
                                },
                                "item": {
                                  "$": "item"
                                },
                                "align": {
                                  "$": "align"
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
