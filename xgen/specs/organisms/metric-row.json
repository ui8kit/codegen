{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.metric-row",
  "name": "MetricRow",
  "docs": "Dashboard counters in a row or a grid: tiles with an icon, a number and a caption, or compact figures. Axes: columns (2, 4), item (tile, compact), tone (default, muted), density (default, compact).",
  "records": {
    "Metric": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "label",
        "type": "string"
      },
      {
        "name": "value",
        "type": "string"
      },
      {
        "name": "icon",
        "type": "string"
      },
      {
        "name": "hint",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "metrics",
      "type": {
        "ts": "Metric[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"2\" | \"4\""
      },
      "default": "4"
    },
    {
      "name": "item",
      "type": {
        "ts": "\"tile\" | \"compact\""
      },
      "default": "tile"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "metrics"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "gauge",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Grid",
                  "props": {
                    "Cols": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "cols"
                            },
                            "2"
                          ]
                        },
                        "1-2",
                        "1-4"
                      ]
                    },
                    "Class": "gap-4"
                  },
                  "attrs": {
                    "data-testid": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "metrics"
                      },
                      "as": "m",
                      "key": {
                        "$": "m.id"
                      },
                      "do": [
                        {
                          "when": {
                            "op": "eq",
                            "args": [
                              {
                                "$": "item"
                              },
                              "tile"
                            ]
                          },
                          "then": [
                            {
                              "use": "Box",
                              "props": {},
                              "attrs": {
                                "data-testid": "item"
                              },
                              "children": [
                                {
                                  "organism": "StatTile",
                                  "props": {
                                    "label": {
                                      "$": "m.label"
                                    },
                                    "value": {
                                      "$": "m.value"
                                    },
                                    "icon": {
                                      "$": "m.icon"
                                    },
                                    "hint": {
                                      "$": "m.hint"
                                    }
                                  }
                                }
                              ]
                            }
                          ],
                          "else": [
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "0",
                                "Class": "rounded bg-card p-4 inset-ring inset-ring-border"
                              },
                              "attrs": {
                                "data-testid": "item"
                              },
                              "children": [
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "2",
                                    "Align": "center",
                                    "Class": "text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "use": "LucideIcon",
                                      "props": {
                                        "Name": {
                                          "$": "m.icon"
                                        },
                                        "Size": 16
                                      }
                                    },
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "xs"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "m.label"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "2xl",
                                    "Weight": "bold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "m.value"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "xs",
                                    "Class": "text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "m.hint"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
