{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.feature-rows",
  "name": "FeatureRows",
  "docs": "The features as rows: text beside a picture (the rows layout of FeatureGrid). Icons are Lucide names.",
  "records": {},
  "props": [
    {
      "name": "features",
      "type": {
        "ts": "Feature[]"
      },
      "required": true
    },
    {
      "name": "mediaSide",
      "type": {
        "ts": "\"end\" | \"start\" | \"alternate\""
      },
      "default": "end",
      "docs": "side of the picture; alternate swaps it every row"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Stack",
      "props": {
        "Gap": "8",
        "Align": "stretch"
      },
      "attrs": {
        "data-testid": "feature-rows"
      },
      "children": [
        {
          "each": {
            "$": "features"
          },
          "as": "feature",
          "key": {
            "$": "feature.id"
          },
          "do": [
            {
              "use": "Grid",
              "props": {
                "Cols": "1-2",
                "Class": "group items-center gap-8"
              },
              "attrs": {
                "data-testid": "feature-card"
              },
              "children": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "2",
                    "Class": "min-w-0"
                  },
                  "children": [
                    {
                      "use": "LucideIcon",
                      "props": {
                        "Name": {
                          "$": "feature.icon"
                        },
                        "Size": 24
                      }
                    },
                    {
                      "use": "Title",
                      "props": {
                        "As": 3,
                        "Size": "xl",
                        "Weight": "bold"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "feature.title"
                          }
                        }
                      ]
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "base",
                        "Class": "text-muted-foreground"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "feature.text"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "Box",
                  "props": {
                    "Class": {
                      "op": "cn",
                      "args": [
                        "w-full min-w-0",
                        {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "mediaSide"
                                },
                                "start"
                              ]
                            },
                            "md:order-first",
                            {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "mediaSide"
                                    },
                                    "alternate"
                                  ]
                                },
                                "md:group-even:order-first",
                                ""
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "organism": "MediaFrame",
                      "props": {
                        "alt": {
                          "$": "feature.title"
                        },
                        "ratio": "4/3"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "FeatureGrid",
      "names": [
        "Feature"
      ]
    }
  ]
}
