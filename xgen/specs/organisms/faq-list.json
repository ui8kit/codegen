{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.faq-list",
  "name": "FaqList",
  "docs": "A section with a heading and the questions. Axes: layout (accordion: native disclosures that open without script; chat: question and answer as alternating bubbles), columns (1, 2), search mode (none, field: a search field above; the page filters by `search.query`), filter mode (none, categories: tabs above; the page filters by `filter.category`), density, tone.",
  "records": {
    "Faq": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "question",
        "type": "string"
      },
      {
        "name": "answer",
        "type": "string"
      },
      {
        "name": "category",
        "type": "string",
        "optional": true
      }
    ],
    "FaqTab": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "value",
        "type": "string"
      }
    ],
    "FaqSearch": [
      {
        "name": "mode",
        "type": "\"none\" | \"field\"",
        "optional": true,
        "docs": "field: a search field above the questions",
        "default": "none"
      },
      {
        "name": "label",
        "type": "string",
        "optional": true,
        "docs": "accessible name and placeholder of the search field"
      },
      {
        "name": "query",
        "type": "string",
        "optional": true,
        "docs": "the text the questions are filtered by"
      }
    ],
    "FaqFilter": [
      {
        "name": "mode",
        "type": "\"none\" | \"categories\"",
        "optional": true,
        "docs": "categories: tabs above the questions",
        "default": "none"
      },
      {
        "name": "tabs",
        "type": "FaqTab[]",
        "optional": true,
        "docs": "the category tabs"
      },
      {
        "name": "label",
        "type": "string",
        "optional": true,
        "docs": "accessible name of the tabs"
      },
      {
        "name": "category",
        "type": "string",
        "optional": true,
        "docs": "the value of the chosen tab"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "items",
      "type": {
        "ts": "Faq[]"
      },
      "required": true
    },
    {
      "name": "search",
      "type": {
        "record": "FaqSearch"
      },
      "docs": "the search field and its text"
    },
    {
      "name": "filter",
      "type": {
        "record": "FaqFilter"
      },
      "docs": "the category tabs and the chosen one"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"accordion\" | \"chat\""
      },
      "default": "accordion"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"1\" | \"2\""
      },
      "default": "1"
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no question, or none matches the search or tab), from the dictionary"
    },
    {
      "name": "multiple",
      "type": "boolean",
      "default": false,
      "docs": "true: several can be open at once; false: opening one closes the others (native details name)"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"roomy\" | \"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "derived": [
    {
      "name": "inCategory",
      "value": {
        "op": "where",
        "args": [
          {
            "$": "items"
          },
          "category",
          {
            "$": "filter.category"
          }
        ]
      }
    },
    {
      "name": "shown",
      "value": {
        "op": "match",
        "args": [
          {
            "$": "inCategory"
          },
          "question",
          {
            "$": "search.query"
          }
        ]
      }
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "query",
      "args": [
        {
          "name": "text",
          "type": "string"
        }
      ],
      "docs": "the search text changed"
    },
    {
      "name": "category",
      "args": [
        {
          "name": "value",
          "type": "string"
        }
      ],
      "docs": "a category tab was chosen"
    }
  ],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "measure": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "layout"
                },
                "chat"
              ]
            },
            "2xl",
            "default"
          ]
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "search.mode"
                  },
                  "field"
                ]
              },
              "then": [
                {
                  "organism": "SearchField",
                  "props": {
                    "label": {
                      "op": "coalesce",
                      "args": [
                        {
                          "$": "search.label"
                        },
                        ""
                      ]
                    },
                    "placeholder": {
                      "$": "search.label"
                    },
                    "value": {
                      "op": "coalesce",
                      "args": [
                        {
                          "$": "search.query"
                        },
                        ""
                      ]
                    }
                  },
                  "on": {
                    "value": {
                      "call": "emit.query",
                      "args": [
                        {
                          "$": "arg"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "filter.mode"
                  },
                  "categories"
                ]
              },
              "then": [
                {
                  "organism": "Switcher",
                  "props": {
                    "label": {
                      "$": "filter.label"
                    }
                  },
                  "slots": {
                    "children": {
                      "args": [],
                      "do": [
                        {
                          "each": {
                            "$": "filter.tabs"
                          },
                          "as": "tab",
                          "key": {
                            "$": "tab.id"
                          },
                          "do": [
                            {
                              "organism": "SwitcherItem",
                              "props": {
                                "active": {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "tab.value"
                                    },
                                    {
                                      "$": "filter.category"
                                    }
                                  ]
                                }
                              },
                              "on": {
                                "click": {
                                  "call": "emit.category",
                                  "args": [
                                    {
                                      "$": "tab.value"
                                    }
                                  ]
                                }
                              },
                              "slots": {
                                "children": {
                                  "args": [],
                                  "do": [
                                    {
                                      "text": {
                                        "$": "tab.title"
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "shown"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "circle-question-mark",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "chat"
                ]
              },
              "then": [
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Align": "stretch"
                  },
                  "attrs": {
                    "data-testid": "faq"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "shown"
                      },
                      "as": "item",
                      "key": {
                        "$": "item.id"
                      },
                      "do": [
                        {
                          "use": "Stack",
                          "props": {
                            "Gap": "2",
                            "Align": "stretch"
                          },
                          "attrs": {
                            "data-testid": "faq-item"
                          },
                          "children": [
                            {
                              "use": "Box",
                              "props": {
                                "Class": "ml-auto max-w-xs sm:max-w-md rounded bg-primary px-4 py-4 text-primary-foreground"
                              },
                              "children": [
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Weight": "semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "item.question"
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "use": "Box",
                              "props": {
                                "Class": "mr-auto max-w-xs sm:max-w-md rounded bg-muted px-4 py-4"
                              },
                              "children": [
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "item.answer"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "else": [
                {
                  "use": "Grid",
                  "props": {
                    "Cols": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "cols"
                            },
                            "2"
                          ]
                        },
                        "1-2",
                        "1"
                      ]
                    },
                    "Class": "items-start gap-x-8"
                  },
                  "attrs": {
                    "data-testid": "faq"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "shown"
                      },
                      "as": "item",
                      "key": {
                        "$": "item.id"
                      },
                      "do": [
                        {
                          "use": "Disclosure",
                          "props": {
                            "Variant": "item",
                            "Name": {
                              "op": "cond",
                              "args": [
                                {
                                  "$": "multiple"
                                },
                                {
                                  "op": "undef",
                                  "args": []
                                },
                                {
                                  "op": "tpl",
                                  "args": [
                                    "{0}-faq",
                                    {
                                      "op": "coalesce",
                                      "args": [
                                        {
                                          "$": "id"
                                        },
                                        "faq"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          },
                          "attrs": {
                            "data-testid": "faq-item"
                          },
                          "children": [
                            {
                              "use": "Summary",
                              "props": {
                                "Variant": "item"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "item.question"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "sm",
                                "Class": "pb-4 text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "item.answer"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
