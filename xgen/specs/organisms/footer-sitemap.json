{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.footer-sitemap",
  "name": "FooterSitemap",
  "docs": "The sitemap link of FooterSplit: an arrow and the word, only where the app gives the address (no address, no link).",
  "records": {},
  "props": [
    {
      "name": "href",
      "type": "string",
      "docs": "the address of the sitemap; none: nothing"
    },
    {
      "name": "label",
      "type": "string",
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "$": "href"
      },
      "then": [
        {
          "use": "Link",
          "props": {
            "Href": {
              "$": "href"
            },
            "Size": "sm"
          },
          "attrs": {
            "data-testid": "footer-sitemap"
          },
          "children": [
            {
              "use": "LucideIcon",
              "props": {
                "Name": "arrow-right",
                "Size": 16
              }
            },
            {
              "text": {
                "$": "label"
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
