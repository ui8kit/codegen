{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.weighted-title",
  "name": "WeightedTitle",
  "docs": "A display title, one span per word; word i takes weights[i] (from the preset). The words wrap like text.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "docs": "id of the heading (the band is labelled by it)"
    },
    {
      "name": "title",
      "type": "string",
      "required": true,
      "docs": "the words, separated by spaces"
    },
    {
      "name": "weights",
      "type": {
        "ts": "readonly string[]"
      },
      "docs": "a font-weight class per word"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2"
      },
      "default": 1
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Title",
      "props": {
        "As": {
          "$": "level"
        },
        "Size": "5xl",
        "Weight": "semibold",
        "Class": {
          "op": "cn",
          "args": [
            "text-center tracking-tight text-background",
            {
              "op": "preset",
              "args": [
                "defaults",
                "hero.title"
              ]
            }
          ]
        }
      },
      "attrs": {
        "id": {
          "$": "id"
        }
      },
      "children": [
        {
          "each": {
            "op": "words",
            "args": [
              {
                "$": "title"
              }
            ]
          },
          "as": "word",
          "key": {
            "$": "i"
          },
          "do": [
            {
              "use": "Inline",
              "props": {
                "Class": {
                  "op": "nth",
                  "args": [
                    {
                      "$": "weights"
                    },
                    {
                      "$": "i"
                    }
                  ]
                }
              },
              "children": [
                {
                  "text": {
                    "$": "word"
                  }
                }
              ]
            },
            {
              "text": " "
            }
          ],
          "index": "i"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
