{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.cta-proof-items",
  "name": "CtaProofItems",
  "docs": "The proof of CtaProof. Shapes: logos (six names with a glyph), features (small features in two columns), stats (three figures), rows (four icon rows), zones (delivery zones: name and areas, price and time).",
  "records": {},
  "props": [
    {
      "name": "content",
      "type": {
        "ts": "CtaContent"
      },
      "required": true
    },
    {
      "name": "proof",
      "type": {
        "ts": "\"logos\" | \"features\" | \"stats\" | \"rows\" | \"zones\""
      },
      "default": "stats"
    },
    {
      "name": "center",
      "type": "boolean",
      "default": false,
      "docs": "the centered layout: items centred in their cells"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "proof"
              },
              "logos"
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "op": "len",
                "args": [
                  {
                    "$": "content.logos"
                  }
                ]
              },
              0
            ]
          }
        ]
      },
      "then": [
        {
          "use": "Box",
          "props": {
            "Class": "grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6"
          },
          "attrs": {
            "data-testid": "cta-proof"
          },
          "children": [
            {
              "each": {
                "$": "content.logos"
              },
              "as": "l",
              "key": {
                "$": "l.id"
              },
              "do": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "2",
                    "Align": "center",
                    "Justify": "center",
                    "Class": "text-muted-foreground"
                  },
                  "attrs": {
                    "data-testid": "cta-item"
                  },
                  "children": [
                    {
                      "use": "LucideIcon",
                      "props": {
                        "Name": {
                          "$": "l.icon"
                        },
                        "Size": 20
                      }
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "sm",
                        "Weight": "semibold"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "l.name"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "proof"
              },
              "features"
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "op": "len",
                "args": [
                  {
                    "$": "content.features"
                  }
                ]
              },
              0
            ]
          }
        ]
      },
      "then": [
        {
          "use": "Box",
          "props": {
            "Class": "grid grid-cols-1 gap-4 text-left sm:grid-cols-2"
          },
          "attrs": {
            "data-testid": "cta-proof"
          },
          "children": [
            {
              "each": {
                "$": "content.features"
              },
              "as": "f",
              "key": {
                "$": "f.id"
              },
              "do": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "4",
                    "Align": "start",
                    "Class": "rounded bg-card inset-ring inset-ring-border p-4"
                  },
                  "attrs": {
                    "data-testid": "cta-item"
                  },
                  "children": [
                    {
                      "use": "Box",
                      "props": {
                        "Class": "flex size-10 shrink-0 items-center justify-center rounded bg-muted"
                      },
                      "children": [
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": {
                              "$": "f.icon"
                            },
                            "Size": 20
                          }
                        }
                      ]
                    },
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "0"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "f.title"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "f.text"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "proof"
              },
              "stats"
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "op": "len",
                "args": [
                  {
                    "$": "content.stats"
                  }
                ]
              },
              0
            ]
          }
        ]
      },
      "then": [
        {
          "use": "Box",
          "props": {
            "Class": "grid grid-cols-3 gap-4"
          },
          "attrs": {
            "data-testid": "cta-proof"
          },
          "children": [
            {
              "each": {
                "$": "content.stats"
              },
              "as": "s",
              "key": {
                "$": "s.id"
              },
              "do": [
                {
                  "when": {
                    "op": "lt",
                    "args": [
                      {
                        "$": "i"
                      },
                      3
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "0",
                        "Class": {
                          "op": "cond",
                          "args": [
                            {
                              "$": "center"
                            },
                            "items-center text-center",
                            ""
                          ]
                        }
                      },
                      "attrs": {
                        "data-testid": "cta-item"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "3xl",
                            "Weight": "bold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "s.value"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "s.label"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "index": "i"
            }
          ]
        }
      ]
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "proof"
              },
              "rows"
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "op": "len",
                "args": [
                  {
                    "$": "content.features"
                  }
                ]
              },
              0
            ]
          }
        ]
      },
      "then": [
        {
          "use": "List",
          "props": {
            "Class": "m-0 flex list-none flex-col gap-4 p-0"
          },
          "attrs": {
            "data-testid": "cta-proof"
          },
          "children": [
            {
              "each": {
                "$": "content.features"
              },
              "as": "f",
              "key": {
                "$": "f.id"
              },
              "do": [
                {
                  "use": "ListItem",
                  "props": {
                    "Class": "flex items-start gap-4"
                  },
                  "attrs": {
                    "data-testid": "cta-item"
                  },
                  "children": [
                    {
                      "use": "Box",
                      "props": {
                        "Class": "flex size-10 shrink-0 items-center justify-center rounded bg-muted"
                      },
                      "children": [
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": {
                              "$": "f.icon"
                            },
                            "Size": 20
                          }
                        }
                      ]
                    },
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "0"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "f.title"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "f.text"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "proof"
              },
              "zones"
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "op": "len",
                "args": [
                  {
                    "$": "content.zones"
                  }
                ]
              },
              0
            ]
          }
        ]
      },
      "then": [
        {
          "use": "List",
          "props": {
            "Class": "m-0 flex list-none flex-col p-0"
          },
          "attrs": {
            "data-testid": "cta-proof"
          },
          "children": [
            {
              "each": {
                "$": "content.zones"
              },
              "as": "z",
              "key": {
                "$": "z.id"
              },
              "do": [
                {
                  "use": "ListItem",
                  "props": {
                    "Class": "flex items-start justify-between gap-4 border-b border-border py-4"
                  },
                  "attrs": {
                    "data-testid": "cta-item"
                  },
                  "children": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "0",
                        "Class": "min-w-0"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "z.name"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "z.area"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "0",
                        "Class": "shrink-0 text-right"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "op": "money",
                                "args": [
                                  {
                                    "$": "z.price"
                                  },
                                  {
                                    "$": "z.currency"
                                  }
                                ]
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "z.time"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "CtaProof",
      "names": [
        "CtaContent"
      ]
    }
  ]
}
