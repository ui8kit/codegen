{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.story-tabs",
  "name": "StoryTabs",
  "docs": "A story in steps (years or slides). Axes: layout (years: a row of year tabs over the panel of the active year with its badge, step, title, text and tag; carousel: the heading beside a picture with previous and next arrows and one dot per step), tone. Choosing a step emits `select`.",
  "records": {
    "StoryLabels": [
      {
        "name": "step",
        "type": "string"
      },
      {
        "name": "previous",
        "type": "string"
      },
      {
        "name": "next",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "badge",
      "type": "string",
      "default": "",
      "docs": "a short pill above the heading"
    },
    {
      "name": "steps",
      "type": {
        "ts": "Milestone[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "active",
      "type": "string",
      "required": true,
      "docs": "the id of the step shown"
    },
    {
      "name": "labels",
      "type": {
        "record": "StoryLabels"
      },
      "required": true,
      "docs": "template step `Step {0} of {1}`; the accessible names of the arrows"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"years\" | \"carousel\""
      },
      "default": "years"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "select",
      "args": [
        {
          "name": "id",
          "type": "string"
        }
      ],
      "docs": "a year tab, an arrow or a dot was chosen"
    }
  ],
  "view": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "op": "len",
            "args": [
              {
                "$": "steps"
              }
            ]
          },
          0
        ]
      },
      "then": [
        {
          "organism": "SectionFrame",
          "props": {
            "id": {
              "$": "id"
            },
            "title": {
              "$": "title"
            },
            "lead": {
              "$": "lead"
            },
            "heading": {
              "badge": {
                "$": "badge"
              }
            },
            "tone": {
              "$": "tone"
            },
            "landmarkLabel": {
              "$": "landmarkLabel"
            }
          },
          "slots": {
            "children": {
              "args": [],
              "do": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "milestone",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ]
            }
          }
        }
      ],
      "else": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "years"
            ]
          },
          "then": [
            {
              "organism": "SectionFrame",
              "props": {
                "id": {
                  "$": "id"
                },
                "title": {
                  "$": "title"
                },
                "lead": {
                  "$": "lead"
                },
                "heading": {
                  "badge": {
                    "$": "badge"
                  }
                },
                "tone": {
                  "$": "tone"
                },
                "landmarkLabel": {
                  "$": "landmarkLabel"
                }
              },
              "slots": {
                "children": {
                  "args": [],
                  "do": [
                    {
                      "use": "Box",
                      "props": {
                        "Class": "grid grid-cols-2 gap-2 sm:grid-cols-4"
                      },
                      "attrs": {
                        "data-testid": "story-tabs"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "steps"
                          },
                          "as": "s",
                          "key": {
                            "$": "s.id"
                          },
                          "do": [
                            {
                              "use": "Button",
                              "props": {
                                "Variant": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "s.id"
                                        },
                                        {
                                          "$": "active"
                                        }
                                      ]
                                    },
                                    "default",
                                    "outline"
                                  ]
                                },
                                "Size": "lg",
                                "Type": "button",
                                "Class": "h-auto flex-col items-start gap-0 py-2 text-start"
                              },
                              "attrs": {
                                "data-testid": "story-tab",
                                "data-active": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "s.id"
                                        },
                                        {
                                          "$": "active"
                                        }
                                      ]
                                    },
                                    "true",
                                    "false"
                                  ]
                                }
                              },
                              "on": {
                                "click": {
                                  "call": "emit.select",
                                  "args": [
                                    {
                                      "$": "s.id"
                                    }
                                  ]
                                }
                              },
                              "children": [
                                {
                                  "use": "Inline",
                                  "props": {
                                    "Class": "text-sm font-semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "s.date"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Inline",
                                  "props": {
                                    "Class": "text-xs"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "s.tag"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "each": {
                        "$": "steps"
                      },
                      "as": "s",
                      "key": {
                        "$": "s.id"
                      },
                      "do": [
                        {
                          "when": {
                            "op": "eq",
                            "args": [
                              {
                                "$": "s.id"
                              },
                              {
                                "$": "active"
                              }
                            ]
                          },
                          "then": [
                            {
                              "organism": "StoryPanel",
                              "props": {
                                "s": {
                                  "$": "s"
                                },
                                "index": {
                                  "$": "i"
                                },
                                "total": {
                                  "op": "len",
                                  "args": [
                                    {
                                      "$": "steps"
                                    }
                                  ]
                                },
                                "labels": {
                                  "$": "labels"
                                }
                              }
                            }
                          ]
                        }
                      ],
                      "index": "i"
                    }
                  ]
                }
              }
            }
          ],
          "else": [
            {
              "organism": "SectionFrame",
              "props": {
                "id": {
                  "$": "id"
                },
                "title": {
                  "$": "title"
                },
                "lead": {
                  "$": "lead"
                },
                "heading": {
                  "badge": {
                    "$": "badge"
                  }
                },
                "tone": {
                  "$": "tone"
                },
                "layout": "split",
                "media": {
                  "show": true
                },
                "landmarkLabel": {
                  "$": "landmarkLabel"
                }
              },
              "slots": {
                "children": {
                  "args": [],
                  "do": []
                },
                "aside": {
                  "args": [],
                  "do": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "4",
                        "Align": "stretch"
                      },
                      "children": [
                        {
                          "organism": "MediaFrame",
                          "props": {
                            "alt": {
                              "$": "title"
                            },
                            "ratio": "4/3"
                          }
                        },
                        {
                          "use": "Group",
                          "props": {
                            "Gap": "4",
                            "Align": "center",
                            "Justify": "between"
                          },
                          "children": [
                            {
                              "use": "Button",
                              "props": {
                                "Variant": "outline",
                                "Size": "sm",
                                "Layout": "icon",
                                "Type": "button",
                                "AriaLabel": {
                                  "$": "labels.previous"
                                }
                              },
                              "attrs": {
                                "data-testid": "story-arrow"
                              },
                              "children": [
                                {
                                  "use": "LucideIcon",
                                  "props": {
                                    "Name": "chevron-left",
                                    "Size": 16
                                  }
                                }
                              ]
                            },
                            {
                              "organism": "StoryDots",
                              "props": {
                                "steps": {
                                  "$": "steps"
                                },
                                "active": {
                                  "$": "active"
                                }
                              }
                            },
                            {
                              "use": "Button",
                              "props": {
                                "Variant": "outline",
                                "Size": "sm",
                                "Layout": "icon",
                                "Type": "button",
                                "AriaLabel": {
                                  "$": "labels.next"
                                }
                              },
                              "attrs": {
                                "data-testid": "story-arrow"
                              },
                              "children": [
                                {
                                  "use": "LucideIcon",
                                  "props": {
                                    "Name": "chevron-right",
                                    "Size": 16
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "MilestoneTimeline",
      "names": [
        "Milestone"
      ]
    }
  ]
}
