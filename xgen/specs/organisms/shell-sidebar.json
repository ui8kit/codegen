{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.shell-sidebar",
  "name": "ShellSidebar",
  "docs": "The sidebar of DashboardShell. Shapes: wide (icon and name), rail (icons only, the names still read), collapsed (the static collapsed state of a wide sidebar, with its expand button), twolevel (a rail beside a panel of the current section's links). side puts it at the start or the end.",
  "records": {},
  "props": [
    {
      "name": "nav",
      "type": {
        "ts": "ShellNav"
      },
      "required": true,
      "docs": "the brand, the links and the texts of the shell"
    },
    {
      "name": "mode",
      "type": {
        "ts": "\"wide\" | \"rail\" | \"collapsed\" | \"twolevel\" | \"none\""
      },
      "default": "wide",
      "docs": "the DashboardShell sidebar; the shell draws no sidebar for none"
    },
    {
      "name": "side",
      "type": {
        "ts": "\"start\" | \"end\""
      },
      "default": "start"
    },
    {
      "name": "brand",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "derived": [
    {
      "name": "named",
      "value": {
        "op": "eq",
        "args": [
          {
            "$": "mode"
          },
          "wide"
        ]
      }
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "toggle",
      "args": [],
      "docs": "the expand button of the collapsed sidebar was pressed"
    }
  ],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "aside",
        "Class": {
          "op": "cn",
          "args": [
            "flex shrink-0 bg-card",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "side"
                    },
                    "end"
                  ]
                },
                "flex-row-reverse border-l border-border",
                "border-r border-border"
              ]
            }
          ]
        }
      },
      "attrs": {
        "aria-label": {
          "op": "coalesce",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "$": "nav.label"
            }
          ]
        },
        "data-testid": "sidebar",
        "data-mode": {
          "$": "mode"
        }
      },
      "children": [
        {
          "use": "Box",
          "props": {
            "Class": {
              "op": "cn",
              "args": [
                "flex flex-col gap-6 py-4",
                {
                  "op": "cond",
                  "args": [
                    {
                      "$": "named"
                    },
                    "w-64 px-4",
                    "w-16 items-center px-2"
                  ]
                }
              ]
            }
          },
          "children": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "brand"
                  },
                  "show"
                ]
              },
              "then": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "2",
                    "Align": "center",
                    "Class": "shrink-0"
                  },
                  "attrs": {
                    "data-testid": "brand"
                  },
                  "children": [
                    {
                      "use": "LucideIcon",
                      "props": {
                        "Name": "layers",
                        "Size": 24
                      }
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "base",
                        "Weight": "bold",
                        "Class": {
                          "op": "cond",
                          "args": [
                            {
                              "$": "named"
                            },
                            "",
                            "sr-only"
                          ]
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "$": "nav.brand"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "gt",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "nav.links"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "NavBlock",
                  "props": {
                    "label": {
                      "op": "cond",
                      "args": [
                        {
                          "$": "landmarkLabel"
                        },
                        {
                          "op": "uniq",
                          "args": [
                            {
                              "op": "tpl",
                              "args": [
                                "{0}, {1}",
                                {
                                  "$": "nav.label"
                                },
                                {
                                  "$": "landmarkLabel"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "$": "nav.label"
                        }
                      ]
                    },
                    "className": "flex-1"
                  },
                  "slots": {
                    "children": {
                      "args": [],
                      "do": [
                        {
                          "use": "List",
                          "props": {
                            "Class": "m-0 flex list-none flex-col gap-2 p-0"
                          },
                          "attrs": {
                            "data-testid": "items"
                          },
                          "children": [
                            {
                              "each": {
                                "$": "nav.links"
                              },
                              "as": "l",
                              "key": {
                                "$": "l.id"
                              },
                              "do": [
                                {
                                  "use": "ListItem",
                                  "children": [
                                    {
                                      "organism": "MenuEntry",
                                      "props": {
                                        "href": {
                                          "$": "l.href"
                                        },
                                        "className": {
                                          "op": "cn",
                                          "args": [
                                            "flex items-center gap-4 rounded py-2 text-sm",
                                            {
                                              "op": "cond",
                                              "args": [
                                                {
                                                  "$": "named"
                                                },
                                                "px-4",
                                                "justify-center px-2"
                                              ]
                                            },
                                            {
                                              "op": "cond",
                                              "args": [
                                                {
                                                  "op": "eq",
                                                  "args": [
                                                    {
                                                      "$": "l.id"
                                                    },
                                                    {
                                                      "$": "nav.current"
                                                    }
                                                  ]
                                                },
                                                "bg-muted font-medium",
                                                ""
                                              ]
                                            }
                                          ]
                                        },
                                        "current": {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "l.id"
                                            },
                                            {
                                              "$": "nav.current"
                                            }
                                          ]
                                        },
                                        "size": "sm",
                                        "testid": "item"
                                      },
                                      "slots": {
                                        "children": {
                                          "args": [],
                                          "do": [
                                            {
                                              "use": "LucideIcon",
                                              "props": {
                                                "Name": {
                                                  "$": "l.icon"
                                                },
                                                "Size": 16
                                              }
                                            },
                                            {
                                              "use": "Inline",
                                              "props": {
                                                "Class": {
                                                  "op": "cond",
                                                  "args": [
                                                    {
                                                      "$": "named"
                                                    },
                                                    "",
                                                    "sr-only"
                                                  ]
                                                }
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "l.name"
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "mode"
                  },
                  "collapsed"
                ]
              },
              "then": [
                {
                  "use": "ButtonPlain",
                  "props": {
                    "Type": "button",
                    "Class": "inline-flex size-10 items-center justify-center rounded text-muted-foreground"
                  },
                  "attrs": {
                    "aria-label": {
                      "$": "nav.expand"
                    },
                    "aria-expanded": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "mode"
                            },
                            "wide"
                          ]
                        },
                        "true",
                        "false"
                      ]
                    },
                    "data-testid": "toggle"
                  },
                  "on": {
                    "click": {
                      "call": "emit.toggle",
                      "args": []
                    }
                  },
                  "children": [
                    {
                      "use": "LucideIcon",
                      "props": {
                        "Name": "panel-left",
                        "Size": 20
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "mode"
                  },
                  "twolevel"
                ]
              },
              {
                "op": "gt",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "nav.sub"
                      }
                    ]
                  },
                  0
                ]
              }
            ]
          },
          "then": [
            {
              "use": "Box",
              "props": {
                "Class": {
                  "op": "cn",
                  "args": [
                    "flex w-56 flex-col gap-4 px-4 py-6",
                    {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "side"
                            },
                            "end"
                          ]
                        },
                        "border-r border-border",
                        "border-l border-border"
                      ]
                    }
                  ]
                }
              },
              "attrs": {
                "data-testid": "subnav"
              },
              "children": [
                {
                  "use": "Text",
                  "props": {
                    "Size": "sm",
                    "Weight": "semibold",
                    "Class": "px-4"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "nav.subTitle"
                      }
                    }
                  ]
                },
                {
                  "organism": "NavBlock",
                  "props": {
                    "label": {
                      "op": "cond",
                      "args": [
                        {
                          "$": "landmarkLabel"
                        },
                        {
                          "op": "uniq",
                          "args": [
                            {
                              "op": "tpl",
                              "args": [
                                "{0}, {1}",
                                {
                                  "$": "nav.subTitle"
                                },
                                {
                                  "$": "landmarkLabel"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "$": "nav.subTitle"
                        }
                      ]
                    }
                  },
                  "slots": {
                    "children": {
                      "args": [],
                      "do": [
                        {
                          "use": "List",
                          "props": {
                            "Class": "m-0 flex list-none flex-col gap-2 p-0"
                          },
                          "children": [
                            {
                              "each": {
                                "$": "nav.sub"
                              },
                              "as": "s",
                              "key": {
                                "$": "s.id"
                              },
                              "do": [
                                {
                                  "use": "ListItem",
                                  "children": [
                                    {
                                      "organism": "MenuEntry",
                                      "props": {
                                        "href": {
                                          "$": "s.href"
                                        },
                                        "className": {
                                          "op": "cn",
                                          "args": [
                                            "flex items-center gap-4 rounded py-2 text-sm",
                                            {
                                              "op": "cond",
                                              "args": [
                                                true,
                                                "px-4",
                                                "justify-center px-2"
                                              ]
                                            },
                                            {
                                              "op": "cond",
                                              "args": [
                                                {
                                                  "op": "eq",
                                                  "args": [
                                                    {
                                                      "$": "s.id"
                                                    },
                                                    {
                                                      "$": "nav.subCurrent"
                                                    }
                                                  ]
                                                },
                                                "bg-muted font-medium",
                                                ""
                                              ]
                                            }
                                          ]
                                        },
                                        "current": {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "s.id"
                                            },
                                            {
                                              "$": "nav.subCurrent"
                                            }
                                          ]
                                        },
                                        "size": "sm",
                                        "testid": "item"
                                      },
                                      "slots": {
                                        "children": {
                                          "args": [],
                                          "do": [
                                            {
                                              "use": "LucideIcon",
                                              "props": {
                                                "Name": {
                                                  "$": "s.icon"
                                                },
                                                "Size": 16
                                              }
                                            },
                                            {
                                              "use": "Inline",
                                              "props": {
                                                "Class": {
                                                  "op": "cond",
                                                  "args": [
                                                    true,
                                                    "",
                                                    "sr-only"
                                                  ]
                                                }
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "s.name"
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "frame": true,
  "typeImports": [
    {
      "from": "DashboardShell",
      "names": [
        "ShellNav"
      ]
    }
  ]
}
