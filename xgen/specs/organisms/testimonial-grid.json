{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.testimonial-grid",
  "name": "TestimonialGrid",
  "docs": "Customer quotes as cards, plain figures or social posts, in a grid, a masonry, a scroll strip, one featured quote or one narrow column. Axes: layout (grid, single, stack, masonry, strip), columns, item kind (card, plain, social), item avatar, item rating, item mark (a company glyph), density, tone. A carousel is the Carousel port contract around the single layout.",
  "records": {
    "Quote": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "author",
        "type": "string"
      },
      {
        "name": "role",
        "type": "string"
      },
      {
        "name": "company",
        "type": "string"
      },
      {
        "name": "quote",
        "type": "string"
      },
      {
        "name": "rating",
        "type": "number"
      },
      {
        "name": "handle",
        "type": "string"
      },
      {
        "name": "time",
        "type": "string"
      },
      {
        "name": "mark",
        "type": "string"
      }
    ],
    "QuoteLabels": [
      {
        "name": "rating",
        "type": "string",
        "optional": false,
        "docs": "template of the rating's accessible name, e.g. `{0} out of 5`"
      },
      {
        "name": "byLine",
        "type": "string",
        "optional": false,
        "docs": "template of the line under the author, e.g. `{0}, {1}` (role, company)"
      },
      {
        "name": "handleLine",
        "type": "string",
        "optional": false,
        "docs": "template of the line under a social author, e.g. `{0} / {1}` (handle, time)"
      }
    ],
    "QuoteItem": [
      {
        "name": "kind",
        "type": "\"card\" | \"plain\" | \"social\"",
        "optional": true,
        "docs": "card: boxed; plain: a bare figure; social: a post of a social wall",
        "default": "card"
      },
      {
        "name": "avatar",
        "type": "\"none\" | \"image\"",
        "optional": true,
        "docs": "a round picture of the author",
        "default": "image"
      },
      {
        "name": "rating",
        "type": "\"show\" | \"hide\"",
        "optional": true,
        "docs": "the stars (not on social posts)",
        "default": "show"
      },
      {
        "name": "mark",
        "type": "\"none\" | \"icon\"",
        "optional": true,
        "docs": "a company glyph above the quote",
        "default": "none"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "quotes",
      "type": {
        "ts": "Quote[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "record": "QuoteLabels"
      },
      "required": true,
      "docs": "the templates of the lines around a quote"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"grid\" | \"single\" | \"stack\" | \"masonry\" | \"strip\""
      },
      "default": "grid",
      "docs": "single: the first quote only, wide; stack: one narrow column; masonry: columns of cards of any height; strip: one row that scrolls sideways"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"1-2\" | \"1-3\""
      },
      "default": "1-3"
    },
    {
      "name": "item",
      "type": {
        "record": "QuoteItem"
      },
      "docs": "how one quote is drawn"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"roomy\" | \"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "align": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "layout"
                },
                "single"
              ]
            },
            "center",
            "start"
          ]
        },
        "measure": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "layout"
                },
                "grid"
              ]
            },
            "default",
            "2xl"
          ]
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "quotes"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "message-square-quote",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "when": {
                    "op": "or",
                    "args": [
                      {
                        "op": "eq",
                        "args": [
                          {
                            "$": "layout"
                          },
                          "masonry"
                        ]
                      },
                      {
                        "op": "eq",
                        "args": [
                          {
                            "$": "layout"
                          },
                          "strip"
                        ]
                      }
                    ]
                  },
                  "then": [
                    {
                      "use": "Block",
                      "props": {
                        "Tag": "div",
                        "Class": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "masonry"
                              ]
                            },
                            "columns-1 gap-4 md:columns-2 xl:columns-3",
                            "flex snap-x gap-4 overflow-x-auto pb-2"
                          ]
                        }
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "quotes"
                          },
                          "as": "q",
                          "key": {
                            "$": "q.id"
                          },
                          "do": [
                            {
                              "organism": "QuoteCard",
                              "props": {
                                "q": {
                                  "$": "q"
                                },
                                "labels": {
                                  "$": "labels"
                                },
                                "item": {
                                  "$": "item"
                                },
                                "layout": {
                                  "$": "layout"
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "grid"
                              ]
                            },
                            {
                              "$": "cols"
                            },
                            "1"
                          ]
                        },
                        "Class": "gap-4"
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "quotes"
                          },
                          "as": "q",
                          "key": {
                            "$": "q.id"
                          },
                          "do": [
                            {
                              "when": {
                                "op": "or",
                                "args": [
                                  {
                                    "op": "ne",
                                    "args": [
                                      {
                                        "$": "layout"
                                      },
                                      "single"
                                    ]
                                  },
                                  {
                                    "op": "eq",
                                    "args": [
                                      {
                                        "$": "i"
                                      },
                                      0
                                    ]
                                  }
                                ]
                              },
                              "then": [
                                {
                                  "organism": "QuoteCard",
                                  "props": {
                                    "q": {
                                      "$": "q"
                                    },
                                    "labels": {
                                      "$": "labels"
                                    },
                                    "item": {
                                      "$": "item"
                                    },
                                    "layout": {
                                      "$": "layout"
                                    }
                                  }
                                }
                              ]
                            }
                          ],
                          "index": "i"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
