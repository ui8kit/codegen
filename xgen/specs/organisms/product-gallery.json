{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.product-gallery",
  "name": "ProductGallery",
  "docs": "The gallery of a product page: the picture (the file of the product's featured media, a placeholder without one) and optional thumbnails below.",
  "records": {},
  "props": [
    {
      "name": "name",
      "type": "string",
      "required": true,
      "docs": "the product name: the alternative text"
    },
    {
      "name": "image",
      "type": "string",
      "docs": "the file of the featured media; none: the placeholder"
    },
    {
      "name": "thumbs",
      "type": {
        "ts": "\"none\" | \"below\""
      },
      "default": "below"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Stack",
      "props": {
        "Gap": "4",
        "Align": "stretch"
      },
      "attrs": {
        "data-testid": "gallery"
      },
      "children": [
        {
          "organism": "MediaFrame",
          "props": {
            "alt": {
              "$": "name"
            },
            "src": {
              "$": "image"
            },
            "ratio": "1/1"
          }
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "thumbs"
              },
              "below"
            ]
          },
          "then": [
            {
              "use": "Grid",
              "props": {
                "Cols": "3",
                "Class": "gap-4"
              },
              "attrs": {
                "data-testid": "thumbs"
              },
              "children": [
                {
                  "organism": "MediaFrame",
                  "props": {
                    "alt": {
                      "$": "name"
                    },
                    "src": {
                      "$": "image"
                    },
                    "ratio": "1/1",
                    "className": "ring-2 ring-foreground"
                  }
                },
                {
                  "organism": "MediaFrame",
                  "props": {
                    "alt": {
                      "$": "name"
                    },
                    "ratio": "1/1"
                  }
                },
                {
                  "organism": "MediaFrame",
                  "props": {
                    "alt": {
                      "$": "name"
                    },
                    "ratio": "1/1"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
