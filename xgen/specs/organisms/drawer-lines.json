{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.drawer-lines",
  "name": "DrawerLines",
  "docs": "The filled body of the CartDrawer: the lines with a quantity field, then the free-delivery bar, the subtotal and total and the button.",
  "records": {},
  "props": [
    {
      "name": "lines",
      "type": {
        "ts": "CartLine[]"
      },
      "required": true
    },
    {
      "name": "rows",
      "type": {
        "ts": "SummaryRow[]"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "CartLabels"
      },
      "required": true
    },
    {
      "name": "drawer",
      "type": {
        "ts": "DrawerLabels"
      },
      "required": true
    },
    {
      "name": "media",
      "type": {
        "ts": "\"image\" | \"none\""
      },
      "default": "image"
    },
    {
      "name": "field",
      "type": "string",
      "default": "qty",
      "docs": "prefix of the quantity field names (one name per line: <field>-<line id>)"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Stack",
      "props": {
        "Gap": "4",
        "Align": "stretch",
        "Class": "flex-1 p-4"
      },
      "attrs": {
        "data-testid": "lines"
      },
      "children": [
        {
          "each": {
            "$": "lines"
          },
          "as": "line",
          "key": {
            "$": "line.id"
          },
          "do": [
            {
              "use": "Group",
              "props": {
                "Gap": "4",
                "Align": "start"
              },
              "attrs": {
                "data-testid": "item"
              },
              "children": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "media"
                      },
                      "image"
                    ]
                  },
                  "then": [
                    {
                      "organism": "MediaFrame",
                      "props": {
                        "alt": {
                          "$": "line.name"
                        },
                        "ratio": "1/1",
                        "className": "size-16 shrink-0"
                      }
                    }
                  ]
                },
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "2",
                    "Align": "stretch",
                    "Class": "flex-1"
                  },
                  "children": [
                    {
                      "use": "Group",
                      "props": {
                        "Gap": "2",
                        "Justify": "between",
                        "Align": "start"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "line.name"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Inline",
                          "props": {
                            "Class": "text-sm font-medium"
                          },
                          "children": [
                            {
                              "text": {
                                "op": "money",
                                "args": [
                                  {
                                    "op": "mul",
                                    "args": [
                                      {
                                        "$": "line.price"
                                      },
                                      {
                                        "$": "line.qty"
                                      }
                                    ]
                                  },
                                  {
                                    "$": "line.currency"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "xs",
                        "Class": "text-muted-foreground"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "line.variant"
                          }
                        }
                      ]
                    },
                    {
                      "organism": "NumberField",
                      "props": {
                        "value": {
                          "op": "str",
                          "args": [
                            {
                              "$": "line.qty"
                            }
                          ]
                        },
                        "name": {
                          "op": "tpl",
                          "args": [
                            "{0}-{1}",
                            {
                              "$": "field"
                            },
                            {
                              "$": "line.id"
                            }
                          ]
                        },
                        "min": "1",
                        "label": {
                          "$": "labels.qty"
                        },
                        "decrease": {
                          "$": "labels.decrease"
                        },
                        "increase": {
                          "$": "labels.increase"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "use": "Stack",
      "props": {
        "Gap": "4",
        "Align": "stretch",
        "Class": "border-t border-border p-4"
      },
      "children": [
        {
          "use": "Stack",
          "props": {
            "Gap": "2",
            "Align": "stretch",
            "Class": "rounded bg-muted p-4"
          },
          "attrs": {
            "data-testid": "progress"
          },
          "children": [
            {
              "use": "Text",
              "props": {
                "Size": "sm"
              },
              "children": [
                {
                  "text": {
                    "$": "drawer.progress"
                  }
                }
              ]
            },
            {
              "use": "Progress",
              "props": {
                "Value": "96",
                "Max": "100"
              },
              "attrs": {
                "aria-label": {
                  "$": "drawer.progress"
                }
              }
            }
          ]
        },
        {
          "use": "List",
          "props": {
            "Tag": "ul",
            "Class": "flex flex-col gap-2"
          },
          "children": [
            {
              "each": {
                "$": "rows"
              },
              "as": "row",
              "key": {
                "$": "row.id"
              },
              "do": [
                {
                  "when": {
                    "op": "cond",
                    "args": [
                      {
                        "$": "row.strong"
                      },
                      true,
                      {
                        "op": "eq",
                        "args": [
                          {
                            "$": "i"
                          },
                          0
                        ]
                      }
                    ]
                  },
                  "then": [
                    {
                      "use": "ListItem",
                      "props": {
                        "Class": {
                          "op": "cond",
                          "args": [
                            {
                              "$": "row.strong"
                            },
                            "flex justify-between text-base font-bold",
                            "flex justify-between text-sm text-muted-foreground"
                          ]
                        }
                      },
                      "children": [
                        {
                          "use": "Inline",
                          "children": [
                            {
                              "text": {
                                "$": "row.label"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Inline",
                          "children": [
                            {
                              "text": {
                                "op": "money",
                                "args": [
                                  {
                                    "$": "row.amount"
                                  },
                                  {
                                    "$": "row.currency"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "index": "i"
            }
          ]
        },
        {
          "use": "Button",
          "props": {
            "Variant": "default",
            "Size": "lg",
            "Class": "w-full"
          },
          "attrs": {
            "data-testid": "checkout"
          },
          "children": [
            {
              "text": {
                "$": "labels.checkout"
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "CartList",
      "names": [
        "CartLine",
        "CartLabels"
      ]
    },
    {
      "from": "OrderSummary",
      "names": [
        "SummaryRow"
      ]
    },
    {
      "from": "CartDrawer",
      "names": [
        "DrawerLabels"
      ]
    }
  ]
}
