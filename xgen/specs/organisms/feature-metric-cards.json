{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.feature-metric-cards",
  "name": "FeatureMetricCards",
  "docs": "Four figures of FeatureSplit as small cards in two columns: a glyph tile, the value with its hint and the label.",
  "records": {},
  "props": [
    {
      "name": "stats",
      "type": {
        "ts": "Stat[]"
      },
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": "grid grid-cols-1 gap-4 sm:grid-cols-2"
      },
      "children": [
        {
          "each": {
            "$": "stats"
          },
          "as": "s",
          "key": {
            "$": "s.id"
          },
          "do": [
            {
              "when": {
                "op": "lt",
                "args": [
                  {
                    "$": "i"
                  },
                  4
                ]
              },
              "then": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "4",
                    "Align": "center",
                    "Class": "rounded bg-card inset-ring inset-ring-border p-4"
                  },
                  "attrs": {
                    "data-testid": "feature-stat"
                  },
                  "children": [
                    {
                      "use": "Inline",
                      "props": {
                        "Class": "flex size-10 shrink-0 items-center justify-center rounded bg-muted text-foreground"
                      },
                      "children": [
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": {
                              "$": "s.icon"
                            },
                            "Size": 20
                          }
                        }
                      ]
                    },
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "0",
                        "Class": "min-w-0"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "lg",
                            "Weight": "bold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "s.value"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "s.label"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "s.hint"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "index": "i"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "StatsBand",
      "names": [
        "Stat"
      ]
    }
  ]
}
