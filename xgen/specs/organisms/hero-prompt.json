{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.hero-prompt",
  "name": "HeroPrompt",
  "docs": "A dark hero band: the head row, a badge, a title with weighted words, the prompt box (or actions) and topic pills.",
  "records": {
    "HeroComposer": [
      {
        "name": "attachLabel",
        "type": "string",
        "optional": true,
        "docs": "attachment chip label"
      },
      {
        "name": "modelLabel",
        "type": "string",
        "optional": true,
        "docs": "model pill label"
      }
    ],
    "HeroNav": [
      {
        "name": "brand",
        "type": "string",
        "optional": true,
        "docs": "brand word of the head row"
      },
      {
        "name": "links",
        "type": "NavLink[]",
        "optional": true,
        "docs": "menu links of the head row"
      },
      {
        "name": "current",
        "type": "string",
        "optional": true,
        "docs": "id of the current link"
      },
      {
        "name": "login",
        "type": "string",
        "optional": true
      },
      {
        "name": "loginHref",
        "type": "string",
        "optional": true
      },
      {
        "name": "skip",
        "type": "string",
        "optional": true,
        "docs": "skip link text"
      },
      {
        "name": "label",
        "type": "string",
        "optional": true,
        "docs": "accessible name of the menu"
      }
    ]
  },
  "props": [
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2"
      },
      "default": 1
    },
    {
      "name": "badge",
      "type": "string",
      "docs": "label of the badge (Meet Model V4.1)"
    },
    {
      "name": "badgeMark",
      "type": "string",
      "docs": "small inner pill text (NEW)"
    },
    {
      "name": "actions",
      "type": {
        "ts": "ActionSet"
      }
    },
    {
      "name": "composer",
      "type": {
        "record": "HeroComposer"
      },
      "docs": "labels of the prompt box"
    },
    {
      "name": "nav",
      "type": {
        "record": "HeroNav"
      },
      "docs": "the head row"
    },
    {
      "name": "topics",
      "type": {
        "ts": "Topic[]"
      }
    },
    {
      "name": "density",
      "type": {
        "ts": "\"roomy\" | \"default\" | \"compact\""
      },
      "default": "roomy",
      "docs": "named on the section (data-density) like every section; the band keeps the frame's padding"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": {
          "op": "cn",
          "args": [
            "flex w-full flex-col bg-foreground text-background py-8 [&_.text-muted-foreground]:text-background/70",
            {
              "op": "preset",
              "args": [
                "defaults",
                "hero.band"
              ]
            }
          ]
        }
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            "home-hero-title"
          ]
        },
        "data-testid": "section",
        "data-tone": "inverse",
        "data-density": {
          "$": "density"
        },
        "data-chrome": "nav",
        "aria-label": {
          "$": "landmarkLabel"
        }
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": {
              "op": "cn",
              "args": [
                "mx-auto w-full px-8",
                {
                  "op": "preset",
                  "args": [
                    "defaults",
                    "hero.container"
                  ]
                }
              ]
            }
          },
          "attrs": {
            "data-slot": "container"
          },
          "children": [
            {
              "use": "Stack",
              "props": {
                "Gap": "0",
                "Align": "stretch"
              },
              "children": [
                {
                  "organism": "HeroHead",
                  "props": {
                    "brand": {
                      "$": "nav.brand"
                    },
                    "links": {
                      "$": "nav.links"
                    },
                    "current": {
                      "$": "nav.current"
                    },
                    "login": {
                      "$": "nav.login"
                    },
                    "loginHref": {
                      "$": "nav.loginHref"
                    },
                    "skip": {
                      "$": "nav.skip"
                    },
                    "navLabel": {
                      "$": "nav.label"
                    },
                    "cta": {
                      "$": "actions.cta"
                    },
                    "href": {
                      "$": "actions.href"
                    },
                    "landmarkLabel": {
                      "$": "landmarkLabel"
                    }
                  }
                },
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "0",
                    "Align": "center",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "mx-auto w-full pt-24 pb-16",
                        {
                          "op": "preset",
                          "args": [
                            "defaults",
                            "hero.column"
                          ]
                        }
                      ]
                    }
                  },
                  "attrs": {
                    "data-testid": "hero-column"
                  },
                  "children": [
                    {
                      "when": {
                        "$": "badge"
                      },
                      "then": [
                        {
                          "organism": "HeroBadge",
                          "props": {
                            "label": {
                              "$": "badge"
                            },
                            "mark": {
                              "$": "badgeMark"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "organism": "WeightedTitle",
                      "props": {
                        "id": "home-hero-title",
                        "title": {
                          "$": "title"
                        },
                        "weights": {
                          "op": "preset",
                          "args": [
                            "defaults",
                            "hero.titleWeights"
                          ]
                        },
                        "level": {
                          "$": "level"
                        }
                      }
                    },
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "actions.mode"
                          },
                          "form"
                        ]
                      },
                      "then": [
                        {
                          "organism": "PromptComposer",
                          "props": {
                            "label": {
                              "$": "actions.emailLabel"
                            },
                            "attachLabel": {
                              "$": "composer.attachLabel"
                            },
                            "modelLabel": {
                              "$": "composer.modelLabel"
                            },
                            "send": {
                              "$": "actions.cta"
                            },
                            "href": {
                              "$": "actions.href"
                            }
                          }
                        }
                      ],
                      "else": [
                        {
                          "when": {
                            "$": "actions.cta"
                          },
                          "then": [
                            {
                              "organism": "ActionGroup",
                              "props": {
                                "primary": {
                                  "$": "actions.cta"
                                },
                                "primaryHref": {
                                  "$": "actions.href"
                                },
                                "secondary": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "actions.mode"
                                        },
                                        "two"
                                      ]
                                    },
                                    {
                                      "$": "actions.secondary"
                                    },
                                    {
                                      "op": "undef",
                                      "args": []
                                    }
                                  ]
                                },
                                "secondaryHref": {
                                  "$": "actions.secondaryHref"
                                },
                                "align": {
                                  "op": "cond",
                                  "args": [
                                    true,
                                    "center",
                                    "start"
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "when": {
                        "op": "and",
                        "args": [
                          {
                            "$": "topics"
                          },
                          {
                            "op": "gt",
                            "args": [
                              {
                                "op": "len",
                                "args": [
                                  {
                                    "$": "topics"
                                  }
                                ]
                              },
                              0
                            ]
                          }
                        ]
                      },
                      "then": [
                        {
                          "organism": "TopicChips",
                          "props": {
                            "topics": {
                              "$": "topics"
                            },
                            "tone": "inverse"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "CtaActions",
      "names": [
        "ActionSet"
      ]
    },
    {
      "from": "NavBar",
      "names": [
        "NavLink"
      ]
    },
    {
      "from": "TopicChips",
      "names": [
        "Topic"
      ]
    }
  ]
}
