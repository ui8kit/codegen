{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.search-palette",
  "name": "SearchPalette",
  "docs": "A search field with a search glyph and the keys that open it.",
  "records": {},
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": true,
      "docs": "name and placeholder of the field"
    },
    {
      "name": "shortcut",
      "type": "string",
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": "relative w-full max-w-sm"
      },
      "attrs": {
        "data-testid": "palette"
      },
      "children": [
        {
          "use": "LucideIcon",
          "props": {
            "Name": "search",
            "Size": 16,
            "Class": "pointer-events-none absolute top-2 left-3 text-muted-foreground"
          }
        },
        {
          "use": "Input",
          "props": {
            "Type": "search",
            "Size": "sm",
            "Placeholder": {
              "$": "label"
            },
            "AriaLabel": {
              "$": "label"
            },
            "Class": "pr-12 pl-10"
          }
        },
        {
          "use": "Inline",
          "props": {
            "Class": "pointer-events-none absolute top-2 right-2 rounded px-2 py-0 text-xs text-muted-foreground inset-ring inset-ring-border"
          },
          "children": [
            {
              "text": {
                "$": "shortcut"
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
