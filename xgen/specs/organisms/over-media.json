{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.over-media",
  "name": "OverMedia",
  "docs": "A faded picture behind the content of its header (a transparent top bar over a hero image); on false: nothing. It sits inside the header Block, which is `relative isolate overflow-hidden` and transparent when on, so the header stays the root of the block (rule 01).",
  "records": {},
  "props": [
    {
      "name": "on",
      "type": "boolean",
      "default": false
    },
    {
      "name": "alt",
      "type": "string",
      "required": true,
      "docs": "accessible name of the picture"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "$": "on"
      },
      "then": [
        {
          "use": "Box",
          "props": {
            "Class": "pointer-events-none absolute inset-0 -z-10"
          },
          "attrs": {
            "data-testid": "over"
          },
          "children": [
            {
              "organism": "MediaFrame",
              "props": {
                "alt": {
                  "$": "alt"
                },
                "ratio": "21/9",
                "className": "size-full rounded-none opacity-40"
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
