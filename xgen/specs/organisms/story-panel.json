{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.story-panel",
  "name": "StoryPanel",
  "docs": "The panel of the active step of StoryTabs: the year badge and the step count, the title, the text and the tag in a muted box.",
  "records": {},
  "props": [
    {
      "name": "s",
      "type": {
        "ts": "Milestone"
      },
      "required": true
    },
    {
      "name": "index",
      "type": "number",
      "required": true,
      "docs": "position of the step, from 0"
    },
    {
      "name": "total",
      "type": "number",
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "StoryLabels"
      },
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Stack",
      "props": {
        "Gap": "4",
        "Align": "stretch",
        "Class": "rounded bg-card inset-ring inset-ring-border p-6"
      },
      "attrs": {
        "data-testid": "story-panel"
      },
      "children": [
        {
          "use": "Group",
          "props": {
            "Gap": "2",
            "Align": "center"
          },
          "children": [
            {
              "use": "Badge",
              "props": {
                "Variant": "secondary",
                "Size": "sm"
              },
              "children": [
                {
                  "text": {
                    "$": "s.date"
                  }
                }
              ]
            },
            {
              "use": "Text",
              "props": {
                "Size": "xs",
                "Class": "text-muted-foreground"
              },
              "children": [
                {
                  "text": {
                    "op": "tpl",
                    "args": [
                      {
                        "$": "labels.step"
                      },
                      {
                        "op": "str",
                        "args": [
                          {
                            "op": "add",
                            "args": [
                              {
                                "$": "index"
                              },
                              1
                            ]
                          }
                        ]
                      },
                      {
                        "op": "str",
                        "args": [
                          {
                            "$": "total"
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "use": "Title",
          "props": {
            "As": 3,
            "Size": "xl",
            "Weight": "semibold"
          },
          "children": [
            {
              "text": {
                "$": "s.title"
              }
            }
          ]
        },
        {
          "use": "Text",
          "props": {
            "Size": "sm",
            "Class": "text-muted-foreground"
          },
          "children": [
            {
              "text": {
                "$": "s.text"
              }
            }
          ]
        },
        {
          "use": "Box",
          "props": {
            "Class": "rounded bg-muted p-4"
          },
          "children": [
            {
              "use": "Text",
              "props": {
                "Size": "sm",
                "Weight": "semibold"
              },
              "children": [
                {
                  "text": {
                    "$": "s.tag"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "MilestoneTimeline",
      "names": [
        "Milestone"
      ]
    },
    {
      "from": "StoryTabs",
      "names": [
        "StoryLabels"
      ]
    }
  ]
}
