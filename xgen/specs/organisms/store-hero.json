{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.store-hero",
  "name": "StoreHero",
  "docs": "The hero of a store: a badge, the heading, a lead, one or two actions and three store promises. The overlay layout puts a picture beside the text with an offer card floating on it; the backdrop layout puts the text over a faint picture. Axes: layout (overlay, backdrop), mediaSide, tone.",
  "records": {
    "OfferCard": [
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "text",
        "type": "string"
      },
      {
        "name": "icon",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "badge",
      "type": "string",
      "default": "",
      "docs": "a short pill above the heading"
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2"
      },
      "default": 1
    },
    {
      "name": "actions",
      "type": {
        "ts": "LinkActions"
      },
      "required": true
    },
    {
      "name": "perks",
      "type": {
        "ts": "Feature[]"
      },
      "required": true,
      "docs": "store promises under the actions (the first three are shown)"
    },
    {
      "name": "card",
      "type": {
        "record": "OfferCard"
      },
      "required": true,
      "docs": "the offer card on the picture (overlay layout)"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"overlay\" | \"backdrop\""
      },
      "default": "overlay"
    },
    {
      "name": "mediaSide",
      "type": {
        "ts": "\"end\" | \"start\""
      },
      "default": "end"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "$": "layout"
          },
          "backdrop"
        ]
      },
      "then": [
        {
          "organism": "SectionFrame",
          "props": {
            "id": {
              "$": "id"
            },
            "title": {
              "$": "title"
            },
            "lead": {
              "$": "lead"
            },
            "heading": {
              "badge": {
                "$": "badge"
              },
              "level": {
                "$": "level"
              }
            },
            "tone": {
              "$": "tone"
            },
            "density": "roomy",
            "measure": "3xl",
            "className": {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    "image",
                    "image"
                  ]
                },
                "relative isolate overflow-hidden",
                ""
              ]
            },
            "landmarkLabel": {
              "$": "landmarkLabel"
            }
          },
          "slots": {
            "children": {
              "args": [],
              "do": [
                {
                  "organism": "Backdrop",
                  "props": {
                    "kind": "image",
                    "alt": {
                      "$": "title"
                    }
                  }
                },
                {
                  "organism": "ActionGroup",
                  "props": {
                    "primary": {
                      "$": "actions.cta"
                    },
                    "primaryHref": {
                      "$": "actions.href"
                    },
                    "secondary": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "actions.mode"
                            },
                            "two"
                          ]
                        },
                        {
                          "$": "actions.secondary"
                        },
                        {
                          "op": "undef",
                          "args": []
                        }
                      ]
                    },
                    "secondaryHref": {
                      "$": "actions.secondaryHref"
                    }
                  }
                },
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "perks"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": "1-3",
                        "Class": "gap-4"
                      },
                      "attrs": {
                        "data-testid": "perks"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "perks"
                          },
                          "as": "p",
                          "key": {
                            "$": "p.id"
                          },
                          "do": [
                            {
                              "when": {
                                "op": "lt",
                                "args": [
                                  {
                                    "$": "i"
                                  },
                                  3
                                ]
                              },
                              "then": [
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "4",
                                    "Align": "start"
                                  },
                                  "attrs": {
                                    "data-testid": "perk"
                                  },
                                  "children": [
                                    {
                                      "use": "Box",
                                      "props": {
                                        "Class": "flex size-10 shrink-0 items-center justify-center rounded bg-muted"
                                      },
                                      "children": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": {
                                              "$": "p.icon"
                                            },
                                            "Size": 20
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Stack",
                                      "props": {
                                        "Gap": "0"
                                      },
                                      "children": [
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "sm",
                                            "Weight": "semibold"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "p.title"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "xs",
                                            "Class": "text-muted-foreground"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "p.text"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ],
                          "index": "i"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      ],
      "else": [
        {
          "organism": "SectionFrame",
          "props": {
            "id": {
              "$": "id"
            },
            "title": {
              "$": "title"
            },
            "lead": {
              "$": "lead"
            },
            "heading": {
              "badge": {
                "$": "badge"
              },
              "level": {
                "$": "level"
              }
            },
            "layout": "split",
            "media": {
              "show": true,
              "side": {
                "$": "mediaSide"
              }
            },
            "tone": {
              "$": "tone"
            },
            "landmarkLabel": {
              "$": "landmarkLabel"
            }
          },
          "slots": {
            "children": {
              "args": [],
              "do": [
                {
                  "organism": "ActionGroup",
                  "props": {
                    "primary": {
                      "$": "actions.cta"
                    },
                    "primaryHref": {
                      "$": "actions.href"
                    },
                    "secondary": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "actions.mode"
                            },
                            "two"
                          ]
                        },
                        {
                          "$": "actions.secondary"
                        },
                        {
                          "op": "undef",
                          "args": []
                        }
                      ]
                    },
                    "secondaryHref": {
                      "$": "actions.secondaryHref"
                    }
                  }
                },
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "perks"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": "1-3",
                        "Class": "gap-4"
                      },
                      "attrs": {
                        "data-testid": "perks"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "perks"
                          },
                          "as": "p",
                          "key": {
                            "$": "p.id"
                          },
                          "do": [
                            {
                              "when": {
                                "op": "lt",
                                "args": [
                                  {
                                    "$": "i"
                                  },
                                  3
                                ]
                              },
                              "then": [
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "4",
                                    "Align": "start"
                                  },
                                  "attrs": {
                                    "data-testid": "perk"
                                  },
                                  "children": [
                                    {
                                      "use": "Box",
                                      "props": {
                                        "Class": "flex size-10 shrink-0 items-center justify-center rounded bg-muted"
                                      },
                                      "children": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": {
                                              "$": "p.icon"
                                            },
                                            "Size": 20
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Stack",
                                      "props": {
                                        "Gap": "0"
                                      },
                                      "children": [
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "sm",
                                            "Weight": "semibold"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "p.title"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "xs",
                                            "Class": "text-muted-foreground"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "p.text"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ],
                          "index": "i"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "aside": {
              "args": [],
              "do": [
                {
                  "organism": "OfferMedia",
                  "props": {
                    "alt": {
                      "$": "title"
                    },
                    "card": {
                      "$": "card"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "FeatureGrid",
      "names": [
        "Feature"
      ]
    },
    {
      "from": "ErrorPage",
      "names": [
        "LinkActions"
      ]
    }
  ]
}
