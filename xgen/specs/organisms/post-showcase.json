{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.post-showcase",
  "name": "PostShowcase",
  "docs": "Posts shown off. Axes: layout (intro: four small post cards beside the intro with a view-all link, featured: the first post in detail beside its picture, overlay: cards with the text over the picture), cols (2, 3: overlay columns), mediaSide, tone.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "badge",
      "type": "string",
      "default": "",
      "docs": "a short pill above the heading"
    },
    {
      "name": "posts",
      "type": {
        "ts": "Post[]"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "PostLabels"
      },
      "required": true
    },
    {
      "name": "action",
      "type": {
        "ts": "HeadLink"
      },
      "required": true,
      "docs": "the view-all link of the intro layout"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"intro\" | \"featured\" | \"overlay\""
      },
      "default": "intro"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"2\" | \"3\""
      },
      "default": "3"
    },
    {
      "name": "mediaSide",
      "type": {
        "ts": "\"end\" | \"start\""
      },
      "default": "start"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "op": "len",
            "args": [
              {
                "$": "posts"
              }
            ]
          },
          0
        ]
      },
      "then": [
        {
          "organism": "SectionFrame",
          "props": {
            "id": {
              "$": "id"
            },
            "title": {
              "$": "title"
            },
            "lead": {
              "$": "lead"
            },
            "heading": {
              "badge": {
                "$": "badge"
              }
            },
            "tone": {
              "$": "tone"
            },
            "landmarkLabel": {
              "$": "landmarkLabel"
            }
          },
          "slots": {
            "children": {
              "args": [],
              "do": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "newspaper",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ]
            }
          }
        }
      ],
      "else": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "intro"
            ]
          },
          "then": [
            {
              "organism": "SectionFrame",
              "props": {
                "id": {
                  "$": "id"
                },
                "title": {
                  "$": "title"
                },
                "lead": {
                  "$": "lead"
                },
                "heading": {
                  "badge": {
                    "$": "badge"
                  }
                },
                "tone": {
                  "$": "tone"
                },
                "layout": "split",
                "media": {
                  "show": true,
                  "side": {
                    "$": "mediaSide"
                  }
                },
                "landmarkLabel": {
                  "$": "landmarkLabel"
                }
              },
              "slots": {
                "children": {
                  "args": [],
                  "do": [
                    {
                      "use": "Link",
                      "props": {
                        "Href": {
                          "$": "action.href"
                        },
                        "Size": "sm"
                      },
                      "attrs": {
                        "data-testid": "section-action"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "action.label"
                          }
                        },
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": "arrow-right",
                            "Size": 16
                          }
                        }
                      ]
                    }
                  ]
                },
                "aside": {
                  "args": [],
                  "do": [
                    {
                      "use": "Box",
                      "props": {
                        "Class": "grid grid-cols-1 gap-4 sm:grid-cols-2"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "posts"
                          },
                          "as": "p",
                          "key": {
                            "$": "p.id"
                          },
                          "do": [
                            {
                              "when": {
                                "op": "lt",
                                "args": [
                                  {
                                    "$": "i"
                                  },
                                  4
                                ]
                              },
                              "then": [
                                {
                                  "organism": "PostMiniCard",
                                  "props": {
                                    "p": {
                                      "$": "p"
                                    },
                                    "labels": {
                                      "$": "labels"
                                    }
                                  }
                                }
                              ]
                            }
                          ],
                          "index": "i"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ],
          "else": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "featured"
                ]
              },
              "then": [
                {
                  "organism": "SectionFrame",
                  "props": {
                    "id": {
                      "$": "id"
                    },
                    "title": {
                      "$": "title"
                    },
                    "lead": {
                      "$": "lead"
                    },
                    "heading": {
                      "badge": {
                        "$": "badge"
                      }
                    },
                    "tone": {
                      "$": "tone"
                    },
                    "layout": "split",
                    "media": {
                      "show": true,
                      "side": {
                        "$": "mediaSide"
                      }
                    },
                    "landmarkLabel": {
                      "$": "landmarkLabel"
                    }
                  },
                  "slots": {
                    "children": {
                      "args": [],
                      "do": [
                        {
                          "each": {
                            "$": "posts"
                          },
                          "as": "p",
                          "key": {
                            "$": "p.id"
                          },
                          "do": [
                            {
                              "when": {
                                "op": "lt",
                                "args": [
                                  {
                                    "$": "i"
                                  },
                                  1
                                ]
                              },
                              "then": [
                                {
                                  "organism": "PostFeature",
                                  "props": {
                                    "p": {
                                      "$": "p"
                                    },
                                    "labels": {
                                      "$": "labels"
                                    }
                                  }
                                }
                              ]
                            }
                          ],
                          "index": "i"
                        }
                      ]
                    },
                    "aside": {
                      "args": [],
                      "do": [
                        {
                          "organism": "MediaFrame",
                          "props": {
                            "alt": {
                              "$": "title"
                            },
                            "ratio": "4/3"
                          }
                        }
                      ]
                    }
                  }
                }
              ],
              "else": [
                {
                  "organism": "SectionFrame",
                  "props": {
                    "id": {
                      "$": "id"
                    },
                    "title": {
                      "$": "title"
                    },
                    "lead": {
                      "$": "lead"
                    },
                    "heading": {
                      "badge": {
                        "$": "badge"
                      }
                    },
                    "tone": {
                      "$": "tone"
                    },
                    "landmarkLabel": {
                      "$": "landmarkLabel"
                    }
                  },
                  "slots": {
                    "children": {
                      "args": [],
                      "do": [
                        {
                          "use": "Box",
                          "props": {
                            "Class": {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "cols"
                                    },
                                    "2"
                                  ]
                                },
                                "grid grid-cols-1 gap-6 md:grid-cols-2",
                                "grid grid-cols-1 gap-6 md:grid-cols-3"
                              ]
                            }
                          },
                          "children": [
                            {
                              "each": {
                                "$": "posts"
                              },
                              "as": "p",
                              "key": {
                                "$": "p.id"
                              },
                              "do": [
                                {
                                  "when": {
                                    "op": "lt",
                                    "args": [
                                      {
                                        "$": "i"
                                      },
                                      {
                                        "op": "cond",
                                        "args": [
                                          {
                                            "op": "eq",
                                            "args": [
                                              {
                                                "$": "cols"
                                              },
                                              "2"
                                            ]
                                          },
                                          2,
                                          3
                                        ]
                                      }
                                    ]
                                  },
                                  "then": [
                                    {
                                      "organism": "PostOverlayCard",
                                      "props": {
                                        "p": {
                                          "$": "p"
                                        },
                                        "labels": {
                                          "$": "labels"
                                        },
                                        "ratio": {
                                          "op": "cond",
                                          "args": [
                                            {
                                              "op": "eq",
                                              "args": [
                                                {
                                                  "$": "cols"
                                                },
                                                "2"
                                              ]
                                            },
                                            "16/9",
                                            "4/3"
                                          ]
                                        }
                                      }
                                    }
                                  ]
                                }
                              ],
                              "index": "i"
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "PostCard",
      "names": [
        "Post",
        "PostLabels"
      ]
    },
    {
      "from": "SectionFrame",
      "names": [
        "HeadLink"
      ]
    }
  ]
}
