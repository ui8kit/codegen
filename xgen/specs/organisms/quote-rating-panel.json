{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.quote-rating-panel",
  "name": "QuoteRatingPanel",
  "docs": "The rating summary of QuoteSplit: the average in large type, the stars, the number of reviews and two figures.",
  "records": {},
  "props": [
    {
      "name": "extras",
      "type": {
        "ts": "QuoteExtras"
      },
      "required": true,
      "docs": "the figures, logos and rating summary"
    },
    {
      "name": "labels",
      "type": {
        "ts": "QuoteLabels"
      },
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Stack",
      "props": {
        "Gap": "6",
        "Align": "center",
        "Class": "rounded bg-card inset-ring inset-ring-border p-8 text-center"
      },
      "attrs": {
        "data-testid": "quote-rating"
      },
      "children": [
        {
          "use": "Text",
          "props": {
            "Size": "5xl",
            "Weight": "bold"
          },
          "children": [
            {
              "text": {
                "$": "extras.score"
              }
            }
          ]
        },
        {
          "organism": "Rating",
          "props": {
            "value": {
              "$": "extras.rating"
            },
            "label": {
              "op": "tpl",
              "args": [
                {
                  "$": "labels.rating"
                },
                {
                  "$": "extras.rating"
                }
              ]
            },
            "size": 20
          }
        },
        {
          "use": "Text",
          "props": {
            "Size": "sm",
            "Class": "text-muted-foreground"
          },
          "children": [
            {
              "text": {
                "$": "extras.reviews"
              }
            }
          ]
        },
        {
          "use": "Box",
          "props": {
            "Class": "grid w-full grid-cols-2 gap-4 border-t border-border pt-6"
          },
          "children": [
            {
              "each": {
                "$": "extras.stats"
              },
              "as": "s",
              "key": {
                "$": "s.id"
              },
              "do": [
                {
                  "when": {
                    "op": "lt",
                    "args": [
                      {
                        "$": "i"
                      },
                      2
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "0",
                        "Align": "center"
                      },
                      "attrs": {
                        "data-testid": "quote-stat"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "2xl",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "s.value"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "s.label"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "index": "i"
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "QuoteSplit",
      "names": [
        "QuoteExtras"
      ]
    },
    {
      "from": "TestimonialGrid",
      "names": [
        "QuoteLabels"
      ]
    }
  ]
}
