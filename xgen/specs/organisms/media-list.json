{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.media-list",
  "name": "MediaList",
  "docs": "A list or figures beside a picture. Axes: layout (figures: four figures in two columns, proof: three figures and a featured review, steps: numbered steps, posts: the latest posts, topics: topic rows with counts, contact: contact buttons and support figures), mediaSide, tone. The actions follow every layout but contact.",
  "records": {
    "MediaExtras": [
      {
        "name": "stats",
        "type": "Stat[]"
      },
      {
        "name": "steps",
        "type": "Step[]"
      },
      {
        "name": "posts",
        "type": "Post[]"
      },
      {
        "name": "topics",
        "type": "Category[]"
      },
      {
        "name": "channels",
        "type": "Feature[]"
      },
      {
        "name": "reviews",
        "type": "Review[]"
      }
    ],
    "MediaListLabels": [
      {
        "name": "list",
        "type": "string"
      },
      {
        "name": "count",
        "type": "string"
      },
      {
        "name": "minutes",
        "type": "string"
      },
      {
        "name": "featured",
        "type": "string"
      },
      {
        "name": "rating",
        "type": "string"
      },
      {
        "name": "figures",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "badge",
      "type": "string",
      "default": "",
      "docs": "a short pill above the heading"
    },
    {
      "name": "extras",
      "type": {
        "record": "MediaExtras"
      },
      "required": true,
      "docs": "the figures, steps, posts, topics, channels and reviews"
    },
    {
      "name": "labels",
      "type": {
        "record": "MediaListLabels"
      },
      "required": true,
      "docs": "the heading of the list; templates: count `{0} articles`, minutes `{0} min read`, rating `{0} out of 5`; the featured-review and figures headings"
    },
    {
      "name": "actions",
      "type": {
        "ts": "LinkActions"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"figures\" | \"proof\" | \"steps\" | \"posts\" | \"topics\" | \"contact\""
      },
      "default": "figures"
    },
    {
      "name": "mediaSide",
      "type": {
        "ts": "\"end\" | \"start\""
      },
      "default": "end"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "heading": {
          "badge": {
            "$": "badge"
          }
        },
        "tone": {
          "$": "tone"
        },
        "layout": "split",
        "media": {
          "show": true,
          "side": {
            "$": "mediaSide"
          }
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "or",
                "args": [
                  {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "figures"
                    ]
                  },
                  {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "proof"
                    ]
                  }
                ]
              },
              "then": [
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "extras.stats"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "organism": "MediaFigures",
                      "props": {
                        "extras": {
                          "$": "extras"
                        },
                        "mode": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "proof"
                              ]
                            },
                            "row",
                            "grid"
                          ]
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "proof"
                ]
              },
              "then": [
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "extras.reviews"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "organism": "MediaReview",
                      "props": {
                        "extras": {
                          "$": "extras"
                        },
                        "labels": {
                          "$": "labels"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "steps"
                ]
              },
              "then": [
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "extras.steps"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "organism": "MediaSteps",
                      "props": {
                        "extras": {
                          "$": "extras"
                        },
                        "labels": {
                          "$": "labels"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "posts"
                ]
              },
              "then": [
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "extras.posts"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "organism": "MediaPosts",
                      "props": {
                        "extras": {
                          "$": "extras"
                        },
                        "labels": {
                          "$": "labels"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "topics"
                ]
              },
              "then": [
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "extras.topics"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "organism": "MediaTopics",
                      "props": {
                        "extras": {
                          "$": "extras"
                        },
                        "labels": {
                          "$": "labels"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "contact"
                ]
              },
              "then": [
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "extras.channels"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "organism": "MediaContacts",
                      "props": {
                        "extras": {
                          "$": "extras"
                        },
                        "labels": {
                          "$": "labels"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "ne",
                "args": [
                  {
                    "$": "layout"
                  },
                  "contact"
                ]
              },
              "then": [
                {
                  "organism": "ActionGroup",
                  "props": {
                    "primary": {
                      "$": "actions.cta"
                    },
                    "primaryHref": {
                      "$": "actions.href"
                    },
                    "secondary": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "actions.mode"
                            },
                            "two"
                          ]
                        },
                        {
                          "$": "actions.secondary"
                        },
                        {
                          "op": "undef",
                          "args": []
                        }
                      ]
                    },
                    "secondaryHref": {
                      "$": "actions.secondaryHref"
                    }
                  }
                }
              ]
            }
          ]
        },
        "aside": {
          "args": [],
          "do": [
            {
              "organism": "MediaFrame",
              "props": {
                "alt": {
                  "$": "title"
                },
                "ratio": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "or",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "layout"
                            },
                            "steps"
                          ]
                        },
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "layout"
                            },
                            "topics"
                          ]
                        }
                      ]
                    },
                    "1/1",
                    "4/3"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "StatsBand",
      "names": [
        "Stat"
      ]
    },
    {
      "from": "StepsList",
      "names": [
        "Step"
      ]
    },
    {
      "from": "PostCard",
      "names": [
        "Post"
      ]
    },
    {
      "from": "CategoryNav",
      "names": [
        "Category"
      ]
    },
    {
      "from": "FeatureGrid",
      "names": [
        "Feature"
      ]
    },
    {
      "from": "ReviewList",
      "names": [
        "Review"
      ]
    },
    {
      "from": "ErrorPage",
      "names": [
        "LinkActions"
      ]
    }
  ]
}
