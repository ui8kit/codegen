{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.slot-grid",
  "name": "SlotGrid",
  "docs": "Delivery windows by day: each day lists its windows as radio chips; closed windows are disabled and struck through. One radio group (`name`) across all days. Static markup.",
  "records": {
    "Day": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "note",
        "type": "string"
      },
      {
        "name": "slots",
        "type": "string[]"
      },
      {
        "name": "closed",
        "type": "string[]"
      }
    ]
  },
  "props": [
    {
      "name": "days",
      "type": {
        "ts": "Day[]"
      },
      "required": true
    },
    {
      "name": "name",
      "type": "string",
      "required": true,
      "docs": "name of the radio group"
    },
    {
      "name": "item",
      "type": {
        "ts": "\"card\" | \"plain\""
      },
      "default": "card",
      "docs": "card: each day in a card; plain: days divided by a line"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Stack",
      "props": {
        "Gap": "4",
        "Align": "stretch"
      },
      "attrs": {
        "data-testid": "days"
      },
      "children": [
        {
          "each": {
            "$": "days"
          },
          "as": "d",
          "key": {
            "$": "d.id"
          },
          "do": [
            {
              "use": "Stack",
              "props": {
                "Gap": "4",
                "Class": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "item"
                        },
                        "card"
                      ]
                    },
                    "rounded bg-card inset-ring inset-ring-border p-4",
                    "border-b border-border pb-4"
                  ]
                }
              },
              "attrs": {
                "data-testid": "day"
              },
              "children": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "4",
                    "Align": "baseline",
                    "Justify": "between",
                    "Class": "flex-wrap"
                  },
                  "children": [
                    {
                      "use": "Text",
                      "props": {
                        "Size": "sm",
                        "Weight": "semibold"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "d.title"
                          }
                        }
                      ]
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "xs",
                        "Class": "text-muted-foreground"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "d.note"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "Box",
                  "props": {
                    "Class": "grid grid-cols-2 gap-2 sm:grid-cols-3"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "d.slots"
                      },
                      "as": "s",
                      "key": {
                        "$": "s"
                      },
                      "do": [
                        {
                          "use": "Label",
                          "props": {
                            "Class": "flex items-center gap-2 rounded px-4 py-2 text-sm inset-ring inset-ring-border has-checked:bg-muted has-checked:inset-ring-foreground"
                          },
                          "children": [
                            {
                              "use": "Radio",
                              "props": {
                                "Name": {
                                  "$": "name"
                                },
                                "Value": {
                                  "op": "tpl",
                                  "args": [
                                    "{0} {1}",
                                    {
                                      "$": "d.id"
                                    },
                                    {
                                      "$": "s"
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "use": "Inline",
                              "children": [
                                {
                                  "text": {
                                    "$": "s"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "each": {
                        "$": "d.closed"
                      },
                      "as": "s",
                      "key": {
                        "$": "s"
                      },
                      "do": [
                        {
                          "use": "Label",
                          "props": {
                            "Class": {
                              "op": "cn",
                              "args": [
                                "flex items-center gap-2 rounded px-4 py-2 text-sm inset-ring inset-ring-border has-checked:bg-muted has-checked:inset-ring-foreground",
                                "text-muted-foreground line-through"
                              ]
                            }
                          },
                          "children": [
                            {
                              "use": "Radio",
                              "props": {
                                "Name": {
                                  "$": "name"
                                },
                                "Value": {
                                  "op": "tpl",
                                  "args": [
                                    "{0} {1}",
                                    {
                                      "$": "d.id"
                                    },
                                    {
                                      "$": "s"
                                    }
                                  ]
                                },
                                "Disabled": true
                              }
                            },
                            {
                              "use": "Inline",
                              "children": [
                                {
                                  "text": {
                                    "$": "s"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
