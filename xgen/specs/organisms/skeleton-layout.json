{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.skeleton-layout",
  "name": "SkeletonLayout",
  "docs": "The loading state of a page: grey blocks in the shape of the content that is coming (cards, a list of rows or an article). Axes: shape (cards, list, article), tone. The label tells assistive technology that the content is loading. The shimmer itself belongs to the Skeleton part.",
  "records": {
    "Line": [
      {
        "name": "id",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "docs": "e.g. `Loading`"
    },
    {
      "name": "lines",
      "type": {
        "ts": "Line[]"
      },
      "required": true,
      "docs": "how many placeholders to draw"
    },
    {
      "name": "shape",
      "type": {
        "ts": "\"cards\" | \"list\" | \"article\""
      },
      "default": "cards"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "use": "Block",
              "props": {
                "Tag": "div",
                "Class": "w-full"
              },
              "attrs": {
                "role": "status",
                "aria-label": {
                  "$": "label"
                },
                "data-testid": "skeleton",
                "data-shape": {
                  "$": "shape"
                }
              },
              "children": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "shape"
                      },
                      "cards"
                    ]
                  },
                  "then": [
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": "1-3",
                        "Class": "gap-4"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "lines"
                          },
                          "as": "l",
                          "key": {
                            "$": "l.id"
                          },
                          "do": [
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "4",
                                "Class": "rounded bg-card inset-ring inset-ring-border p-4"
                              },
                              "attrs": {
                                "data-testid": "item"
                              },
                              "children": [
                                {
                                  "use": "Skeleton",
                                  "props": {
                                    "Class": "aspect-video w-full"
                                  }
                                },
                                {
                                  "use": "Skeleton",
                                  "props": {
                                    "Class": "h-4 w-2/3"
                                  }
                                },
                                {
                                  "use": "Skeleton",
                                  "props": {
                                    "Class": "h-4 w-full"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "shape"
                          },
                          "list"
                        ]
                      },
                      "then": [
                        {
                          "use": "Stack",
                          "props": {
                            "Gap": "4",
                            "Align": "stretch"
                          },
                          "children": [
                            {
                              "each": {
                                "$": "lines"
                              },
                              "as": "l",
                              "key": {
                                "$": "l.id"
                              },
                              "do": [
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "4",
                                    "Align": "center"
                                  },
                                  "attrs": {
                                    "data-testid": "item"
                                  },
                                  "children": [
                                    {
                                      "use": "Skeleton",
                                      "props": {
                                        "Class": "size-10 shrink-0 rounded-full"
                                      }
                                    },
                                    {
                                      "use": "Stack",
                                      "props": {
                                        "Gap": "2",
                                        "Class": "flex-1"
                                      },
                                      "children": [
                                        {
                                          "use": "Skeleton",
                                          "props": {
                                            "Class": "h-4 w-1/3"
                                          }
                                        },
                                        {
                                          "use": "Skeleton",
                                          "props": {
                                            "Class": "h-4 w-full"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "else": [
                        {
                          "use": "Stack",
                          "props": {
                            "Gap": "4",
                            "Align": "stretch",
                            "Class": "mx-auto max-w-2xl"
                          },
                          "children": [
                            {
                              "use": "Skeleton",
                              "props": {
                                "Class": "h-8 w-3/4"
                              }
                            },
                            {
                              "each": {
                                "$": "lines"
                              },
                              "as": "l",
                              "key": {
                                "$": "l.id"
                              },
                              "do": [
                                {
                                  "use": "Stack",
                                  "props": {
                                    "Gap": "2"
                                  },
                                  "attrs": {
                                    "data-testid": "item"
                                  },
                                  "children": [
                                    {
                                      "use": "Skeleton",
                                      "props": {
                                        "Class": "h-4 w-full"
                                      }
                                    },
                                    {
                                      "use": "Skeleton",
                                      "props": {
                                        "Class": "h-4 w-5/6"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
