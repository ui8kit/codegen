{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.before-after",
  "name": "BeforeAfter",
  "docs": "Two columns that set life without the product against life with it, point by point. Axes: layout (cards: two cards, rows: one row per point), icons (show, hide), tone, density.",
  "records": {
    "Contrast": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "before",
        "type": "string"
      },
      {
        "name": "after",
        "type": "string"
      }
    ],
    "BeforeAfterLabels": [
      {
        "name": "before",
        "type": "string"
      },
      {
        "name": "after",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "points",
      "type": {
        "ts": "Contrast[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "labels",
      "type": {
        "record": "BeforeAfterLabels"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"cards\" | \"rows\""
      },
      "default": "cards"
    },
    {
      "name": "icons",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "points"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "git-compare",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "cards"
                    ]
                  },
                  "then": [
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": "1-2",
                        "Class": "items-stretch gap-4"
                      },
                      "attrs": {
                        "data-testid": "sides"
                      },
                      "children": [
                        {
                          "use": "Card",
                          "props": {
                            "Variant": "muted",
                            "Class": {
                              "op": "cn",
                              "args": [
                                "h-full",
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "density"
                                        },
                                        "compact"
                                      ]
                                    },
                                    "gap-4 p-4",
                                    ""
                                  ]
                                }
                              ]
                            }
                          },
                          "attrs": {
                            "data-testid": "side",
                            "data-side": "before"
                          },
                          "children": [
                            {
                              "use": "CardContent",
                              "props": {
                                "Class": "flex flex-col gap-4"
                              },
                              "children": [
                                {
                                  "use": "Title",
                                  "props": {
                                    "As": 3,
                                    "Size": "xl",
                                    "Weight": "bold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "labels.before"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "List",
                                  "props": {
                                    "Class": "m-0 flex list-none flex-col gap-4 p-0"
                                  },
                                  "children": [
                                    {
                                      "each": {
                                        "$": "points"
                                      },
                                      "as": "p",
                                      "key": {
                                        "$": "p.id"
                                      },
                                      "do": [
                                        {
                                          "use": "ListItem",
                                          "props": {
                                            "Class": "flex items-start gap-4"
                                          },
                                          "attrs": {
                                            "data-testid": "item"
                                          },
                                          "children": [
                                            {
                                              "when": {
                                                "op": "eq",
                                                "args": [
                                                  {
                                                    "$": "icons"
                                                  },
                                                  "show"
                                                ]
                                              },
                                              "then": [
                                                {
                                                  "use": "LucideIcon",
                                                  "props": {
                                                    "Name": "x",
                                                    "Size": 16,
                                                    "Class": "h-lh shrink-0 text-sm"
                                                  }
                                                }
                                              ]
                                            },
                                            {
                                              "use": "Text",
                                              "props": {
                                                "Size": "sm"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "p.before"
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "use": "Card",
                          "props": {
                            "Variant": "default",
                            "Class": {
                              "op": "cn",
                              "args": [
                                "h-full",
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "density"
                                        },
                                        "compact"
                                      ]
                                    },
                                    "gap-4 p-4",
                                    ""
                                  ]
                                }
                              ]
                            }
                          },
                          "attrs": {
                            "data-testid": "side",
                            "data-side": "after"
                          },
                          "children": [
                            {
                              "use": "CardContent",
                              "props": {
                                "Class": "flex flex-col gap-4"
                              },
                              "children": [
                                {
                                  "use": "Title",
                                  "props": {
                                    "As": 3,
                                    "Size": "xl",
                                    "Weight": "bold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "labels.after"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "List",
                                  "props": {
                                    "Class": "m-0 flex list-none flex-col gap-4 p-0"
                                  },
                                  "children": [
                                    {
                                      "each": {
                                        "$": "points"
                                      },
                                      "as": "p",
                                      "key": {
                                        "$": "p.id"
                                      },
                                      "do": [
                                        {
                                          "use": "ListItem",
                                          "props": {
                                            "Class": "flex items-start gap-4"
                                          },
                                          "attrs": {
                                            "data-testid": "item"
                                          },
                                          "children": [
                                            {
                                              "when": {
                                                "op": "eq",
                                                "args": [
                                                  {
                                                    "$": "icons"
                                                  },
                                                  "show"
                                                ]
                                              },
                                              "then": [
                                                {
                                                  "use": "LucideIcon",
                                                  "props": {
                                                    "Name": "check",
                                                    "Size": 16,
                                                    "Class": "h-lh shrink-0 text-sm"
                                                  }
                                                }
                                              ]
                                            },
                                            {
                                              "use": "Text",
                                              "props": {
                                                "Size": "sm"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "p.after"
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "2",
                        "Align": "stretch"
                      },
                      "attrs": {
                        "data-testid": "rows"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "points"
                          },
                          "as": "p",
                          "key": {
                            "$": "p.id"
                          },
                          "do": [
                            {
                              "use": "Grid",
                              "props": {
                                "Cols": "1-3",
                                "Class": {
                                  "op": "cn",
                                  "args": [
                                    "items-center gap-4",
                                    "rounded bg-card inset-ring inset-ring-border p-4"
                                  ]
                                }
                              },
                              "attrs": {
                                "data-testid": "item"
                              },
                              "children": [
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "base",
                                    "Weight": "semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "p.title"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "2",
                                    "Align": "start"
                                  },
                                  "children": [
                                    {
                                      "when": {
                                        "op": "eq",
                                        "args": [
                                          {
                                            "$": "icons"
                                          },
                                          "show"
                                        ]
                                      },
                                      "then": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": "x",
                                            "Size": 16,
                                            "Class": "h-lh shrink-0 text-sm text-muted-foreground"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "sm",
                                        "Class": "text-muted-foreground"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "p.before"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "2",
                                    "Align": "start"
                                  },
                                  "children": [
                                    {
                                      "when": {
                                        "op": "eq",
                                        "args": [
                                          {
                                            "$": "icons"
                                          },
                                          "show"
                                        ]
                                      },
                                      "then": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": "check",
                                            "Size": 16,
                                            "Class": "h-lh shrink-0 text-sm text-primary"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "sm",
                                        "Weight": "semibold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "p.after"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
