{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.icon-wall",
  "name": "IconWall",
  "docs": "A dense grid of small tiles: an icon and a short label. Axes: columns (3, 4, 6), item (tile: icon above the label, chip: icon beside it), tone, density.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "features",
      "type": {
        "ts": "Feature[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"3\" | \"4\" | \"6\""
      },
      "default": "4"
    },
    {
      "name": "item",
      "type": {
        "ts": "\"tile\" | \"chip\""
      },
      "default": "tile"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "derived": [
    {
      "name": "askedCols",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "item"
                  },
                  "chip"
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "$": "cols"
                  },
                  "6"
                ]
              }
            ]
          },
          "2-6",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "cols"
                  },
                  "2"
                ]
              },
              "2",
              {
                "op": "cond",
                "args": [
                  {
                    "op": "eq",
                    "args": [
                      {
                        "$": "cols"
                      },
                      "3"
                    ]
                  },
                  "2-3",
                  {
                    "op": "cond",
                    "args": [
                      {
                        "op": "eq",
                        "args": [
                          {
                            "$": "cols"
                          },
                          "4"
                        ]
                      },
                      "2-4",
                      "3-6"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "wallCols",
      "value": {
        "op": "fitCols",
        "args": [
          {
            "$": "askedCols"
          },
          {
            "op": "len",
            "args": [
              {
                "$": "features"
              }
            ]
          }
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "features"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "layout-grid",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Grid",
                  "props": {
                    "Cols": {
                      "$": "wallCols"
                    },
                    "Class": "gap-4"
                  },
                  "attrs": {
                    "data-testid": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "features"
                      },
                      "as": "f",
                      "key": {
                        "$": "f.id"
                      },
                      "do": [
                        {
                          "use": "Box",
                          "props": {
                            "Class": {
                              "op": "cn",
                              "args": [
                                "flex items-center gap-2",
                                "rounded bg-card inset-ring inset-ring-border",
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "item"
                                        },
                                        "tile"
                                      ]
                                    },
                                    {
                                      "op": "cn",
                                      "args": [
                                        "flex-col justify-center text-center",
                                        {
                                          "op": "cond",
                                          "args": [
                                            {
                                              "op": "eq",
                                              "args": [
                                                {
                                                  "$": "density"
                                                },
                                                "compact"
                                              ]
                                            },
                                            "p-4",
                                            "p-6"
                                          ]
                                        }
                                      ]
                                    },
                                    "px-4 py-2"
                                  ]
                                }
                              ]
                            }
                          },
                          "attrs": {
                            "data-testid": "item"
                          },
                          "children": [
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": {
                                  "$": "f.icon"
                                },
                                "Size": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "item"
                                        },
                                        "tile"
                                      ]
                                    },
                                    24,
                                    16
                                  ]
                                }
                              }
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "sm",
                                "Weight": "semibold"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "f.title"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "FeatureGrid",
      "names": [
        "Feature"
      ]
    }
  ]
}
