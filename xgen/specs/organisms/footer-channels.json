{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.footer-channels",
  "name": "FooterChannels",
  "docs": "The channels of the community as three cards: a glyph over the name and one line.",
  "records": {},
  "props": [
    {
      "name": "extras",
      "type": {
        "ts": "FooterExtras"
      },
      "required": true,
      "docs": "the figures, points, contacts and channels"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "gt",
        "args": [
          {
            "op": "len",
            "args": [
              {
                "$": "extras.channels"
              }
            ]
          },
          0
        ]
      },
      "then": [
        {
          "use": "Box",
          "props": {
            "Class": "grid grid-cols-1 gap-4 sm:grid-cols-3"
          },
          "children": [
            {
              "each": {
                "$": "extras.channels"
              },
              "as": "c",
              "key": {
                "$": "c.id"
              },
              "do": [
                {
                  "when": {
                    "op": "lt",
                    "args": [
                      {
                        "$": "i"
                      },
                      3
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "2",
                        "Align": "start",
                        "Class": "rounded bg-card inset-ring inset-ring-border p-4"
                      },
                      "attrs": {
                        "data-testid": "footer-channel"
                      },
                      "children": [
                        {
                          "use": "Inline",
                          "props": {
                            "Class": "flex size-10 shrink-0 items-center justify-center rounded bg-muted text-foreground"
                          },
                          "children": [
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": {
                                  "$": "c.icon"
                                },
                                "Size": 20
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "c.title"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "c.text"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "index": "i"
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "FooterSplit",
      "names": [
        "FooterExtras",
        "FooterSplitLabels"
      ]
    }
  ]
}
