{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.mega-menu",
  "name": "MegaMenu",
  "docs": "A top bar whose first item opens a wide panel of link groups, each with an icon and a list, and an optional promo card. The page keeps `open`; opening on hover or click is a port contract. Axes: panel (open, closed), cols (2, 3), promo (none, card).",
  "records": {
    "MegaGroup": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "icon",
        "type": "string"
      },
      {
        "name": "links",
        "type": "NavLink[]"
      },
      {
        "name": "href",
        "type": "string",
        "optional": true
      }
    ]
  },
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": true
    },
    {
      "name": "brand",
      "type": "string",
      "required": true
    },
    {
      "name": "brandHref",
      "type": "string",
      "docs": "the address of the home page; none: the brand is text"
    },
    {
      "name": "trigger",
      "type": "string",
      "required": true,
      "docs": "text of the item that opens the panel"
    },
    {
      "name": "links",
      "type": {
        "ts": "NavLink[]"
      },
      "required": true,
      "docs": "the other items of the bar"
    },
    {
      "name": "groups",
      "type": {
        "ts": "MegaGroup[]"
      },
      "required": true
    },
    {
      "name": "promoTitle",
      "type": "string"
    },
    {
      "name": "promoText",
      "type": "string"
    },
    {
      "name": "panel",
      "type": {
        "ts": "\"open\" | \"closed\""
      },
      "default": "open"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"2\" | \"3\""
      },
      "default": "3"
    },
    {
      "name": "promo",
      "type": {
        "ts": "\"none\" | \"card\""
      },
      "default": "none"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "header",
        "Class": "relative border-b border-border bg-background"
      },
      "attrs": {
        "data-testid": "mega-menu",
        "aria-label": {
          "$": "landmarkLabel"
        }
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": {
              "op": "cn",
              "args": [
                "mx-auto w-full max-w-6xl px-4",
                "flex flex-wrap items-center gap-6 py-4"
              ]
            }
          },
          "attrs": {
            "data-slot": "container"
          },
          "children": [
            {
              "organism": "MenuEntry",
              "props": {
                "href": {
                  "$": "brandHref"
                },
                "className": "text-lg font-medium",
                "testid": "brand"
              },
              "slots": {
                "children": {
                  "args": [],
                  "do": [
                    {
                      "text": {
                        "$": "brand"
                      }
                    }
                  ]
                }
              }
            },
            {
              "organism": "NavBlock",
              "props": {
                "label": {
                  "op": "cond",
                  "args": [
                    {
                      "$": "landmarkLabel"
                    },
                    {
                      "op": "uniq",
                      "args": [
                        {
                          "op": "tpl",
                          "args": [
                            "{0}, {1}",
                            {
                              "$": "label"
                            },
                            {
                              "$": "landmarkLabel"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "$": "label"
                    }
                  ]
                },
                "className": "flex-1"
              },
              "slots": {
                "children": {
                  "args": [],
                  "do": [
                    {
                      "use": "Group",
                      "props": {
                        "Gap": "4",
                        "Align": "center",
                        "Class": "flex-wrap"
                      },
                      "children": [
                        {
                          "use": "ButtonPlain",
                          "props": {
                            "Type": "button",
                            "Class": "inline-flex items-center gap-2 text-sm font-semibold"
                          },
                          "attrs": {
                            "aria-expanded": {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "panel"
                                    },
                                    "open"
                                  ]
                                },
                                "true",
                                "false"
                              ]
                            },
                            "data-testid": "mega-trigger"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "trigger"
                              }
                            },
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": "chevron-down",
                                "Size": 16
                              }
                            }
                          ]
                        },
                        {
                          "each": {
                            "$": "links"
                          },
                          "as": "l",
                          "key": {
                            "$": "l.id"
                          },
                          "do": [
                            {
                              "organism": "MenuEntry",
                              "props": {
                                "href": {
                                  "$": "l.href"
                                },
                                "className": "text-sm",
                                "current": {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "l.id"
                                    },
                                    ""
                                  ]
                                },
                                "testid": "nav-link"
                              },
                              "slots": {
                                "children": {
                                  "args": [],
                                  "do": [
                                    {
                                      "text": {
                                        "$": "l.name"
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "$": "panel"
          },
          "open"
        ]
      },
      "then": [
        {
          "use": "Box",
          "props": {
            "Class": "border-t border-border bg-card"
          },
          "attrs": {
            "data-testid": "mega-panel"
          },
          "children": [
            {
              "use": "Container",
              "props": {
                "Class": {
                  "op": "cn",
                  "args": [
                    "mx-auto w-full max-w-6xl px-4",
                    "grid gap-8 py-6",
                    {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "promo"
                            },
                            "card"
                          ]
                        },
                        "md:grid-cols-[1fr_16rem]",
                        ""
                      ]
                    }
                  ]
                }
              },
              "attrs": {
                "data-slot": "container"
              },
              "children": [
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "groups"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "cols"
                                },
                                "2"
                              ]
                            },
                            "1-2",
                            "1-3"
                          ]
                        },
                        "Class": "gap-6"
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "groups"
                          },
                          "as": "g",
                          "key": {
                            "$": "g.id"
                          },
                          "do": [
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "2"
                              },
                              "attrs": {
                                "data-testid": "item"
                              },
                              "children": [
                                {
                                  "use": "Group",
                                  "props": {
                                    "Gap": "2",
                                    "Align": "center"
                                  },
                                  "children": [
                                    {
                                      "use": "LucideIcon",
                                      "props": {
                                        "Name": {
                                          "$": "g.icon"
                                        },
                                        "Size": 16
                                      }
                                    },
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "sm",
                                        "Weight": "semibold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "g.title"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "List",
                                  "props": {
                                    "Class": "m-0 flex list-none flex-col gap-2 p-0"
                                  },
                                  "children": [
                                    {
                                      "each": {
                                        "$": "g.links"
                                      },
                                      "as": "item",
                                      "key": {
                                        "$": "item.id"
                                      },
                                      "do": [
                                        {
                                          "use": "ListItem",
                                          "children": [
                                            {
                                              "organism": "MenuEntry",
                                              "props": {
                                                "href": {
                                                  "$": "item.href"
                                                },
                                                "className": "text-sm text-muted-foreground"
                                              },
                                              "slots": {
                                                "children": {
                                                  "args": [],
                                                  "do": [
                                                    {
                                                      "text": {
                                                        "$": "item.name"
                                                      }
                                                    }
                                                  ]
                                                }
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "promo"
                      },
                      "card"
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "2",
                        "Class": "rounded bg-card inset-ring inset-ring-border p-4"
                      },
                      "attrs": {
                        "data-testid": "promo"
                      },
                      "children": [
                        {
                          "organism": "MediaFrame",
                          "props": {
                            "alt": {
                              "op": "coalesce",
                              "args": [
                                {
                                  "$": "promoTitle"
                                },
                                ""
                              ]
                            },
                            "ratio": "4/3"
                          }
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "base",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "promoTitle"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "promoText"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "NavBar",
      "names": [
        "NavLink"
      ]
    }
  ]
}
