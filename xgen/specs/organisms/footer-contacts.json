{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.footer-contacts",
  "name": "FooterContacts",
  "docs": "The ways to reach the team in a column: a glyph tile, the kind (Email, Phone) and the value.",
  "records": {},
  "props": [
    {
      "name": "extras",
      "type": {
        "ts": "FooterExtras"
      },
      "required": true,
      "docs": "the figures, points, contacts and channels"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "gt",
        "args": [
          {
            "op": "len",
            "args": [
              {
                "$": "extras.contacts"
              }
            ]
          },
          0
        ]
      },
      "then": [
        {
          "use": "Stack",
          "props": {
            "Gap": "4",
            "Align": "stretch"
          },
          "children": [
            {
              "each": {
                "$": "extras.contacts"
              },
              "as": "c",
              "key": {
                "$": "c.id"
              },
              "do": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "4",
                    "Align": "center"
                  },
                  "attrs": {
                    "data-testid": "footer-contact"
                  },
                  "children": [
                    {
                      "use": "Inline",
                      "props": {
                        "Class": "flex size-10 shrink-0 items-center justify-center rounded bg-muted text-foreground"
                      },
                      "children": [
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": {
                              "$": "c.icon"
                            },
                            "Size": 20
                          }
                        }
                      ]
                    },
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "0"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "c.title"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "c.text"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "FooterSplit",
      "names": [
        "FooterExtras",
        "FooterSplitLabels"
      ]
    }
  ]
}
