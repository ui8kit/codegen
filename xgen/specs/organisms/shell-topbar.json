{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.shell-topbar",
  "name": "ShellTopbar",
  "docs": "The top bar of DashboardShell: the brand (when no sidebar carries it), the links (when there is no sidebar), an optional search field, and the signed-in person.",
  "records": {},
  "props": [
    {
      "name": "nav",
      "type": {
        "ts": "ShellNav"
      },
      "required": true,
      "docs": "the brand, the links and the texts of the shell"
    },
    {
      "name": "brand",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "links",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "hide"
    },
    {
      "name": "search",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "header",
        "Class": "flex h-16 shrink-0 items-center gap-6 border-b border-border bg-background px-6"
      },
      "attrs": {
        "data-testid": "topbar",
        "aria-label": {
          "$": "landmarkLabel"
        }
      },
      "children": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "brand"
              },
              "show"
            ]
          },
          "then": [
            {
              "use": "Group",
              "props": {
                "Gap": "2",
                "Align": "center",
                "Class": "shrink-0"
              },
              "attrs": {
                "data-testid": "brand"
              },
              "children": [
                {
                  "use": "LucideIcon",
                  "props": {
                    "Name": "layers",
                    "Size": 24
                  }
                },
                {
                  "use": "Text",
                  "props": {
                    "Size": "base",
                    "Weight": "bold",
                    "Class": {
                      "op": "cond",
                      "args": [
                        true,
                        "",
                        "sr-only"
                      ]
                    }
                  },
                  "children": [
                    {
                      "text": {
                        "$": "nav.brand"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "links"
                  },
                  "show"
                ]
              },
              {
                "op": "gt",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "nav.links"
                      }
                    ]
                  },
                  0
                ]
              }
            ]
          },
          "then": [
            {
              "organism": "NavBlock",
              "props": {
                "label": {
                  "op": "cond",
                  "args": [
                    {
                      "$": "landmarkLabel"
                    },
                    {
                      "op": "uniq",
                      "args": [
                        {
                          "op": "tpl",
                          "args": [
                            "{0}, {1}",
                            {
                              "$": "nav.label"
                            },
                            {
                              "$": "landmarkLabel"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "$": "nav.label"
                    }
                  ]
                },
                "className": "hidden lg:block"
              },
              "slots": {
                "children": {
                  "args": [],
                  "do": [
                    {
                      "use": "List",
                      "props": {
                        "Class": "m-0 flex list-none items-center gap-2 p-0"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "nav.links"
                          },
                          "as": "l",
                          "key": {
                            "$": "l.id"
                          },
                          "do": [
                            {
                              "use": "ListItem",
                              "children": [
                                {
                                  "organism": "MenuEntry",
                                  "props": {
                                    "href": {
                                      "$": "l.href"
                                    },
                                    "className": {
                                      "op": "cn",
                                      "args": [
                                        "flex items-center gap-4 rounded py-2 text-sm",
                                        {
                                          "op": "cond",
                                          "args": [
                                            true,
                                            "px-4",
                                            "justify-center px-2"
                                          ]
                                        },
                                        {
                                          "op": "cond",
                                          "args": [
                                            {
                                              "op": "eq",
                                              "args": [
                                                {
                                                  "$": "l.id"
                                                },
                                                {
                                                  "$": "nav.current"
                                                }
                                              ]
                                            },
                                            "bg-muted font-medium",
                                            ""
                                          ]
                                        }
                                      ]
                                    },
                                    "current": {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "l.id"
                                        },
                                        {
                                          "$": "nav.current"
                                        }
                                      ]
                                    },
                                    "size": "sm",
                                    "testid": "item"
                                  },
                                  "slots": {
                                    "children": {
                                      "args": [],
                                      "do": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": {
                                              "$": "l.icon"
                                            },
                                            "Size": 16
                                          }
                                        },
                                        {
                                          "use": "Inline",
                                          "props": {
                                            "Class": {
                                              "op": "cond",
                                              "args": [
                                                true,
                                                "",
                                                "sr-only"
                                              ]
                                            }
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "l.name"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "search"
              },
              "show"
            ]
          },
          "then": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "links"
                  },
                  "show"
                ]
              },
              "then": [
                {
                  "use": "Box",
                  "props": {
                    "Class": "ml-auto hidden w-64 shrink-0 xl:block"
                  },
                  "children": [
                    {
                      "organism": "SearchPalette",
                      "props": {
                        "label": {
                          "$": "nav.search"
                        },
                        "shortcut": {
                          "$": "nav.shortcut"
                        }
                      }
                    }
                  ]
                }
              ],
              "else": [
                {
                  "organism": "SearchPalette",
                  "props": {
                    "label": {
                      "$": "nav.search"
                    },
                    "shortcut": {
                      "$": "nav.shortcut"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "use": "Group",
          "props": {
            "Gap": "4",
            "Align": "center",
            "Class": {
              "op": "cond",
              "args": [
                {
                  "op": "and",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "links"
                        },
                        "show"
                      ]
                    },
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "search"
                        },
                        "show"
                      ]
                    }
                  ]
                },
                "shrink-0",
                "ml-auto shrink-0"
              ]
            }
          },
          "attrs": {
            "data-testid": "user"
          },
          "children": [
            {
              "use": "LucideIcon",
              "props": {
                "Name": "bell",
                "Size": 20,
                "Class": "text-muted-foreground"
              }
            },
            {
              "organism": "MediaFrame",
              "props": {
                "alt": {
                  "$": "nav.userName"
                },
                "ratio": "1/1",
                "className": "size-8 shrink-0 rounded-full"
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "frame": true,
  "typeImports": [
    {
      "from": "DashboardShell",
      "names": [
        "ShellNav"
      ]
    }
  ]
}
