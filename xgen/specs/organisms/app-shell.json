{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.app-shell",
  "name": "AppShell",
  "docs": "The frame of a signed-in app with a first screen in it. Axes: layout (sidebar: navigation on the left, top: a bar above the content, panes: a narrow navigation, a list and a detail), density. The collapse of the sidebar is a port contract.",
  "records": {
    "AppNav": [
      {
        "name": "label",
        "type": "string",
        "optional": false,
        "docs": "accessible name of the navigation"
      },
      {
        "name": "brand",
        "type": "string",
        "optional": false
      },
      {
        "name": "links",
        "type": "NavLink[]",
        "optional": false
      },
      {
        "name": "current",
        "type": "string",
        "optional": true,
        "docs": "id of the current link"
      }
    ],
    "AppUser": [
      {
        "name": "name",
        "type": "string",
        "optional": false
      },
      {
        "name": "email",
        "type": "string",
        "optional": false
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "nav",
      "type": {
        "record": "AppNav"
      },
      "required": true,
      "docs": "the navigation (sidebar or top bar)"
    },
    {
      "name": "user",
      "type": {
        "record": "AppUser"
      },
      "required": true,
      "docs": "the signed-in person, under the sidebar"
    },
    {
      "name": "search",
      "type": {
        "ts": "NavSearch"
      },
      "required": true,
      "docs": "the search field of the top bar"
    },
    {
      "name": "metrics",
      "type": {
        "ts": "Metric[]"
      },
      "required": true
    },
    {
      "name": "chart",
      "type": {
        "ts": "OverviewChart"
      },
      "required": true
    },
    {
      "name": "activity",
      "type": {
        "ts": "OverviewActivity"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"sidebar\" | \"top\" | \"panes\""
      },
      "default": "sidebar"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": "bg-background"
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            {
              "op": "tpl",
              "args": [
                "{0}-title",
                {
                  "$": "id"
                }
              ]
            }
          ]
        },
        "data-testid": "app-shell",
        "data-layout": {
          "$": "layout"
        },
        "aria-label": {
          "$": "landmarkLabel"
        }
      },
      "children": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "top"
            ]
          },
          "then": [
            {
              "use": "Stack",
              "props": {
                "Gap": "6",
                "Align": "stretch"
              },
              "children": [
                {
                  "organism": "NavBar",
                  "props": {
                    "label": {
                      "$": "nav.label"
                    },
                    "brand": {
                      "$": "nav.brand"
                    },
                    "links": {
                      "$": "nav.links"
                    },
                    "current": {
                      "$": "nav.current"
                    },
                    "search": {
                      "$": "search"
                    },
                    "actions": {
                      "mode": "none"
                    },
                    "layout": "search",
                    "landmarkLabel": {
                      "$": "landmarkLabel"
                    }
                  }
                },
                {
                  "use": "Container",
                  "props": {
                    "Class": {
                      "op": "cn",
                      "args": [
                        "mx-auto w-full max-w-6xl px-4",
                        "pb-8"
                      ]
                    }
                  },
                  "attrs": {
                    "data-slot": "container"
                  },
                  "children": [
                    {
                      "organism": "AppMain",
                      "props": {
                        "id": {
                          "$": "id"
                        },
                        "title": {
                          "$": "title"
                        },
                        "metrics": {
                          "$": "metrics"
                        },
                        "chart": {
                          "$": "chart"
                        },
                        "cols": "1-4",
                        "activity": {
                          "$": "activity"
                        },
                        "density": {
                          "$": "density"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "else": [
            {
              "use": "Container",
              "props": {
                "Class": {
                  "op": "cn",
                  "args": [
                    "mx-auto w-full max-w-6xl px-4",
                    "py-8"
                  ]
                }
              },
              "attrs": {
                "data-slot": "container"
              },
              "children": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "layout"
                      },
                      "sidebar"
                    ]
                  },
                  "then": [
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": "1",
                        "Class": "items-start gap-6 md:grid-cols-[16rem_minmax(0,1fr)]"
                      },
                      "children": [
                        {
                          "organism": "SidebarNav",
                          "props": {
                            "label": {
                              "$": "nav.label"
                            },
                            "brand": {
                              "$": "nav.brand"
                            },
                            "links": {
                              "$": "nav.links"
                            },
                            "current": {
                              "$": "nav.current"
                            },
                            "userName": {
                              "$": "user.name"
                            },
                            "userEmail": {
                              "$": "user.email"
                            },
                            "density": {
                              "$": "density"
                            },
                            "landmarkLabel": {
                              "$": "landmarkLabel"
                            }
                          }
                        },
                        {
                          "organism": "AppMain",
                          "props": {
                            "id": {
                              "$": "id"
                            },
                            "title": {
                              "$": "title"
                            },
                            "metrics": {
                              "$": "metrics"
                            },
                            "chart": {
                              "$": "chart"
                            },
                            "activity": {
                              "$": "activity"
                            },
                            "density": {
                              "$": "density"
                            }
                          }
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "use": "Grid",
                      "props": {
                        "Cols": "1-3",
                        "Class": "items-start gap-4"
                      },
                      "children": [
                        {
                          "organism": "SidebarNav",
                          "props": {
                            "label": {
                              "$": "nav.label"
                            },
                            "brand": {
                              "$": "nav.brand"
                            },
                            "links": {
                              "$": "nav.links"
                            },
                            "current": {
                              "$": "nav.current"
                            },
                            "userName": {
                              "$": "user.name"
                            },
                            "userEmail": {
                              "$": "user.email"
                            },
                            "width": "compact",
                            "density": {
                              "$": "density"
                            },
                            "landmarkLabel": {
                              "$": "landmarkLabel"
                            }
                          }
                        },
                        {
                          "when": {
                            "op": "gt",
                            "args": [
                              {
                                "op": "len",
                                "args": [
                                  {
                                    "$": "activity.events"
                                  }
                                ]
                              },
                              0
                            ]
                          },
                          "then": [
                            {
                              "organism": "Panel",
                              "props": {
                                "title": {
                                  "$": "activity.title"
                                },
                                "description": {
                                  "$": "activity.text"
                                },
                                "id": {
                                  "op": "tpl",
                                  "args": [
                                    "{0}-list",
                                    {
                                      "$": "id"
                                    }
                                  ]
                                }
                              },
                              "slots": {
                                "children": {
                                  "args": [],
                                  "do": [
                                    {
                                      "use": "List",
                                      "props": {
                                        "Class": "m-0 flex list-none flex-col gap-4 p-0"
                                      },
                                      "attrs": {
                                        "data-testid": "items"
                                      },
                                      "children": [
                                        {
                                          "each": {
                                            "$": "activity.events"
                                          },
                                          "as": "e",
                                          "key": {
                                            "$": "e.id"
                                          },
                                          "do": [
                                            {
                                              "use": "ListItem",
                                              "props": {
                                                "Class": "flex flex-col gap-2"
                                              },
                                              "attrs": {
                                                "data-testid": "item"
                                              },
                                              "children": [
                                                {
                                                  "use": "Text",
                                                  "props": {
                                                    "Size": "sm",
                                                    "Weight": "semibold"
                                                  },
                                                  "children": [
                                                    {
                                                      "text": {
                                                        "$": "e.title"
                                                      }
                                                    }
                                                  ]
                                                },
                                                {
                                                  "use": "Text",
                                                  "props": {
                                                    "Size": "xs",
                                                    "Class": "text-muted-foreground"
                                                  },
                                                  "children": [
                                                    {
                                                      "text": {
                                                        "$": "e.time"
                                                      }
                                                    }
                                                  ]
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        },
                        {
                          "organism": "AppMain",
                          "props": {
                            "id": {
                              "$": "id"
                            },
                            "title": {
                              "$": "title"
                            },
                            "metrics": {
                              "$": "metrics"
                            },
                            "chart": {
                              "$": "chart"
                            },
                            "density": "compact"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "NavBar",
      "names": [
        "NavLink",
        "NavSearch"
      ]
    },
    {
      "from": "MetricRow",
      "names": [
        "Metric"
      ]
    },
    {
      "from": "ChartPanel",
      "names": [
        "Point"
      ]
    },
    {
      "from": "ActivityFeed",
      "names": [
        "Event"
      ]
    },
    {
      "from": "DashboardOverview",
      "names": [
        "OverviewChart",
        "OverviewActivity"
      ]
    }
  ]
}
