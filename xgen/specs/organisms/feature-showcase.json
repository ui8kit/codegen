{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.feature-showcase",
  "name": "FeatureShowcase",
  "docs": "Features as cards under a centered heading. Axes: item (picture: a picture on top, then the title, the text and a read link; panel: a muted panel with a large glyph on top, then the title and the text), cols (3, 4), tone.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "features",
      "type": {
        "ts": "Feature[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "more",
      "type": "string",
      "required": true,
      "docs": "the word of the read link of the picture cards"
    },
    {
      "name": "item",
      "type": {
        "ts": "\"picture\" | \"panel\""
      },
      "default": "picture"
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"3\" | \"4\""
      },
      "default": "3"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "align": "center",
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "features"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "layout-grid",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Box",
                  "props": {
                    "Class": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "cols"
                            },
                            "4"
                          ]
                        },
                        "grid grid-cols-1 gap-6 text-start sm:grid-cols-2 lg:grid-cols-4",
                        "grid grid-cols-1 gap-6 text-start sm:grid-cols-2 lg:grid-cols-3"
                      ]
                    }
                  },
                  "children": [
                    {
                      "each": {
                        "$": "features"
                      },
                      "as": "f",
                      "key": {
                        "$": "f.id"
                      },
                      "do": [
                        {
                          "use": "Card",
                          "props": {
                            "Variant": "default",
                            "Class": "h-full gap-4 overflow-hidden"
                          },
                          "attrs": {
                            "data-testid": "showcase-card"
                          },
                          "children": [
                            {
                              "when": {
                                "op": "eq",
                                "args": [
                                  {
                                    "$": "item"
                                  },
                                  "picture"
                                ]
                              },
                              "then": [
                                {
                                  "organism": "MediaFrame",
                                  "props": {
                                    "alt": {
                                      "$": "f.title"
                                    }
                                  }
                                }
                              ],
                              "else": [
                                {
                                  "use": "Box",
                                  "props": {
                                    "Class": "flex aspect-video items-center justify-center rounded bg-muted text-foreground"
                                  },
                                  "attrs": {
                                    "data-testid": "showcase-panel"
                                  },
                                  "children": [
                                    {
                                      "use": "LucideIcon",
                                      "props": {
                                        "Name": {
                                          "$": "f.icon"
                                        },
                                        "Size": 32
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "use": "CardContent",
                              "props": {
                                "Class": "flex flex-1 flex-col gap-2"
                              },
                              "children": [
                                {
                                  "use": "Title",
                                  "props": {
                                    "As": 3,
                                    "Size": "base",
                                    "Weight": "semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "f.title"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Class": "text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "f.text"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "when": {
                                    "op": "eq",
                                    "args": [
                                      {
                                        "$": "item"
                                      },
                                      "picture"
                                    ]
                                  },
                                  "then": [
                                    {
                                      "organism": "MenuEntry",
                                      "props": {
                                        "href": {
                                          "$": "f.href"
                                        },
                                        "className": "mt-auto gap-2 pt-2 text-sm font-medium",
                                        "size": "sm",
                                        "testid": "read"
                                      },
                                      "slots": {
                                        "children": {
                                          "args": [],
                                          "do": [
                                            {
                                              "text": {
                                                "$": "more"
                                              }
                                            },
                                            {
                                              "use": "LucideIcon",
                                              "props": {
                                                "Name": "arrow-right",
                                                "Size": 16
                                              }
                                            }
                                          ]
                                        }
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "FeatureGrid",
      "names": [
        "Feature"
      ]
    }
  ]
}
