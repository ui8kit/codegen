{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.post-tags",
  "name": "PostTags",
  "docs": "The tags of a post as small badges in a wrapping row.",
  "records": {},
  "props": [
    {
      "name": "tags",
      "type": {
        "ts": "NavLink[]"
      },
      "required": true
    },
    {
      "name": "align",
      "type": {
        "ts": "\"start\" | \"center\""
      },
      "default": "start"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Group",
      "props": {
        "Gap": "2",
        "Justify": {
          "$": "align"
        },
        "Class": "flex-wrap"
      },
      "children": [
        {
          "each": {
            "$": "tags"
          },
          "as": "tag",
          "key": {
            "$": "tag.id"
          },
          "do": [
            {
              "use": "Badge",
              "props": {
                "Variant": "secondary",
                "Size": "sm"
              },
              "attrs": {
                "data-testid": "post-tag"
              },
              "children": [
                {
                  "text": {
                    "$": "tag.name"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "NavBar",
      "names": [
        "NavLink"
      ]
    }
  ]
}
