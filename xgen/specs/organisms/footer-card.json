{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.footer-card",
  "name": "FooterCard",
  "docs": "The card layout of SitemapFooter: the brand mark and word, then the link groups in one row, in a rounded card.",
  "records": {},
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": true,
      "docs": "accessible name of the link groups"
    },
    {
      "name": "brand",
      "type": "string",
      "required": true
    },
    {
      "name": "groups",
      "type": {
        "ts": "MegaGroup[]"
      },
      "required": true
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "footer",
        "Class": "py-8"
      },
      "attrs": {
        "data-testid": "site-footer",
        "data-layout": "card",
        "aria-label": {
          "$": "landmarkLabel"
        }
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": {
              "op": "cn",
              "args": [
                {
                  "op": "cn",
                  "args": [
                    "mx-auto w-full px-4",
                    {
                      "op": "preset",
                      "args": [
                        "defaults",
                        "section.landing"
                      ]
                    }
                  ]
                },
                "px-0"
              ]
            }
          },
          "attrs": {
            "data-slot": "container"
          },
          "children": [
            {
              "use": "Box",
              "props": {
                "Class": {
                  "op": "cn",
                  "args": [
                    "flex w-full flex-row items-start overflow-hidden bg-muted p-10",
                    {
                      "op": "preset",
                      "args": [
                        "defaults",
                        "footer.card"
                      ]
                    }
                  ]
                }
              },
              "attrs": {
                "data-testid": "footer-card"
              },
              "children": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "4",
                    "Align": "center",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "h-8 shrink-0",
                        {
                          "op": "preset",
                          "args": [
                            "defaults",
                            "footer.brand"
                          ]
                        }
                      ]
                    }
                  },
                  "attrs": {
                    "data-testid": "footer-brand"
                  },
                  "children": [
                    {
                      "use": "Inline",
                      "props": {
                        "Class": "flex size-8 items-center justify-center rounded bg-foreground text-background"
                      },
                      "children": [
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": "hexagon",
                            "Size": 16
                          }
                        }
                      ]
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "base",
                        "Weight": "bold"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "brand"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "groups"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "organism": "NavBlock",
                      "props": {
                        "label": {
                          "op": "cond",
                          "args": [
                            {
                              "$": "landmarkLabel"
                            },
                            {
                              "op": "uniq",
                              "args": [
                                {
                                  "op": "tpl",
                                  "args": [
                                    "{0}, {1}",
                                    {
                                      "$": "label"
                                    },
                                    {
                                      "$": "landmarkLabel"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "$": "label"
                            }
                          ]
                        },
                        "className": "min-w-0 flex-1"
                      },
                      "slots": {
                        "children": {
                          "args": [],
                          "do": [
                            {
                              "use": "Group",
                              "props": {
                                "Gap": "0",
                                "Align": "start",
                                "Class": {
                                  "op": "cn",
                                  "args": [
                                    "flex w-full flex-nowrap justify-between",
                                    {
                                      "op": "preset",
                                      "args": [
                                        "defaults",
                                        "footer.groups"
                                      ]
                                    }
                                  ]
                                }
                              },
                              "attrs": {
                                "data-testid": "footer-groups"
                              },
                              "children": [
                                {
                                  "each": {
                                    "$": "groups"
                                  },
                                  "as": "g",
                                  "key": {
                                    "$": "g.id"
                                  },
                                  "do": [
                                    {
                                      "use": "Stack",
                                      "props": {
                                        "Gap": "4"
                                      },
                                      "attrs": {
                                        "data-testid": "group"
                                      },
                                      "children": [
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "xs",
                                            "Weight": "semibold",
                                            "Class": "leading-5"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "g.title"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "List",
                                          "props": {
                                            "Class": "m-0 flex list-none flex-col gap-4 p-0"
                                          },
                                          "children": [
                                            {
                                              "each": {
                                                "$": "g.links"
                                              },
                                              "as": "item",
                                              "key": {
                                                "$": "item.id"
                                              },
                                              "do": [
                                                {
                                                  "use": "ListItem",
                                                  "children": [
                                                    {
                                                      "organism": "MenuEntry",
                                                      "props": {
                                                        "href": {
                                                          "$": "item.href"
                                                        },
                                                        "className": "text-xs leading-5 text-muted-foreground"
                                                      },
                                                      "slots": {
                                                        "children": {
                                                          "args": [],
                                                          "do": [
                                                            {
                                                              "text": {
                                                                "$": "item.name"
                                                              }
                                                            }
                                                          ]
                                                        }
                                                      }
                                                    }
                                                  ]
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "frame": true,
  "typeImports": [
    {
      "from": "MegaMenu",
      "names": [
        "MegaGroup"
      ]
    }
  ]
}
