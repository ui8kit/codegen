{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.milestone-timeline",
  "name": "MilestoneTimeline",
  "docs": "Milestones on a line: the year, a tag, a title and a sentence each. Axes: layout (split: a vertical line beside a picture, stacked: a vertical line in a narrow column, row: a horizontal line of columns), tone, density.",
  "records": {
    "Milestone": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "date",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "text",
        "type": "string"
      },
      {
        "name": "tag",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "milestones",
      "type": {
        "ts": "Milestone[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"split\" | \"stacked\" | \"row\""
      },
      "default": "split"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "layout": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "layout"
                },
                "split"
              ]
            },
            "split",
            "stack"
          ]
        },
        "media": {
          "show": {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "split"
            ]
          },
          "side": "start",
          "align": "start"
        },
        "measure": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "layout"
                },
                "stacked"
              ]
            },
            "2xl",
            "default"
          ]
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "milestones"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "milestone",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "List",
                  "props": {
                    "Tag": "ol",
                    "Class": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "layout"
                            },
                            "row"
                          ]
                        },
                        "grid grid-cols-1 gap-8 border-t border-border sm:grid-cols-2 lg:grid-cols-4",
                        "flex flex-col gap-8 border-l border-border"
                      ]
                    }
                  },
                  "attrs": {
                    "data-testid": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "milestones"
                      },
                      "as": "m",
                      "key": {
                        "$": "m.id"
                      },
                      "do": [
                        {
                          "use": "ListItem",
                          "props": {
                            "Class": {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "layout"
                                    },
                                    "row"
                                  ]
                                },
                                "relative flex flex-col gap-2 pt-6",
                                "relative flex flex-col gap-2 pl-6"
                              ]
                            }
                          },
                          "attrs": {
                            "data-testid": "item"
                          },
                          "children": [
                            {
                              "use": "Inline",
                              "props": {
                                "Class": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "layout"
                                        },
                                        "row"
                                      ]
                                    },
                                    "absolute top-0 left-0 size-2 -translate-y-1/2 rounded bg-primary",
                                    "absolute top-2 left-0 size-2 -translate-x-1/2 rounded bg-primary"
                                  ]
                                }
                              },
                              "attrs": {
                                "aria-hidden": "true"
                              }
                            },
                            {
                              "use": "Group",
                              "props": {
                                "Gap": "2",
                                "Align": "center"
                              },
                              "children": [
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Weight": "semibold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "m.date"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Badge",
                                  "props": {
                                    "Variant": "outline",
                                    "Size": "sm"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "m.tag"
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "use": "Title",
                              "props": {
                                "As": 3,
                                "Size": "lg",
                                "Weight": "bold"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "m.title"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "sm",
                                "Class": "text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "m.text"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "aside": {
          "args": [],
          "do": [
            {
              "organism": "MediaFrame",
              "props": {
                "alt": {
                  "$": "title"
                },
                "ratio": "3/4"
              }
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
