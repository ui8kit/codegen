{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.bento-grid",
  "name": "BentoGrid",
  "docs": "Tiles of different sizes in one grid: the large and wide tiles hold the important features. Sizes come from the data (large, wide, small). Axes: layout (bento, even: all tiles alike), media (none, image: a picture in the large tiles), tone, density.",
  "records": {
    "Tile": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "text",
        "type": "string"
      },
      {
        "name": "icon",
        "type": "string"
      },
      {
        "name": "size",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "tiles",
      "type": {
        "ts": "Tile[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"bento\" | \"even\""
      },
      "default": "bento"
    },
    {
      "name": "media",
      "type": {
        "ts": "\"none\" | \"image\""
      },
      "default": "none"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "consts": {
    "SPAN": {
      "large": "md:col-span-2 md:row-span-2",
      "wide": "md:col-span-2",
      "small": ""
    }
  },
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "tiles"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "layout-dashboard",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Grid",
                  "props": {
                    "Cols": "1-4",
                    "Class": "auto-rows-fr gap-4"
                  },
                  "attrs": {
                    "data-testid": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "tiles"
                      },
                      "as": "tile",
                      "key": {
                        "$": "tile.id"
                      },
                      "do": [
                        {
                          "use": "Card",
                          "props": {
                            "Variant": "default",
                            "Class": {
                              "op": "cn",
                              "args": [
                                "h-full overflow-hidden",
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "density"
                                        },
                                        "compact"
                                      ]
                                    },
                                    "gap-4 p-4",
                                    ""
                                  ]
                                },
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "layout"
                                        },
                                        "bento"
                                      ]
                                    },
                                    {
                                      "op": "at",
                                      "args": [
                                        {
                                          "$": "SPAN"
                                        },
                                        {
                                          "$": "tile.size"
                                        }
                                      ]
                                    },
                                    ""
                                  ]
                                }
                              ]
                            }
                          },
                          "attrs": {
                            "data-testid": "item",
                            "data-size": {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "layout"
                                    },
                                    "bento"
                                  ]
                                },
                                {
                                  "$": "tile.size"
                                },
                                "even"
                              ]
                            }
                          },
                          "children": [
                            {
                              "use": "CardContent",
                              "props": {
                                "Class": "flex h-full flex-col gap-4"
                              },
                              "children": [
                                {
                                  "use": "LucideIcon",
                                  "props": {
                                    "Name": {
                                      "$": "tile.icon"
                                    },
                                    "Size": 24
                                  }
                                },
                                {
                                  "use": "Title",
                                  "props": {
                                    "As": 3,
                                    "Size": "xl",
                                    "Weight": "bold"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "tile.title"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "use": "Text",
                                  "props": {
                                    "Size": "sm",
                                    "Class": "text-muted-foreground"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "tile.text"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "when": {
                                    "op": "and",
                                    "args": [
                                      {
                                        "op": "eq",
                                        "args": [
                                          {
                                            "$": "media"
                                          },
                                          "image"
                                        ]
                                      },
                                      {
                                        "op": "or",
                                        "args": [
                                          {
                                            "op": "eq",
                                            "args": [
                                              {
                                                "$": "tile.size"
                                              },
                                              "large"
                                            ]
                                          },
                                          {
                                            "op": "eq",
                                            "args": [
                                              {
                                                "$": "layout"
                                              },
                                              "even"
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  },
                                  "then": [
                                    {
                                      "organism": "MediaFrame",
                                      "props": {
                                        "alt": {
                                          "$": "tile.title"
                                        },
                                        "ratio": "4/3",
                                        "className": "mt-auto"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
