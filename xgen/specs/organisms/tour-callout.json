{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.tour-callout",
  "name": "TourCallout",
  "docs": "One stop of a product tour: the element being explained and a callout beside it with a title, a sentence, the position in the tour and the buttons. Axes: placement (below, above, end: the callout sits beside the target), tone, density.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "text",
      "type": "string",
      "required": true
    },
    {
      "name": "target",
      "type": "string",
      "required": true,
      "docs": "the name of the explained element, drawn as a button"
    },
    {
      "name": "position",
      "type": "string",
      "required": true,
      "docs": "e.g. `Step 2 of 4`"
    },
    {
      "name": "skip",
      "type": "string",
      "required": true
    },
    {
      "name": "next",
      "type": "string",
      "required": true
    },
    {
      "name": "placement",
      "type": {
        "ts": "\"below\" | \"above\" | \"end\""
      },
      "default": "below"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "use": "Block",
              "props": {
                "Tag": "div",
                "Class": {
                  "op": "cn",
                  "args": [
                    "flex gap-4",
                    {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "placement"
                            },
                            "end"
                          ]
                        },
                        "flex-col items-start md:flex-row md:items-center",
                        {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "placement"
                                },
                                "above"
                              ]
                            },
                            "flex-col-reverse items-start",
                            "flex-col items-start"
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              "attrs": {
                "data-testid": "tour",
                "data-placement": {
                  "$": "placement"
                }
              },
              "children": [
                {
                  "use": "Button",
                  "props": {
                    "Variant": "outline",
                    "Size": "default",
                    "Type": "button",
                    "Class": "inset-ring-foreground"
                  },
                  "attrs": {
                    "data-testid": "tour-target"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "target"
                      }
                    }
                  ]
                },
                {
                  "use": "Stack",
                  "props": {
                    "Gap": "4",
                    "Align": "stretch",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "w-full max-w-sm",
                        "rounded bg-card inset-ring inset-ring-border",
                        "p-4",
                        "shadow-md"
                      ]
                    }
                  },
                  "attrs": {
                    "role": "group",
                    "aria-label": {
                      "$": "title"
                    },
                    "data-testid": "tour-callout"
                  },
                  "children": [
                    {
                      "use": "Text",
                      "props": {
                        "Size": "xs",
                        "Class": "text-muted-foreground"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "position"
                          }
                        }
                      ]
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "base",
                        "Weight": "semibold"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "title"
                          }
                        }
                      ]
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "sm",
                        "Class": "text-muted-foreground"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "text"
                          }
                        }
                      ]
                    },
                    {
                      "use": "Group",
                      "props": {
                        "Gap": "2",
                        "Justify": "end"
                      },
                      "children": [
                        {
                          "use": "Button",
                          "props": {
                            "Variant": "ghost",
                            "Size": "sm",
                            "Type": "button"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "skip"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Button",
                          "props": {
                            "Variant": "default",
                            "Size": "sm",
                            "Type": "button"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "next"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
