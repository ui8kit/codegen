{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.media-topics",
  "name": "MediaTopics",
  "docs": "The topics of MediaList as card rows: a glyph tile, the name, the count and an arrow.",
  "records": {},
  "props": [
    {
      "name": "extras",
      "type": {
        "ts": "MediaExtras"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "MediaListLabels"
      },
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Stack",
      "props": {
        "Gap": "4",
        "Align": "stretch"
      },
      "children": [
        {
          "use": "Text",
          "props": {
            "Size": "sm",
            "Weight": "semibold"
          },
          "children": [
            {
              "text": {
                "$": "labels.list"
              }
            }
          ]
        },
        {
          "each": {
            "$": "extras.topics"
          },
          "as": "c",
          "key": {
            "$": "c.id"
          },
          "do": [
            {
              "when": {
                "op": "lt",
                "args": [
                  {
                    "$": "i"
                  },
                  5
                ]
              },
              "then": [
                {
                  "organism": "MenuEntry",
                  "props": {
                    "href": {
                      "$": "c.href"
                    },
                    "className": "rounded bg-card inset-ring inset-ring-border flex w-full items-center gap-4 p-4",
                    "variant": "block",
                    "testid": "media-topic",
                    "block": true
                  },
                  "slots": {
                    "children": {
                      "args": [],
                      "do": [
                        {
                          "use": "Inline",
                          "props": {
                            "Class": "flex size-8 shrink-0 items-center justify-center rounded bg-primary text-primary-foreground"
                          },
                          "children": [
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": {
                                  "$": "c.icon"
                                },
                                "Size": 16
                              }
                            }
                          ]
                        },
                        {
                          "use": "Stack",
                          "props": {
                            "Gap": "0",
                            "Class": "min-w-0 flex-1"
                          },
                          "children": [
                            {
                              "use": "Text",
                              "props": {
                                "Size": "sm",
                                "Weight": "semibold"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "c.name"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "xs",
                                "Class": "text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "op": "tpl",
                                    "args": [
                                      {
                                        "$": "labels.count"
                                      },
                                      {
                                        "$": "c.count"
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": "arrow-right",
                            "Size": 16
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ],
          "index": "i"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "MediaList",
      "names": [
        "MediaExtras",
        "MediaListLabels"
      ]
    }
  ]
}
