{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.category-nav",
  "name": "CategoryNav",
  "docs": "Navigation between product categories as chips, a bar with an underline, a side list, tiles with a big icon, or chips under a toolbar (search, sort and the number shown). The current one carries aria-current. Axes: layout (chips, bar, sidebar, tiles, toolbar), count (show, hide), icon (show, hide), density.",
  "records": {
    "Category": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "icon",
        "type": "string"
      },
      {
        "name": "count",
        "type": "number"
      },
      {
        "name": "href",
        "type": "string",
        "optional": true
      }
    ],
    "CategoryTools": [
      {
        "name": "search",
        "type": "string",
        "optional": true,
        "docs": "label of the search field"
      },
      {
        "name": "sort",
        "type": "string",
        "optional": true,
        "docs": "label of the sort select"
      },
      {
        "name": "sortValue",
        "type": "string",
        "optional": true,
        "docs": "the chosen sort"
      },
      {
        "name": "shown",
        "type": "string",
        "optional": true,
        "docs": "how many products are shown"
      },
      {
        "name": "query",
        "type": "string",
        "optional": true,
        "docs": "the text in the search field",
        "default": ""
      }
    ]
  },
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": true,
      "docs": "accessible name of the navigation"
    },
    {
      "name": "categories",
      "type": {
        "ts": "Category[]"
      },
      "required": true
    },
    {
      "name": "current",
      "type": "string",
      "default": "all",
      "docs": "id of the current category"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"chips\" | \"bar\" | \"sidebar\" | \"tiles\" | \"toolbar\""
      },
      "default": "chips"
    },
    {
      "name": "count",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "icon",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "tools",
      "type": {
        "record": "CategoryTools"
      },
      "docs": "the toolbar layout: labels of the search, the sort and the number shown"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "derived": [
    {
      "name": "chipLike",
      "value": {
        "op": "or",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "chips"
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "toolbar"
            ]
          }
        ]
      }
    },
    {
      "name": "tiles",
      "value": {
        "op": "eq",
        "args": [
          {
            "$": "layout"
          },
          "tiles"
        ]
      }
    },
    {
      "name": "linkShape",
      "value": {
        "op": "cond",
        "args": [
          {
            "$": "chipLike"
          },
          "inline-flex h-8 items-center gap-2 rounded px-3 inset-ring inset-ring-border",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "bar"
                ]
              },
              "inline-flex items-center gap-2 -mb-px border-b px-1 py-2",
              {
                "op": "cond",
                "args": [
                  {
                    "$": "tiles"
                  },
                  "flex h-full flex-col items-start gap-4 rounded p-4 inset-ring inset-ring-border",
                  "inline-flex w-full items-center gap-2 rounded px-3 py-2"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "currentLook",
      "value": {
        "op": "cond",
        "args": [
          {
            "$": "chipLike"
          },
          "bg-primary text-primary-foreground",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "bar"
                ]
              },
              "border-foreground font-semibold",
              {
                "op": "cond",
                "args": [
                  {
                    "$": "tiles"
                  },
                  "inset-ring-foreground font-semibold",
                  "bg-muted font-semibold"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "otherLook",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "bar"
            ]
          },
          "border-transparent",
          ""
        ]
      }
    },
    {
      "name": "listShape",
      "value": {
        "op": "cond",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "layout"
              },
              "sidebar"
            ]
          },
          "flex flex-col gap-2",
          {
            "op": "cond",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "bar"
                ]
              },
              "flex flex-wrap gap-2 gap-x-4 border-b border-border",
              {
                "op": "cond",
                "args": [
                  {
                    "$": "tiles"
                  },
                  "grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6",
                  "flex flex-wrap gap-2"
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "nav"
      },
      "attrs": {
        "aria-label": {
          "op": "coalesce",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "$": "label"
            }
          ]
        },
        "data-testid": "category-nav",
        "data-layout": {
          "$": "layout"
        }
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": {
              "op": "cn",
              "args": [
                "mx-auto w-full max-w-6xl px-4",
                {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "density"
                        },
                        "compact"
                      ]
                    },
                    "py-2",
                    "py-4"
                  ]
                }
              ]
            }
          },
          "attrs": {
            "data-slot": "container"
          },
          "children": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "layout"
                  },
                  "toolbar"
                ]
              },
              "then": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "4",
                    "Align": "center",
                    "Class": "mb-4 flex-wrap"
                  },
                  "attrs": {
                    "data-testid": "toolbar"
                  },
                  "children": [
                    {
                      "organism": "SearchField",
                      "props": {
                        "value": {
                          "op": "coalesce",
                          "args": [
                            {
                              "$": "tools.query"
                            },
                            ""
                          ]
                        },
                        "label": {
                          "op": "coalesce",
                          "args": [
                            {
                              "$": "tools.search"
                            },
                            ""
                          ]
                        },
                        "placeholder": {
                          "$": "tools.search"
                        }
                      }
                    },
                    {
                      "use": "Select",
                      "props": {
                        "Name": "sort",
                        "Size": "sm",
                        "AriaLabel": {
                          "$": "tools.sort"
                        },
                        "Class": "w-48"
                      },
                      "children": [
                        {
                          "use": "SelectOption",
                          "props": {
                            "Value": "sort",
                            "Label": {
                              "$": "tools.sortValue"
                            },
                            "Selected": true
                          }
                        }
                      ]
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "sm",
                        "Class": "text-muted-foreground"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "tools.shown"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "gt",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "categories"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "use": "List",
                  "props": {
                    "Tag": "ul",
                    "Class": {
                      "$": "listShape"
                    }
                  },
                  "attrs": {
                    "data-testid": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "categories"
                      },
                      "as": "c",
                      "key": {
                        "$": "c.id"
                      },
                      "do": [
                        {
                          "use": "ListItem",
                          "children": [
                            {
                              "organism": "MenuEntry",
                              "props": {
                                "href": {
                                  "$": "c.href"
                                },
                                "className": {
                                  "op": "cn",
                                  "args": [
                                    "text-sm",
                                    {
                                      "$": "linkShape"
                                    },
                                    {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "c.id"
                                            },
                                            {
                                              "$": "current"
                                            }
                                          ]
                                        },
                                        {
                                          "$": "currentLook"
                                        },
                                        {
                                          "$": "otherLook"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                "current": {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "c.id"
                                    },
                                    {
                                      "$": "current"
                                    }
                                  ]
                                },
                                "testid": "item",
                                "block": true
                              },
                              "slots": {
                                "children": {
                                  "args": [],
                                  "do": [
                                    {
                                      "when": {
                                        "op": "eq",
                                        "args": [
                                          {
                                            "$": "icon"
                                          },
                                          "show"
                                        ]
                                      },
                                      "then": [
                                        {
                                          "when": {
                                            "$": "tiles"
                                          },
                                          "then": [
                                            {
                                              "use": "Inline",
                                              "props": {
                                                "Class": "flex size-10 items-center justify-center rounded bg-muted"
                                              },
                                              "children": [
                                                {
                                                  "use": "LucideIcon",
                                                  "props": {
                                                    "Name": {
                                                      "$": "c.icon"
                                                    },
                                                    "Size": 20
                                                  }
                                                }
                                              ]
                                            }
                                          ],
                                          "else": [
                                            {
                                              "use": "LucideIcon",
                                              "props": {
                                                "Name": {
                                                  "$": "c.icon"
                                                },
                                                "Size": 16
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Inline",
                                      "children": [
                                        {
                                          "text": {
                                            "$": "c.name"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "when": {
                                        "op": "eq",
                                        "args": [
                                          {
                                            "$": "count"
                                          },
                                          "show"
                                        ]
                                      },
                                      "then": [
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "xs",
                                            "Class": "text-muted-foreground"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "op": "str",
                                                "args": [
                                                  {
                                                    "$": "c.count"
                                                  }
                                                ]
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
