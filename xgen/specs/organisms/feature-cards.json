{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.feature-cards",
  "name": "FeatureCards",
  "docs": "The features as a grid of cards, tiles or bordered cells (the body of FeatureGrid). Icons are Lucide names.",
  "records": {},
  "props": [
    {
      "name": "features",
      "type": {
        "ts": "Feature[]"
      },
      "required": true
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"1-2\" | \"1-3\" | \"1-4\""
      },
      "default": "1-3",
      "docs": "columns of the grid (responsive)"
    },
    {
      "name": "item",
      "type": {
        "ts": "\"card\" | \"tile\" | \"cell\""
      },
      "default": "card",
      "docs": "card: icon, title and text stacked; tile: compact icon beside title and text; cell: bordered cell with a round icon"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Grid",
      "props": {
        "Cols": {
          "$": "cols"
        },
        "Class": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "item"
                },
                "cell"
              ]
            },
            {
              "op": "cn",
              "args": [
                "w-full gap-px overflow-hidden bg-border p-px",
                {
                  "op": "preset",
                  "args": [
                    "defaults",
                    "features.cells"
                  ]
                }
              ]
            },
            "gap-6"
          ]
        }
      },
      "attrs": {
        "data-testid": "feature-grid"
      },
      "children": [
        {
          "each": {
            "$": "features"
          },
          "as": "feature",
          "key": {
            "$": "feature.id"
          },
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "item"
                  },
                  "tile"
                ]
              },
              "then": [
                {
                  "use": "Card",
                  "props": {
                    "Variant": "compact"
                  },
                  "attrs": {
                    "data-testid": "feature-card"
                  },
                  "children": [
                    {
                      "use": "Group",
                      "props": {
                        "Gap": "4",
                        "Align": "start"
                      },
                      "children": [
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": {
                              "$": "feature.icon"
                            },
                            "Size": 20
                          }
                        },
                        {
                          "use": "Stack",
                          "props": {
                            "Gap": "2"
                          },
                          "children": [
                            {
                              "use": "Title",
                              "props": {
                                "As": 3,
                                "Size": "base",
                                "Weight": "bold"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "feature.title"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "sm",
                                "Class": "text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "feature.text"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "else": [
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "item"
                      },
                      "cell"
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "2",
                        "Align": "center",
                        "Class": "h-full gap-8 bg-background px-6 py-12 text-center"
                      },
                      "attrs": {
                        "data-testid": "feature-card"
                      },
                      "children": [
                        {
                          "use": "IconBadge",
                          "props": {
                            "Variant": "primary",
                            "Size": "xl"
                          },
                          "attrs": {
                            "data-testid": "feature-icon"
                          },
                          "children": [
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": {
                                  "$": "feature.icon"
                                },
                                "Size": 24
                              }
                            }
                          ]
                        },
                        {
                          "use": "Title",
                          "props": {
                            "As": 3,
                            "Size": "xl",
                            "Weight": "semibold",
                            "Class": "leading-6"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "feature.title"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Weight": "semibold",
                            "Class": "leading-5 text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "feature.text"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "use": "Card",
                      "props": {
                        "Variant": "default"
                      },
                      "attrs": {
                        "data-testid": "feature-card"
                      },
                      "children": [
                        {
                          "use": "CardHeader",
                          "props": {
                            "Class": "flex flex-col gap-4"
                          },
                          "children": [
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": {
                                  "$": "feature.icon"
                                },
                                "Size": 24
                              }
                            },
                            {
                              "use": "CardTitle",
                              "props": {
                                "As": 3
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "feature.title"
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "use": "CardContent",
                          "children": [
                            {
                              "use": "Text",
                              "props": {
                                "Size": "sm",
                                "Class": "text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "feature.text"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "FeatureGrid",
      "names": [
        "Feature"
      ]
    }
  ]
}
