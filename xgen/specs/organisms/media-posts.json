{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.media-posts",
  "name": "MediaPosts",
  "docs": "The latest posts of MediaList as rows: a dot, the title, the date and reading time.",
  "records": {},
  "props": [
    {
      "name": "extras",
      "type": {
        "ts": "MediaExtras"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "MediaListLabels"
      },
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Stack",
      "props": {
        "Gap": "4",
        "Align": "stretch"
      },
      "children": [
        {
          "use": "Text",
          "props": {
            "Size": "sm",
            "Weight": "semibold"
          },
          "children": [
            {
              "text": {
                "$": "labels.list"
              }
            }
          ]
        },
        {
          "each": {
            "$": "extras.posts"
          },
          "as": "p",
          "key": {
            "$": "p.id"
          },
          "do": [
            {
              "when": {
                "op": "lt",
                "args": [
                  {
                    "$": "i"
                  },
                  3
                ]
              },
              "then": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "4",
                    "Align": "start"
                  },
                  "attrs": {
                    "data-testid": "media-post"
                  },
                  "children": [
                    {
                      "use": "Inline",
                      "props": {
                        "Class": "mt-2 size-2 shrink-0 rounded-full bg-primary"
                      }
                    },
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "0"
                      },
                      "children": [
                        {
                          "organism": "MenuEntry",
                          "props": {
                            "href": {
                              "$": "p.href"
                            },
                            "className": "text-sm font-medium",
                            "size": "sm"
                          },
                          "slots": {
                            "children": {
                              "args": [],
                              "do": [
                                {
                                  "text": {
                                    "$": "p.title"
                                  }
                                }
                              ]
                            }
                          }
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "op": "tpl",
                                "args": [
                                  "{0} · {1}",
                                  {
                                    "$": "p.date"
                                  },
                                  {
                                    "op": "tpl",
                                    "args": [
                                      {
                                        "$": "labels.minutes"
                                      },
                                      {
                                        "$": "p.minutes"
                                      }
                                    ]
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "index": "i"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "MediaList",
      "names": [
        "MediaExtras",
        "MediaListLabels"
      ]
    }
  ]
}
