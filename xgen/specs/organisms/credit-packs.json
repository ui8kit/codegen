{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.credit-packs",
  "name": "CreditPacks",
  "docs": "Packs of credits as tiles: the amount, a badge, the price and a buy button. Axes: columns (2, 4), item (tile, row), tone, density.",
  "records": {
    "Pack": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "credits",
        "type": "number"
      },
      {
        "name": "price",
        "type": "number"
      },
      {
        "name": "currency",
        "type": "string"
      },
      {
        "name": "badge",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "packs",
      "type": {
        "ts": "Pack[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "badges",
      "type": {
        "ts": "Record<string, string>"
      },
      "required": true,
      "docs": "badge word by pack badge (popular, best)"
    },
    {
      "name": "buy",
      "type": "string",
      "required": true
    },
    {
      "name": "cols",
      "type": {
        "ts": "\"2\" | \"4\""
      },
      "default": "4"
    },
    {
      "name": "item",
      "type": {
        "ts": "\"tile\" | \"row\""
      },
      "default": "tile"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "measure": {
          "op": "cond",
          "args": [
            {
              "op": "eq",
              "args": [
                {
                  "$": "item"
                },
                "row"
              ]
            },
            "2xl",
            "default"
          ]
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "packs"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "coins",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Grid",
                  "props": {
                    "Cols": {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "item"
                            },
                            "row"
                          ]
                        },
                        "1",
                        {
                          "op": "fitCols",
                          "args": [
                            {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "cols"
                                    },
                                    "2"
                                  ]
                                },
                                "1-2",
                                "1-4"
                              ]
                            },
                            {
                              "op": "len",
                              "args": [
                                {
                                  "$": "packs"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    "Class": "gap-4"
                  },
                  "attrs": {
                    "data-testid": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "packs"
                      },
                      "as": "pack",
                      "key": {
                        "$": "pack.id"
                      },
                      "do": [
                        {
                          "use": "Card",
                          "props": {
                            "Variant": "default",
                            "Class": {
                              "op": "cn",
                              "args": [
                                "h-full",
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "item"
                                        },
                                        "row"
                                      ]
                                    },
                                    "gap-4 p-4",
                                    {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "density"
                                            },
                                            "compact"
                                          ]
                                        },
                                        "gap-4 p-4",
                                        ""
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          },
                          "attrs": {
                            "data-testid": "item",
                            "data-badge": {
                              "$": "pack.badge"
                            }
                          },
                          "children": [
                            {
                              "use": "CardContent",
                              "props": {
                                "Class": {
                                  "op": "cn",
                                  "args": [
                                    "flex h-full gap-4",
                                    {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "item"
                                            },
                                            "row"
                                          ]
                                        },
                                        "flex-row flex-wrap items-center justify-between",
                                        "flex-col"
                                      ]
                                    }
                                  ]
                                }
                              },
                              "children": [
                                {
                                  "use": "Stack",
                                  "props": {
                                    "Gap": "2",
                                    "Align": "start",
                                    "Class": {
                                      "op": "cn",
                                      "args": [
                                        "min-w-0",
                                        {
                                          "op": "cond",
                                          "args": [
                                            {
                                              "op": "eq",
                                              "args": [
                                                {
                                                  "$": "item"
                                                },
                                                "row"
                                              ]
                                            },
                                            "flex-1",
                                            ""
                                          ]
                                        }
                                      ]
                                    }
                                  },
                                  "children": [
                                    {
                                      "when": {
                                        "op": "or",
                                        "args": [
                                          {
                                            "$": "pack.badge"
                                          },
                                          {
                                            "op": "and",
                                            "args": [
                                              {
                                                "op": "ne",
                                                "args": [
                                                  {
                                                    "$": "item"
                                                  },
                                                  "row"
                                                ]
                                              },
                                              {
                                                "op": "gt",
                                                "args": [
                                                  {
                                                    "op": "count",
                                                    "args": [
                                                      {
                                                        "$": "packs"
                                                      },
                                                      "badge"
                                                    ]
                                                  },
                                                  0
                                                ]
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      "then": [
                                        {
                                          "use": "Box",
                                          "props": {
                                            "Class": "flex min-h-6 items-center"
                                          },
                                          "attrs": {
                                            "data-slot": "badge-slot"
                                          },
                                          "children": [
                                            {
                                              "when": {
                                                "$": "pack.badge"
                                              },
                                              "then": [
                                                {
                                                  "use": "Badge",
                                                  "props": {
                                                    "Variant": "default",
                                                    "Size": "default",
                                                    "Class": "w-fit shrink-0"
                                                  },
                                                  "attrs": {
                                                    "data-testid": "badge"
                                                  },
                                                  "children": [
                                                    {
                                                      "text": {
                                                        "op": "at",
                                                        "args": [
                                                          {
                                                            "$": "badges"
                                                          },
                                                          {
                                                            "$": "pack.badge"
                                                          }
                                                        ]
                                                      }
                                                    }
                                                  ]
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Stack",
                                      "props": {
                                        "Gap": "0",
                                        "Class": "min-w-0"
                                      },
                                      "children": [
                                        {
                                          "use": "Title",
                                          "props": {
                                            "As": 3,
                                            "Size": "xl",
                                            "Weight": "bold"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "$": "pack.name"
                                              }
                                            }
                                          ]
                                        },
                                        {
                                          "use": "Text",
                                          "props": {
                                            "Size": "2xl",
                                            "Weight": "bold"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "op": "money",
                                                "args": [
                                                  {
                                                    "$": "pack.price"
                                                  },
                                                  {
                                                    "$": "pack.currency"
                                                  }
                                                ]
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "Button",
                                  "props": {
                                    "Variant": {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "pack.badge"
                                            },
                                            "popular"
                                          ]
                                        },
                                        "default",
                                        "outline"
                                      ]
                                    },
                                    "Size": "sm",
                                    "Type": "button",
                                    "Class": {
                                      "op": "cn",
                                      "args": [
                                        "w-fit shrink-0",
                                        {
                                          "op": "cond",
                                          "args": [
                                            {
                                              "op": "eq",
                                              "args": [
                                                {
                                                  "$": "item"
                                                },
                                                "row"
                                              ]
                                            },
                                            "",
                                            "mt-auto"
                                          ]
                                        }
                                      ]
                                    }
                                  },
                                  "attrs": {
                                    "data-testid": "buy"
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "buy"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
