{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.usage-calculator",
  "name": "UsageCalculator",
  "docs": "A price that follows a slider: the chosen amount of use, the price per unit and the estimate. The page keeps the amount and updates it on the `usage` event. Axes: layout (card, plain), ends (show: the smallest and the largest amount under the slider, hide), tone.",
  "records": {
    "UsageSlider": [
      {
        "name": "min",
        "type": "number",
        "optional": false
      },
      {
        "name": "max",
        "type": "number",
        "optional": false
      },
      {
        "name": "label",
        "type": "string",
        "optional": false,
        "docs": "accessible name of the slider"
      },
      {
        "name": "unit",
        "type": "string",
        "optional": false,
        "docs": "template of an amount, e.g. `{0} credits`"
      }
    ],
    "UsagePrice": [
      {
        "name": "rate",
        "type": "number",
        "optional": false,
        "docs": "price of one unit in minor units (cents)"
      },
      {
        "name": "currency",
        "type": "string",
        "optional": false
      },
      {
        "name": "label",
        "type": "string",
        "optional": false,
        "docs": "name of the estimate"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "text",
      "type": "string",
      "required": true
    },
    {
      "name": "usage",
      "type": "number",
      "required": true,
      "docs": "the chosen amount"
    },
    {
      "name": "slider",
      "type": {
        "record": "UsageSlider"
      },
      "required": true,
      "docs": "the range of the slider and its labels"
    },
    {
      "name": "price",
      "type": {
        "record": "UsagePrice"
      },
      "required": true,
      "docs": "how the estimate is computed and named"
    },
    {
      "name": "cta",
      "type": "string",
      "required": true
    },
    {
      "name": "href",
      "type": "string"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"card\" | \"plain\""
      },
      "default": "card"
    },
    {
      "name": "ends",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "usage",
      "args": [
        {
          "name": "value",
          "type": "string"
        }
      ],
      "docs": "the slider moved"
    }
  ],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "text"
        },
        "tone": {
          "$": "tone"
        },
        "align": "center",
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "use": "Stack",
              "props": {
                "Gap": "4",
                "Align": "stretch",
                "Class": {
                  "op": "cn",
                  "args": [
                    "mx-auto w-full max-w-xl",
                    {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "layout"
                            },
                            "card"
                          ]
                        },
                        "rounded bg-card p-6 inset-ring inset-ring-border",
                        ""
                      ]
                    }
                  ]
                }
              },
              "attrs": {
                "data-testid": "usage"
              },
              "children": [
                {
                  "use": "Group",
                  "props": {
                    "Justify": "between",
                    "Align": "baseline"
                  },
                  "children": [
                    {
                      "use": "Text",
                      "props": {
                        "Size": "xl",
                        "Weight": "bold"
                      },
                      "children": [
                        {
                          "text": {
                            "op": "tpl",
                            "args": [
                              {
                                "$": "slider.unit"
                              },
                              {
                                "$": "usage"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "sm",
                        "Class": "text-muted-foreground"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "slider.label"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "Range",
                  "props": {
                    "Min": {
                      "$": "slider.min"
                    },
                    "Max": {
                      "$": "slider.max"
                    },
                    "Value": {
                      "$": "usage"
                    },
                    "AriaLabel": {
                      "$": "slider.label"
                    }
                  },
                  "attrs": {
                    "data-testid": "slider"
                  },
                  "on": {
                    "input": {
                      "call": "emit.usage",
                      "args": [
                        {
                          "$": "event.value"
                        }
                      ]
                    }
                  }
                },
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "ends"
                      },
                      "show"
                    ]
                  },
                  "then": [
                    {
                      "use": "Group",
                      "props": {
                        "Justify": "between"
                      },
                      "attrs": {
                        "data-testid": "ends"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "op": "tpl",
                                "args": [
                                  {
                                    "$": "slider.unit"
                                  },
                                  {
                                    "$": "slider.min"
                                  }
                                ]
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "op": "tpl",
                                "args": [
                                  {
                                    "$": "slider.unit"
                                  },
                                  {
                                    "$": "slider.max"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "use": "Group",
                  "props": {
                    "Justify": "between",
                    "Align": "center",
                    "Class": "flex-wrap"
                  },
                  "children": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "0"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "price.label"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "4xl",
                            "Weight": "bold"
                          },
                          "attrs": {
                            "data-testid": "estimate"
                          },
                          "children": [
                            {
                              "text": {
                                "op": "money",
                                "args": [
                                  {
                                    "op": "mul",
                                    "args": [
                                      {
                                        "$": "usage"
                                      },
                                      {
                                        "$": "price.rate"
                                      }
                                    ]
                                  },
                                  {
                                    "$": "price.currency"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "use": "Button",
                      "props": {
                        "Variant": "default",
                        "Size": "default",
                        "Href": {
                          "$": "href"
                        }
                      },
                      "attrs": {
                        "data-testid": "submit"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "cta"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
