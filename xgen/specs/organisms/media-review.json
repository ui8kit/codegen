{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.media-review",
  "name": "MediaReview",
  "docs": "The featured review of MediaList in a muted card: a label with the stars, the text in quotes and the author.",
  "records": {},
  "props": [
    {
      "name": "extras",
      "type": {
        "ts": "MediaExtras"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "MediaListLabels"
      },
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "each": {
        "$": "extras.reviews"
      },
      "as": "r",
      "key": {
        "$": "r.id"
      },
      "do": [
        {
          "when": {
            "op": "lt",
            "args": [
              {
                "$": "i"
              },
              1
            ]
          },
          "then": [
            {
              "use": "Stack",
              "props": {
                "Gap": "4",
                "Align": "stretch",
                "Class": "rounded bg-muted p-6"
              },
              "attrs": {
                "data-testid": "media-review"
              },
              "children": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "4",
                    "Align": "center",
                    "Justify": "between",
                    "Class": "flex-wrap"
                  },
                  "children": [
                    {
                      "use": "Text",
                      "props": {
                        "Size": "sm",
                        "Weight": "medium"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "labels.featured"
                          }
                        }
                      ]
                    },
                    {
                      "organism": "Rating",
                      "props": {
                        "value": {
                          "$": "r.rating"
                        },
                        "label": {
                          "op": "tpl",
                          "args": [
                            {
                              "$": "labels.rating"
                            },
                            {
                              "$": "r.rating"
                            }
                          ]
                        }
                      }
                    }
                  ]
                },
                {
                  "use": "Text",
                  "props": {
                    "Size": "base"
                  },
                  "children": [
                    {
                      "text": {
                        "op": "tpl",
                        "args": [
                          "“{0}”",
                          {
                            "$": "r.text"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "use": "Text",
                  "props": {
                    "Size": "sm",
                    "Class": "text-muted-foreground"
                  },
                  "children": [
                    {
                      "text": {
                        "op": "tpl",
                        "args": [
                          "{0} · {1}",
                          {
                            "$": "r.author"
                          },
                          {
                            "$": "r.date"
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "index": "i"
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "MediaList",
      "names": [
        "MediaExtras",
        "MediaListLabels"
      ]
    }
  ]
}
