{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.order-rows",
  "name": "OrderRows",
  "docs": "The orders as a table (the table layout of OrderTable): number, date, items, total and a status pill.",
  "records": {},
  "props": [
    {
      "name": "orders",
      "type": {
        "ts": "Order[]"
      },
      "required": true
    },
    {
      "name": "statuses",
      "type": {
        "ts": "Record<string, string>"
      },
      "required": true,
      "docs": "word by order status"
    },
    {
      "name": "labels",
      "type": {
        "ts": "OrderLabels"
      },
      "required": true
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": "w-full overflow-x-auto"
      },
      "children": [
        {
          "use": "Table",
          "props": {
            "Class": "w-full text-left text-sm"
          },
          "attrs": {
            "data-testid": "order-table"
          },
          "children": [
            {
              "use": "TableCaption",
              "props": {
                "Class": "sr-only"
              },
              "children": [
                {
                  "text": {
                    "$": "labels.caption"
                  }
                }
              ]
            },
            {
              "use": "TableHead",
              "children": [
                {
                  "use": "TableRow",
                  "children": [
                    {
                      "use": "TableHeadCell",
                      "props": {
                        "Scope": "col",
                        "Class": "py-2"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "labels.number"
                          }
                        }
                      ]
                    },
                    {
                      "use": "TableHeadCell",
                      "props": {
                        "Scope": "col",
                        "Class": "py-2"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "labels.date"
                          }
                        }
                      ]
                    },
                    {
                      "use": "TableHeadCell",
                      "props": {
                        "Scope": "col",
                        "Class": "py-2"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "labels.items"
                          }
                        }
                      ]
                    },
                    {
                      "use": "TableHeadCell",
                      "props": {
                        "Scope": "col",
                        "Class": "py-2"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "labels.total"
                          }
                        }
                      ]
                    },
                    {
                      "use": "TableHeadCell",
                      "props": {
                        "Scope": "col",
                        "Class": "py-2"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "labels.status"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "use": "TableBody",
              "children": [
                {
                  "each": {
                    "$": "orders"
                  },
                  "as": "o",
                  "key": {
                    "$": "o.id"
                  },
                  "do": [
                    {
                      "use": "TableRow",
                      "props": {
                        "Class": "border-t border-border"
                      },
                      "attrs": {
                        "data-testid": "item"
                      },
                      "children": [
                        {
                          "use": "TableCell",
                          "props": {
                            "Class": {
                              "op": "cn",
                              "args": [
                                "font-semibold",
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "density"
                                        },
                                        "compact"
                                      ]
                                    },
                                    "py-2",
                                    "py-4"
                                  ]
                                }
                              ]
                            }
                          },
                          "children": [
                            {
                              "text": {
                                "$": "o.number"
                              }
                            }
                          ]
                        },
                        {
                          "use": "TableCell",
                          "props": {
                            "Class": ""
                          },
                          "children": [
                            {
                              "text": {
                                "$": "o.date"
                              }
                            }
                          ]
                        },
                        {
                          "use": "TableCell",
                          "props": {
                            "Class": ""
                          },
                          "children": [
                            {
                              "text": {
                                "op": "tpl",
                                "args": [
                                  {
                                    "$": "labels.itemsCount"
                                  },
                                  {
                                    "$": "o.items"
                                  }
                                ]
                              }
                            }
                          ]
                        },
                        {
                          "use": "TableCell",
                          "props": {
                            "Class": ""
                          },
                          "children": [
                            {
                              "text": {
                                "op": "money",
                                "args": [
                                  {
                                    "$": "o.total"
                                  },
                                  {
                                    "$": "o.currency"
                                  }
                                ]
                              }
                            }
                          ]
                        },
                        {
                          "use": "TableCell",
                          "children": [
                            {
                              "organism": "Pill",
                              "props": {
                                "tone": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "o.status"
                                        },
                                        "paid"
                                      ]
                                    },
                                    "green",
                                    {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "o.status"
                                            },
                                            "shipped"
                                          ]
                                        },
                                        "blue",
                                        {
                                          "op": "cond",
                                          "args": [
                                            {
                                              "op": "eq",
                                              "args": [
                                                {
                                                  "$": "o.status"
                                                },
                                                "pending"
                                              ]
                                            },
                                            "amber",
                                            "gray"
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              },
                              "slots": {
                                "children": {
                                  "args": [],
                                  "do": [
                                    {
                                      "text": {
                                        "op": "at",
                                        "args": [
                                          {
                                            "$": "statuses"
                                          },
                                          {
                                            "$": "o.status"
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "OrderTable",
      "names": [
        "Order",
        "OrderLabels"
      ]
    }
  ]
}
