{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.store-locations",
  "name": "StoreLocations",
  "docs": "The stores of a shop: name, a badge of its kind (pickup or store only), address, hours, phone, a note and the services. Axes: layout (cards, list: one row per store, map: compact cards beside a map picture), tone.",
  "records": {
    "Store": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "kind",
        "type": "string"
      },
      {
        "name": "address",
        "type": "string"
      },
      {
        "name": "hours",
        "type": "string"
      },
      {
        "name": "phone",
        "type": "string"
      },
      {
        "name": "note",
        "type": "string"
      },
      {
        "name": "services",
        "type": "string[]"
      }
    ],
    "StoreLabels": [
      {
        "name": "map",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "lead",
      "type": "string",
      "default": ""
    },
    {
      "name": "stores",
      "type": {
        "ts": "Store[]"
      },
      "required": true
    },
    {
      "name": "empty",
      "type": "string",
      "default": "",
      "docs": "the text of the empty state (no records), from the dictionary"
    },
    {
      "name": "kinds",
      "type": {
        "ts": "Record<string, string>"
      },
      "required": true,
      "docs": "word by store kind (pickup, store only)"
    },
    {
      "name": "labels",
      "type": {
        "record": "StoreLabels"
      },
      "required": true
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"cards\" | \"list\" | \"map\""
      },
      "default": "cards"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "title": {
          "$": "title"
        },
        "lead": {
          "$": "lead"
        },
        "tone": {
          "$": "tone"
        },
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "stores"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "organism": "EmptyState",
                  "props": {
                    "icon": "store",
                    "title": {
                      "$": "empty"
                    }
                  }
                }
              ],
              "else": [
                {
                  "use": "Box",
                  "props": {
                    "Class": {
                      "op": "cn",
                      "args": [
                        "grid grid-cols-1 gap-8",
                        {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "map"
                              ]
                            },
                            "items-start md:grid-cols-2",
                            ""
                          ]
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "use": "Box",
                      "props": {
                        "Class": {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "layout"
                                },
                                "cards"
                              ]
                            },
                            "grid grid-cols-1 gap-4 md:grid-cols-2",
                            "flex flex-col gap-4"
                          ]
                        }
                      },
                      "attrs": {
                        "data-testid": "items"
                      },
                      "children": [
                        {
                          "each": {
                            "$": "stores"
                          },
                          "as": "s",
                          "key": {
                            "$": "s.id"
                          },
                          "do": [
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "4",
                                "Class": {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "layout"
                                        },
                                        "list"
                                      ]
                                    },
                                    "border-b border-border pb-4",
                                    "rounded bg-card inset-ring inset-ring-border p-6"
                                  ]
                                }
                              },
                              "attrs": {
                                "data-testid": "item"
                              },
                              "children": [
                                {
                                  "use": "Stack",
                                  "props": {
                                    "Gap": "2"
                                  },
                                  "children": [
                                    {
                                      "use": "Badge",
                                      "props": {
                                        "Variant": "outline",
                                        "Size": "default",
                                        "Class": "w-fit"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "op": "at",
                                            "args": [
                                              {
                                                "$": "kinds"
                                              },
                                              {
                                                "$": "s.kind"
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Title",
                                      "props": {
                                        "As": 3,
                                        "Size": "lg",
                                        "Weight": "bold"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "s.name"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "use": "List",
                                  "props": {
                                    "Tag": "ul",
                                    "Class": {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "layout"
                                            },
                                            "list"
                                          ]
                                        },
                                        "flex flex-wrap gap-x-8 gap-y-2 text-sm",
                                        "flex flex-col gap-2 text-sm"
                                      ]
                                    }
                                  },
                                  "children": [
                                    {
                                      "use": "ListItem",
                                      "props": {
                                        "Class": "flex items-center gap-2"
                                      },
                                      "children": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": "map-pin",
                                            "Size": 16
                                          }
                                        },
                                        {
                                          "use": "Inline",
                                          "children": [
                                            {
                                              "text": {
                                                "$": "s.address"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "use": "ListItem",
                                      "props": {
                                        "Class": "flex items-center gap-2"
                                      },
                                      "children": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": "clock",
                                            "Size": 16
                                          }
                                        },
                                        {
                                          "use": "Inline",
                                          "children": [
                                            {
                                              "text": {
                                                "$": "s.hours"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "use": "ListItem",
                                      "props": {
                                        "Class": "flex items-center gap-2"
                                      },
                                      "children": [
                                        {
                                          "use": "LucideIcon",
                                          "props": {
                                            "Name": "phone",
                                            "Size": 16
                                          }
                                        },
                                        {
                                          "use": "Link",
                                          "props": {
                                            "Href": {
                                              "op": "tpl",
                                              "args": [
                                                "tel:{0}",
                                                {
                                                  "$": "s.phone"
                                                }
                                              ]
                                            },
                                            "Variant": "default"
                                          },
                                          "children": [
                                            {
                                              "text": {
                                                "op": "nbsp",
                                                "args": [
                                                  {
                                                    "$": "s.phone"
                                                  }
                                                ]
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "when": {
                                    "op": "eq",
                                    "args": [
                                      {
                                        "$": "layout"
                                      },
                                      "cards"
                                    ]
                                  },
                                  "then": [
                                    {
                                      "use": "Text",
                                      "props": {
                                        "Size": "sm",
                                        "Class": "text-muted-foreground"
                                      },
                                      "children": [
                                        {
                                          "text": {
                                            "$": "s.note"
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "use": "Group",
                                      "props": {
                                        "Gap": "2",
                                        "Class": "flex-wrap"
                                      },
                                      "children": [
                                        {
                                          "each": {
                                            "$": "s.services"
                                          },
                                          "as": "v",
                                          "key": {
                                            "$": "v"
                                          },
                                          "do": [
                                            {
                                              "use": "Badge",
                                              "props": {
                                                "Variant": "secondary",
                                                "Size": "default"
                                              },
                                              "children": [
                                                {
                                                  "text": {
                                                    "$": "v"
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "layout"
                          },
                          "map"
                        ]
                      },
                      "then": [
                        {
                          "use": "Box",
                          "props": {
                            "Class": "md:sticky md:top-8"
                          },
                          "children": [
                            {
                              "organism": "MediaFrame",
                              "props": {
                                "alt": {
                                  "$": "labels.map"
                                },
                                "ratio": "1/1"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
