{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.product-card",
  "name": "ProductCard",
  "docs": "A product as a card: picture, optional badge, category, name, rating, summary, price (and the old price struck through when `compareAt` is higher) and an add button. Axes: layout (vertical, horizontal), media (image, none), ratio, rating (show, hide), action (button, none), density.",
  "records": {
    "Product": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "summary",
        "type": "string"
      },
      {
        "name": "price",
        "type": "number"
      },
      {
        "name": "currency",
        "type": "string"
      },
      {
        "name": "rating",
        "type": "number"
      },
      {
        "name": "reviews",
        "type": "number"
      },
      {
        "name": "badge",
        "type": "string",
        "optional": true
      },
      {
        "name": "category",
        "type": "string"
      },
      {
        "name": "inStock",
        "type": "boolean"
      },
      {
        "name": "compareAt",
        "type": "number",
        "optional": true
      },
      {
        "name": "href",
        "type": "string",
        "optional": true
      },
      {
        "name": "image",
        "type": "string",
        "optional": true
      }
    ],
    "ProductLabels": [
      {
        "name": "add",
        "type": "string"
      },
      {
        "name": "soldOut",
        "type": "string"
      },
      {
        "name": "reviews",
        "type": "string"
      },
      {
        "name": "ratingLabel",
        "type": "string"
      },
      {
        "name": "was",
        "type": "string"
      },
      {
        "name": "empty",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "product",
      "type": {
        "record": "Product"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "record": "ProductLabels"
      },
      "required": true
    },
    {
      "name": "badges",
      "type": {
        "ts": "Record<string, string>"
      },
      "required": true,
      "docs": "badge word by product badge (new, sale)"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"vertical\" | \"horizontal\""
      },
      "default": "vertical"
    },
    {
      "name": "media",
      "type": {
        "ts": "\"image\" | \"none\""
      },
      "default": "image"
    },
    {
      "name": "ratio",
      "type": {
        "ts": "\"4/3\" | \"1/1\" | \"3/4\""
      },
      "default": "4/3"
    },
    {
      "name": "rating",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "action",
      "type": {
        "ts": "\"button\" | \"none\""
      },
      "default": "button"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"default\" | \"compact\""
      },
      "default": "default"
    }
  ],
  "slots": [],
  "events": [
    {
      "name": "add",
      "args": [
        {
          "name": "id",
          "type": "string"
        }
      ],
      "docs": "the add button was pressed"
    }
  ],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "article",
        "Class": {
          "op": "cn",
          "args": [
            "flex flex-col gap-8 bg-card p-6 text-card-foreground inset-ring inset-ring-border rounded",
            "h-full gap-4 overflow-hidden",
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "layout"
                    },
                    "horizontal"
                  ]
                },
                "flex flex-col sm:flex-row",
                "flex flex-col"
              ]
            }
          ]
        }
      },
      "attrs": {
        "data-slot": "card",
        "data-testid": "item",
        "data-layout": {
          "$": "layout"
        }
      },
      "children": [
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "media"
              },
              "image"
            ]
          },
          "then": [
            {
              "use": "Box",
              "props": {
                "Class": {
                  "op": "cn",
                  "args": [
                    "relative shrink-0",
                    {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "layout"
                            },
                            "horizontal"
                          ]
                        },
                        "sm:w-48",
                        ""
                      ]
                    }
                  ]
                }
              },
              "children": [
                {
                  "organism": "MediaFrame",
                  "props": {
                    "alt": {
                      "$": "product.name"
                    },
                    "src": {
                      "$": "product.image"
                    },
                    "ratio": {
                      "$": "ratio"
                    },
                    "className": "h-full"
                  }
                },
                {
                  "when": {
                    "$": "product.badge"
                  },
                  "then": [
                    {
                      "use": "Badge",
                      "props": {
                        "Variant": "default",
                        "Size": "default",
                        "Class": "absolute left-4 top-4"
                      },
                      "attrs": {
                        "data-testid": "badge"
                      },
                      "children": [
                        {
                          "text": {
                            "op": "at",
                            "args": [
                              {
                                "$": "badges"
                              },
                              {
                                "$": "product.badge"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "use": "CardContent",
          "props": {
            "Class": "flex flex-1 flex-col gap-2"
          },
          "children": [
            {
              "use": "Text",
              "props": {
                "Size": "xs",
                "Class": "uppercase tracking-wide text-muted-foreground"
              },
              "children": [
                {
                  "text": {
                    "$": "product.category"
                  }
                }
              ]
            },
            {
              "use": "Title",
              "props": {
                "As": 3,
                "Size": "base",
                "Weight": "bold"
              },
              "children": [
                {
                  "when": {
                    "$": "product.href"
                  },
                  "then": [
                    {
                      "use": "Link",
                      "props": {
                        "Href": {
                          "$": "product.href"
                        },
                        "Variant": "default"
                      },
                      "attrs": {
                        "data-testid": "open"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "product.name"
                          }
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "text": {
                        "$": "product.name"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "rating"
                  },
                  "show"
                ]
              },
              "then": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "2"
                  },
                  "children": [
                    {
                      "organism": "Rating",
                      "props": {
                        "value": {
                          "$": "product.rating"
                        },
                        "label": {
                          "op": "tpl",
                          "args": [
                            {
                              "$": "labels.ratingLabel"
                            },
                            {
                              "$": "product.rating"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "use": "Text",
                      "props": {
                        "Size": "xs",
                        "Class": "text-muted-foreground"
                      },
                      "children": [
                        {
                          "text": {
                            "op": "tpl",
                            "args": [
                              {
                                "$": "labels.reviews"
                              },
                              {
                                "$": "product.reviews"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$": "density"
                  },
                  "default"
                ]
              },
              "then": [
                {
                  "use": "Text",
                  "props": {
                    "Size": "sm",
                    "Class": "text-muted-foreground"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "product.summary"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "use": "Group",
              "props": {
                "Gap": "4",
                "Justify": "between",
                "Class": "mt-auto pt-2"
              },
              "children": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "2",
                    "Align": "baseline",
                    "Class": "flex-wrap"
                  },
                  "children": [
                    {
                      "use": "Text",
                      "props": {
                        "Size": "xl",
                        "Weight": "bold"
                      },
                      "children": [
                        {
                          "text": {
                            "op": "money",
                            "args": [
                              {
                                "$": "product.price"
                              },
                              {
                                "$": "product.currency"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "when": {
                        "op": "and",
                        "args": [
                          {
                            "$": "product.compareAt"
                          },
                          {
                            "op": "gt",
                            "args": [
                              {
                                "$": "product.compareAt"
                              },
                              {
                                "$": "product.price"
                              }
                            ]
                          }
                        ]
                      },
                      "then": [
                        {
                          "use": "Text",
                          "props": {
                            "Tag": "del",
                            "Size": "sm",
                            "Class": "relative text-muted-foreground"
                          },
                          "attrs": {
                            "data-testid": "compare-at"
                          },
                          "children": [
                            {
                              "use": "Inline",
                              "props": {
                                "Class": "sr-only"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "labels.was"
                                  }
                                }
                              ]
                            },
                            {
                              "text": {
                                "op": "money",
                                "args": [
                                  {
                                    "$": "product.compareAt"
                                  },
                                  {
                                    "$": "product.currency"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "when": {
                    "op": "eq",
                    "args": [
                      {
                        "$": "action"
                      },
                      "button"
                    ]
                  },
                  "then": [
                    {
                      "use": "Button",
                      "props": {
                        "Variant": {
                          "op": "cond",
                          "args": [
                            {
                              "$": "product.inStock"
                            },
                            "default",
                            "outline"
                          ]
                        },
                        "Size": "sm",
                        "Disabled": {
                          "op": "not",
                          "args": [
                            {
                              "$": "product.inStock"
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "data-testid": "add"
                      },
                      "on": {
                        "click": {
                          "call": "emit.add",
                          "args": [
                            {
                              "$": "product.id"
                            }
                          ]
                        }
                      },
                      "children": [
                        {
                          "text": {
                            "op": "cond",
                            "args": [
                              {
                                "$": "product.inStock"
                              },
                              {
                                "$": "labels.add"
                              },
                              {
                                "$": "labels.soldOut"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
