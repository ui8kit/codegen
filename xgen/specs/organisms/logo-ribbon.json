{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.logo-ribbon",
  "name": "LogoRibbon",
  "docs": "A heading over one centered row of logo slots (LogoSlot); the row and slot sizes come from the default preset.",
  "records": {},
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "logos",
      "type": {
        "ts": "Logo[]"
      },
      "required": true
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"roomy\" | \"default\" | \"compact\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "organism": "SectionFrame",
      "props": {
        "id": {
          "$": "id"
        },
        "tone": {
          "$": "tone"
        },
        "density": {
          "$": "density"
        },
        "measure": "fill",
        "align": "center",
        "className": "py-0",
        "landmarkLabel": {
          "$": "landmarkLabel"
        }
      },
      "slots": {
        "children": {
          "args": [],
          "do": [
            {
              "use": "Stack",
              "props": {
                "Gap": "6",
                "Align": "center"
              },
              "attrs": {
                "data-testid": "logos-block"
              },
              "children": [
                {
                  "use": "Title",
                  "props": {
                    "As": 2,
                    "Size": "xl",
                    "Weight": "semibold",
                    "Class": "leading-7"
                  },
                  "attrs": {
                    "id": {
                      "op": "add",
                      "args": [
                        {
                          "$": "id"
                        },
                        "-title"
                      ]
                    }
                  },
                  "children": [
                    {
                      "text": {
                        "$": "title"
                      }
                    }
                  ]
                },
                {
                  "use": "Group",
                  "props": {
                    "Gap": "0",
                    "Justify": "center",
                    "Align": "start",
                    "Class": {
                      "op": "cn",
                      "args": [
                        "flex w-full flex-wrap",
                        {
                          "op": "preset",
                          "args": [
                            "defaults",
                            "logos.row"
                          ]
                        }
                      ]
                    }
                  },
                  "attrs": {
                    "data-testid": "items"
                  },
                  "children": [
                    {
                      "each": {
                        "$": "logos"
                      },
                      "as": "logo",
                      "key": {
                        "$": "logo.id"
                      },
                      "do": [
                        {
                          "organism": "LogoSlot",
                          "props": {
                            "name": {
                              "$": "logo.name"
                            },
                            "icon": {
                              "$": "logo.icon"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "LogoCloud",
      "names": [
        "Logo"
      ]
    }
  ]
}
