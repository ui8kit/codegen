{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.cart-summary-card",
  "name": "CartSummaryCard",
  "docs": "The order summary card of the cart page and the checkout: the lines in short (optional), a promo code field with ready codes, the free-delivery progress, the totals, the button and a note. Static markup.",
  "records": {
    "Promo": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "code",
        "type": "string"
      }
    ],
    "CartSummaryLabels": [
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "items",
        "type": "string"
      },
      {
        "name": "promo",
        "type": "string"
      },
      {
        "name": "apply",
        "type": "string"
      },
      {
        "name": "codes",
        "type": "string"
      },
      {
        "name": "progress",
        "type": "string"
      },
      {
        "name": "checkout",
        "type": "string"
      },
      {
        "name": "note",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "lines",
      "type": {
        "ts": "CartLine[]"
      },
      "required": true
    },
    {
      "name": "rows",
      "type": {
        "ts": "SummaryRow[]"
      },
      "required": true
    },
    {
      "name": "promos",
      "type": {
        "ts": "Promo[]"
      },
      "required": true
    },
    {
      "name": "labels",
      "type": {
        "ts": "CartSummaryLabels"
      },
      "required": true
    },
    {
      "name": "items",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "hide",
      "docs": "show: the lines in short at the top"
    },
    {
      "name": "promo",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "field",
      "type": "string",
      "default": "promo",
      "docs": "name of the promo code field (unique on the page)"
    },
    {
      "name": "progress",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "value",
      "type": "number",
      "default": 70,
      "docs": "how far the order is towards free delivery, 0 to 100"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Stack",
      "props": {
        "Gap": "6",
        "Align": "stretch",
        "Class": "rounded bg-card inset-ring inset-ring-border p-6"
      },
      "attrs": {
        "data-testid": "summary"
      },
      "children": [
        {
          "use": "Group",
          "props": {
            "Gap": "4",
            "Align": "baseline",
            "Justify": "between"
          },
          "children": [
            {
              "use": "Title",
              "props": {
                "As": 2,
                "Size": "lg",
                "Weight": "semibold"
              },
              "children": [
                {
                  "text": {
                    "$": "labels.title"
                  }
                }
              ]
            },
            {
              "use": "Text",
              "props": {
                "Size": "xs",
                "Class": "text-muted-foreground"
              },
              "children": [
                {
                  "text": {
                    "op": "tpl",
                    "args": [
                      {
                        "$": "labels.items"
                      },
                      {
                        "op": "str",
                        "args": [
                          {
                            "op": "len",
                            "args": [
                              {
                                "$": "lines"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "when": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "$": "items"
                  },
                  "show"
                ]
              },
              {
                "op": "gt",
                "args": [
                  {
                    "op": "len",
                    "args": [
                      {
                        "$": "lines"
                      }
                    ]
                  },
                  0
                ]
              }
            ]
          },
          "then": [
            {
              "use": "List",
              "props": {
                "Tag": "ul",
                "Class": "flex flex-col gap-4"
              },
              "attrs": {
                "data-testid": "summary-lines"
              },
              "children": [
                {
                  "each": {
                    "$": "lines"
                  },
                  "as": "line",
                  "key": {
                    "$": "line.id"
                  },
                  "do": [
                    {
                      "use": "ListItem",
                      "props": {
                        "Class": "flex items-center gap-4 text-sm"
                      },
                      "children": [
                        {
                          "organism": "MediaFrame",
                          "props": {
                            "alt": {
                              "$": "line.name"
                            },
                            "ratio": "1/1",
                            "className": "size-12 shrink-0"
                          }
                        },
                        {
                          "use": "Stack",
                          "props": {
                            "Gap": "0",
                            "Class": "flex-1"
                          },
                          "children": [
                            {
                              "use": "Text",
                              "props": {
                                "Size": "sm",
                                "Weight": "semibold"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "line.name"
                                  }
                                }
                              ]
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "xs",
                                "Class": "text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "op": "tpl",
                                    "args": [
                                      "{0} x {1}",
                                      {
                                        "$": "line.qty"
                                      },
                                      {
                                        "op": "money",
                                        "args": [
                                          {
                                            "$": "line.price"
                                          },
                                          {
                                            "$": "line.currency"
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "use": "Inline",
                          "props": {
                            "Class": "font-medium"
                          },
                          "children": [
                            {
                              "text": {
                                "op": "money",
                                "args": [
                                  {
                                    "op": "mul",
                                    "args": [
                                      {
                                        "$": "line.price"
                                      },
                                      {
                                        "$": "line.qty"
                                      }
                                    ]
                                  },
                                  {
                                    "$": "line.currency"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "promo"
              },
              "show"
            ]
          },
          "then": [
            {
              "use": "Stack",
              "props": {
                "Gap": "2",
                "Align": "stretch"
              },
              "attrs": {
                "data-testid": "promo"
              },
              "children": [
                {
                  "use": "Group",
                  "props": {
                    "Gap": "2",
                    "Align": "center"
                  },
                  "children": [
                    {
                      "use": "Input",
                      "props": {
                        "Type": "text",
                        "Name": {
                          "$": "field"
                        },
                        "AriaLabel": {
                          "$": "labels.promo"
                        },
                        "Placeholder": {
                          "$": "labels.promo"
                        },
                        "Class": "min-w-0 flex-1"
                      }
                    },
                    {
                      "use": "Button",
                      "props": {
                        "Variant": "outline",
                        "Size": "default",
                        "Type": "button"
                      },
                      "children": [
                        {
                          "text": {
                            "$": "labels.apply"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "when": {
                    "op": "gt",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "$": "promos"
                          }
                        ]
                      },
                      0
                    ]
                  },
                  "then": [
                    {
                      "use": "Group",
                      "props": {
                        "Gap": "2",
                        "Align": "center",
                        "Class": "flex-wrap"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "xs",
                            "Class": "text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "labels.codes"
                              }
                            }
                          ]
                        },
                        {
                          "each": {
                            "$": "promos"
                          },
                          "as": "c",
                          "key": {
                            "$": "c.id"
                          },
                          "do": [
                            {
                              "use": "Badge",
                              "props": {
                                "Variant": "outline",
                                "Size": "sm"
                              },
                              "attrs": {
                                "data-testid": "code"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "c.code"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "when": {
            "op": "eq",
            "args": [
              {
                "$": "progress"
              },
              "show"
            ]
          },
          "then": [
            {
              "use": "Stack",
              "props": {
                "Gap": "2",
                "Align": "stretch",
                "Class": "rounded bg-muted p-4"
              },
              "attrs": {
                "data-testid": "progress"
              },
              "children": [
                {
                  "use": "Text",
                  "props": {
                    "Size": "sm"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "labels.progress"
                      }
                    }
                  ]
                },
                {
                  "use": "Progress",
                  "props": {
                    "Value": {
                      "op": "str",
                      "args": [
                        {
                          "$": "value"
                        }
                      ]
                    },
                    "Max": "100"
                  },
                  "attrs": {
                    "aria-label": {
                      "$": "labels.progress"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "when": {
            "op": "gt",
            "args": [
              {
                "op": "len",
                "args": [
                  {
                    "$": "rows"
                  }
                ]
              },
              0
            ]
          },
          "then": [
            {
              "use": "List",
              "props": {
                "Tag": "ul",
                "Class": "flex flex-col gap-2"
              },
              "children": [
                {
                  "each": {
                    "$": "rows"
                  },
                  "as": "row",
                  "key": {
                    "$": "row.id"
                  },
                  "do": [
                    {
                      "use": "ListItem",
                      "props": {
                        "Class": {
                          "op": "cn",
                          "args": [
                            "flex items-center justify-between gap-4",
                            {
                              "op": "cond",
                              "args": [
                                {
                                  "$": "row.strong"
                                },
                                "border-t border-border pt-4 text-base font-bold",
                                "text-sm text-muted-foreground"
                              ]
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "data-testid": "row"
                      },
                      "children": [
                        {
                          "use": "Inline",
                          "children": [
                            {
                              "text": {
                                "$": "row.label"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Inline",
                          "children": [
                            {
                              "text": {
                                "op": "money",
                                "args": [
                                  {
                                    "$": "row.amount"
                                  },
                                  {
                                    "$": "row.currency"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "use": "Button",
          "props": {
            "Variant": "default",
            "Size": "lg",
            "Class": "w-full"
          },
          "attrs": {
            "data-testid": "checkout"
          },
          "children": [
            {
              "text": {
                "$": "labels.checkout"
              }
            }
          ]
        },
        {
          "use": "Text",
          "props": {
            "Size": "xs",
            "Class": "text-muted-foreground"
          },
          "children": [
            {
              "text": {
                "$": "labels.note"
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "CartList",
      "names": [
        "CartLine"
      ]
    },
    {
      "from": "OrderSummary",
      "names": [
        "SummaryRow"
      ]
    }
  ]
}
