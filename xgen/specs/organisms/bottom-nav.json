{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "organism.bottom-nav",
  "name": "BottomNav",
  "docs": "An app-style tab bar for a phone: an icon over a label per tab, the current one marked. Axes: labels (show, hide: icons only with the name hidden), position (static, sticky: stays at the bottom of the page), tone.",
  "records": {},
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": true
    },
    {
      "name": "tabs",
      "type": {
        "ts": "NavLink[]"
      },
      "required": true
    },
    {
      "name": "current",
      "type": "string",
      "default": ""
    },
    {
      "name": "labels",
      "type": {
        "ts": "\"show\" | \"hide\""
      },
      "default": "show"
    },
    {
      "name": "position",
      "type": {
        "ts": "\"static\" | \"sticky\""
      },
      "default": "static"
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\""
      },
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "gt",
        "args": [
          {
            "op": "len",
            "args": [
              {
                "$": "tabs"
              }
            ]
          },
          0
        ]
      },
      "then": [
        {
          "use": "Block",
          "props": {
            "Tag": "nav",
            "Class": {
              "op": "cn",
              "args": [
                "mx-auto w-full max-w-md border-t border-border",
                {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "tone"
                        },
                        "muted"
                      ]
                    },
                    "bg-muted",
                    "bg-background"
                  ]
                },
                {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "position"
                        },
                        "sticky"
                      ]
                    },
                    "sticky bottom-0 z-40",
                    ""
                  ]
                }
              ]
            }
          },
          "attrs": {
            "aria-label": {
              "op": "coalesce",
              "args": [
                {
                  "$": "landmarkLabel"
                },
                {
                  "$": "label"
                }
              ]
            },
            "data-testid": "bottom-nav",
            "data-position": {
              "$": "position"
            }
          },
          "children": [
            {
              "use": "List",
              "props": {
                "Class": "m-0 grid list-none grid-flow-col auto-cols-fr p-0"
              },
              "attrs": {
                "data-testid": "items"
              },
              "children": [
                {
                  "each": {
                    "$": "tabs"
                  },
                  "as": "tab",
                  "key": {
                    "$": "tab.id"
                  },
                  "do": [
                    {
                      "use": "ListItem",
                      "children": [
                        {
                          "organism": "MenuEntry",
                          "props": {
                            "href": {
                              "$": "tab.href"
                            },
                            "className": {
                              "op": "cn",
                              "args": [
                                "flex flex-col items-center gap-2 py-2 text-xs",
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "tab.id"
                                        },
                                        {
                                          "$": "current"
                                        }
                                      ]
                                    },
                                    "font-semibold text-primary",
                                    "text-muted-foreground"
                                  ]
                                }
                              ]
                            },
                            "current": {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "tab.id"
                                },
                                {
                                  "$": "current"
                                }
                              ]
                            },
                            "testid": "item"
                          },
                          "slots": {
                            "children": {
                              "args": [],
                              "do": [
                                {
                                  "use": "LucideIcon",
                                  "props": {
                                    "Name": {
                                      "$": "tab.icon"
                                    },
                                    "Size": 20
                                  }
                                },
                                {
                                  "use": "Inline",
                                  "props": {
                                    "Class": {
                                      "op": "cond",
                                      "args": [
                                        {
                                          "op": "eq",
                                          "args": [
                                            {
                                              "$": "labels"
                                            },
                                            "hide"
                                          ]
                                        },
                                        "sr-only",
                                        ""
                                      ]
                                    }
                                  },
                                  "children": [
                                    {
                                      "text": {
                                        "$": "tab.name"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "NavBar",
      "names": [
        "NavLink"
      ]
    }
  ]
}
