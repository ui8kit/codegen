                "Class": "h-10 w-32 rounded bg-muted"
              },
              "attrs": {
                "aria-hidden": "true"
              }
            }
          ]
        },
        {
          "use": "Box",
          "props": {
            "Class": "flex flex-1 flex-col gap-4"
