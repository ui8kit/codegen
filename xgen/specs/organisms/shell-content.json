{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.shell-content",
  "name": "ShellContent",
  "docs": "The placeholder content of DashboardShell: the page heading beside a grey action, then empty cards on the 8px grid. Shapes: grid (four small cards over a big one), split (a wide card beside a narrow one over a low one), list (a toolbar over a card of rows). The cards are hidden from assistive technology.",
  "records": {},
  "props": [
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "titleId",
      "type": "string",
      "required": true
    },
    {
      "name": "level",
      "type": {
        "ts": "1 | 2"
      },
      "default": 2
    },
    {
      "name": "content",
      "type": {
        "ts": "\"grid\" | \"split\" | \"list\""
      },
      "default": "grid"
    }
  ],
  "slots": [],
  "events": [],
