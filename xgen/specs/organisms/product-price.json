{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.product-price",
  "name": "ProductPrice",
  "docs": "The price line of a product page: the price (integer minor units in the currency), the old price (compare_at) struck through when higher, and the badge.",
  "records": {},
  "props": [
    {
      "name": "price",
      "type": "number",
      "required": true,
      "docs": "integer minor units"
    },
    {
      "name": "compareAt",
      "type": "number",
      "docs": "the old price, same currency; shown only when higher than the price"
    },
    {
      "name": "currency",
      "type": "string",
      "required": true
    },
    {
      "name": "badge",
      "type": "string",
      "default": "",
      "docs": "the label of the badge; empty: none"
    },
    {
      "name": "was",
      "type": "string",
      "required": true,
      "docs": "the screen reader word before the old price"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Group",
      "props": {
        "Gap": "4",
        "Align": "center",
        "Class": "flex-wrap"
      },
      "children": [
        {
          "use": "Text",
          "props": {
            "Size": "4xl",
            "Weight": "bold"
          },
          "children": [
            {
              "text": {
                "op": "money",
                "args": [
                  {
                    "$": "price"
                  },
                  {
                    "$": "currency"
                  }
                ]
              }
            }
          ]
        },
        {
          "when": {
            "op": "and",
            "args": [
              {
                "$": "compareAt"
              },
              {
                "op": "gt",
                "args": [
                  {
                    "$": "compareAt"
                  },
                  {
                    "$": "price"
                  }
                ]
              }
            ]
          },
          "then": [
            {
              "use": "Text",
              "props": {
                "Tag": "del",
                "Size": "lg",
                "Class": "relative text-muted-foreground"
              },
              "attrs": {
                "data-testid": "compare-at"
              },
              "children": [
                {
                  "use": "Inline",
                  "props": {
                    "Class": "sr-only"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "was"
                      }
                    }
                  ]
                },
                {
                  "text": {
                    "op": "money",
                    "args": [
                      {
                        "$": "compareAt"
                      },
                      {
                        "$": "currency"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "when": {
            "$": "badge"
          },
          "then": [
            {
              "use": "Badge",
              "props": {
                "Variant": "default",
                "Size": "default"
              },
              "children": [
                {
                  "text": {
                    "$": "badge"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
