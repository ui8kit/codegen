{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.footer-points",
  "name": "FooterPoints",
  "docs": "Four points with their glyphs in a column, under the tagline of FooterSplit.",
  "records": {},
  "props": [
    {
      "name": "extras",
      "type": {
        "ts": "FooterExtras"
      },
      "required": true,
      "docs": "the figures, points, contacts and channels"
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "gt",
        "args": [
          {
            "op": "len",
            "args": [
              {
                "$": "extras.points"
              }
            ]
          },
          0
        ]
      },
      "then": [
        {
          "use": "Stack",
          "props": {
            "Gap": "4",
            "Align": "start"
          },
          "children": [
            {
              "use": "Text",
              "props": {
                "Size": "sm",
                "Weight": "semibold"
              },
              "children": [
                {
                  "text": {
                    "$": "title"
                  }
                }
              ]
            },
            {
              "each": {
                "$": "extras.points"
              },
              "as": "p",
              "key": {
                "$": "p.id"
              },
              "do": [
                {
                  "when": {
                    "op": "lt",
                    "args": [
                      {
                        "$": "i"
                      },
                      4
                    ]
                  },
                  "then": [
                    {
                      "use": "Group",
                      "props": {
                        "Gap": "2",
                        "Align": "center"
                      },
                      "attrs": {
                        "data-testid": "footer-point"
                      },
                      "children": [
                        {
                          "use": "LucideIcon",
                          "props": {
                            "Name": {
                              "$": "p.icon"
                            },
                            "Size": 16
                          }
                        },
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "p.title"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "index": "i"
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "FooterSplit",
      "names": [
        "FooterExtras",
        "FooterSplitLabels"
      ]
    }
  ]
}
