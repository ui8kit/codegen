{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.hero-split-media",
  "name": "HeroSplitMedia",
  "docs": "What HeroSplit shows beside the text: a picture, a picture with a floating card, a grid of four pictures with captions, or a picture with two plan cards floating over it.",
  "records": {},
  "props": [
    {
      "name": "content",
      "type": {
        "ts": "HeroContent"
      },
      "required": true,
      "docs": "the figures, small cards, people, proof line and floating card of the hero"
    },
    {
      "name": "alt",
      "type": "string",
      "required": true,
      "docs": "accessible name of the pictures"
    },
    {
      "name": "media",
      "type": {
        "ts": "\"picture\" | \"card\" | \"grid\" | \"plans\""
      },
      "default": "picture"
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "$": "media"
          },
          "picture"
        ]
      },
      "then": [
        {
          "organism": "MediaFrame",
          "props": {
            "alt": {
              "$": "alt"
            },
            "ratio": "4/3"
          }
        }
      ]
    },
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "$": "media"
          },
          "card"
        ]
      },
      "then": [
        {
          "organism": "OfferMedia",
          "props": {
            "alt": {
              "$": "alt"
            },
            "card": {
              "$": "content.card"
            }
          }
        }
      ]
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "media"
              },
              "grid"
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "op": "len",
                "args": [
                  {
                    "$": "content.features"
                  }
                ]
              },
              0
            ]
          }
        ]
      },
      "then": [
        {
          "use": "Box",
          "props": {
            "Class": "grid grid-cols-2 gap-4"
          },
          "attrs": {
            "data-testid": "hero-grid"
          },
          "children": [
            {
              "each": {
                "$": "content.features"
              },
              "as": "f",
              "key": {
                "$": "f.id"
              },
              "do": [
                {
                  "when": {
                    "op": "lt",
                    "args": [
                      {
                        "$": "i"
                      },
                      4
                    ]
                  },
                  "then": [
                    {
                      "organism": "FigureBlock",
                      "props": {
                        "className": "flex flex-col gap-2",
                        "testid": "hero-tile"
                      },
                      "slots": {
                        "children": {
                          "args": [],
                          "do": [
                            {
                              "organism": "MediaFrame",
                              "props": {
                                "alt": {
                                  "$": "f.title"
                                },
                                "ratio": "1/1"
                              }
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "xs",
                                "Class": "text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "f.title"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              ],
              "index": "i"
            }
          ]
        }
      ]
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "media"
              },
              "plans"
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "op": "len",
                "args": [
                  {
                    "$": "content.plans"
                  }
                ]
              },
              0
            ]
          }
        ]
      },
      "then": [
        {
          "use": "Box",
          "props": {
            "Class": "relative"
          },
          "attrs": {
            "data-testid": "hero-media"
          },
          "children": [
            {
              "organism": "MediaFrame",
              "props": {
                "alt": {
                  "$": "alt"
                },
                "ratio": "4/3"
              }
            },
            {
              "each": {
                "$": "content.plans"
              },
              "as": "p",
              "key": {
                "$": "p.id"
              },
              "do": [
                {
                  "when": {
                    "op": "lt",
                    "args": [
                      {
                        "$": "i"
                      },
                      2
                    ]
                  },
                  "then": [
                    {
                      "use": "Stack",
                      "props": {
                        "Gap": "2",
                        "Class": {
                          "op": "cn",
                          "args": [
                            "absolute w-48 rounded bg-card p-4 shadow-lg",
                            {
                              "op": "cond",
                              "args": [
                                {
                                  "op": "eq",
                                  "args": [
                                    {
                                      "$": "i"
                                    },
                                    0
                                  ]
                                },
                                "top-8 left-4",
                                "right-4 bottom-8"
                              ]
                            }
                          ]
                        }
                      },
                      "attrs": {
                        "data-testid": "hero-plan"
                      },
                      "children": [
                        {
                          "use": "Text",
                          "props": {
                            "Size": "sm",
                            "Weight": "semibold"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "p.name"
                              }
                            }
                          ]
                        },
                        {
                          "use": "Group",
                          "props": {
                            "Gap": "2",
                            "Align": "center"
                          },
                          "children": [
                            {
                              "use": "LucideIcon",
                              "props": {
                                "Name": "check",
                                "Size": 16
                              }
                            },
                            {
                              "use": "Text",
                              "props": {
                                "Size": "xs",
                                "Class": "text-muted-foreground"
                              },
                              "children": [
                                {
                                  "text": {
                                    "$": "p.tagline"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "index": "i"
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "HeroSplit",
      "names": [
        "HeroContent"
      ]
    }
  ]
}
