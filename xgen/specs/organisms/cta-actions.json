{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.cta-actions",
  "name": "CtaActions",
  "docs": "The actions of a call to action: one or two links (ActionGroup), or an email field with a button (actions form).",
  "records": {
    "ActionSet": [
      {
        "name": "mode",
        "type": "\"one\" | \"two\" | \"form\"",
        "optional": true,
        "docs": "one or two links, or a form",
        "default": "one"
      },
      {
        "name": "cta",
        "type": "string",
        "optional": false,
        "docs": "primary action label"
      },
      {
        "name": "href",
        "type": "string",
        "optional": true,
        "docs": "the address of the primary action; none: a button, not a link"
      },
      {
        "name": "secondary",
        "type": "string",
        "optional": true
      },
      {
        "name": "secondaryHref",
        "type": "string",
        "optional": true
      },
      {
        "name": "emailLabel",
        "type": "string",
        "optional": true,
        "docs": "label of the form field (the email field, or the prompt line of HeroPrompt)"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "required": true
    },
    {
      "name": "actions",
      "type": {
        "record": "ActionSet"
      },
      "required": true
    },
    {
      "name": "center",
      "type": "boolean",
      "default": false
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "$": "actions.mode"
          },
          "form"
        ]
      },
      "then": [
        {
          "use": "Form",
          "props": {
            "Method": "dialog",
            "Class": {
              "op": "cn",
              "args": [
                "w-full max-w-md",
                {
                  "op": "cond",
                  "args": [
                    {
                      "$": "center"
                    },
                    "mx-auto",
                    ""
                  ]
                }
              ]
            }
          },
          "attrs": {
            "data-testid": "email-form"
          },
          "children": [
            {
              "use": "Label",
              "props": {
                "HTMLFor": {
                  "op": "tpl",
                  "args": [
                    "{0}-email",
                    {
                      "$": "id"
                    }
                  ]
                },
                "Class": "sr-only"
              },
              "children": [
                {
                  "text": {
                    "$": "actions.emailLabel"
                  }
                }
              ]
            },
            {
              "use": "Group",
              "props": {
                "Gap": "2",
                "Align": "start",
                "Class": "w-full flex-wrap"
              },
              "children": [
                {
                  "use": "Input",
                  "props": {
                    "Type": "email",
                    "Name": "email",
                    "Class": "min-w-0 flex-1"
                  },
                  "attrs": {
                    "id": {
                      "op": "tpl",
                      "args": [
                        "{0}-email",
                        {
                          "$": "id"
                        }
                      ]
                    },
                    "data-testid": "field"
                  }
                },
                {
                  "use": "Button",
                  "props": {
                    "Variant": "default",
                    "Size": "default",
                    "Type": "submit"
                  },
                  "attrs": {
                    "data-testid": "submit"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "actions.cta"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "else": [
        {
          "organism": "ActionGroup",
          "props": {
            "primary": {
              "$": "actions.cta"
            },
            "primaryHref": {
              "$": "actions.href"
            },
            "secondary": {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "actions.mode"
                    },
                    "two"
                  ]
                },
                {
                  "$": "actions.secondary"
                },
                {
                  "op": "undef",
                  "args": []
                }
              ]
            },
            "secondaryHref": {
              "$": "actions.secondaryHref"
            },
            "align": {
              "op": "cond",
              "args": [
                {
                  "$": "center"
                },
                "center",
                "start"
              ]
            }
          }
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
