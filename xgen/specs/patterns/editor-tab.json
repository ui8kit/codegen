{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.editor-tab",
  "name": "EditorTab",
  "docs": "An editor file tab (40 px high): a file icon, the label and a close button. `preview` marks a tab that is not pinned yet. Keyboard (Enter and Space activate, Delete closes) is the programmer's behind the click and close events.",
  "records": {},
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": true
    },
    {
      "name": "closeLabel",
      "type": "string",
      "docs": "accessible name of the close button, e.g. \"Close index.tsx\"",
      "required": true
    },
    {
      "name": "active",
      "type": "boolean",
      "docs": "the selected tab",
      "default": false
    },
    {
      "name": "preview",
      "type": "boolean",
      "docs": "not pinned yet (italic)",
      "default": false
    }
  ],
  "className": true,
  "slots": [
    {
      "name": "icon",
      "args": [],
      "docs": "the file icon"
    }
  ],
  "events": [
    {
      "name": "click",
      "args": [],
      "docs": "the tab was pressed"
    },
    {
      "name": "close",
      "args": [],
      "docs": "the close button was pressed"
    }
  ],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": {
          "op": "cn",
          "args": [
            "flex h-10 shrink-0 cursor-pointer flex-col justify-center data-[state=active]:bg-card [&_svg]:text-muted-foreground",
            "border-r border-border",
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "role": "tab",
        "aria-selected": {
          "$": "active"
        },
        "tabindex": {
          "op": "cond",
          "args": [
            {
              "$": "active"
            },
            0,
            -1
          ]
        },
        "data-slot": "editor-tab",
        "data-state": {
          "op": "cond",
          "args": [
            {
              "$": "active"
            },
            "active",
            "default"
          ]
        }
      },
      "on": {
        "click": {
          "call": "emit.click",
          "args": []
        }
      },
      "children": [
        {
          "use": "Inline",
          "props": {
            "Class": "flex h-10 items-center gap-2 px-3"
          },
          "attrs": {
            "data-slot": "editor-tab-content"
          },
          "children": [
            {
              "slot": "icon"
            },
            {
              "use": "Inline",
              "props": {
                "Class": {
                  "op": "cn",
                  "args": [
                    "text-xs text-foreground",
                    {
                      "op": "cond",
                      "args": [
                        {
                          "$": "preview"
                        },
                        "font-semibold italic",
                        "font-bold"
                      ]
                    }
                  ]
                }
              },
              "attrs": {
                "data-slot": "editor-tab-label"
              },
              "children": [
                {
                  "text": {
                    "$": "label"
                  }
                }
              ]
            },
            {
              "use": "Button",
              "props": {
                "Variant": "ghost",
                "Size": "sm",
                "Layout": "icon",
                "Class": "p-0 [&>svg]:size-4",
                "AriaLabel": {
                  "$": "closeLabel"
                }
              },
              "attrs": {
                "tabindex": -1,
                "data-slot": "editor-tab-close"
              },
              "on": {
                "click": {
                  "call": "emit.close",
                  "args": []
                }
              },
              "children": [
                {
                  "use": "LucideIcon",
                  "props": {
                    "Name": "x",
                    "Size": 16
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
