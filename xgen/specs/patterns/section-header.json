{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.section-header",
  "name": "SectionHeader",
  "docs": "The head of a section: an optional badge, the heading (h1 or h2) with an optional link opposite it, and an optional lead. No wrapper: its parts are children of the section stack.",
  "records": {},
  "props": [
    {
      "name": "titleId",
      "type": "string",
      "docs": "id of the heading (the section is labelled by it)",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "docs": "heading; empty string: no heading",
      "default": ""
    },
    {
      "name": "heading",
      "type": {
        "ts": "SectionHeading"
      },
      "docs": "how the heading is drawn: its level (2), its scale, a badge above it"
    },
    {
      "name": "action",
      "type": {
        "ts": "HeadLink"
      },
      "docs": "optional link opposite the heading (View all)"
    },
    {
      "name": "lead",
      "type": "string",
      "docs": "text under the heading"
    },
    {
      "name": "center",
      "type": "boolean",
      "docs": "centered text",
      "default": false
    }
  ],
  "derived": [
    {
      "name": "level",
      "value": {
        "op": "coalesce",
        "args": [
          {
            "$": "heading.level"
          },
          2
        ]
      }
    },
    {
      "name": "scale",
      "value": {
        "op": "coalesce",
        "args": [
          {
            "$": "heading.scale"
          },
          "default"
        ]
      }
    },
    {
      "name": "hasAction",
      "value": {
        "op": "and",
        "args": [
          {
            "$": "action.label"
          },
          {
            "$": "action.href"
          }
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "$": "heading.badge"
      },
      "then": [
        {
          "use": "Badge",
          "props": {
            "Variant": "outline",
            "Size": "lg",
            "Class": {
              "op": "cond",
              "args": [
                {
                  "$": "center"
                },
                "mx-auto w-fit",
                "w-fit"
              ]
            }
          },
          "attrs": {
            "data-testid": "section-badge"
          },
          "children": [
            {
              "text": {
                "$": "heading.badge"
              }
            }
          ]
        }
      ]
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "ne",
            "args": [
              {
                "$": "title"
              },
              ""
            ]
          },
          {
            "$": "hasAction"
          }
        ]
      },
      "then": [
        {
          "use": "Group",
          "props": {
            "Gap": "4",
            "Align": "center",
            "Justify": "between",
            "Class": "w-full flex-wrap"
          },
          "children": [
            {
              "use": "Title",
              "props": {
                "As": {
                  "$": "level"
                },
                "Size": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "level"
                        },
                        1
                      ]
                    },
                    "5xl",
                    "xl"
                  ]
                },
                "Weight": "semibold",
                "Class": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "scale"
                        },
                        "display"
                      ]
                    },
                    "text-6xl tracking-tight md:text-8xl",
                    {
                      "op": "cond",
                      "args": [
                        {
                          "op": "eq",
                          "args": [
                            {
                              "$": "level"
                            },
                            1
                          ]
                        },
                        "leading-tight",
                        "leading-7"
                      ]
                    }
                  ]
                }
              },
              "attrs": {
                "id": {
                  "$": "titleId"
                }
              },
              "children": [
                {
                  "text": {
                    "$": "title"
                  }
                }
              ]
            },
            {
              "use": "Link",
              "props": {
                "Href": {
                  "$": "action.href"
                },
                "Variant": "default",
                "Class": {
                  "op": "cn",
                  "args": [
                    {
                      "op": "preset",
                      "args": [
                        "defaults",
                        "text.tiny"
                      ]
                    },
                    "shrink-0 font-medium leading-5"
                  ]
                }
              },
              "attrs": {
                "data-testid": "section-action"
              },
              "children": [
                {
                  "text": {
                    "$": "action.label"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "ne",
            "args": [
              {
                "$": "title"
              },
              ""
            ]
          },
          {
            "op": "not",
            "args": [
              {
                "$": "hasAction"
              }
            ]
          }
        ]
      },
      "then": [
        {
          "use": "Title",
          "props": {
            "As": {
              "$": "level"
            },
            "Size": {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "level"
                    },
                    1
                  ]
                },
                "5xl",
                "xl"
              ]
            },
            "Weight": "semibold",
            "Class": {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "scale"
                    },
                    "display"
                  ]
                },
                "text-6xl tracking-tight md:text-8xl",
                {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "level"
                        },
                        1
                      ]
                    },
                    "leading-tight",
                    "leading-7"
                  ]
                }
              ]
            }
          },
          "attrs": {
            "id": {
              "$": "titleId"
            }
          },
          "children": [
            {
              "text": {
                "$": "title"
              }
            }
          ]
        }
      ]
    },
    {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "$": "title"
              },
              ""
            ]
          },
          {
            "$": "hasAction"
          }
        ]
      },
      "then": [
        {
          "use": "Group",
          "props": {
            "Gap": "4",
            "Align": "center",
            "Justify": "end",
            "Class": "w-full"
          },
          "children": [
            {
              "use": "Link",
              "props": {
                "Href": {
                  "$": "action.href"
                },
                "Variant": "default",
                "Class": {
                  "op": "cn",
                  "args": [
                    {
                      "op": "preset",
                      "args": [
                        "defaults",
                        "text.tiny"
                      ]
                    },
                    "shrink-0 font-medium leading-5"
                  ]
                }
              },
              "attrs": {
                "data-testid": "section-action"
              },
              "children": [
                {
                  "text": {
                    "$": "action.label"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "when": {
        "$": "lead"
      },
      "then": [
        {
          "use": "Text",
          "props": {
            "Size": "base",
            "Class": {
              "op": "cn",
              "args": [
                "max-w-2xl text-muted-foreground",
                {
                  "op": "cond",
                  "args": [
                    {
                      "$": "center"
                    },
                    "mx-auto",
                    ""
                  ]
                }
              ]
            }
          },
          "children": [
            {
              "text": {
                "$": "lead"
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "typeImports": [
    {
      "from": "SectionFrame",
      "names": [
        "SectionHeading",
        "HeadLink"
      ]
    }
  ]
}
