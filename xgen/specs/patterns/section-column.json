{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.section-column",
  "name": "SectionColumn",
  "docs": "The stacked body of a SectionFrame: the heading, the children and the media in one column; a narrow measure (xs to 3xl) holds the column at that width, centred.",
  "records": {},
  "props": [
    {
      "name": "measure",
      "type": {
        "ts": "\"default\" | \"landing\" | \"fill\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" | \"3xl\""
      },
      "docs": "the measure of the SectionFrame; xs to 3xl: a centred column of that width",
      "default": "default"
    }
  ],
  "children": true,
  "recipes": {
    "sectionColumn": "section-column"
  },
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Stack",
      "props": {
        "Gap": "6",
        "Align": "stretch",
        "Class": {
          "op": "recipe",
          "args": [
            "sectionColumn",
            "measure",
            {
              "$": "measure"
            }
          ]
        }
      },
      "children": [
        {
          "slot": "children"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "examples": [
    {
      "id": "measure.default",
      "props": {
        "measure": "default"
      }
    },
    {
      "id": "measure.landing",
      "props": {
        "measure": "landing"
      }
    },
    {
      "id": "measure.fill",
      "props": {
        "measure": "fill"
      }
    },
    {
      "id": "measure.xs",
      "props": {
        "measure": "xs"
      }
    },
    {
      "id": "measure.sm",
      "props": {
        "measure": "sm"
      }
    },
    {
      "id": "measure.md",
      "props": {
        "measure": "md"
      }
    },
    {
      "id": "measure.lg",
      "props": {
        "measure": "lg"
      }
    },
    {
      "id": "measure.xl",
      "props": {
        "measure": "xl"
      }
    },
    {
      "id": "measure.2xl",
      "props": {
        "measure": "2xl"
      }
    },
    {
      "id": "measure.3xl",
      "props": {
        "measure": "3xl"
      }
    }
  ]
}
