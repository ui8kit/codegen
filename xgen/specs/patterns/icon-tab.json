{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.icon-tab",
  "name": "IconTab",
  "docs": "One icon-only tab (28 by 28, a 16 px glyph in the children). `label` is its accessible name. Arrow-key movement between tabs is the job of IconTabs (see roving).",
  "records": {},
  "props": [
    {
      "name": "active",
      "type": "boolean",
      "docs": "the selected tab",
      "default": false
    },
    {
      "name": "label",
      "type": "string",
      "docs": "accessible name",
      "required": true
    }
  ],
  "className": true,
  "children": true,
  "recipes": {
    "iconTab": "icon-tab"
  },
  "slots": [],
  "events": [
    {
      "name": "click",
      "args": [],
      "docs": "the tab was pressed"
    }
  ],
  "view": [
    {
      "use": "ButtonPlain",
      "props": {
        "Type": "button",
        "Role": "tab",
        "AriaLabel": {
          "$": "label"
        },
        "Class": {
          "op": "cn",
          "args": [
            {
              "op": "recipe",
              "args": [
                "iconTab",
                "state",
                {
                  "op": "cond",
                  "args": [
                    {
                      "$": "active"
                    },
                    "active",
                    "default"
                  ]
                }
              ]
            },
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "aria-selected": {
          "$": "active"
        },
        "tabindex": {
          "op": "cond",
          "args": [
            {
              "$": "active"
            },
            0,
            -1
          ]
        },
        "data-slot": "icon-tab",
        "data-state": {
          "op": "cond",
          "args": [
            {
              "$": "active"
            },
            "active",
            "default"
          ]
        }
      },
      "on": {
        "click": {
          "call": "emit.click",
          "args": []
        }
      },
      "children": [
        {
          "slot": "children"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "examples": [
    {
      "id": "active.default",
      "props": {
        "label": "Files",
        "active": false
      }
    },
    {
      "id": "active.active",
      "props": {
        "label": "Files",
        "active": true
      }
    }
  ]
}
