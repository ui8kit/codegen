{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.section-frame",
  "name": "SectionFrame",
  "docs": "A page section: the landmark named by its heading, the heading (h1 or h2), an optional lead, the body (`children`) and optional media. `layout` stacks everything or puts the media beside the text; `boxed` puts the body in a card. Axes: layout, media side, tone, density, align.",
  "records": {
    "SectionHeading": [
      {
        "name": "level",
        "type": "1 | 2",
        "optional": true,
        "docs": "heading level",
        "default": 2
      },
      {
        "name": "scale",
        "type": "\"default\" | \"display\"",
        "optional": true,
        "docs": "display: an oversized heading",
        "default": "default"
      },
      {
        "name": "badge",
        "type": "string",
        "optional": true,
        "docs": "a short pill above the heading (e.g. New)"
      }
    ],
    "HeadLink": [
      {
        "name": "label",
        "type": "string",
        "optional": true,
        "docs": "text of the link (View all, Browse all); none: no link"
      },
      {
        "name": "href",
        "type": "string",
        "optional": true,
        "docs": "href of the link; none: no link"
      }
    ],
    "SectionMedia": [
      {
        "name": "show",
        "type": "boolean",
        "optional": true,
        "docs": "the `aside` slot is shown",
        "default": false
      },
      {
        "name": "side",
        "type": "\"end\" | \"start\"",
        "optional": true,
        "docs": "side of the media in the split layout",
        "default": "end"
      },
      {
        "name": "align",
        "type": "\"center\" | \"start\"",
        "optional": true,
        "docs": "split layout: the body and the media centred on each other, or both from the top",
        "default": "center"
      }
    ]
  },
  "props": [
    {
      "name": "id",
      "type": "string",
      "docs": "ties the heading to the section: the heading id is `<id>-title`",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "docs": "section heading; empty string: no heading",
      "default": ""
    },
    {
      "name": "lead",
      "type": "string",
      "docs": "text under the heading"
    },
    {
      "name": "heading",
      "type": {
        "record": "SectionHeading"
      },
      "docs": "how the heading is drawn: its level, its scale, a badge above it"
    },
    {
      "name": "action",
      "type": {
        "record": "HeadLink"
      },
      "docs": "optional link opposite the heading"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"stack\" | \"split\""
      },
      "docs": "stack: media below the body; split: media beside it",
      "default": "stack"
    },
    {
      "name": "media",
      "type": {
        "record": "SectionMedia"
      },
      "docs": "the `aside` slot: shown or not, and its side"
    },
    {
      "name": "boxed",
      "type": "boolean",
      "docs": "the body sits in a card",
      "default": false
    },
    {
      "name": "tone",
      "type": {
        "ts": "\"default\" | \"muted\" | \"inverse\""
      },
      "docs": "background",
      "default": "default"
    },
    {
      "name": "density",
      "type": {
        "ts": "\"roomy\" | \"default\" | \"compact\" | \"flush\""
      },
      "docs": "vertical padding",
      "default": "default"
    },
    {
      "name": "align",
      "type": {
        "ts": "\"start\" | \"center\""
      },
      "docs": "text alignment",
      "default": "start"
    },
    {
      "name": "measure",
      "type": {
        "ts": "\"default\" | \"landing\" | \"fill\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" | \"3xl\""
      },
      "docs": "default: max-w-6xl; landing: the landing column of the preset; fill: full width of parent; xs to 3xl: a narrow body, the heading and the body one column of that width centred in the default container",
      "default": "default"
    },
    {
      "name": "landmarkLabel",
      "type": "string",
      "docs": "accessible name of the landmark of this component when the page shows it more than once (a variant); replaces the heading name of the root landmark, follows the name of a nested one"
    }
  ],
  "className": true,
  "children": true,
  "recipes": {
    "sectionFrame": "section-frame"
  },
  "derived": [
    {
      "name": "titleId",
      "value": {
        "op": "add",
        "args": [
          {
            "$": "id"
          },
          "-title"
        ]
      }
    },
    {
      "name": "sectionTone",
      "value": {
        "op": "cond",
        "args": [
          {
            "$": "boxed"
          },
          "default",
          {
            "$": "tone"
          }
        ]
      }
    },
    {
      "name": "center",
      "value": {
        "op": "eq",
        "args": [
          {
            "$": "align"
          },
          "center"
        ]
      }
    }
  ],
  "slots": [
    {
      "name": "aside",
      "args": [],
      "docs": "the media (a MediaFrame)"
    }
  ],
  "events": [],
  "view": [
    {
      "use": "Block",
      "props": {
        "Tag": "section",
        "Class": {
          "op": "cn",
          "args": [
            {
              "op": "recipe",
              "args": [
                "sectionFrame",
                "tone",
                {
                  "$": "sectionTone"
                },
                "density",
                {
                  "$": "density"
                },
                "align",
                {
                  "$": "align"
                }
              ]
            },
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "undef",
              "args": []
            },
            {
              "op": "cond",
              "args": [
                {
                  "op": "ne",
                  "args": [
                    {
                      "$": "title"
                    },
                    ""
                  ]
                },
                {
                  "$": "titleId"
                },
                {
                  "op": "undef",
                  "args": []
                }
              ]
            }
          ]
        },
        "aria-label": {
          "op": "coalesce",
          "args": [
            {
              "$": "landmarkLabel"
            },
            {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "title"
                    },
                    ""
                  ]
                },
                {
                  "$": "id"
                },
                {
                  "op": "undef",
                  "args": []
                }
              ]
            }
          ]
        },
        "data-testid": "section",
        "data-tone": {
          "$": "tone"
        },
        "data-density": {
          "$": "density"
        }
      },
      "children": [
        {
          "use": "Container",
          "props": {
            "Class": {
              "op": "cond",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "measure"
                    },
                    "landing"
                  ]
                },
                {
                  "op": "cn",
                  "args": [
                    "mx-auto w-full px-4",
                    {
                      "op": "preset",
                      "args": [
                        "defaults",
                        "section.landing"
                      ]
                    }
                  ]
                },
                {
                  "op": "cond",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "measure"
                        },
                        "fill"
                      ]
                    },
                    "w-full",
                    "mx-auto w-full max-w-6xl px-4"
                  ]
                }
              ]
            }
          },
          "attrs": {
            "data-slot": "container"
          },
          "children": [
            {
              "organism": "SectionBox",
              "props": {
                "boxed": {
                  "$": "boxed"
                }
              },
              "slots": {
                "children": {
                  "args": [],
                  "do": [
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "layout"
                          },
                          "split"
                        ]
                      },
                      "then": [
                        {
                          "use": "Grid",
                          "props": {
                            "Cols": "1-2",
                            "Class": {
                              "op": "cn",
                              "args": [
                                "gap-8",
                                {
                                  "op": "cond",
                                  "args": [
                                    {
                                      "op": "eq",
                                      "args": [
                                        {
                                          "$": "media.align"
                                        },
                                        "start"
                                      ]
                                    },
                                    "items-start",
                                    "items-center"
                                  ]
                                }
                              ]
                            }
                          },
                          "children": [
                            {
                              "when": {
                                "op": "and",
                                "args": [
                                  {
                                    "$": "media.show"
                                  },
                                  {
                                    "op": "eq",
                                    "args": [
                                      {
                                        "$": "media.side"
                                      },
                                      "start"
                                    ]
                                  }
                                ]
                              },
                              "then": [
                                {
                                  "use": "Box",
                                  "props": {
                                    "Class": "w-full"
                                  },
                                  "attrs": {
                                    "data-slot": "media"
                                  },
                                  "children": [
                                    {
                                      "slot": "aside"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "use": "Stack",
                              "props": {
                                "Gap": "6",
                                "Align": "stretch"
                              },
                              "children": [
                                {
                                  "organism": "SectionHeader",
                                  "props": {
                                    "titleId": {
                                      "$": "titleId"
                                    },
                                    "title": {
                                      "$": "title"
                                    },
                                    "heading": {
                                      "$": "heading"
                                    },
                                    "action": {
                                      "$": "action"
                                    },
                                    "lead": {
                                      "$": "lead"
                                    },
                                    "center": {
                                      "$": "center"
                                    }
                                  }
                                },
                                {
                                  "slot": "children"
                                }
                              ]
                            },
                            {
                              "when": {
                                "op": "and",
                                "args": [
                                  {
                                    "$": "media.show"
                                  },
                                  {
                                    "op": "ne",
                                    "args": [
                                      {
                                        "$": "media.side"
                                      },
                                      "start"
                                    ]
                                  }
                                ]
                              },
                              "then": [
                                {
                                  "use": "Box",
                                  "props": {
                                    "Class": "w-full"
                                  },
                                  "attrs": {
                                    "data-slot": "media"
                                  },
                                  "children": [
                                    {
                                      "slot": "aside"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "else": [
                        {
                          "organism": "SectionColumn",
                          "props": {
                            "measure": {
                              "$": "measure"
                            }
                          },
                          "slots": {
                            "children": {
                              "args": [],
                              "do": [
                                {
                                  "organism": "SectionHeader",
                                  "props": {
                                    "titleId": {
                                      "$": "titleId"
                                    },
                                    "title": {
                                      "$": "title"
                                    },
                                    "heading": {
                                      "$": "heading"
                                    },
                                    "action": {
                                      "$": "action"
                                    },
                                    "lead": {
                                      "$": "lead"
                                    },
                                    "center": {
                                      "$": "center"
                                    }
                                  }
                                },
                                {
                                  "slot": "children"
                                },
                                {
                                  "when": {
                                    "$": "media.show"
                                  },
                                  "then": [
                                    {
                                      "use": "Box",
                                      "props": {
                                        "Class": "w-full"
                                      },
                                      "attrs": {
                                        "data-slot": "media"
                                      },
                                      "children": [
                                        {
                                          "slot": "aside"
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "frame": true,
  "examples": [
    {
      "id": "tone.default",
      "props": {
        "id": "frame",
        "title": "Title",
        "tone": "default"
      }
    },
    {
      "id": "tone.muted",
      "props": {
        "id": "frame",
        "title": "Title",
        "tone": "muted"
      }
    },
    {
      "id": "tone.inverse",
      "props": {
        "id": "frame",
        "title": "Title",
        "tone": "inverse"
      }
    },
    {
      "id": "density.roomy",
      "props": {
        "id": "frame",
        "title": "Title",
        "density": "roomy"
      }
    },
    {
      "id": "density.default",
      "props": {
        "id": "frame",
        "title": "Title",
        "density": "default"
      }
    },
    {
      "id": "density.compact",
      "props": {
        "id": "frame",
        "title": "Title",
        "density": "compact"
      }
    },
    {
      "id": "density.flush",
      "props": {
        "id": "frame",
        "title": "Title",
        "density": "flush"
      }
    },
    {
      "id": "align.start",
      "props": {
        "id": "frame",
        "title": "Title",
        "align": "start"
      }
    },
    {
      "id": "align.center",
      "props": {
        "id": "frame",
        "title": "Title",
        "align": "center"
      }
    },
    {
      "id": "measure.xs",
      "props": {
        "id": "frame",
        "title": "Title",
        "measure": "xs"
      }
    },
    {
      "id": "measure.md",
      "props": {
        "id": "frame",
        "title": "Title",
        "measure": "md"
      }
    },
    {
      "id": "measure.2xl",
      "props": {
        "id": "frame",
        "title": "Title",
        "measure": "2xl"
      }
    }
  ]
}
