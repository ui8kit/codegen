{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.media-frame",
  "name": "MediaFrame",
  "docs": "A picture in a fixed ratio that follows the theme. `src` is the picture of the light theme, `darkSrc` the one of the dark theme (without it the dark theme shows `src`). Without both it shows the built-in neutral placeholders (base64 data URIs, one light and one dark), so a page can be laid out before it has pictures; the placeholder stands in for a real `src` and is switched by the theme token. `ratio` comes from the recipe; the corners are the plain theme radius.",
  "records": {},
  "props": [
    {
      "name": "alt",
      "type": "string",
      "docs": "accessible name of the picture",
      "required": true
    },
    {
      "name": "src",
      "type": "string",
      "docs": "address of the picture (light theme); none: the built-in light placeholder"
    },
    {
      "name": "darkSrc",
      "type": "string",
      "docs": "address of the picture for the dark theme; none: `src`, or the built-in dark placeholder when there is no `src`"
    },
    {
      "name": "ratio",
      "type": {
        "ts": "\"16/9\" | \"4/3\" | \"1/1\" | \"3/4\" | \"21/9\""
      },
      "docs": "width to height",
      "default": "16/9"
    }
  ],
  "className": true,
  "recipes": {
    "mediaFrame": "media-frame"
  },
  "consts": {
    "PLACEHOLDER": {
      "light": "data:image/svg+xml;base64,",
      "dark": "data:image/svg+xml;base64,"
    }
  },
  "derived": [
    {
      "name": "lightSrc",
      "value": {
        "op": "coalesce",
        "args": [
          {
            "$": "src"
          },
          {
            "op": "at",
            "args": [
              {
                "$": "PLACEHOLDER"
              },
              "light"
            ]
          }
        ]
      }
    },
    {
      "name": "nightSrc",
      "value": {
        "op": "coalesce",
        "args": [
          {
            "$": "darkSrc"
          },
          {
            "$": "src"
          },
          {
            "op": "at",
            "args": [
              {
                "$": "PLACEHOLDER"
              },
              "dark"
            ]
          }
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": {
          "op": "cn",
          "args": [
            {
              "op": "recipe",
              "args": [
                "mediaFrame",
                "ratio",
                {
                  "$": "ratio"
                }
              ]
            },
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "data-slot": "media-frame",
        "data-placeholder": {
          "op": "cond",
          "args": [
            {
              "$": "src"
            },
            "false",
            "true"
          ]
        }
      },
      "children": [
        {
          "use": "Image",
          "props": {
            "Src": {
              "$": "lightSrc"
            },
            "Alt": {
              "$": "alt"
            },
            "Class": "absolute inset-0 size-full object-cover dark:hidden"
          },
          "attrs": {
            "data-theme-src": "light"
          }
        },
        {
          "use": "Image",
          "props": {
            "Src": {
              "$": "nightSrc"
            },
            "Alt": {
              "$": "alt"
            },
            "Class": "absolute inset-0 hidden size-full object-cover dark:block"
          },
          "attrs": {
            "data-theme-src": "dark"
          }
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "examples": [
    {
      "id": "ratio.16/9",
      "props": {
        "alt": "Picture",
        "ratio": "16/9"
      }
    },
    {
      "id": "ratio.4/3",
      "props": {
        "alt": "Picture",
        "ratio": "4/3"
      }
    },
    {
      "id": "ratio.1/1",
      "props": {
        "alt": "Picture",
        "ratio": "1/1"
      }
    },
    {
      "id": "ratio.3/4",
      "props": {
        "alt": "Picture",
        "ratio": "3/4"
      }
    },
    {
      "id": "ratio.21/9",
      "props": {
        "alt": "Picture",
        "ratio": "21/9"
      }
    }
  ]
}
