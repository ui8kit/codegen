{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.backdrop",
  "name": "Backdrop",
  "docs": "A faint full-size picture behind the content of its section (image), or nothing (none). It sits inside the Block of the block, which `behind` makes `relative isolate overflow-hidden`, so the section stays the root of the block (rule 01).",
  "records": {},
  "props": [
    {
      "name": "kind",
      "type": {
        "ts": "\"none\" | \"image\""
      },
      "docs": "what is drawn behind",
      "default": "none"
    },
    {
      "name": "alt",
      "type": "string",
      "docs": "accessible name of the picture (image)",
      "default": ""
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "when": {
        "op": "eq",
        "args": [
          {
            "$": "kind"
          },
          "image"
        ]
      },
      "then": [
        {
          "use": "Box",
          "props": {
            "Class": "pointer-events-none absolute inset-0 -z-10"
          },
          "attrs": {
            "data-testid": "backdrop"
          },
          "children": [
            {
              "organism": "MediaFrame",
              "props": {
                "alt": {
                  "$": "alt"
                },
                "ratio": "21/9",
                "className": "size-full rounded-none opacity-30"
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
