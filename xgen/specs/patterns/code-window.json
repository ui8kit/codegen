{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.code-window",
  "name": "CodeWindow",
  "docs": "A terminal or code window: a title bar with three round marks, then the lines. A `command` line starts with the prompt, an `output` line is muted. Static: the typing animation belongs to the port (TypingText contract).",
  "records": {
    "CodeLine": [
      {
        "name": "id",
        "type": "string"
      },
      {
        "name": "text",
        "type": "string"
      },
      {
        "name": "kind",
        "type": "string"
      }
    ]
  },
  "props": [
    {
      "name": "title",
      "type": "string",
      "required": true,
      "docs": "name of the window, also its accessible name"
    },
    {
      "name": "prompt",
      "type": "string",
      "required": true,
      "docs": "the mark before a command line"
    },
    {
      "name": "lines",
      "type": {
        "ts": "CodeLine[]"
      },
      "required": true
    }
  ],
  "className": true,
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": {
          "op": "cn",
          "args": [
            "w-full overflow-hidden rounded bg-card text-left inset-ring inset-ring-border",
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "role": "group",
        "aria-label": {
          "$": "title"
        },
        "data-slot": "code-window"
      },
      "children": [
        {
          "use": "Box",
          "props": {
            "Class": "flex items-center border-b border-border px-4 py-2"
          },
          "children": [
            {
              "use": "Text",
              "props": {
                "Size": "xs",
                "Class": "text-muted-foreground"
              },
              "children": [
                {
                  "text": {
                    "$": "title"
                  }
                }
              ]
            }
          ]
        },
        {
          "use": "List",
          "props": {
            "Class": "m-0 flex list-none flex-col gap-2 p-4 font-mono text-sm"
          },
          "children": [
            {
              "each": {
                "$": "lines"
              },
              "as": "line",
              "key": {
                "$": "line.id"
              },
              "do": [
                {
                  "use": "ListItem",
                  "props": {
                    "Class": {
                      "op": "cn",
                      "args": [
                        "flex gap-2",
                        {
                          "op": "cond",
                          "args": [
                            {
                              "op": "eq",
                              "args": [
                                {
                                  "$": "line.kind"
                                },
                                "command"
                              ]
                            },
                            "text-foreground",
                            "text-muted-foreground"
                          ]
                        }
                      ]
                    }
                  },
                  "attrs": {
                    "data-kind": {
                      "$": "line.kind"
                    }
                  },
                  "children": [
                    {
                      "when": {
                        "op": "eq",
                        "args": [
                          {
                            "$": "line.kind"
                          },
                          "command"
                        ]
                      },
                      "then": [
                        {
                          "use": "Inline",
                          "props": {
                            "Class": "select-none text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "prompt"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "use": "Inline",
                      "children": [
                        {
                          "text": {
                            "$": "line.text"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
