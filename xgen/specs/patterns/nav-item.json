{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.nav-item",
  "name": "NavItem",
  "docs": "A sidebar list item: icon, label and an optional right slot. With `href` it is a link, with `interactive` a button, otherwise a static box.",
  "records": {},
  "props": [
    {
      "name": "selected",
      "type": "boolean",
      "docs": "the current item",
      "default": false
    },
    {
      "name": "level",
      "type": {
        "ts": "\"1\" | \"2\" | \"3\" | \"4\""
      },
      "docs": "indent level"
    },
    {
      "name": "href",
      "type": "string"
    },
    {
      "name": "interactive",
      "type": "boolean",
      "docs": "render a button (the click event is wired)",
      "default": false
    },
    {
      "name": "reserveRight",
      "type": "boolean",
      "docs": "keep the empty 20 by 20 frame on the right when there is no right content",
      "default": false
    },
    {
      "name": "contentClass",
      "type": "string",
      "docs": "classes of the inner row"
    }
  ],
  "className": true,
  "children": true,
  "recipes": {
    "navItem": "nav-item",
    "navItemContent": "nav-item-content"
  },
  "derived": [
    {
      "name": "state",
      "value": {
        "op": "cond",
        "args": [
          {
            "$": "selected"
          },
          "selected",
          "default"
        ]
      }
    },
    {
      "name": "outer",
      "value": {
        "op": "cn",
        "args": [
          {
            "op": "recipe",
            "args": [
              "navItem",
              "level",
              {
                "$": "level"
              },
              "state",
              {
                "$": "state"
              }
            ]
          },
          "group in-data-[nav=collapsed]:justify-center",
          {
            "$": "className"
          }
        ]
      }
    },
    {
      "name": "inner",
      "value": {
        "op": "cn",
        "args": [
          {
            "op": "recipe",
            "args": [
              "navItemContent",
              "level",
              {
                "$": "level"
              },
              "state",
              {
                "$": "state"
              }
            ]
          },
          {
            "op": "and",
            "args": [
              {
                "op": "not",
                "args": [
                  {
                    "$": "selected"
                  }
                ]
              },
              "group-hover:bg-muted"
            ]
          },
          "in-data-[nav=collapsed]:w-10 in-data-[nav=collapsed]:flex-none in-data-[nav=collapsed]:justify-center in-data-[nav=collapsed]:px-0",
          {
            "$": "contentClass"
          }
        ]
      }
    }
  ],
  "slots": [
    {
      "name": "icon",
      "args": [],
      "docs": "leading icon"
    },
    {
      "name": "right",
      "args": [],
      "docs": "trailing content"
    }
  ],
  "events": [
    {
      "name": "click",
      "args": [],
      "docs": "the item was pressed (link and button)"
    }
  ],
  "view": [
    {
      "when": {
        "$": "href"
      },
      "then": [
        {
          "use": "LinkPlain",
          "props": {
            "Href": {
              "$": "href"
            },
            "Class": {
              "$": "outer"
            },
            "AriaCurrent": {
              "op": "cond",
              "args": [
                {
                  "$": "selected"
                },
                "page",
                {
                  "op": "undef",
                  "args": []
                }
              ]
            }
          },
          "attrs": {
            "data-slot": "nav-item",
            "data-state": {
              "$": "state"
            }
          },
          "on": {
            "click": {
              "call": "emit.click",
              "args": []
            }
          },
          "children": [
            {
              "organism": "NavItemRow",
              "props": {
                "inner": {
                  "$": "inner"
                },
                "reserveRight": {
                  "$": "reserveRight"
                }
              },
              "slots": {
                "icon": {
                  "args": [],
                  "do": [],
                  "forward": "icon"
                },
                "right": {
                  "args": [],
                  "do": [],
                  "forward": "right"
                },
                "children": {
                  "args": [],
                  "do": [],
                  "forward": "children"
                }
              }
            }
          ]
        }
      ],
      "else": [
        {
          "when": {
            "$": "interactive"
          },
          "then": [
            {
              "use": "ButtonPlain",
              "props": {
                "Type": "button",
                "Class": {
                  "op": "cn",
                  "args": [
                    {
                      "$": "outer"
                    },
                    "text-left"
                  ]
                }
              },
              "attrs": {
                "aria-current": {
                  "op": "cond",
                  "args": [
                    {
                      "$": "selected"
                    },
                    "page",
                    {
                      "op": "undef",
                      "args": []
                    }
                  ]
                },
                "data-slot": "nav-item",
                "data-state": {
                  "$": "state"
                }
              },
              "on": {
                "click": {
                  "call": "emit.click",
                  "args": []
                }
              },
              "children": [
                {
                  "organism": "NavItemRow",
                  "props": {
                    "inner": {
                      "$": "inner"
                    },
                    "reserveRight": {
                      "$": "reserveRight"
                    }
                  },
                  "slots": {
                    "icon": {
                      "args": [],
                      "do": [],
                      "forward": "icon"
                    },
                    "right": {
                      "args": [],
                      "do": [],
                      "forward": "right"
                    },
                    "children": {
                      "args": [],
                      "do": [],
                      "forward": "children"
                    }
                  }
                }
              ]
            }
          ],
          "else": [
            {
              "use": "Box",
              "props": {
                "Class": {
                  "$": "outer"
                }
              },
              "attrs": {
                "aria-current": {
                  "op": "cond",
                  "args": [
                    {
                      "$": "selected"
                    },
                    "page",
                    {
                      "op": "undef",
                      "args": []
                    }
                  ]
                },
                "data-slot": "nav-item",
                "data-state": {
                  "$": "state"
                }
              },
              "children": [
                {
                  "organism": "NavItemRow",
                  "props": {
                    "inner": {
                      "$": "inner"
                    },
                    "reserveRight": {
                      "$": "reserveRight"
                    }
                  },
                  "slots": {
                    "icon": {
                      "args": [],
                      "do": [],
                      "forward": "icon"
                    },
                    "right": {
                      "args": [],
                      "do": [],
                      "forward": "right"
                    },
                    "children": {
                      "args": [],
                      "do": [],
                      "forward": "children"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "examples": [
    {
      "id": "level.1",
      "props": {
        "level": "1"
      }
    },
    {
      "id": "level.2",
      "props": {
        "level": "2"
      }
    },
    {
      "id": "level.3",
      "props": {
        "level": "3"
      }
    },
    {
      "id": "level.4",
      "props": {
        "level": "4"
      }
    },
    {
      "id": "state.selected",
      "props": {
        "selected": true
      }
    },
    {
      "id": "link",
      "props": {
        "href": "#/home"
      }
    },
    {
      "id": "button",
      "props": {
        "interactive": true
      }
    }
  ]
}
