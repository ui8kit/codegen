{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.icon-tabs",
  "name": "IconTabs",
  "docs": "A row of icon-only tabs (a file tree pane: Files, Search, Apps). Put IconTab in it. Arrow keys: attach `moveFocus` from the utils to the keydown of the row (orientation horizontal, activate).",
  "records": {},
  "props": [
    {
      "name": "label",
      "type": "string",
      "docs": "accessible name of the tab list"
    }
  ],
  "className": true,
  "children": true,
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": {
          "op": "cn",
          "args": [
            "flex items-center gap-2",
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "role": "tablist",
        "aria-label": {
          "$": "label"
        },
        "data-slot": "icon-tabs"
      },
      "children": [
        {
          "slot": "children"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
