{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.switcher-item",
  "name": "SwitcherItem",
  "docs": "One item of a Switcher (default or active). Pass the same size and layout as the Switcher.",
  "records": {},
  "props": [
    {
      "name": "active",
      "type": "boolean",
      "docs": "the selected item",
      "default": false
    },
    {
      "name": "size",
      "type": {
        "ts": "\"sm\" | \"default\" | \"lg\""
      },
      "docs": "height",
      "default": "default"
    },
    {
      "name": "layout",
      "type": {
        "ts": "\"text\" | \"icon\""
      },
      "docs": "text or icon",
      "default": "text"
    }
  ],
  "className": true,
  "children": true,
  "recipes": {
    "switcherItem": "switcher-item"
  },
  "slots": [],
  "events": [
    {
      "name": "click",
      "args": [],
      "docs": "the item was pressed"
    }
  ],
  "view": [
    {
      "use": "ButtonPlain",
      "props": {
        "Type": "button",
        "Role": "tab",
        "Class": {
          "op": "cn",
          "args": [
            {
              "op": "recipe",
              "args": [
                "switcherItem",
                "size",
                {
                  "$": "size"
                },
                "layout",
                {
                  "$": "layout"
                },
                "state",
                {
                  "op": "cond",
                  "args": [
                    {
                      "$": "active"
                    },
                    "active",
                    "default"
                  ]
                }
              ]
            },
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "aria-selected": {
          "$": "active"
        },
        "tabindex": {
          "op": "cond",
          "args": [
            {
              "$": "active"
            },
            0,
            -1
          ]
        },
        "data-slot": "switcher-item",
        "data-state": {
          "op": "cond",
          "args": [
            {
              "$": "active"
            },
            "active",
            "default"
          ]
        }
      },
      "on": {
        "click": {
          "call": "emit.click",
          "args": []
        }
      },
      "children": [
        {
          "slot": "children"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "examples": [
    {
      "id": "size.sm",
      "props": {
        "size": "sm"
      }
    },
    {
      "id": "size.default",
      "props": {
        "size": "default"
      }
    },
    {
      "id": "size.lg",
      "props": {
        "size": "lg"
      }
    },
    {
      "id": "layout.text",
      "props": {
        "layout": "text"
      }
    },
    {
      "id": "layout.icon",
      "props": {
        "layout": "icon"
      }
    },
    {
      "id": "state.active",
      "props": {
        "active": true
      }
    }
  ]
}
