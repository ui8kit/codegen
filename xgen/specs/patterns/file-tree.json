{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "pattern.file-tree",
  "name": "FileTree",
  "docs": "The list of a file tree. Put FileTreeItem in it. Arrow keys and type-ahead: attach `moveFocus` and `typeahead` from the utils to the keydown (vertical, no loop).",
  "records": {},
  "props": [
    {
      "name": "label",
      "type": "string",
      "docs": "accessible name of the tree"
    }
  ],
  "className": true,
  "children": true,
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": {
          "op": "cn",
          "args": [
            "flex flex-col gap-2 p-2",
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "role": "tree",
        "aria-label": {
          "$": "label"
        },
        "data-slot": "file-tree"
      },
      "children": [
        {
          "slot": "children"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
