{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "part.avatar",
  "name": "Avatar",
  "docs": "An image in a round frame (recipe: size xs to xl, 24 to 64 px). Avatars are always round.",
  "records": {},
  "props": [
    {
      "name": "src",
      "type": "string",
      "required": true
    },
    {
      "name": "alt",
      "type": "string",
      "docs": "empty for a decorative picture",
      "default": ""
    },
    {
      "name": "size",
      "type": {
        "ts": "\"xs\" | \"sm\" | \"default\" | \"lg\" | \"xl\""
      },
      "docs": "frame size in px",
      "default": "default"
    }
  ],
  "className": true,
  "recipes": {
    "avatar": "avatar"
  },
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Inline",
      "props": {
        "Class": {
          "op": "cn",
          "args": [
            {
              "op": "recipe",
              "args": [
                "avatar",
                "size",
                {
                  "$": "size"
                }
              ]
            },
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "data-slot": "avatar"
      },
      "children": [
        {
          "use": "Image",
          "props": {
            "Src": {
              "$": "src"
            },
            "Alt": {
              "$": "alt"
            },
            "Class": "size-full object-cover",
            "Fit": "cover",
            "Size": "auto",
            "Loading": "eager",
            "Decoding": "auto"
          },
          "attrs": {
            "draggable": "false"
          }
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  },
  "examples": [
    {
      "id": "size.xs",
      "props": {
        "src": "avatar.png",
        "size": "xs"
      }
    },
    {
      "id": "size.sm",
      "props": {
        "src": "avatar.png",
        "size": "sm"
      }
    },
    {
      "id": "size.default",
      "props": {
        "src": "avatar.png",
        "size": "default"
      }
    },
    {
      "id": "size.lg",
      "props": {
        "src": "avatar.png",
        "size": "lg"
      }
    },
    {
      "id": "size.xl",
      "props": {
        "src": "avatar.png",
        "size": "xl"
      }
    }
  ]
}
