{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "part.notice",
  "name": "Notice",
  "docs": "A short confirmation toast: fixed bottom right, read out by screen readers through role status. Empty text renders nothing visible.",
  "records": {},
  "props": [
    {
      "name": "text",
      "type": "string",
      "required": true
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": "contents"
      },
      "attrs": {
        "role": "status",
        "data-testid": "notice"
      },
      "children": [
        {
          "when": {
            "$": "text"
          },
          "then": [
            {
              "use": "Text",
              "props": {
                "Class": "fixed right-4 bottom-4 z-40 m-0 flex items-center gap-2 rounded bg-foreground p-4 text-xs font-bold text-background shadow-lg"
              },
              "children": [
                {
                  "use": "LucideIcon",
                  "props": {
                    "Name": "circle-check",
                    "Size": 16
                  }
                },
                {
                  "text": {
                    "$": "text"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
