{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "part.table-toolbar",
  "name": "TableToolbar",
  "docs": "The toolbar above a table: search and filter controls on the left (children), the actions on the right (`actions`). One tab stop group (role toolbar).",
  "records": {},
  "props": [
    {
      "name": "label",
      "type": "string",
      "docs": "accessible name of the toolbar",
      "required": true
    }
  ],
  "className": true,
  "children": true,
  "slots": [
    {
      "name": "actions",
      "args": [],
      "docs": "actions on the right"
    }
  ],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": {
          "op": "cn",
          "args": [
            "flex flex-wrap items-center justify-between gap-2",
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "role": "toolbar",
        "aria-label": {
          "$": "label"
        },
        "data-slot": "table-toolbar"
      },
      "children": [
        {
          "use": "Inline",
          "props": {
            "Class": "flex min-w-0 flex-wrap items-center gap-2"
          },
          "children": [
            {
              "slot": "children"
            }
          ]
        },
        {
          "use": "Inline",
          "props": {
            "Class": "flex flex-wrap items-center gap-2"
          },
          "children": [
            {
              "slot": "actions"
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
