{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "part.rating",
  "name": "Rating",
  "docs": "One to five stars (a review's grade, the average of a product). The value is read as the label; the stars themselves are decoration.",
  "records": {},
  "props": [
    {
      "name": "value",
      "type": "number",
      "docs": "0 to max, halves are rounded",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "docs": "read to assistive technology, e.g. \"4 of 5\"",
      "required": true
    },
    {
      "name": "max",
      "type": "number",
      "docs": "number of stars",
      "default": 5
    },
    {
      "name": "size",
      "type": "number",
      "docs": "size of a star in px",
      "default": 16
    }
  ],
  "className": true,
  "derived": [
    {
      "name": "full",
      "value": {
        "op": "round",
        "args": [
          {
            "op": "min",
            "args": [
              {
                "$": "max"
              },
              {
                "op": "max",
                "args": [
                  0,
                  {
                    "$": "value"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": {
          "op": "cn",
          "args": [
            "inline-flex items-center gap-0",
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "role": "img",
        "aria-label": {
          "$": "label"
        },
        "data-slot": "rating",
        "data-value": {
          "$": "full"
        }
      },
      "children": [
        {
          "each": {
            "op": "range",
            "args": [
              {
                "$": "max"
              }
            ]
          },
          "as": "i",
          "key": {
            "$": "i"
          },
          "do": [
            {
              "use": "LucideIcon",
              "props": {
                "Name": "star",
                "Size": {
                  "$": "size"
                },
                "Class": {
                  "op": "cond",
                  "args": [
                    {
                      "op": "lt",
                      "args": [
                        {
                          "$": "i"
                        },
                        {
                          "$": "full"
                        }
                      ]
                    },
                    "fill-foreground text-foreground",
                    "text-border"
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
