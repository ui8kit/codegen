{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "part.field",
  "name": "Field",
  "docs": "A form field: label, control (children), hint and error text. `htmlFor` ties the label to the id of the control.",
  "records": {},
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": true
    },
    {
      "name": "htmlFor",
      "type": "string",
      "docs": "id of the control",
      "required": true
    },
    {
      "name": "hint",
      "type": "string"
    },
    {
      "name": "error",
      "type": "string",
      "docs": "when set it replaces the hint and is announced (role alert)"
    }
  ],
  "className": true,
  "children": true,
  "slots": [],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": {
          "op": "cn",
          "args": [
            "flex min-w-0 flex-col gap-2",
            {
              "$": "className"
            }
          ]
        }
      },
      "children": [
        {
          "use": "Label",
          "props": {
            "Class": "text-xs font-bold text-foreground",
            "HTMLFor": {
              "$": "htmlFor"
            }
          },
          "children": [
            {
              "text": {
                "$": "label"
              }
            }
          ]
        },
        {
          "slot": "children"
        },
        {
          "when": {
            "$": "error"
          },
          "then": [
            {
              "use": "Text",
              "props": {
                "Class": "m-0 text-xs font-semibold text-destructive"
              },
              "attrs": {
                "role": "alert"
              },
              "children": [
                {
                  "text": {
                    "$": "error"
                  }
                }
              ]
            }
          ],
          "else": [
            {
              "when": {
                "$": "hint"
              },
              "then": [
                {
                  "use": "Text",
                  "props": {
                    "Class": "m-0 text-xs font-medium text-muted-foreground"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "hint"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
