{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "part.panel",
  "name": "Panel",
  "docs": "A titled card (surface bg-card, hairline ring): the content panel of a page. An optional title, description and header actions. Pass `id` to name the panel by its title. Not a landmark: a labelled group inside the Block of its block (rule 01).",
  "records": {},
  "props": [
    {
      "name": "title",
      "type": "string"
    },
    {
      "name": "description",
      "type": "string"
    },
    {
      "name": "id",
      "type": "string",
      "docs": "base id: the title gets `{id}-t` and the panel points at it with aria-labelledby"
    }
  ],
  "className": true,
  "children": true,
  "slots": [
    {
      "name": "actions",
      "args": [],
      "docs": "header actions"
    }
  ],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": {
          "op": "cn",
          "args": [
            "flex min-w-0 flex-col gap-4 rounded bg-card p-6 inset-ring inset-ring-border",
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "role": "group",
        "aria-labelledby": {
          "op": "cond",
          "args": [
            {
              "op": "and",
              "args": [
                {
                  "$": "title"
                },
                {
                  "$": "id"
                }
              ]
            },
            {
              "op": "tpl",
              "args": [
                "{0}-t",
                {
                  "$": "id"
                }
              ]
            },
            {
              "op": "undef",
              "args": []
            }
          ]
        }
      },
      "children": [
        {
          "when": {
            "op": "or",
            "args": [
              {
                "$": "title"
              },
              {
                "$": "actions"
              }
            ]
          },
          "then": [
            {
              "use": "Box",
              "props": {
                "Class": "flex items-start justify-between gap-4"
              },
              "children": [
                {
                  "use": "Box",
                  "props": {
                    "Class": "flex min-w-0 flex-col gap-2"
                  },
                  "children": [
                    {
                      "when": {
                        "$": "title"
                      },
                      "then": [
                        {
                          "use": "Title",
                          "props": {
                            "As": 2,
                            "Size": "base",
                            "Class": "m-0 text-foreground"
                          },
                          "attrs": {
                            "id": {
                              "op": "cond",
                              "args": [
                                {
                                  "$": "id"
                                },
                                {
                                  "op": "tpl",
                                  "args": [
                                    "{0}-t",
                                    {
                                      "$": "id"
                                    }
                                  ]
                                },
                                {
                                  "op": "undef",
                                  "args": []
                                }
                              ]
                            }
                          },
                          "children": [
                            {
                              "text": {
                                "$": "title"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "when": {
                        "$": "description"
                      },
                      "then": [
                        {
                          "use": "Text",
                          "props": {
                            "Class": "m-0 text-xs font-medium text-muted-foreground"
                          },
                          "children": [
                            {
                              "text": {
                                "$": "description"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "slot": "actions"
                }
              ]
            }
          ]
        },
        {
          "slot": "children"
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
