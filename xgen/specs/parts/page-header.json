{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "part.page-header",
  "name": "PageHeader",
  "docs": "The page heading: a title, a one-line summary and the action buttons on the right (below on phones).",
  "records": {},
  "props": [
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "summary",
      "type": "string"
    },
    {
      "name": "id",
      "type": "string",
      "docs": "id of the heading, for aria-labelledby"
    }
  ],
  "slots": [
    {
      "name": "actions",
      "args": [],
      "docs": "action buttons"
    }
  ],
  "events": [],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": "flex flex-col items-start gap-4 md:flex-row md:items-center md:justify-between"
      },
      "children": [
        {
          "use": "Box",
          "props": {
            "Class": "flex min-w-0 flex-col gap-2"
          },
          "children": [
            {
              "use": "Title",
              "props": {
                "As": 1,
                "Size": "xl",
                "Weight": "bold",
                "Class": "m-0"
              },
              "attrs": {
                "id": {
                  "$": "id"
                }
              },
              "children": [
                {
                  "text": {
                    "$": "title"
                  }
                }
              ]
            },
            {
              "when": {
                "$": "summary"
              },
              "then": [
                {
                  "use": "Text",
                  "props": {
                    "Class": "m-0 text-xs font-medium text-muted-foreground"
                  },
                  "children": [
                    {
                      "text": {
                        "$": "summary"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "when": {
            "$": "actions"
          },
          "then": [
            {
              "use": "Box",
              "props": {
                "Class": "flex flex-wrap items-center gap-2"
              },
              "children": [
                {
                  "slot": "actions"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
