{
  "$schema": "../../schema/schemas/organism.schema.json",
  "specVersion": 1,
  "id": "part.search-field",
  "name": "SearchField",
  "docs": "A search input with a magnifier. `value` fires on every keystroke with the new text.",
  "records": {},
  "props": [
    {
      "name": "value",
      "type": "string",
      "required": true
    },
    {
      "name": "placeholder",
      "type": "string"
    },
    {
      "name": "label",
      "type": "string",
      "docs": "accessible name",
      "required": true
    }
  ],
  "className": true,
  "slots": [],
  "events": [
    {
      "name": "value",
      "args": [
        {
          "name": "value",
          "type": "string"
        }
      ],
      "docs": "the text changed"
    }
  ],
  "view": [
    {
      "use": "Box",
      "props": {
        "Class": {
          "op": "cn",
          "args": [
            "relative min-w-44 flex-1",
            {
              "$": "className"
            }
          ]
        }
      },
      "attrs": {
        "role": "search"
      },
      "children": [
        {
          "use": "LucideIcon",
          "props": {
            "Name": "search",
            "Size": 16,
            "Class": "pointer-events-none absolute top-2 left-3 text-muted-foreground"
          }
        },
        {
          "use": "Input",
          "props": {
            "Size": "sm",
            "Type": "search",
            "Placeholder": {
              "$": "placeholder"
            },
            "AriaLabel": {
              "$": "label"
            },
            "Class": "pr-3 pl-10",
            "Value": {
              "$": "value"
            }
          },
          "on": {
            "input": {
              "call": "emit.value",
              "args": [
                {
                  "$": "event.value"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
