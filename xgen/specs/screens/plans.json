    "collection": "plans",
    "kind": "plan",
    "record": "Plan",
    "fields": {
      "id": "id",
      "name": "title",
      "tagline": "metadata.tagline.value",
      "price": "metadata.price.value",
      "currency": "metadata.currency.value",
      "seats": "metadata.seats.value",
      "storage": "metadata.storage.value",
      "highlighted": "metadata.highlighted.value",
      "features": "metadata.features.value",
      "yearly": "metadata.yearly.value",
      "status": "metadata.plan_status.value"
    }
  },
  "list": {
    "columns": [
      {
        "id": "name",
        "label": "plans.col.name",
        "type": "text",
        "sortable": true
      },
      {
        "id": "price",
        "label": "plans.col.price",
        "type": "money",
        "sortable": true,
        "align": "end"
      },
      {
        "id": "seats",
        "label": "plans.col.seats",
        "type": "number",
        "sortable": true,
        "align": "end"
      },
      {
        "id": "storage",
        "label": "plans.col.storage",
        "type": "number",
        "sortable": true,
        "align": "end"
      },
      {
        "id": "status",
        "label": "plans.col.status",
        "type": "badge"
      }
    ],
    "searchFields": [
      "name",
      "tagline"
    ],
    "pageSize": 5,
    "defaultSort": "price:asc"
  },
  "state": {
    "q": "q",
    "sort": "sort",
    "page": "page"
  },
  "routes": [
    {
      "path": "plans",
      "area": "list"
    },
    {
      "path": "plans/:id",
      "area": "record"
    }
  ],
  "organisms": [
    "PricingCard"
  ],
