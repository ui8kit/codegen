{
  "$schema": "../../schema/schemas/composed.schema.json",
  "specVersion": 1,
  "id": "screen.theme-account-portal",
  "name": "ThemeAccountPortalScreen",
  "kind": "composed",
  "docs": "Sign-in and account pages: split, centered and minimal sign-in, sign-up, reset, magic link, social first, the sign-up wizard, cards and the profile.",
  "routes": [
    {
      "path": "",
      "area": "home"
    },
    {
      "path": "start",
      "area": "start"
    },
    {
      "path": "signup",
      "area": "signup"
    },
    {
      "path": "welcome",
      "area": "welcome"
    },
    {
      "path": "reset",
      "area": "reset"
    },
    {
      "path": "magic",
      "area": "magic"
    },
    {
      "path": "minimal",
      "area": "minimal"
    },
    {
      "path": "options",
      "area": "options"
    },
    {
      "path": "join",
      "area": "join"
    },
    {
      "path": "cards",
      "area": "cards"
    },
    {
      "path": "profile",
      "area": "profile"
    }
  ],
  "frame": {
    "before": [
      {
        "block": "navbar",
        "variant": "inline",
        "props": {
          "brandHref": "#/",
          "links": {
            "$": "nav.links"
          },
          "current": {
            "$": "nav.current"
          },
          "skip": {
            "$": "ui.site.header.skip"
          },
          "actions": {
            "themeLabel": {
              "$": "ui.theme.toggle"
            }
          }
        }
      }
    ],
    "after": [
      {
        "block": "sitemap",
        "variant": "row"
      }
    ]
  },
  "areas": {
    "home": [
      {
        "block": "authpage",
        "variant": "split",
        "props": {
          "title": {
            "$": "ui.pages.accountPortal.home.title"
          },
          "text": {
            "$": "ui.pages.accountPortal.home.text"
          },
          "submit": {
            "$": "ui.pages.accountPortal.home.cta"
          }
        }
      }
    ],
    "start": [
      {
        "block": "authpage",
        "variant": "splitStart",
        "props": {
          "title": {
            "$": "ui.pages.accountPortal.start.title"
          },
          "text": {
            "$": "ui.pages.accountPortal.start.text"
          },
          "submit": {
            "$": "ui.pages.accountPortal.start.cta"
          }
        }
      }
    ],
    "signup": [
      {
        "block": "authpage",
        "variant": "signup",
        "props": {
          "title": {
            "$": "ui.pages.accountPortal.signup.title"
          },
          "text": {
            "$": "ui.pages.accountPortal.signup.text"
          },
          "submit": {
            "$": "ui.pages.accountPortal.signup.cta"
          }
        }
      }
    ],
    "welcome": [
      {
        "block": "authpage",
        "variant": "socialFirst",
        "props": {
          "title": {
            "$": "ui.pages.accountPortal.welcome.title"
          },
          "text": {
            "$": "ui.pages.accountPortal.welcome.text"
          },
          "submit": {
            "$": "ui.pages.accountPortal.welcome.cta"
          }
        }
      }
    ],
    "reset": [
      {
        "block": "authpage",
        "variant": "reset",
        "props": {
          "title": {
            "$": "ui.pages.accountPortal.reset.title"
          },
          "text": {
            "$": "ui.pages.accountPortal.reset.text"
          },
          "submit": {
            "$": "ui.pages.accountPortal.reset.cta"
          }
        }
      }
    ],
    "magic": [
      {
        "block": "authpage",
        "variant": "magic",
        "props": {
          "title": {
            "$": "ui.pages.accountPortal.magic.title"
          },
          "text": {
            "$": "ui.pages.accountPortal.magic.text"
          },
          "submit": {
            "$": "ui.pages.accountPortal.magic.cta"
          }
        }
      }
    ],
    "minimal": [
      {
        "block": "authpage",
        "variant": "minimal",
        "props": {
          "title": {
            "$": "ui.pages.accountPortal.minimal.title"
          },
          "text": {
            "$": "ui.pages.accountPortal.minimal.text"
          },
          "submit": {
            "$": "ui.pages.accountPortal.minimal.cta"
          }
        }
      }
    ],
    "options": [
      {
        "block": "authpage",
        "variant": "social",
        "props": {
          "title": {
            "$": "ui.pages.accountPortal.options.title"
          },
          "text": {
            "$": "ui.pages.accountPortal.options.text"
          },
          "submit": {
            "$": "ui.pages.accountPortal.options.cta"
          }
        }
      }
    ],
    "join": [
      {
        "block": "pagehead",
        "variant": "center",
        "props": {
          "title": {
            "$": "ui.pages.accountPortal.join.title"
          },
          "text": {
            "$": "ui.pages.accountPortal.join.text"
          },
          "cta": {
            "$": "ui.pages.accountPortal.join.cta"
          },
          "href": "#/cards"
        }
      },
      {
        "block": "wizard",
        "variant": "bar"
      },
      {
        "block": "wizard",
        "variant": "list"
      }
    ],
    "cards": [
      {
        "block": "pagehead",
        "variant": "start",
        "props": {
          "title": {
            "$": "ui.pages.accountPortal.cards.title"
          },
          "text": {
            "$": "ui.pages.accountPortal.cards.text"
          },
          "cta": {
            "$": "ui.pages.accountPortal.cards.cta"
          },
          "href": "#/profile"
        }
      },
      {
        "block": "auth",
        "variant": "signin"
      },
      {
        "block": "auth",
        "variant": "social"
      },
      {
        "block": "auth",
        "variant": "signupSocial"
      }
    ],
    "profile": [
      {
        "block": "pagehead",
        "variant": "start",
        "props": {
          "title": {
            "$": "ui.pages.accountPortal.profile.title"
          },
          "text": {
            "$": "ui.pages.accountPortal.profile.text"
          },
          "cta": {
            "$": "ui.pages.accountPortal.profile.cta"
          },
          "href": "#/"
        }
      },
      {
        "block": "profile",
        "variant": "split"
      },
      {
        "block": "profile",
        "variant": "stacked"
      }
    ]
  },
  "chunks": true,
  "requireH1": true,
  "nameLandmarks": true,
  "nav": true,
  "menu": [
    {
      "id": "home",
      "path": "",
      "titleKey": "pages.accountPortal.home.nav"
    },
    {
      "id": "start",
      "path": "start",
      "titleKey": "pages.accountPortal.start.nav"
    },
    {
      "id": "signup",
      "path": "signup",
      "titleKey": "pages.accountPortal.signup.nav"
    },
    {
      "id": "welcome",
      "path": "welcome",
      "titleKey": "pages.accountPortal.welcome.nav"
    },
    {
      "id": "reset",
      "path": "reset",
      "titleKey": "pages.accountPortal.reset.nav"
    },
    {
      "id": "magic",
      "path": "magic",
      "titleKey": "pages.accountPortal.magic.nav"
    },
    {
      "id": "minimal",
      "path": "minimal",
      "titleKey": "pages.accountPortal.minimal.nav"
    },
    {
      "id": "options",
      "path": "options",
      "titleKey": "pages.accountPortal.options.nav"
    },
    {
      "id": "join",
      "path": "join",
      "titleKey": "pages.accountPortal.join.nav"
    },
    {
      "id": "cards",
      "path": "cards",
      "titleKey": "pages.accountPortal.cards.nav"
    },
    {
      "id": "profile",
      "path": "profile",
      "titleKey": "pages.accountPortal.profile.nav"
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
