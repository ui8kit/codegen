{
  "$schema": "../../schema/schemas/composed.schema.json",
  "specVersion": 1,
  "id": "screen.theme-marketing-pricing",
  "name": "ThemeMarketingPricingScreen",
  "kind": "composed",
  "docs": "Pricing pages: tiers with a billing switch, a comparison table, one plan, a usage slider, credit packs, free against pro, and us against the rest.",
  "routes": [
    {
      "path": "",
      "area": "home"
    },
    {
      "path": "plans",
      "area": "plans"
    },
    {
      "path": "usage",
      "area": "usage"
    },
    {
      "path": "compare",
      "area": "compare"
    }
  ],
  "frame": {
    "before": [
      {
        "block": "navbar",
        "variant": "inline",
        "props": {
          "brandHref": "#/",
          "links": {
            "$": "nav.links"
          },
          "current": {
            "$": "nav.current"
          },
          "skip": {
            "$": "ui.site.header.skip"
          },
          "actions": {
            "themeLabel": {
              "$": "ui.theme.toggle"
            }
          }
        }
      }
    ],
    "after": [
      {
        "block": "sitemap",
        "variant": "newsletter"
      }
    ]
  },
  "areas": {
    "home": [
      {
        "block": "pagehead",
        "variant": "center",
        "props": {
          "title": {
            "$": "ui.pages.marketingPricing.home.title"
          },
          "text": {
            "$": "ui.pages.marketingPricing.home.text"
          },
          "cta": {
            "$": "ui.pages.marketingPricing.home.cta"
          },
          "href": "#/plans"
        }
      },
      {
        "block": "pricing",
        "variant": "monthly"
      },
      {
        "block": "logos",
        "variant": "grid3"
      },
      {
        "block": "compare",
        "variant": "plans"
      },
      {
        "block": "faq",
        "variant": "twoColumns"
      },
      {
        "block": "cta",
        "variant": "saas"
      }
    ],
    "plans": [
      {
        "block": "pagehead",
        "variant": "start",
        "props": {
          "title": {
            "$": "ui.pages.marketingPricing.plans.title"
          },
          "text": {
            "$": "ui.pages.marketingPricing.plans.text"
          },
          "cta": {
            "$": "ui.pages.marketingPricing.plans.cta"
          },
          "href": "#/usage"
        }
      },
      {
        "block": "pricing",
        "variant": "duo"
      },
      {
        "block": "plan",
        "variant": "standard"
      },
      {
        "block": "pricing",
        "variant": "stack"
      },
      {
        "block": "compare",
        "variant": "highlight"
      }
    ],
    "usage": [
      {
        "block": "pagehead",
        "variant": "muted",
        "props": {
          "title": {
            "$": "ui.pages.marketingPricing.usage.title"
          },
          "text": {
            "$": "ui.pages.marketingPricing.usage.text"
          },
          "cta": {
            "$": "ui.pages.marketingPricing.usage.cta"
          },
          "href": "#/compare"
        }
      },
      {
        "block": "usage",
        "variant": "card"
      },
      {
        "block": "credits",
        "variant": "tiles4"
      },
      {
        "block": "credits",
        "variant": "rows"
      },
      {
        "block": "pricing",
        "variant": "annual"
      },
      {
        "block": "cta",
        "variant": "row"
      }
    ],
    "compare": [
      {
        "block": "hero",
        "variant": "muted",
        "props": {
          "title": {
            "$": "ui.pages.marketingPricing.compare.title"
          },
          "text": {
            "$": "ui.pages.marketingPricing.compare.text"
          },
          "actions": {
            "cta": {
              "$": "ui.pages.marketingPricing.compare.cta"
            },
            "href": "#/"
          }
        }
      },
      {
        "block": "compare",
        "variant": "rivals"
      },
      {
        "block": "testimonials",
        "variant": "featured"
      },
      {
        "block": "faq",
        "variant": "search"
      },
      {
        "block": "cta",
        "variant": "quote"
      }
    ]
  },
  "chunks": true,
  "requireH1": true,
  "nameLandmarks": true,
  "nav": true,
  "menu": [
    {
      "id": "home",
      "path": "",
      "titleKey": "pages.marketingPricing.home.nav"
    },
    {
      "id": "plans",
      "path": "plans",
      "titleKey": "pages.marketingPricing.plans.nav"
    },
    {
      "id": "usage",
      "path": "usage",
      "titleKey": "pages.marketingPricing.usage.nav"
    },
    {
      "id": "compare",
      "path": "compare",
      "titleKey": "pages.marketingPricing.compare.nav"
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
