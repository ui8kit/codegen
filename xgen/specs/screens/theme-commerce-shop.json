{
  "$schema": "../../schema/schemas/composed.schema.json",
  "specVersion": 1,
  "id": "screen.theme-commerce-shop",
  "name": "ThemeCommerceShopScreen",
  "kind": "composed",
  "docs": "A shop: home with categories and products, the catalog, offers, a product page with details and reviews, the cart, the checkout, delivery and pickup, and the orders.",
  "routes": [
    {
      "path": "",
      "area": "home"
    },
    {
      "path": "catalog",
      "area": "catalog"
    },
    {
      "path": "browse",
      "area": "browse"
    },
    {
      "path": "offers",
      "area": "offers"
    },
    {
      "path": "product",
      "area": "product"
    },
    {
      "path": "cart",
      "area": "cart"
    },
    {
      "path": "checkout",
      "area": "checkout"
    },
    {
      "path": "delivery",
      "area": "delivery"
    },
    {
      "path": "orders",
      "area": "orders"
    }
  ],
  "frame": {
    "before": [
      {
        "block": "navbar",
        "variant": "inline",
        "props": {
          "brandHref": "#/",
          "links": {
            "$": "nav.links"
          },
          "current": {
            "$": "nav.current"
          },
          "skip": {
            "$": "ui.site.header.skip"
          },
          "actions": {
            "themeLabel": {
              "$": "ui.theme.toggle"
            }
          }
        }
      }
    ],
    "after": [
      {
        "block": "sitemap",
        "variant": "columns"
      }
    ]
  },
  "areas": {
    "home": [
      {
        "block": "hero",
        "variant": "shop",
        "props": {
          "title": {
            "$": "ui.pages.commerceShop.home.title"
          },
          "text": {
            "$": "ui.pages.commerceShop.home.text"
          },
          "actions": {
            "cta": {
              "$": "ui.pages.commerceShop.home.cta"
            },
            "href": "#/catalog"
          }
        }
      },
      {
        "block": "categories",
        "variant": "chips"
      },
      {
        "block": "products",
        "variant": "grid4"
      },
      {
        "block": "reviews",
        "variant": "grid"
      },
      {
        "block": "newsletter",
        "variant": "stacked"
      },
      {
        "block": "cta",
        "variant": "shop"
      }
    ],
    "catalog": [
      {
        "block": "pagetrail",
        "variant": "crumbsFigure"
      },
      {
        "block": "categories",
        "variant": "sidebar"
      },
      {
        "block": "products",
        "variant": "catalog"
      }
    ],
    "browse": [
      {
        "block": "pagehead",
        "variant": "center",
        "props": {
          "title": {
            "$": "ui.pages.commerceShop.browse.title"
          },
          "text": {
            "$": "ui.pages.commerceShop.browse.text"
          },
          "cta": {
            "$": "ui.pages.commerceShop.browse.cta"
          },
          "href": "#/offers"
        }
      },
      {
        "block": "categories",
        "variant": "bar"
      },
      {
        "block": "products",
        "variant": "browse"
      },
      {
        "block": "products",
        "variant": "showcase"
      },
      {
        "block": "products",
        "variant": "list"
      }
    ],
    "offers": [
      {
        "block": "storehero",
        "variant": "overlay"
      },
      {
        "block": "usp",
        "variant": "strip"
      },
      {
        "block": "products",
        "variant": "railCompact"
      },
      {
        "block": "cartdrawer",
        "variant": "filled"
      }
    ],
    "product": [
      {
        "block": "product",
        "variant": "split"
      },
      {
        "block": "productinfo",
        "variant": "split"
      },
      {
        "block": "reviews",
        "variant": "list"
      },
      {
        "block": "products",
        "variant": "grid3"
      }
    ],
    "cart": [
      {
        "block": "pagehead",
        "variant": "start",
        "props": {
          "title": {
            "$": "ui.pages.commerceShop.cart.title"
          },
          "text": {
            "$": "ui.pages.commerceShop.cart.text"
          },
          "cta": {
            "$": "ui.pages.commerceShop.cart.cta"
          },
          "href": "#/checkout"
        }
      },
      {
        "block": "cartpage",
        "variant": "split"
      },
      {
        "block": "cart",
        "variant": "table"
      },
      {
        "block": "summary",
        "variant": "card"
      }
    ],
    "checkout": [
      {
        "block": "pagehead",
        "variant": "start",
        "props": {
          "title": {
            "$": "ui.pages.commerceShop.checkout.title"
          },
          "text": {
            "$": "ui.pages.commerceShop.checkout.text"
          },
          "cta": {
            "$": "ui.pages.commerceShop.checkout.cta"
          },
          "href": "#/delivery"
        }
      },
      {
        "block": "checkout",
        "variant": "numbered"
      }
    ],
    "delivery": [
      {
        "block": "pagehead",
        "variant": "center",
        "props": {
          "title": {
            "$": "ui.pages.commerceShop.delivery.title"
          },
          "text": {
            "$": "ui.pages.commerceShop.delivery.text"
          },
          "cta": {
            "$": "ui.pages.commerceShop.delivery.cta"
          },
          "href": "#/orders"
        }
      },
      {
        "block": "delivery",
        "variant": "full"
      },
      {
        "block": "zones",
        "variant": "table"
      },
      {
        "block": "slots",
        "variant": "split"
      },
      {
        "block": "locations",
        "variant": "cards"
      }
    ],
    "orders": [
      {
        "block": "pagehead",
        "variant": "start",
        "props": {
          "title": {
            "$": "ui.pages.commerceShop.orders.title"
          },
          "text": {
            "$": "ui.pages.commerceShop.orders.text"
          },
          "cta": {
            "$": "ui.pages.commerceShop.orders.cta"
          },
          "href": "#/"
        }
      },
      {
        "block": "orders",
        "variant": "table"
      },
      {
        "block": "orders",
        "variant": "cards"
      }
    ]
  },
  "chunks": true,
  "requireH1": true,
  "nameLandmarks": true,
  "nav": true,
  "menu": [
    {
      "id": "home",
      "path": "",
      "titleKey": "pages.commerceShop.home.nav"
    },
    {
      "id": "catalog",
      "path": "catalog",
      "titleKey": "pages.commerceShop.catalog.nav"
    },
    {
      "id": "browse",
      "path": "browse",
      "titleKey": "pages.commerceShop.browse.nav"
    },
    {
      "id": "offers",
      "path": "offers",
      "titleKey": "pages.commerceShop.offers.nav"
    },
    {
      "id": "product",
      "path": "product",
      "titleKey": "pages.commerceShop.product.nav"
    },
    {
      "id": "cart",
      "path": "cart",
      "titleKey": "pages.commerceShop.cart.nav"
    },
    {
      "id": "checkout",
      "path": "checkout",
      "titleKey": "pages.commerceShop.checkout.nav"
    },
    {
      "id": "delivery",
      "path": "delivery",
      "titleKey": "pages.commerceShop.delivery.nav"
    },
    {
      "id": "orders",
      "path": "orders",
      "titleKey": "pages.commerceShop.orders.nav"
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
