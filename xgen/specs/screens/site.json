{
  "$schema": "../../schema/schemas/composed.schema.json",
  "specVersion": 1,
  "id": "screen.site",
  "name": "SiteScreen",
  "kind": "composed",
  "docs": "A marketing site of two routes, home and pricing, made of blocks: header, hero, features, pricing, FAQ, call to action, footer. Data: the Codex fixtures `features`, `tiers` and `faq`. The only action is the theme button.",
  "routes": [
    {
      "path": "",
      "area": "home"
    },
    {
      "path": "pricing",
      "area": "pricing"
    }
  ],
  "frame": {
    "before": [
      {
        "block": "header",
        "variant": "inline",
        "props": {
          "current": {
            "$": "route.area"
          },
          "routes": {
            "home": "#/",
            "pricing": "#/pricing"
          }
        }
      }
    ],
    "after": [
      {
        "block": "footer",
        "variant": "minimal",
        "props": {
          "routes": {
            "home": "#/",
            "pricing": "#/pricing"
          }
        }
      }
    ]
  },
  "areas": {
    "home": [
      {
        "block": "hero",
        "variant": "centered",
        "props": {
          "id": "home-hero"
        }
      },
      {
        "block": "features",
        "variant": "grid",
        "props": {
          "id": "home-features"
        }
      },
      {
        "block": "cta",
        "variant": "card",
        "props": {
          "id": "home-cta"
        }
      }
    ],
    "pricing": [
      {
        "block": "hero",
        "variant": "centered",
        "props": {
          "id": "pricing-hero",
          "title": {
            "$": "ui.site.pricing.title"
          },
          "text": {
            "$": "ui.site.pricing.text"
          },
          "actions": {
            "op": "undef",
            "args": []
          }
        }
      },
      {
        "block": "pricing",
        "variant": "grid",
        "props": {
          "id": "pricing-tiers"
        }
      },
      {
        "block": "faq",
        "variant": "list",
        "props": {
          "id": "pricing-faq"
        }
      }
    ],
    "notfound": [
      {
        "block": "hero",
        "variant": "centered",
        "props": {
          "id": "not-found",
          "title": {
            "$": "ui.site.notFound.title"
          },
          "text": {
            "$": "ui.site.notFound.text"
          },
          "actions": {
            "cta": {
              "$": "ui.site.notFound.back"
            },
            "href": "#/"
          }
        }
      }
    ]
  },
  "portable": {
    "svelte": true,
    "react": true
  }
}
