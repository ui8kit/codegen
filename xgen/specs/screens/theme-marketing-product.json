{
  "$schema": "../../schema/schemas/composed.schema.json",
  "specVersion": 1,
  "id": "screen.theme-marketing-product",
  "name": "ThemeMarketingProductScreen",
  "kind": "composed",
  "docs": "Product pages: features as grids, bento, tabs, an accordion and a sticky list, before and after pictures, and the navigation patterns.",
  "routes": [
    {
      "path": "",
      "area": "home"
    },
    {
      "path": "tour",
      "area": "tour"
    },
    {
      "path": "capabilities",
      "area": "capabilities"
    },
    {
      "path": "navigation",
      "area": "navigation"
    }
  ],
  "frame": {
    "before": [
      {
        "block": "navbar",
        "variant": "inline",
        "props": {
          "brandHref": "#/",
          "links": {
            "$": "nav.links"
          },
          "current": {
            "$": "nav.current"
          },
          "skip": {
            "$": "ui.site.header.skip"
          },
          "actions": {
            "themeLabel": {
              "$": "ui.theme.toggle"
            }
          }
        }
      }
    ],
    "after": [
      {
        "block": "sitemap",
        "variant": "columns"
      }
    ]
  },
  "areas": {
    "home": [
      {
        "block": "hero",
        "variant": "split",
        "props": {
          "title": {
            "$": "ui.pages.marketingProduct.home.title"
          },
          "text": {
            "$": "ui.pages.marketingProduct.home.text"
          },
          "actions": {
            "cta": {
              "$": "ui.pages.marketingProduct.home.cta"
            },
            "href": "#/tour"
          }
        }
      },
      {
        "block": "features",
        "variant": "grid"
      },
      {
        "block": "featuresplit",
        "variant": "metricCards"
      },
      {
        "block": "featureshowcase",
        "variant": "panelCards4"
      },
      {
        "block": "bento",
        "variant": "images"
      },
      {
        "block": "featuretabs",
        "variant": "split"
      },
      {
        "block": "accordion",
        "variant": "media"
      }
    ],
    "tour": [
      {
        "block": "pagehead",
        "variant": "center",
        "props": {
          "title": {
            "$": "ui.pages.marketingProduct.tour.title"
          },
          "text": {
            "$": "ui.pages.marketingProduct.tour.text"
          },
          "cta": {
            "$": "ui.pages.marketingProduct.tour.cta"
          },
          "href": "#/capabilities"
        }
      },
      {
        "block": "sticky",
        "variant": "end"
      },
      {
        "block": "beforeafter",
        "variant": "cards"
      },
      {
        "block": "steps",
        "variant": "column"
      },
      {
        "block": "videos",
        "variant": "grid3"
      },
      {
        "block": "megamenu",
        "variant": "open"
      }
    ],
    "capabilities": [
      {
        "block": "pagehead",
        "variant": "start",
        "props": {
          "title": {
            "$": "ui.pages.marketingProduct.capabilities.title"
          },
          "text": {
            "$": "ui.pages.marketingProduct.capabilities.text"
          },
          "cta": {
            "$": "ui.pages.marketingProduct.capabilities.cta"
          },
          "href": "#/navigation"
        }
      },
      {
        "block": "features",
        "variant": "grid2"
      },
      {
        "block": "iconwall",
        "variant": "chips6"
      },
      {
        "block": "accordion",
        "variant": "first"
      },
      {
        "block": "beforeafter",
        "variant": "rows"
      },
      {
        "block": "sticky",
        "variant": "card"
      },
      {
        "block": "cta",
        "variant": "compact"
      }
    ],
    "navigation": [
      {
        "block": "pagehead",
        "variant": "muted",
        "props": {
          "title": {
            "$": "ui.pages.marketingProduct.navigation.title"
          },
          "text": {
            "$": "ui.pages.marketingProduct.navigation.text"
          },
          "cta": {
            "$": "ui.pages.marketingProduct.navigation.cta"
          },
          "href": "#/"
        }
      },
      {
        "block": "header",
        "variant": "stacked"
      },
      {
        "block": "navbar",
        "variant": "split"
      },
      {
        "block": "navbar",
        "variant": "search"
      },
      {
        "block": "navbar",
        "variant": "media"
      },
      {
        "block": "megamenu",
        "variant": "twoCols"
      },
      {
        "block": "footer",
        "variant": "centered"
      }
    ]
  },
  "chunks": true,
  "requireH1": true,
  "nameLandmarks": true,
  "nav": true,
  "menu": [
    {
      "id": "home",
      "path": "",
      "titleKey": "pages.marketingProduct.home.nav"
    },
    {
      "id": "tour",
      "path": "tour",
      "titleKey": "pages.marketingProduct.tour.nav"
    },
    {
      "id": "capabilities",
      "path": "capabilities",
      "titleKey": "pages.marketingProduct.capabilities.nav"
    },
    {
      "id": "navigation",
      "path": "navigation",
      "titleKey": "pages.marketingProduct.navigation.nav"
    }
  ],
  "portable": {
    "svelte": true,
    "react": true
  }
}
