{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.orders",
  "name": "Order history",
  "docs": "Past orders with status.",
  "theme": "commerce",
  "group": "account",
  "organism": "OrderTable",
  "axes": {
    "layout": [
      "table",
      "cards"
    ],
    "pager": [
      "show",
      "hide"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "table",
    "pager": "show",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "table",
      "set": {}
    },
    {
      "id": "cards",
      "set": {
        "layout": "cards"
      }
    },
    {
      "id": "noPager",
      "set": {
        "pager": "hide"
      }
    },
    {
      "id": "compactMuted",
      "set": {
        "tone": "muted",
        "density": "compact",
        "pager": "hide"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "OrderRows",
    "Pager",
    "Pill",
    "SectionFrame"
  ],
  "data": [
    {
      "as": "orders",
      "collection": "orders",
      "kind": "order",
      "record": "Order",
      "fields": {
        "id": "id",
        "number": "title",
        "date": "metadata.date.value|date",
        "total": "metadata.total.value",
        "currency": "metadata.currency.value",
        "status": "metadata.order_status.value",
        "items": "metadata.items.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "orders",
      "title": {
        "$": "ui.commerce.orders.title"
      },
      "orders": {
        "$": "orders"
      },
      "empty": {
        "$": "ui.empty.orders"
      },
      "statuses": {
        "$": "ui.status"
      },
      "labels": {
        "$": "ui.commerce.orders"
      }
    }
  }
}
