{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.cookie",
  "name": "Cookie notice",
  "docs": "A consent notice with accept and decline buttons.",
  "theme": "promo",
  "group": "banner",
  "organism": "CookieBanner",
  "axes": {
    "layout": [
      "bar",
      "card"
    ],
    "actions": [
      "two",
      "three"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "layout": "bar",
    "actions": "two",
    "tone": "default"
  },
  "variants": [
    {
      "id": "bar",
      "set": {}
    },
    {
      "id": "card",
      "set": {
        "layout": "card"
      }
    },
    {
      "id": "settings",
      "set": {
        "actions": "three"
      }
    },
    {
      "id": "muted",
      "set": {
        "layout": "card",
        "actions": "three",
        "tone": "muted"
      }
    }
  ],
  "slots": [],
  "data": [],
  "sample": {
    "props": {
      "id": "cookie",
      "title": {
        "$": "ui.promo.cookie.title"
      },
      "text": {
        "$": "ui.promo.cookie.text"
      },
      "accept": {
        "$": "ui.promo.cookie.accept"
      },
      "decline": {
        "$": "ui.promo.cookie.decline"
      },
      "settings": {
        "$": "ui.promo.cookie.settings"
      }
    }
  }
}
