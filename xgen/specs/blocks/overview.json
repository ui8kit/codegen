{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.overview",
  "name": "Dashboard overview",
  "docs": "Counters, a chart and recent activity in one section.",
  "theme": "dashboard",
  "group": "widgets",
  "organism": "DashboardOverview",
  "axes": {
    "layout": [
      "split",
      "stacked"
    ],
    "cols": [
      "2",
      "4"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "split",
    "cols": "4",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "split",
      "set": {}
    },
    {
      "id": "stacked",
      "set": {
        "layout": "stacked"
      }
    },
    {
      "id": "twoCols",
      "set": {
        "cols": "2"
      }
    },
    {
      "id": "muted",
      "set": {
        "tone": "muted",
        "density": "compact"
      }
    }
  ],
  "slots": [
    "BarChart",
    "Panel",
    "SectionFrame",
    "StatTile",
    "Timeline"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"items\"] > [data-testid=\"item\"]",
      "n": "@metrics"
    },
    {
      "sel": "[data-slot=\"bar-chart\"]",
      "n": 1
    },
    {
      "sel": "[data-slot=\"timeline\"]",
      "n": 1
    },
    {
      "sel": "[data-testid=\"panels\"] > section",
      "cols": 2,
      "when": {
        "layout": "split"
      }
    },
    {
      "sel": "[data-testid=\"panels\"] > section",
      "cols": 1,
      "when": {
        "layout": "stacked"
      }
    }
  ],
  "data": [
    {
      "as": "metrics",
      "collection": "metrics",
      "kind": "metric",
      "record": "Stat",
      "fields": {
        "id": "id",
        "label": "title",
        "value": "metadata.value.value|number",
        "icon": "metadata.icon.value",
        "hint": "metadata.hint.value"
      }
    },
    {
      "as": "series",
      "collection": "series",
      "kind": "point",
      "record": "Point",
      "fields": {
        "id": "id",
        "label": "title",
        "value": "metadata.value.value"
      }
    },
    {
      "as": "activity",
      "collection": "activity",
      "kind": "event",
      "record": "Event",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "time": "metadata.time.value|ago",
        "tone": "metadata.tone.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "overview",
      "title": {
        "$": "ui.vibe.overview.title"
      },
      "metrics": {
        "$": "metrics"
      },
      "chart": {
        "title": {
          "$": "ui.dashboard.chart.title"
        },
        "text": {
          "$": "ui.dashboard.chart.text"
        },
        "summary": {
          "$": "ui.dashboard.chart.summary"
        },
        "series": {
          "$": "series"
        }
      },
      "activity": {
        "title": {
          "$": "ui.dashboard.activity.title"
        },
        "text": {
          "$": "ui.dashboard.activity.text"
        },
        "events": {
          "$": "activity"
        }
      }
    }
  }
}
