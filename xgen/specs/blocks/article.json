{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.article",
  "name": "Article",
  "docs": "A long read in one reading column, or beside a table of contents that links to the sections.",
  "theme": "content",
  "group": "blog",
  "organism": "ArticleBody",
  "axes": {
    "layout": [
      "column",
      "toc"
    ],
    "quotes": [
      "show",
      "hide"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "layout": "column",
    "quotes": "show",
    "tone": "default"
  },
  "variants": [
    {
      "id": "column",
      "set": {}
    },
    {
      "id": "toc",
      "set": {
        "layout": "toc"
      }
    },
    {
      "id": "plain",
      "set": {
        "quotes": "hide"
      }
    },
    {
      "id": "muted",
      "set": {
        "tone": "muted"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "NavBlock",
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"article\"] > [data-testid=\"item\"]",
      "n": "@article"
    },
    {
      "sel": "[data-testid=\"toc-link\"]",
      "n": "@article",
      "when": {
        "layout": "toc"
      }
    },
    {
      "sel": "[data-testid=\"toc\"]",
      "n": 0,
      "when": {
        "layout": "column"
      }
    },
    {
      "sel": "[data-testid=\"quote\"]",
      "n": 0,
      "when": {
        "quotes": "hide"
      }
    },
    {
      "sel": "[data-testid=\"quote\"]",
      "n": 1,
      "when": {
        "quotes": "show"
      }
    }
  ],
  "data": [
    {
      "as": "article",
      "collection": "article",
      "kind": "section",
      "record": "Section",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "quote": "metadata.quote.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "article",
      "title": {
        "$": "ui.vibe.article.title"
      },
      "sections": {
        "$": "article"
      },
      "empty": {
        "$": "ui.empty.sections"
      },
      "tocTitle": {
        "$": "ui.vibe.article.toc"
      }
    }
  }
}
