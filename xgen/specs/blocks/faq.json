{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.faq",
  "name": "FAQ",
  "docs": "Questions as native disclosures.",
  "theme": "marketing",
  "group": "faq",
  "organism": "FaqList",
  "axes": {
    "layout": [
      "accordion",
      "chat"
    ],
    "cols": [
      "1",
      "2"
    ],
    "search.mode": [
      "none",
      "field"
    ],
    "filter.mode": [
      "none",
      "categories"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "roomy",
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "accordion",
    "cols": "1",
    "search.mode": "none",
    "filter.mode": "none",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "list",
      "set": {}
    },
    {
      "id": "chat",
      "set": {
        "layout": "chat"
      }
    },
    {
      "id": "search",
      "set": {
        "search.mode": "field"
      }
    },
    {
      "id": "tabs",
      "set": {
        "filter.mode": "categories"
      },
      "props": {
        "filter": {
          "category": "billing"
        }
      }
    },
    {
      "id": "twoColumns",
      "set": {
        "cols": "2"
      }
    },
    {
      "id": "muted",
      "set": {
        "tone": "muted",
        "density": "compact"
      }
    },
    {
      "id": "roomy",
      "set": {
        "density": "roomy"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "SearchField",
    "SectionFrame",
    "Switcher",
    "SwitcherItem"
  ],
  "data": [
    {
      "as": "faq",
      "collection": "faq",
      "kind": "faq",
      "record": "Faq",
      "fields": {
        "id": "id",
        "question": "title",
        "answer": "metadata.answer.value",
        "category": "terms|term-slug:faq_category"
      }
    },
    {
      "as": "faqtabs",
      "collection": "faqtabs",
      "kind": "tab",
      "record": "FaqTab",
      "fields": {
        "id": "id",
        "title": "title",
        "value": "metadata.value.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "faq",
      "title": {
        "$": "ui.site.pricing.faqTitle"
      },
      "items": {
        "$": "faq"
      },
      "empty": {
        "$": "ui.vibe.faq.empty"
      },
      "search": {
        "label": {
          "$": "ui.vibe.faq.search"
        },
        "query": ""
      },
      "filter": {
        "tabs": {
          "$": "faqtabs"
        },
        "label": {
          "$": "ui.vibe.faq.tabs"
        },
        "category": ""
      }
    }
  }
}
