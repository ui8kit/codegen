{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.storehero",
  "name": "Store hero",
  "docs": "The hero of a store with promises under the actions, beside a picture with an offer card or over a faint picture.",
  "theme": "commerce",
  "group": "storefront",
  "organism": "StoreHero",
  "axes": {
    "layout": [
      "overlay",
      "backdrop"
    ],
    "mediaSide": [
      "end",
      "start"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "layout": "overlay",
    "mediaSide": "end",
    "tone": "default"
  },
  "variants": [
    {
      "id": "overlay",
      "set": {}
    },
    {
      "id": "overlayStart",
      "set": {
        "mediaSide": "start"
      }
    },
    {
      "id": "backdrop",
      "set": {
        "layout": "backdrop"
      }
    },
    {
      "id": "muted",
      "set": {
        "tone": "muted"
      },
      "props": {
        "actions": {
          "mode": "one",
          "cta": {
            "$": "ui.commerce.storeHero.cta"
          },
          "href": "#/catalog"
        }
      }
    }
  ],
  "slots": [
    "ActionGroup",
    "Backdrop",
    "OfferMedia",
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"perk\"]",
      "n": 3
    },
    {
      "sel": "[data-testid=\"offer-card\"]",
      "n": 1,
      "when": {
        "layout": "overlay"
      }
    },
    {
      "sel": "[data-testid=\"offer-card\"]",
      "n": 0,
      "when": {
        "layout": "backdrop"
      }
    },
    {
      "sel": "[data-testid=\"backdrop\"]",
      "n": 1,
      "when": {
        "layout": "backdrop"
      }
    },
    {
      "sel": "[data-testid=\"backdrop\"]",
      "n": 0,
      "when": {
        "layout": "overlay"
      }
    }
  ],
  "data": [
    {
      "as": "perks",
      "collection": "perks",
      "kind": "perk",
      "record": "Feature",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "icon": "metadata.icon.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "storehero",
      "title": {
        "$": "ui.commerce.storeHero.title"
      },
      "lead": {
        "$": "ui.commerce.storeHero.lead"
      },
      "badge": {
        "$": "ui.commerce.storeHero.badge"
      },
      "perks": {
        "$": "perks"
      },
      "card": {
        "$": "ui.commerce.storeHero.card"
      },
      "actions": {
        "mode": "two",
        "cta": {
          "$": "ui.commerce.storeHero.cta"
        },
        "href": "#/catalog",
        "secondary": {
          "$": "ui.commerce.storeHero.secondary"
        },
        "secondaryHref": "#/delivery"
      }
    }
  }
}
