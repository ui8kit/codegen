{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.dashshell",
  "name": "Dashboard shell",
  "docs": "Twelve frames of a signed-in app around empty cards: a top bar across the shell or over the content, with or without search; a wide, rail, collapsed, two-level or no sidebar, at the start or the end; a footer across the shell, under the content or none.",
  "theme": "dashboard",
  "group": "layout",
  "organism": "DashboardShell",
  "axes": {
    "topbar": [
      "full",
      "inset",
      "none"
    ],
    "search": [
      "show",
      "hide"
    ],
    "sidebar": [
      "wide",
      "rail",
      "collapsed",
      "twolevel",
      "none"
    ],
    "side": [
      "start",
      "end"
    ],
    "footer": [
      "full",
      "inset",
      "none"
    ],
    "content": [
      "grid",
      "split",
      "list"
    ]
  },
  "defaults": {
    "topbar": "full",
    "search": "show",
    "sidebar": "wide",
    "side": "start",
    "footer": "none",
    "content": "grid"
  },
  "variants": [
    {
      "id": "classic",
      "set": {}
    },
    {
      "id": "inset",
      "set": {
        "topbar": "inset",
        "footer": "inset",
        "content": "split"
      }
    },
    {
      "id": "rail",
      "set": {
        "sidebar": "rail",
        "search": "hide",
        "content": "list"
      }
    },
    {
      "id": "railFooter",
      "set": {
        "topbar": "inset",
        "sidebar": "rail",
        "footer": "full"
      }
    },
    {
      "id": "collapsed",
      "set": {
        "topbar": "inset",
        "sidebar": "collapsed",
        "content": "split"
      }
    },
    {
      "id": "twoLevel",
      "set": {
        "topbar": "inset",
        "search": "hide",
        "sidebar": "twolevel",
        "footer": "inset",
        "content": "list"
      }
    },
    {
      "id": "twoLevelFull",
      "set": {
        "sidebar": "twolevel",
        "footer": "full",
        "content": "split"
      }
    },
    {
      "id": "end",
      "set": {
        "side": "end",
        "footer": "full",
        "content": "split"
      }
    },
    {
      "id": "railEnd",
      "set": {
        "topbar": "inset",
        "search": "hide",
        "sidebar": "rail",
        "side": "end",
        "footer": "inset"
      }
    },
    {
      "id": "topOnly",
      "set": {
        "sidebar": "none",
        "footer": "full"
      }
    },
    {
      "id": "sideOnly",
      "set": {
        "topbar": "none",
        "footer": "inset",
        "content": "list"
      }
    },
    {
      "id": "collapsedEnd",
      "set": {
        "topbar": "none",
        "sidebar": "collapsed",
        "side": "end",
        "footer": "full",
        "content": "split"
      }
    }
  ],
  "slots": [
    "ShellContent",
    "ShellFooter",
    "ShellSidebar",
    "ShellTopbar"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"dashboard-shell\"]",
      "n": 1
    },
    {
      "sel": "[data-testid=\"topbar\"]",
      "n": 1,
      "when": {
        "topbar": [
          "full",
          "inset"
        ]
      }
    },
    {
      "sel": "[data-testid=\"topbar\"]",
      "n": 0,
      "when": {
        "topbar": "none"
      }
    },
    {
      "sel": "[data-testid=\"sidebar\"]",
      "n": 1,
      "when": {
        "sidebar": [
          "wide",
          "rail",
          "collapsed",
          "twolevel"
        ]
      }
    },
    {
      "sel": "[data-testid=\"sidebar\"]",
      "n": 0,
      "when": {
        "sidebar": "none"
      }
    },
    {
      "sel": "[data-testid=\"subnav\"]",
      "n": 1,
      "when": {
        "sidebar": "twolevel"
      }
    },
    {
      "sel": "[data-testid=\"subnav\"]",
      "n": 0,
      "when": {
        "sidebar": [
          "wide",
          "rail",
          "collapsed",
          "none"
        ]
      }
    },
    {
      "sel": "[data-testid=\"toggle\"]",
      "n": 1,
      "when": {
        "sidebar": "collapsed"
      }
    },
    {
      "sel": "[data-testid=\"toggle\"]",
      "n": 0,
      "when": {
        "sidebar": [
          "wide",
          "rail",
          "twolevel",
          "none"
        ]
      }
    },
    {
      "sel": "[data-testid=\"footer\"]",
      "n": 1,
      "when": {
        "footer": [
          "full",
          "inset"
        ]
      }
    },
    {
      "sel": "[data-testid=\"footer\"]",
      "n": 0,
      "when": {
        "footer": "none"
      }
    },
    {
      "sel": "[data-testid=\"sidebar\"] [data-testid=\"items\"] [data-testid=\"item\"]",
      "n": "@sidenav",
      "when": {
        "sidebar": [
          "wide",
          "rail",
          "collapsed",
          "twolevel"
        ]
      }
    },
    {
      "sel": "[data-testid=\"subnav\"] [data-testid=\"item\"]",
      "n": "@subnav",
      "when": {
        "sidebar": "twolevel"
      }
    },
    {
      "sel": "[data-testid=\"footer\"] li",
      "n": "@helplinks",
      "when": {
        "footer": [
          "full",
          "inset"
        ]
      }
    },
    {
      "sel": "[data-testid=\"panel\"]",
      "n": 5,
      "when": {
        "content": "grid"
      }
    },
    {
      "sel": "[data-testid=\"panel\"]",
      "n": 3,
      "when": {
        "content": "split"
      }
    },
    {
      "sel": "[data-testid=\"panel\"]",
      "n": 1,
      "when": {
        "content": "list"
      }
    }
  ],
  "data": [
    {
      "as": "sidenav",
      "collection": "sidenav",
      "kind": "menu_item",
      "record": "NavLink",
      "fields": {
        "id": "id",
        "name": "title",
        "icon": "metadata.icon.value",
        "href": "slug|route"
      }
    },
    {
      "as": "subnav",
      "collection": "subnav",
      "kind": "menu_item",
      "record": "NavLink",
      "fields": {
        "id": "id",
        "name": "title",
        "icon": "metadata.icon.value",
        "href": "slug|route"
      }
    },
    {
      "as": "helplinks",
      "collection": "helplinks",
      "kind": "menu_item",
      "record": "NavLink",
      "fields": {
        "id": "id",
        "name": "title",
        "icon": "metadata.icon.value",
        "href": "slug|route"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "dashshell",
      "title": {
        "$": "ui.dashboard.shells.title"
      },
      "nav": {
        "label": {
          "$": "ui.dashboard.shells.label"
        },
        "brand": {
          "$": "ui.site.header.brand"
        },
        "links": {
          "$": "sidenav"
        },
        "current": "item-orders",
        "subTitle": {
          "$": "ui.dashboard.shells.subTitle"
        },
        "sub": {
          "$": "subnav"
        },
        "subCurrent": "subitem-all",
        "search": {
          "$": "ui.dashboard.shells.search"
        },
        "shortcut": {
          "$": "ui.dashboard.shells.shortcut"
        },
        "expand": {
          "$": "ui.dashboard.shells.expand"
        },
        "userName": {
          "$": "ui.dashboard.shells.userName"
        },
        "copyright": {
          "$": "ui.dashboard.shells.copyright"
        },
        "footerLabel": {
          "$": "ui.dashboard.shells.footerLabel"
        },
        "footer": {
          "$": "helplinks"
        }
      }
    }
  }
}
