{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.faqsplit",
  "name": "FAQ, split",
  "docs": "Questions beside the heading, a help card, a picture or a finder, or as cards in three or four columns.",
  "theme": "marketing",
  "group": "faq",
  "organism": "FaqSplit",
  "axes": {
    "layout": [
      "head",
      "aside",
      "media",
      "search",
      "cards"
    ],
    "cards": [
      "grid3",
      "grid4",
      "icons"
    ],
    "mediaSide": [
      "end",
      "start"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "layout": "head",
    "cards": "grid3",
    "mediaSide": "end",
    "tone": "default"
  },
  "variants": [
    {
      "id": "headSplit",
      "set": {}
    },
    {
      "id": "helpCard",
      "set": {
        "layout": "aside"
      }
    },
    {
      "id": "picture",
      "set": {
        "layout": "media"
      }
    },
    {
      "id": "finder",
      "set": {
        "layout": "search",
        "mediaSide": "start"
      }
    },
    {
      "id": "cards3",
      "set": {
        "layout": "cards"
      }
    },
    {
      "id": "cards4",
      "set": {
        "layout": "cards",
        "cards": "grid4"
      }
    },
    {
      "id": "cardsIcons",
      "set": {
        "layout": "cards",
        "cards": "icons",
        "tone": "muted"
      }
    }
  ],
  "slots": [
    "FaqCards",
    "FaqDisclosures",
    "FaqFinder",
    "FaqHelp",
    "MediaFrame",
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"faq-item\"]",
      "n": "@questions",
      "when": {
        "layout": [
          "head",
          "aside",
          "media"
        ]
      }
    },
    {
      "sel": "[data-testid=\"faq-card\"]",
      "n": "@questions",
      "when": {
        "layout": "cards"
      }
    },
    {
      "sel": "[data-testid=\"faq-help\"]",
      "n": 1,
      "when": {
        "layout": "aside"
      }
    },
    {
      "sel": "[data-testid=\"faq-help\"]",
      "n": 0,
      "when": {
        "layout": [
          "head",
          "media",
          "search",
          "cards"
        ]
      }
    },
    {
      "sel": "[data-testid=\"faq-finder\"]",
      "n": 1,
      "when": {
        "layout": "search"
      }
    },
    {
      "sel": "[data-testid=\"faq-finder\"]",
      "n": 0,
      "when": {
        "layout": [
          "head",
          "aside",
          "media",
          "cards"
        ]
      }
    },
    {
      "sel": "[data-testid=\"faq-topic\"]",
      "n": "@faqtabs",
      "when": {
        "layout": "search"
      }
    },
    {
      "sel": "[data-testid=\"faq-popular\"]",
      "n": 3,
      "when": {
        "layout": "search"
      }
    },
    {
      "sel": "[data-testid=\"faq-cta\"]",
      "n": 1,
      "when": {
        "layout": [
          "head",
          "media"
        ]
      }
    }
  ],
  "data": [
    {
      "as": "questions",
      "collection": "questions",
      "kind": "question",
      "record": "Question",
      "fields": {
        "id": "id",
        "question": "title",
        "answer": "metadata.answer.value",
        "category": "terms|term:faq_category",
        "icon": "metadata.icon.value"
      }
    },
    {
      "as": "channels",
      "collection": "channels",
      "kind": "channel",
      "record": "Feature",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "icon": "metadata.icon.value"
      }
    },
    {
      "as": "faqtabs",
      "collection": "faqtabs",
      "kind": "tab",
      "record": "FaqTab",
      "fields": {
        "id": "id",
        "title": "title",
        "value": "metadata.value.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "faqsplit",
      "title": {
        "$": "ui.marketing.faqSplit.title"
      },
      "lead": {
        "$": "ui.marketing.faqSplit.lead"
      },
      "badge": {
        "$": "ui.marketing.faqSplit.badge"
      },
      "items": {
        "$": "questions"
      },
      "channels": {
        "$": "channels"
      },
      "topics": {
        "$": "faqtabs"
      },
      "labels": {
        "cta": {
          "$": "ui.marketing.faqSplit.cta"
        },
        "more": {
          "$": "ui.marketing.faqSplit.more"
        },
        "asideTitle": {
          "$": "ui.marketing.faqSplit.asideTitle"
        },
        "asideText": {
          "$": "ui.marketing.faqSplit.asideText"
        },
        "asideCta": {
          "$": "ui.marketing.faqSplit.asideCta"
        },
        "search": {
          "$": "ui.marketing.faqSplit.search"
        },
        "popular": {
          "$": "ui.marketing.faqSplit.popular"
        }
      }
    }
  }
}
