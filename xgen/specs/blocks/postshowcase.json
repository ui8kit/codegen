{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.postshowcase",
  "name": "Post showcase",
  "docs": "Four small post cards beside an intro with a view-all link; the first post in detail beside its picture; or cards with the text on a panel over the picture, in two or three columns.",
  "theme": "content",
  "group": "blog",
  "organism": "PostShowcase",
  "axes": {
    "layout": [
      "intro",
      "featured",
      "overlay"
    ],
    "cols": [
      "2",
      "3"
    ],
    "mediaSide": [
      "end",
      "start"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "layout": "intro",
    "cols": "3",
    "mediaSide": "start",
    "tone": "default"
  },
  "variants": [
    {
      "id": "introCards",
      "set": {}
    },
    {
      "id": "featuredEnd",
      "set": {
        "layout": "featured",
        "mediaSide": "end",
        "tone": "muted"
      }
    },
    {
      "id": "overlay3",
      "set": {
        "layout": "overlay"
      }
    },
    {
      "id": "overlay2",
      "set": {
        "layout": "overlay",
        "cols": "2"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "MediaFrame",
    "PostFeature",
    "PostMiniCard",
    "PostOverlayCard",
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"post-mini\"]",
      "n": 4,
      "when": {
        "layout": "intro"
      }
    },
    {
      "sel": "[data-testid=\"post-feature\"]",
      "n": 1,
      "when": {
        "layout": "featured"
      }
    },
    {
      "sel": "[data-testid=\"post-overlay\"]",
      "n": 3,
      "when": {
        "layout": "overlay",
        "cols": "3"
      }
    },
    {
      "sel": "[data-testid=\"post-overlay\"]",
      "n": 2,
      "when": {
        "layout": "overlay",
        "cols": "2"
      }
    },
    {
      "sel": "[data-testid=\"section-action\"]",
      "n": 1,
      "when": {
        "layout": "intro"
      }
    }
  ],
  "data": [
    {
      "as": "posts",
      "collection": "posts",
      "kind": "post",
      "record": "Post",
      "fields": {
        "id": "id",
        "title": "title",
        "excerpt": "excerpt",
        "category": "terms|term:category",
        "author": "author_id|author",
        "date": "metadata.date.value|date",
        "minutes": "metadata.minutes.value",
        "icon": "metadata.icon.value",
        "href": "slug|route",
        "image": "featured_media_id|media"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "postshowcase",
      "title": {
        "$": "ui.content.postShowcase.title"
      },
      "lead": {
        "$": "ui.content.postShowcase.lead"
      },
      "badge": {
        "$": "ui.content.postShowcase.badge"
      },
      "posts": {
        "$": "posts"
      },
      "empty": {
        "$": "ui.empty.posts"
      },
      "labels": {
        "$": "ui.content.labels"
      },
      "action": {
        "label": {
          "$": "ui.content.postShowcase.action"
        },
        "href": "#/articles"
      }
    }
  }
}
