{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.reviews",
  "name": "Reviews",
  "docs": "Customer reviews with ratings.",
  "theme": "commerce",
  "group": "product",
  "organism": "ReviewList",
  "axes": {
    "layout": [
      "list",
      "grid"
    ],
    "item": [
      "card",
      "plain"
    ],
    "avatar": [
      "none",
      "image"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "default",
      "roomy"
    ]
  },
  "defaults": {
    "layout": "list",
    "item": "card",
    "avatar": "none",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "list",
      "set": {}
    },
    {
      "id": "grid",
      "set": {
        "layout": "grid"
      }
    },
    {
      "id": "plain",
      "set": {
        "item": "plain"
      }
    },
    {
      "id": "avatars",
      "set": {
        "avatar": "image"
      }
    },
    {
      "id": "mutedGrid",
      "set": {
        "layout": "grid",
        "avatar": "image",
        "tone": "muted",
        "density": "roomy"
      }
    }
  ],
  "slots": [
    "ArticleBlock",
    "EmptyState",
    "MediaFrame",
    "Rating",
    "SectionFrame"
  ],
  "data": [
    {
      "as": "reviews",
      "collection": "reviews",
      "kind": "review",
      "record": "Review",
      "fields": {
        "id": "id",
        "title": "title",
        "author": "author_id|author",
        "rating": "metadata.rating.value",
        "text": "metadata.text.value",
        "date": "metadata.date.value|date"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "reviews",
      "title": {
        "$": "ui.commerce.reviews.title"
      },
      "reviews": {
        "$": "reviews"
      },
      "labels": {
        "$": "ui.commerce.reviewLabels"
      }
    }
  }
}
