{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.cta",
  "name": "Call to action",
  "docs": "A closing call to action.",
  "theme": "marketing",
  "group": "cta",
  "organism": "CtaBand",
  "axes": {
    "layout": [
      "card",
      "band",
      "split",
      "row",
      "banner"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "actions.mode": [
      "one",
      "two",
      "form"
    ],
    "proof": [
      "none",
      "quote"
    ],
    "density": [
      "roomy",
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "card",
    "tone": "muted",
    "actions.mode": "one",
    "proof": "none",
    "density": "default"
  },
  "variants": [
    {
      "id": "card",
      "set": {}
    },
    {
      "id": "banner",
      "set": {
        "layout": "banner",
        "tone": "muted",
        "density": "compact"
      }
    },
    {
      "id": "row",
      "set": {
        "layout": "row"
      }
    },
    {
      "id": "form",
      "set": {
        "layout": "band",
        "actions.mode": "form"
      }
    },
    {
      "id": "quote",
      "set": {
        "layout": "band",
        "proof": "quote",
        "tone": "muted"
      }
    },
    {
      "id": "band",
      "set": {
        "layout": "band",
        "density": "roomy"
      }
    },
    {
      "id": "split",
      "set": {
        "layout": "split",
        "tone": "default",
        "actions.mode": "two"
      }
    },
    {
      "id": "compact",
      "set": {
        "density": "compact"
      }
    },
    {
      "id": "saas",
      "set": {
        "layout": "band",
        "actions.mode": "two",
        "density": "roomy"
      },
      "props": {
        "title": {
          "$": "ui.cases.saas.cta.title"
        },
        "text": {
          "$": "ui.cases.saas.cta.text"
        },
        "actions": {
          "cta": {
            "$": "ui.cases.saas.cta.cta"
          },
          "secondary": {
            "$": "ui.cases.saas.cta.secondary"
          }
        }
      }
    },
    {
      "id": "shop",
      "set": {
        "layout": "split",
        "tone": "default"
      },
      "props": {
        "title": {
          "$": "ui.cases.shop.cta.title"
        },
        "text": {
          "$": "ui.cases.shop.cta.text"
        },
        "actions": {
          "cta": {
            "$": "ui.cases.shop.cta.cta"
          },
          "secondary": {
            "$": "ui.cases.shop.cta.secondary"
          }
        }
      }
    },
    {
      "id": "agency",
      "set": {
        "actions.mode": "two",
        "tone": "muted"
      },
      "props": {
        "title": {
          "$": "ui.cases.agency.cta.title"
        },
        "text": {
          "$": "ui.cases.agency.cta.text"
        },
        "actions": {
          "cta": {
            "$": "ui.cases.agency.cta.cta"
          },
          "secondary": {
            "$": "ui.cases.agency.cta.secondary"
          }
        }
      }
    }
  ],
  "slots": [
    "CtaActions",
    "MediaFrame",
    "QuoteProof",
    "SectionFrame"
  ],
  "data": [],
  "sample": {
    "props": {
      "id": "cta",
      "title": {
        "$": "ui.site.home.ctaTitle"
      },
      "text": {
        "$": "ui.site.home.ctaText"
      },
      "actions": {
        "cta": {
          "$": "ui.site.home.ctaButton"
        },
        "href": "#/pricing",
        "secondary": {
          "$": "ui.site.home.ctaSecondary"
        },
        "secondaryHref": "#/",
        "emailLabel": {
          "$": "ui.promo.newsletter.label"
        }
      },
      "quote": {
        "text": {
          "$": "ui.vibe.cta.quote"
        },
        "by": {
          "$": "ui.vibe.cta.quoteBy"
        }
      }
    }
  }
}
