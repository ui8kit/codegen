{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.features",
  "name": "Features",
  "docs": "Features as cards, tiles or rows with a picture.",
  "theme": "marketing",
  "group": "features",
  "organism": "FeatureGrid",
  "axes": {
    "layout": [
      "grid",
      "rows"
    ],
    "cols": [
      "1-2",
      "1-3",
      "1-4"
    ],
    "item": [
      "card",
      "tile",
      "cell"
    ],
    "mediaSide": [
      "end",
      "start",
      "alternate"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "roomy",
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "grid",
    "cols": "1-3",
    "item": "card",
    "mediaSide": "end",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "grid",
      "set": {}
    },
    {
      "id": "grid2",
      "set": {
        "cols": "1-2",
        "density": "roomy"
      }
    },
    {
      "id": "tiles4",
      "set": {
        "cols": "1-4",
        "item": "tile"
      }
    },
    {
      "id": "cells4",
      "set": {
        "cols": "1-4",
        "item": "cell",
        "density": "compact"
      },
      "props": {
        "action": {
          "label": {
            "$": "ui.site.home.featuresAction"
          },
          "href": "#/"
        }
      }
    },
    {
      "id": "rows",
      "set": {
        "layout": "rows"
      }
    },
    {
      "id": "rowsStart",
      "set": {
        "layout": "rows",
        "mediaSide": "start",
        "density": "compact"
      }
    },
    {
      "id": "rowsAlternate",
      "set": {
        "layout": "rows",
        "mediaSide": "alternate",
        "tone": "muted"
      }
    },
    {
      "id": "tilesMuted",
      "set": {
        "item": "tile",
        "tone": "muted",
        "density": "compact"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "FeatureCards",
    "FeatureRows",
    "SectionFrame"
  ],
  "data": [
    {
      "as": "features",
      "collection": "features",
      "kind": "feature",
      "record": "Feature",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "icon": "metadata.icon.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "features",
      "title": {
        "$": "ui.site.home.featuresTitle"
      },
      "features": {
        "$": "features"
      },
      "empty": {
        "$": "ui.empty.features"
      },
      "action": {
        "label": {
          "$": "ui.site.home.featuresAction"
        },
        "href": "#/"
      }
    }
  }
}
