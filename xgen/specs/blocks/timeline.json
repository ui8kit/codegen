{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.timeline",
  "name": "Timeline",
  "docs": "Milestones on a vertical line beside a picture, in a narrow column, or in a row.",
  "theme": "content",
  "group": "story",
  "organism": "MilestoneTimeline",
  "axes": {
    "layout": [
      "split",
      "stacked",
      "row"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "split",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "split",
      "set": {}
    },
    {
      "id": "stacked",
      "set": {
        "layout": "stacked"
      }
    },
    {
      "id": "row",
      "set": {
        "layout": "row"
      }
    },
    {
      "id": "rowMuted",
      "set": {
        "layout": "row",
        "tone": "muted",
        "density": "compact"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "MediaFrame",
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"item\"]",
      "n": "@milestones"
    },
    {
      "sel": "[data-slot=\"media\"]",
      "n": 1,
      "when": {
        "layout": "split"
      }
    },
    {
      "sel": "[data-slot=\"media\"]",
      "n": 0,
      "when": {
        "layout": [
          "stacked",
          "row"
        ]
      }
    }
  ],
  "data": [
    {
      "as": "milestones",
      "collection": "milestones",
      "kind": "milestone",
      "record": "Milestone",
      "fields": {
        "id": "id",
        "date": "metadata.date.value",
        "title": "title",
        "text": "metadata.text.value",
        "tag": "metadata.tag.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "timeline",
      "title": {
        "$": "ui.company.timeline.title"
      },
      "lead": {
        "$": "ui.company.timeline.lead"
      },
      "milestones": {
        "$": "milestones"
      },
      "empty": {
        "$": "ui.empty.milestones"
      }
    }
  }
}
