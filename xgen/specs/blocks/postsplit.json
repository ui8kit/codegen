{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.postsplit",
  "name": "Post header, split",
  "docs": "Tags, reading figures and an author card with share and save over a wide cover; the author, figures, tags and actions beside the cover; or the facts and related reading beside it.",
  "theme": "content",
  "group": "blog",
  "organism": "PostSplit",
  "axes": {
    "layout": [
      "center",
      "split",
      "outline"
    ],
    "mediaSide": [
      "end",
      "start"
    ],
    "author": [
      "line",
      "card",
      "bio"
    ],
    "cover": [
      "wide",
      "square"
    ],
    "actions": [
      "pair",
      "wide",
      "icons"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "layout": "split",
    "mediaSide": "end",
    "author": "line",
    "cover": "wide",
    "actions": "pair",
    "tone": "default"
  },
  "variants": [
    {
      "id": "centerShare",
      "set": {
        "layout": "center"
      }
    },
    {
      "id": "splitTags",
      "set": {}
    },
    {
      "id": "splitBioStart",
      "set": {
        "mediaSide": "start",
        "author": "bio",
        "actions": "wide"
      }
    },
    {
      "id": "splitSquare",
      "set": {
        "cover": "square",
        "actions": "icons"
      }
    },
    {
      "id": "outlineStart",
      "set": {
        "layout": "outline",
        "mediaSide": "start"
      }
    },
    {
      "id": "splitStats",
      "set": {
        "author": "card",
        "tone": "muted"
      }
    }
  ],
  "slots": [
    "MediaFrame",
    "PostActions",
    "PostAuthor",
    "PostOutline",
    "PostStats",
    "PostTags",
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"post-author\"]",
      "n": 1,
      "when": {
        "layout": [
          "center",
          "split"
        ]
      }
    },
    {
      "sel": "[data-testid=\"post-author\"]",
      "n": 0,
      "when": {
        "layout": "outline"
      }
    },
    {
      "sel": "[data-testid=\"post-tag\"]",
      "n": "@posttags",
      "when": {
        "layout": [
          "center",
          "split"
        ]
      }
    },
    {
      "sel": "[data-testid=\"post-link\"]",
      "n": "@outline",
      "when": {
        "layout": "outline"
      }
    },
    {
      "sel": "[data-testid=\"post-link\"]",
      "n": 0,
      "when": {
        "layout": [
          "center",
          "split"
        ]
      }
    },
    {
      "sel": "[data-testid=\"post-stats\"]",
      "n": 1,
      "when": {
        "layout": "center"
      }
    },
    {
      "sel": "[data-testid=\"post-save\"]",
      "n": 1,
      "when": {
        "actions": [
          "pair",
          "icons"
        ]
      }
    },
    {
      "sel": "[data-testid=\"post-save\"]",
      "n": 0,
      "when": {
        "actions": "wide",
        "layout": [
          "split",
          "outline"
        ]
      }
    },
    {
      "sel": "[data-testid=\"action-primary\"]",
      "n": 1,
      "when": {
        "layout": [
          "split",
          "outline"
        ]
      }
    }
  ],
  "data": [
    {
      "as": "posts",
      "collection": "posts",
      "kind": "post",
      "record": "Post",
      "fields": {
        "id": "id",
        "title": "title",
        "excerpt": "excerpt",
        "category": "terms|term:category",
        "author": "author_id|author",
        "date": "metadata.date.value|date",
        "minutes": "metadata.minutes.value",
        "icon": "metadata.icon.value",
        "href": "slug|route",
        "image": "featured_media_id|media"
      }
    },
    {
      "as": "posttags",
      "collection": "posttags",
      "kind": "posttag",
      "record": "NavLink",
      "fields": {
        "id": "id",
        "name": "title",
        "icon": "metadata.icon.value"
      }
    },
    {
      "as": "outline",
      "collection": "outline",
      "kind": "menu_item",
      "record": "NavLink",
      "fields": {
        "id": "id",
        "name": "title",
        "icon": "metadata.icon.value",
        "href": "slug|route"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "postsplit",
      "post": {
        "op": "pick",
        "args": [
          {
            "$": "posts"
          },
          "post-static-first"
        ]
      },
      "labels": {
        "$": "ui.content.postSplit.labels"
      },
      "extras": {
        "role": {
          "$": "ui.content.postSplit.role"
        },
        "bio": {
          "$": "ui.content.postSplit.bio"
        },
        "views": {
          "$": "ui.content.postSplit.views"
        },
        "likes": {
          "$": "ui.content.postSplit.likes"
        },
        "tags": {
          "$": "posttags"
        },
        "outline": {
          "$": "outline"
        }
      }
    }
  }
}
