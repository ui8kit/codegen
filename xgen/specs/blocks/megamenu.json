{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.megamenu",
  "name": "Mega menu",
  "docs": "A top bar whose first item opens a wide panel of link groups, with an optional promo card.",
  "theme": "marketing",
  "group": "navigation",
  "organism": "MegaMenu",
  "axes": {
    "panel": [
      "open",
      "closed"
    ],
    "cols": [
      "2",
      "3"
    ],
    "promo": [
      "none",
      "card"
    ]
  },
  "defaults": {
    "panel": "open",
    "cols": "3",
    "promo": "none"
  },
  "variants": [
    {
      "id": "open",
      "set": {}
    },
    {
      "id": "closed",
      "set": {
        "panel": "closed"
      }
    },
    {
      "id": "twoCols",
      "set": {
        "cols": "2"
      }
    },
    {
      "id": "promo",
      "set": {
        "promo": "card"
      }
    }
  ],
  "slots": [
    "MediaFrame",
    "MenuEntry",
    "NavBlock"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"mega-trigger\"]",
      "n": 1
    },
    {
      "sel": "[data-testid=\"mega-panel\"]",
      "n": 1,
      "when": {
        "panel": "open"
      }
    },
    {
      "sel": "[data-testid=\"mega-panel\"]",
      "n": 0,
      "when": {
        "panel": "closed"
      }
    },
    {
      "sel": "[data-testid=\"mega-panel\"] [data-testid=\"item\"]",
      "n": "@megagroups",
      "when": {
        "panel": "open"
      }
    },
    {
      "sel": "[data-testid=\"mega-panel\"] [data-testid=\"item\"]",
      "cols": 3,
      "when": {
        "panel": "open",
        "cols": "3"
      }
    },
    {
      "sel": "[data-testid=\"mega-panel\"] [data-testid=\"item\"]",
      "cols": 2,
      "when": {
        "panel": "open",
        "cols": "2"
      }
    },
    {
      "sel": "[data-testid=\"promo\"]",
      "n": 1,
      "when": {
        "panel": "open",
        "promo": "card"
      }
    }
  ],
  "data": [
    {
      "as": "navlinks",
      "collection": "navlinks",
      "kind": "menu_item",
      "record": "NavLink",
      "fields": {
        "id": "id",
        "name": "title",
        "icon": "metadata.icon.value",
        "href": "slug|route"
      }
    },
    {
      "as": "megagroups",
      "collection": "megagroups",
      "kind": "menu_item",
      "record": "MegaGroup",
      "fields": {
        "id": "id",
        "title": "title",
        "icon": "metadata.icon.value",
        "links": "id|menu",
        "href": "slug|route"
      }
    }
  ],
  "sample": {
    "props": {
      "label": {
        "$": "ui.vibe.nav.label"
      },
      "brand": {
        "$": "ui.site.header.brand"
      },
      "trigger": {
        "$": "ui.vibe.mega.trigger"
      },
      "links": {
        "$": "navlinks"
      },
      "groups": {
        "$": "megagroups"
      },
      "promoTitle": {
        "$": "ui.vibe.mega.promoTitle"
      },
      "promoText": {
        "$": "ui.vibe.mega.promoText"
      }
    }
  }
}
