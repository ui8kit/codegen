{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.pricing",
  "name": "Pricing",
  "docs": "Plans as a grid or a stack of cards.",
  "theme": "marketing",
  "group": "pricing",
  "organism": "PricingTiers",
  "axes": {
    "layout": [
      "grid",
      "stack"
    ],
    "cols": [
      "1-2",
      "1-3",
      "1-4"
    ],
    "emphasis": [
      "auto",
      "off"
    ],
    "billing": [
      "off",
      "monthly",
      "annual"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "roomy",
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "grid",
    "cols": "1-3",
    "emphasis": "auto",
    "billing": "off",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "grid",
      "set": {}
    },
    {
      "id": "monthly",
      "set": {
        "billing": "monthly"
      }
    },
    {
      "id": "annual",
      "set": {
        "billing": "annual"
      }
    },
    {
      "id": "duo",
      "set": {
        "cols": "1-2",
        "emphasis": "off"
      },
      "props": {
        "plans": {
          "$": "duo"
        }
      }
    },
    {
      "id": "grid2",
      "set": {
        "cols": "1-2"
      }
    },
    {
      "id": "grid4",
      "set": {
        "cols": "1-4"
      }
    },
    {
      "id": "stack",
      "set": {
        "layout": "stack"
      }
    },
    {
      "id": "flat",
      "set": {
        "emphasis": "off"
      }
    },
    {
      "id": "compactMuted",
      "set": {
        "tone": "muted",
        "density": "compact"
      }
    },
    {
      "id": "roomy",
      "set": {
        "density": "roomy"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "SectionFrame",
    "Switcher",
    "SwitcherItem"
  ],
  "data": [
    {
      "as": "tiers",
      "collection": "tiers",
      "kind": "plan",
      "record": "Plan",
      "fields": {
        "id": "id",
        "name": "title",
        "tagline": "metadata.tagline.value",
        "price": "metadata.price.value",
        "currency": "metadata.currency.value",
        "seats": "metadata.seats.value",
        "storage": "metadata.storage.value",
        "highlighted": "metadata.highlighted.value",
        "features": "metadata.features.value",
        "yearly": "metadata.yearly.value"
      }
    },
    {
      "as": "duo",
      "collection": "duo",
      "kind": "plan",
      "record": "Plan",
      "fields": {
        "id": "id",
        "name": "title",
        "tagline": "metadata.tagline.value",
        "price": "metadata.price.value",
        "currency": "metadata.currency.value",
        "seats": "metadata.seats.value",
        "storage": "metadata.storage.value",
        "highlighted": "metadata.highlighted.value",
        "features": "metadata.features.value",
        "yearly": "metadata.yearly.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "pricing",
      "title": {
        "$": "ui.site.pricing.tiersTitle"
      },
      "plans": {
        "$": "tiers"
      },
      "labels": {
        "$": "ui.pricing"
      },
      "billingLabels": {
        "$": "ui.vibe.billing"
      }
    }
  }
}
