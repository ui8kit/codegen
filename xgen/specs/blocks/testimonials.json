{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.testimonials",
  "name": "Testimonials",
  "docs": "Customer quotes as cards or plain figures.",
  "theme": "marketing",
  "group": "proof",
  "organism": "TestimonialGrid",
  "axes": {
    "layout": [
      "grid",
      "single",
      "stack",
      "masonry",
      "strip"
    ],
    "cols": [
      "1-2",
      "1-3"
    ],
    "item.kind": [
      "card",
      "plain",
      "social"
    ],
    "item.avatar": [
      "none",
      "image"
    ],
    "item.rating": [
      "show",
      "hide"
    ],
    "item.mark": [
      "none",
      "icon"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "roomy",
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "grid",
    "cols": "1-3",
    "item.kind": "card",
    "item.avatar": "image",
    "item.rating": "show",
    "item.mark": "none",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "grid3",
      "set": {}
    },
    {
      "id": "masonry",
      "set": {
        "layout": "masonry",
        "item.rating": "hide"
      }
    },
    {
      "id": "strip",
      "set": {
        "layout": "strip",
        "item.avatar": "none"
      }
    },
    {
      "id": "social",
      "set": {
        "item.kind": "social",
        "layout": "masonry",
        "item.rating": "hide"
      }
    },
    {
      "id": "featured",
      "set": {
        "layout": "single",
        "item.kind": "plain",
        "item.rating": "hide",
        "item.mark": "icon"
      }
    },
    {
      "id": "grid2",
      "set": {
        "cols": "1-2"
      }
    },
    {
      "id": "single",
      "set": {
        "layout": "single",
        "item.kind": "plain",
        "item.rating": "hide"
      }
    },
    {
      "id": "stack",
      "set": {
        "layout": "stack",
        "item.avatar": "none"
      }
    },
    {
      "id": "plain",
      "set": {
        "item.kind": "plain",
        "item.avatar": "none",
        "tone": "muted",
        "density": "compact"
      }
    },
    {
      "id": "noRating",
      "set": {
        "item.rating": "hide",
        "density": "roomy"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "QuoteCard",
    "SectionFrame"
  ],
  "data": [
    {
      "as": "testimonials",
      "collection": "testimonials",
      "kind": "testimonial",
      "record": "Quote",
      "fields": {
        "id": "id",
        "author": "title",
        "role": "metadata.role.value",
        "company": "metadata.company.value",
        "quote": "metadata.quote.value",
        "rating": "metadata.rating.value",
        "handle": "metadata.handle.value",
        "time": "metadata.time.value|ago-short",
        "mark": "metadata.mark.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "testimonials",
      "title": {
        "$": "ui.marketing.testimonials.title"
      },
      "quotes": {
        "$": "testimonials"
      },
      "empty": {
        "$": "ui.empty.quotes"
      },
      "labels": {
        "rating": {
          "$": "ui.testimonials.rating"
        },
        "byLine": {
          "$": "ui.testimonials.byLine"
        },
        "handleLine": {
          "$": "ui.testimonials.handleLine"
        }
      }
    }
  }
}
