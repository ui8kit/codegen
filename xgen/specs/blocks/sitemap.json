{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.sitemap",
  "name": "Sitemap footer",
  "docs": "A footer with the brand, groups of links and the copyright; a single row, a sign-up first or a status pill.",
  "theme": "marketing",
  "group": "navigation",
  "organism": "SitemapFooter",
  "axes": {
    "layout": [
      "columns",
      "row",
      "card"
    ],
    "signup.mode": [
      "none",
      "first"
    ],
    "status.mode": [
      "none",
      "show"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "columns",
    "signup.mode": "none",
    "status.mode": "none",
    "density": "default"
  },
  "variants": [
    {
      "id": "columns",
      "set": {}
    },
    {
      "id": "card",
      "set": {
        "layout": "card"
      }
    },
    {
      "id": "row",
      "set": {
        "layout": "row"
      }
    },
    {
      "id": "newsletter",
      "set": {
        "signup.mode": "first"
      }
    },
    {
      "id": "status",
      "set": {
        "status.mode": "show"
      }
    },
    {
      "id": "compact",
      "set": {
        "density": "compact"
      }
    }
  ],
  "slots": [
    "FooterCard",
    "FooterColumns",
    "MenuEntry",
    "NavBlock",
    "Pill"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"group\"]",
      "n": "@sitemap"
    },
    {
      "sel": "[data-testid=\"group\"]",
      "cols": "@sitemap",
      "when": {
        "layout": "columns"
      }
    },
    {
      "sel": "[data-testid=\"signup\"]",
      "n": 1,
      "when": {
        "signup.mode": "first"
      }
    },
    {
      "sel": "[data-testid=\"signup\"]",
      "n": 0,
      "when": {
        "signup.mode": "none"
      }
    },
    {
      "sel": "[data-slot=\"pill\"]",
      "n": 1,
      "when": {
        "status.mode": "show"
      }
    }
  ],
  "data": [
    {
      "as": "sitemap",
      "collection": "sitemap",
      "kind": "menu_item",
      "record": "MegaGroup",
      "fields": {
        "id": "id",
        "title": "title",
        "icon": "metadata.icon.value",
        "links": "id|menu",
        "href": "slug|route"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "sitemap",
      "label": {
        "$": "ui.vibe.sitemap.label"
      },
      "brand": {
        "$": "ui.site.header.brand"
      },
      "tagline": {
        "$": "ui.vibe.sitemap.tagline"
      },
      "copyright": {
        "$": "ui.vibe.sitemap.copyright"
      },
      "groups": {
        "$": "sitemap"
      },
      "signup": {
        "title": {
          "$": "ui.vibe.sitemap.signupTitle"
        },
        "label": {
          "$": "ui.vibe.sitemap.signupLabel"
        },
        "submit": {
          "$": "ui.vibe.sitemap.signupSubmit"
        }
      },
      "status": {
        "label": {
          "$": "ui.vibe.sitemap.status"
        }
      }
    }
  }
}
