{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.chart",
  "name": "Chart panel",
  "docs": "Orders per day as bars or meters.",
  "theme": "dashboard",
  "group": "widgets",
  "organism": "ChartPanel",
  "axes": {
    "chart": [
      "bars",
      "meters"
    ],
    "size": [
      "default",
      "compact"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "chart": "bars",
    "size": "default",
    "tone": "default"
  },
  "variants": [
    {
      "id": "bars",
      "set": {}
    },
    {
      "id": "short",
      "set": {
        "size": "compact"
      }
    },
    {
      "id": "meters",
      "set": {
        "chart": "meters"
      }
    },
    {
      "id": "muted",
      "set": {
        "chart": "meters",
        "size": "compact",
        "tone": "muted"
      }
    }
  ],
  "slots": [
    "BarChart",
    "EmptyState",
    "MeterRow",
    "Panel"
  ],
  "data": [
    {
      "as": "series",
      "collection": "series",
      "kind": "point",
      "record": "Point",
      "fields": {
        "id": "id",
        "label": "title",
        "value": "metadata.value.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "chart",
      "title": {
        "$": "ui.dashboard.chart.title"
      },
      "text": {
        "$": "ui.dashboard.chart.text"
      },
      "series": {
        "$": "series"
      },
      "empty": {
        "$": "ui.empty.series"
      },
      "summary": {
        "$": "ui.dashboard.chart.summary"
      },
      "percent": {
        "$": "ui.dashboard.chart.percent"
      }
    }
  }
}
