{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.projects",
  "name": "Projects",
  "docs": "Projects as cards, a compact grid, captions over pictures, a bento or a list beside a collage.",
  "theme": "marketing",
  "group": "company",
  "organism": "ProjectGrid",
  "axes": {
    "layout": [
      "cards",
      "compact",
      "overlay",
      "bento",
      "list"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "cards",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "cards",
      "set": {}
    },
    {
      "id": "compact",
      "set": {
        "layout": "compact"
      }
    },
    {
      "id": "overlay",
      "set": {
        "layout": "overlay"
      }
    },
    {
      "id": "bento",
      "set": {
        "layout": "bento"
      }
    },
    {
      "id": "list",
      "set": {
        "layout": "list"
      }
    },
    {
      "id": "cardsMuted",
      "set": {
        "tone": "muted",
        "density": "compact"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "MediaFrame",
    "ProjectTiles",
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"item\"]",
      "n": "@projects"
    },
    {
      "sel": "[data-testid=\"featured\"]",
      "n": 2,
      "when": {
        "layout": [
          "cards",
          "overlay",
          "bento"
        ]
      }
    },
    {
      "sel": "[data-testid=\"featured\"]",
      "n": 0,
      "when": {
        "layout": [
          "compact",
          "list"
        ]
      }
    }
  ],
  "data": [
    {
      "as": "projects",
      "collection": "projects",
      "kind": "project",
      "record": "Project",
      "fields": {
        "id": "id",
        "title": "title",
        "category": "terms|term:project_category",
        "year": "metadata.year.value",
        "summary": "metadata.summary.value",
        "tags": "metadata.tags.value",
        "featured": "metadata.featured.value",
        "client": "metadata.client.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "projects",
      "title": {
        "$": "ui.company.projects.title"
      },
      "lead": {
        "$": "ui.company.projects.lead"
      },
      "projects": {
        "$": "projects"
      },
      "empty": {
        "$": "ui.empty.projects"
      },
      "labels": {
        "$": "ui.company.projects"
      }
    }
  }
}
