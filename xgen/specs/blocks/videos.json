{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.videos",
  "name": "Video testimonials",
  "docs": "Customer videos as thumbnails with a play button. Playing is a port contract (VideoEmbed).",
  "theme": "marketing",
  "group": "proof",
  "organism": "VideoGrid",
  "axes": {
    "cols": [
      "1-2",
      "1-3"
    ],
    "caption": [
      "below",
      "overlay"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "cols": "1-3",
    "caption": "below",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "grid3",
      "set": {}
    },
    {
      "id": "grid2",
      "set": {
        "cols": "1-2"
      }
    },
    {
      "id": "overlay",
      "set": {
        "caption": "overlay"
      }
    },
    {
      "id": "muted",
      "set": {
        "tone": "muted",
        "density": "compact"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "FigureBlock",
    "MediaFrame",
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"item\"]",
      "n": "@testimonials"
    },
    {
      "sel": "[data-testid=\"item\"]",
      "cols": "$cols"
    },
    {
      "sel": "[data-testid=\"play\"]",
      "n": "@testimonials"
    }
  ],
  "data": [
    {
      "as": "testimonials",
      "collection": "testimonials",
      "kind": "testimonial",
      "record": "Quote",
      "fields": {
        "id": "id",
        "author": "title",
        "role": "metadata.role.value",
        "company": "metadata.company.value",
        "quote": "metadata.quote.value",
        "rating": "metadata.rating.value",
        "handle": "metadata.handle.value",
        "time": "metadata.time.value|ago-short",
        "mark": "metadata.mark.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "videos",
      "title": {
        "$": "ui.vibe.videos.title"
      },
      "quotes": {
        "$": "testimonials"
      },
      "empty": {
        "$": "ui.empty.quotes"
      },
      "playLabel": {
        "$": "ui.vibe.videos.play"
      },
      "byLine": {
        "$": "ui.testimonials.byLine"
      }
    }
  }
}
