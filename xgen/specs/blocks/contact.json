{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.contact",
  "name": "Contact form",
  "docs": "A message form, alone or beside the ways to reach us.",
  "theme": "support",
  "group": "contact",
  "organism": "ContactForm",
  "axes": {
    "layout": [
      "single",
      "split"
    ],
    "fields": [
      "short",
      "full"
    ],
    "terms": [
      "show",
      "hide"
    ],
    "page": [
      "section",
      "full"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "layout": "single",
    "fields": "full",
    "terms": "hide",
    "page": "section",
    "tone": "default"
  },
  "variants": [
    {
      "id": "single",
      "set": {}
    },
    {
      "id": "page",
      "set": {
        "page": "full",
        "fields": "short"
      }
    },
    {
      "id": "short",
      "set": {
        "fields": "short"
      }
    },
    {
      "id": "split",
      "set": {
        "layout": "split"
      }
    },
    {
      "id": "consent",
      "set": {
        "terms": "show"
      }
    },
    {
      "id": "muted",
      "set": {
        "layout": "split",
        "fields": "short",
        "tone": "muted",
        "terms": "show"
      }
    }
  ],
  "slots": [
    "Field",
    "SectionFrame"
  ],
  "data": [
    {
      "as": "channels",
      "collection": "channels",
      "kind": "channel",
      "record": "Feature",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "icon": "metadata.icon.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "contact",
      "title": {
        "$": "ui.support.contact.title"
      },
      "text": {
        "$": "ui.support.contact.text"
      },
      "labels": {
        "$": "ui.support.contact.labels"
      },
      "details": {
        "$": "channels"
      }
    }
  }
}
