{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.videomodal",
  "name": "Video walkthrough",
  "docs": "A dialog with a walkthrough video and an optional list of chapters. Opening and playing are port contracts.",
  "theme": "onboarding",
  "group": "guidance",
  "organism": "VideoModal",
  "axes": {
    "size": [
      "default",
      "wide"
    ],
    "outline": [
      "none",
      "chapters"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "size": "default",
    "outline": "none",
    "tone": "default"
  },
  "variants": [
    {
      "id": "default",
      "set": {}
    },
    {
      "id": "wide",
      "set": {
        "size": "wide"
      }
    },
    {
      "id": "chapters",
      "set": {
        "outline": "chapters"
      }
    },
    {
      "id": "muted",
      "set": {
        "tone": "muted"
      }
    }
  ],
  "slots": [
    "MediaFrame",
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "[role=\"dialog\"]",
      "n": 1
    },
    {
      "sel": "[data-testid=\"play\"]",
      "n": 1
    },
    {
      "sel": "[data-testid=\"modal-close\"]",
      "n": 1
    },
    {
      "sel": "[data-testid=\"chapters\"] [data-testid=\"item\"]",
      "n": "@chapters",
      "when": {
        "outline": "chapters"
      }
    },
    {
      "sel": "[data-testid=\"chapters\"]",
      "n": 0,
      "when": {
        "outline": "none"
      }
    }
  ],
  "data": [
    {
      "as": "chapters",
      "collection": "chapters",
      "kind": "chapter",
      "record": "Chapter",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "modal",
      "title": {
        "$": "ui.vibe.modal.title"
      },
      "text": {
        "$": "ui.vibe.modal.text"
      },
      "close": {
        "$": "ui.vibe.modal.close"
      },
      "play": {
        "$": "ui.vibe.modal.play"
      },
      "chaptersTitle": {
        "$": "ui.vibe.modal.chapters"
      },
      "chapters": {
        "$": "chapters"
      }
    }
  }
}
