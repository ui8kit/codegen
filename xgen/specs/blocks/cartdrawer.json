{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.cartdrawer",
  "name": "Cart drawer",
  "docs": "The cart drawer in its open state, filled or empty.",
  "theme": "commerce",
  "group": "checkout",
  "organism": "CartDrawer",
  "axes": {
    "state": [
      "filled",
      "empty"
    ],
    "media": [
      "image",
      "none"
    ]
  },
  "defaults": {
    "state": "filled",
    "media": "image"
  },
  "variants": [
    {
      "id": "filled",
      "set": {}
    },
    {
      "id": "compact",
      "set": {
        "media": "none"
      }
    },
    {
      "id": "empty",
      "set": {
        "state": "empty"
      }
    }
  ],
  "slots": [
    "DrawerLines",
    "EmptyState"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"drawer\"]",
      "n": 1
    },
    {
      "sel": "[data-testid=\"item\"]",
      "n": "@cart",
      "when": {
        "state": "filled"
      }
    },
    {
      "sel": "[data-testid=\"empty\"]",
      "n": 1,
      "when": {
        "state": "empty"
      }
    },
    {
      "sel": "[data-testid=\"empty\"]",
      "n": 0,
      "when": {
        "state": "filled"
      }
    }
  ],
  "data": [
    {
      "as": "cart",
      "collection": "cart",
      "kind": "cartline",
      "record": "CartLine",
      "fields": {
        "id": "id",
        "name": "title",
        "variant": "metadata.variant.value",
        "price": "metadata.price.value",
        "currency": "metadata.currency.value",
        "qty": "metadata.qty.value"
      }
    },
    {
      "as": "summary",
      "collection": "summary",
      "kind": "summaryrow",
      "record": "SummaryRow",
      "fields": {
        "id": "id",
        "label": "title",
        "amount": "metadata.amount.value",
        "currency": "metadata.currency.value",
        "strong": "metadata.strong.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "cartdrawer",
      "lines": {
        "$": "cart"
      },
      "rows": {
        "$": "summary"
      },
      "labels": {
        "$": "ui.commerce.cart"
      },
      "drawer": {
        "$": "ui.commerce.drawer"
      }
    }
  }
}
