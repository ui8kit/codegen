{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.header",
  "name": "Header",
  "docs": "Skip link, brand, navigation, theme button and an optional call to action.",
  "theme": "marketing",
  "group": "navigation",
  "organism": "SiteHeader",
  "axes": {
    "layout": [
      "inline",
      "stacked"
    ],
    "position": [
      "static",
      "sticky"
    ],
    "actions": [
      "none",
      "cta"
    ]
  },
  "defaults": {
    "layout": "inline",
    "position": "static",
    "actions": "none"
  },
  "variants": [
    {
      "id": "inline",
      "set": {}
    },
    {
      "id": "stacked",
      "set": {
        "layout": "stacked"
      }
    },
    {
      "id": "sticky",
      "set": {
        "position": "sticky"
      }
    },
    {
      "id": "withCta",
      "set": {
        "actions": "cta"
      }
    }
  ],
  "slots": [
    "MenuEntry",
    "NavBlock"
  ],
  "events": {
    "theme": "toggleTheme"
  },
  "data": [],
  "sample": {
    "props": {
      "labels": {
        "$": "ui.site.header"
      },
      "current": "home",
      "cta": {
        "$": "ui.site.header.cta"
      }
    }
  }
}
