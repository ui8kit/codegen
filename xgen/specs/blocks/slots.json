{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.slots",
  "name": "Delivery window",
  "docs": "Days with their delivery windows as radio chips, beside the zone card.",
  "theme": "commerce",
  "group": "delivery",
  "organism": "SlotBoard",
  "axes": {
    "layout": [
      "split",
      "stacked"
    ],
    "item": [
      "card",
      "plain"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "layout": "split",
    "item": "card",
    "tone": "default"
  },
  "variants": [
    {
      "id": "split",
      "set": {}
    },
    {
      "id": "plain",
      "set": {
        "item": "plain"
      }
    },
    {
      "id": "stacked",
      "set": {
        "layout": "stacked",
        "tone": "muted"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "Field",
    "SectionFrame",
    "SlotGrid"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"day\"]",
      "n": "@days"
    },
    {
      "sel": "input[type=\"radio\"]",
      "n": 12
    },
    {
      "sel": "input[type=\"radio\"]:disabled",
      "n": 4
    },
    {
      "sel": "[data-testid=\"aside\"]",
      "n": 1,
      "when": {
        "layout": "split"
      }
    },
    {
      "sel": "[data-testid=\"aside\"]",
      "n": 0,
      "when": {
        "layout": "stacked"
      }
    }
  ],
  "data": [
    {
      "as": "days",
      "collection": "days",
      "kind": "day",
      "record": "Day",
      "fields": {
        "id": "id",
        "title": "title",
        "note": "metadata.note.value",
        "slots": "metadata.slots.value",
        "closed": "metadata.closed.value"
      }
    },
    {
      "as": "zones",
      "collection": "zones",
      "kind": "zone",
      "record": "Zone",
      "fields": {
        "id": "id",
        "name": "title",
        "area": "metadata.area.value",
        "price": "metadata.price.value",
        "freeFrom": "metadata.freeFrom.value",
        "minOrder": "metadata.minOrder.value",
        "time": "metadata.time.value",
        "express": "metadata.express.value",
        "currency": "metadata.currency.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "slots",
      "title": {
        "$": "ui.commerce.slots.title"
      },
      "lead": {
        "$": "ui.commerce.slots.lead"
      },
      "days": {
        "$": "days"
      },
      "empty": {
        "$": "ui.empty.days"
      },
      "zone": {
        "op": "pick",
        "args": [
          {
            "$": "zones"
          },
          "zone-central"
        ]
      },
      "labels": {
        "$": "ui.commerce.slots"
      }
    }
  }
}
