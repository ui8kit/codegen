{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.pagetrail",
  "name": "Page heading with breadcrumbs",
  "docs": "Breadcrumbs over the badge, the heading and the lead; with one large figure, a note card or four key facts at the end.",
  "theme": "marketing",
  "group": "page",
  "organism": "PageTrail",
  "axes": {
    "aside": [
      "none",
      "figure",
      "note",
      "facts"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "aside": "none",
    "tone": "default"
  },
  "variants": [
    {
      "id": "crumbs",
      "set": {}
    },
    {
      "id": "crumbsFigure",
      "set": {
        "aside": "figure"
      }
    },
    {
      "id": "crumbsNote",
      "set": {
        "aside": "note"
      }
    },
    {
      "id": "keyFacts",
      "set": {
        "aside": "facts",
        "tone": "muted"
      }
    }
  ],
  "slots": [
    "PageAside",
    "PageCrumbs",
    "SectionHeader"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"crumb\"]",
      "n": 2
    },
    {
      "sel": "[data-testid=\"page-figure\"]",
      "n": 1,
      "when": {
        "aside": "figure"
      }
    },
    {
      "sel": "[data-testid=\"page-note\"]",
      "n": 1,
      "when": {
        "aside": "note"
      }
    },
    {
      "sel": "[data-testid=\"page-fact\"]",
      "n": 4,
      "when": {
        "aside": "facts"
      }
    },
    {
      "sel": "[data-testid=\"page-fact\"]",
      "n": 0,
      "when": {
        "aside": [
          "none",
          "figure",
          "note"
        ]
      }
    }
  ],
  "data": [
    {
      "as": "crumbs",
      "collection": "crumbs",
      "kind": "page",
      "record": "NavLink",
      "fields": {
        "id": "id",
        "name": "title",
        "icon": "metadata.icon.value",
        "href": "slug|route"
      }
    },
    {
      "as": "stats",
      "collection": "stats",
      "kind": "stat",
      "record": "Stat",
      "fields": {
        "id": "id",
        "label": "title",
        "value": "metadata.value.value|number",
        "icon": "metadata.icon.value",
        "hint": "metadata.hint.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "pagetrail",
      "title": {
        "$": "ui.marketing.pageTrail.title"
      },
      "lead": {
        "$": "ui.marketing.pageTrail.lead"
      },
      "badge": {
        "$": "ui.marketing.pageTrail.badge"
      },
      "label": {
        "$": "ui.marketing.pageTrail.label"
      },
      "crumbs": {
        "$": "crumbs"
      },
      "extras": {
        "value": {
          "$": "ui.marketing.pageTrail.value"
        },
        "caption": {
          "$": "ui.marketing.pageTrail.caption"
        },
        "note": {
          "$": "ui.marketing.pageTrail.note"
        },
        "icon": "package",
        "facts": {
          "$": "stats"
        }
      }
    }
  }
}
