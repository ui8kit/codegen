{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.checkout",
  "name": "Checkout",
  "docs": "Contacts, address, a window and the payment beside a sticky order summary.",
  "theme": "commerce",
  "group": "checkout",
  "organism": "CheckoutForm",
  "axes": {
    "layout": [
      "cards",
      "numbered"
    ],
    "summary": [
      "aside",
      "none"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "layout": "cards",
    "summary": "aside",
    "tone": "default"
  },
  "variants": [
    {
      "id": "cards",
      "set": {}
    },
    {
      "id": "numbered",
      "set": {
        "layout": "numbered"
      }
    },
    {
      "id": "noSummary",
      "set": {
        "summary": "none",
        "tone": "muted"
      }
    }
  ],
  "slots": [
    "CartSummaryCard",
    "CheckoutStep",
    "CheckoutSubmit",
    "Field",
    "PaymentOptions",
    "SectionFrame",
    "SlotGrid"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"step\"]",
      "n": 4
    },
    {
      "sel": "[data-testid=\"payment\"]",
      "n": "@payments"
    },
    {
      "sel": "[data-testid=\"day\"]",
      "n": "@days"
    },
    {
      "sel": "[data-testid=\"aside\"]",
      "n": 1,
      "when": {
        "summary": "aside"
      }
    },
    {
      "sel": "[data-testid=\"aside\"]",
      "n": 0,
      "when": {
        "summary": "none"
      }
    }
  ],
  "data": [
    {
      "as": "days",
      "collection": "days",
      "kind": "day",
      "record": "Day",
      "fields": {
        "id": "id",
        "title": "title",
        "note": "metadata.note.value",
        "slots": "metadata.slots.value",
        "closed": "metadata.closed.value"
      }
    },
    {
      "as": "payments",
      "collection": "payments",
      "kind": "payment",
      "record": "Payment",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "icon": "metadata.icon.value"
      }
    },
    {
      "as": "cart",
      "collection": "cart",
      "kind": "cartline",
      "record": "CartLine",
      "fields": {
        "id": "id",
        "name": "title",
        "variant": "metadata.variant.value",
        "price": "metadata.price.value",
        "currency": "metadata.currency.value",
        "qty": "metadata.qty.value"
      }
    },
    {
      "as": "summary",
      "collection": "summary",
      "kind": "summaryrow",
      "record": "SummaryRow",
      "fields": {
        "id": "id",
        "label": "title",
        "amount": "metadata.amount.value",
        "currency": "metadata.currency.value",
        "strong": "metadata.strong.value"
      }
    },
    {
      "as": "promos",
      "collection": "promos",
      "kind": "promo",
      "record": "Promo",
      "fields": {
        "id": "id",
        "code": "title"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "checkout",
      "title": {
        "$": "ui.commerce.checkout.title"
      },
      "days": {
        "$": "days"
      },
      "payments": {
        "$": "payments"
      },
      "lines": {
        "$": "cart"
      },
      "rows": {
        "$": "summary"
      },
      "promos": {
        "$": "promos"
      },
      "labels": {
        "$": "ui.commerce.checkout"
      },
      "totals": {
        "$": "ui.commerce.totals"
      }
    }
  }
}
