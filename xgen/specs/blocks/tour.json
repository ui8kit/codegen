{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.tour",
  "name": "Tour callout",
  "docs": "One stop of a product tour: the explained element and a callout with the step, a sentence and buttons. Placing it on the real element is a port contract.",
  "theme": "onboarding",
  "group": "guidance",
  "organism": "TourCallout",
  "axes": {
    "placement": [
      "below",
      "above",
      "end"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "placement": "below",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "below",
      "set": {}
    },
    {
      "id": "above",
      "set": {
        "placement": "above"
      }
    },
    {
      "id": "end",
      "set": {
        "placement": "end"
      }
    },
    {
      "id": "muted",
      "set": {
        "tone": "muted",
        "density": "compact"
      }
    }
  ],
  "slots": [
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"tour-target\"]",
      "n": 1
    },
    {
      "sel": "[data-testid=\"tour-callout\"]",
      "n": 1
    },
    {
      "sel": "[data-testid=\"tour\"]",
      "n": 1
    }
  ],
  "data": [],
  "sample": {
    "props": {
      "id": "tour",
      "title": {
        "$": "ui.vibe.tour.title"
      },
      "text": {
        "$": "ui.vibe.tour.text"
      },
      "target": {
        "$": "ui.vibe.tour.target"
      },
      "position": {
        "$": "ui.vibe.tour.position"
      },
      "skip": {
        "$": "ui.vibe.tour.skip"
      },
      "next": {
        "$": "ui.vibe.tour.next"
      }
    }
  }
}
