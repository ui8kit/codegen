{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.footersplit",
  "name": "Footer, split",
  "docs": "The brand with figures and a sitemap link over link-group cards; or a split beside a picture with points, link columns, a newsletter card, the contacts or the community channels.",
  "theme": "marketing",
  "group": "navigation",
  "organism": "FooterSplit",
  "axes": {
    "layout": [
      "stats",
      "points",
      "links",
      "newsletter",
      "contacts",
      "channels"
    ],
    "mediaSide": [
      "end",
      "start"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "layout": "stats",
    "mediaSide": "end",
    "tone": "default"
  },
  "variants": [
    {
      "id": "statsCards",
      "set": {}
    },
    {
      "id": "splitPoints",
      "set": {
        "layout": "points"
      }
    },
    {
      "id": "splitLinks",
      "set": {
        "layout": "links",
        "tone": "muted"
      }
    },
    {
      "id": "newsletterStart",
      "set": {
        "layout": "newsletter",
        "mediaSide": "start"
      }
    },
    {
      "id": "splitContacts",
      "set": {
        "layout": "contacts"
      }
    },
    {
      "id": "channelsStart",
      "set": {
        "layout": "channels",
        "mediaSide": "start"
      }
    }
  ],
  "slots": [
    "ActionGroup",
    "FooterBrand",
    "FooterChannels",
    "FooterContacts",
    "FooterFigures",
    "FooterGroupCards",
    "FooterLinkColumns",
    "FooterPoints",
    "FooterSignupCard",
    "FooterSitemap",
    "MediaFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"group\"]",
      "n": "@sitemap",
      "when": {
        "layout": "stats"
      }
    },
    {
      "sel": "[data-testid=\"group\"]",
      "n": 3,
      "when": {
        "layout": [
          "links",
          "newsletter"
        ]
      }
    },
    {
      "sel": "[data-testid=\"group\"]",
      "n": 0,
      "when": {
        "layout": [
          "points",
          "contacts",
          "channels"
        ]
      }
    },
    {
      "sel": "[data-testid=\"footer-stat\"]",
      "n": 3,
      "when": {
        "layout": [
          "stats",
          "channels"
        ]
      }
    },
    {
      "sel": "[data-testid=\"footer-point\"]",
      "n": 4,
      "when": {
        "layout": "points"
      }
    },
    {
      "sel": "[data-testid=\"signup\"]",
      "n": 1,
      "when": {
        "layout": "newsletter"
      }
    },
    {
      "sel": "[data-testid=\"footer-contact\"]",
      "n": "@contacts",
      "when": {
        "layout": "contacts"
      }
    },
    {
      "sel": "[data-testid=\"footer-channel\"]",
      "n": 3,
      "when": {
        "layout": "channels"
      }
    },
    {
      "sel": "[data-slot=\"media-frame\"]",
      "n": 1,
      "when": {
        "layout": [
          "points",
          "links",
          "newsletter",
          "contacts",
          "channels"
        ]
      }
    },
    {
      "sel": "[data-slot=\"media-frame\"]",
      "n": 0,
      "when": {
        "layout": "stats"
      }
    }
  ],
  "data": [
    {
      "as": "sitemap",
      "collection": "sitemap",
      "kind": "menu_item",
      "record": "MegaGroup",
      "fields": {
        "id": "id",
        "title": "title",
        "icon": "metadata.icon.value",
        "links": "id|menu",
        "href": "slug|route"
      }
    },
    {
      "as": "stats",
      "collection": "stats",
      "kind": "stat",
      "record": "Stat",
      "fields": {
        "id": "id",
        "label": "title",
        "value": "metadata.value.value|number",
        "icon": "metadata.icon.value",
        "hint": "metadata.hint.value"
      }
    },
    {
      "as": "features",
      "collection": "features",
      "kind": "feature",
      "record": "Feature",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "icon": "metadata.icon.value"
      }
    },
    {
      "as": "contacts",
      "collection": "contacts",
      "kind": "contact",
      "record": "Feature",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "icon": "metadata.icon.value"
      }
    },
    {
      "as": "community",
      "collection": "community",
      "kind": "channel",
      "record": "Feature",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "icon": "metadata.icon.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "footersplit",
      "label": {
        "$": "ui.vibe.sitemap.label"
      },
      "brand": {
        "$": "ui.site.header.brand"
      },
      "tagline": {
        "$": "ui.marketing.footerSplit.tagline"
      },
      "copyright": {
        "$": "ui.marketing.footerSplit.copyright"
      },
      "groups": {
        "$": "sitemap"
      },
      "extras": {
        "stats": {
          "$": "stats"
        },
        "points": {
          "$": "features"
        },
        "contacts": {
          "$": "contacts"
        },
        "channels": {
          "$": "community"
        }
      },
      "labels": {
        "$": "ui.marketing.footerSplit.labels"
      }
    }
  }
}
