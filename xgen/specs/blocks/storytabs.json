{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.storytabs",
  "name": "Story in steps",
  "docs": "Year tabs over the panel of the chosen year, or the heading beside a picture with arrows and one dot per step. Choosing a step is an event.",
  "theme": "content",
  "group": "story",
  "organism": "StoryTabs",
  "axes": {
    "layout": [
      "years",
      "carousel"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "layout": "years",
    "tone": "default"
  },
  "variants": [
    {
      "id": "yearTabs",
      "set": {}
    },
    {
      "id": "carouselSplit",
      "set": {
        "layout": "carousel"
      }
    },
    {
      "id": "yearTabsMuted",
      "set": {
        "tone": "muted"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "MediaFrame",
    "SectionFrame",
    "StoryDots",
    "StoryPanel"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"story-tab\"]",
      "n": "@milestones",
      "when": {
        "layout": "years"
      }
    },
    {
      "sel": "[data-testid=\"story-panel\"]",
      "n": 1,
      "when": {
        "layout": "years"
      }
    },
    {
      "sel": "[data-testid=\"story-dot\"]",
      "n": "@milestones",
      "when": {
        "layout": "carousel"
      }
    },
    {
      "sel": "[data-testid=\"story-arrow\"]",
      "n": 2,
      "when": {
        "layout": "carousel"
      }
    },
    {
      "sel": "[data-testid=\"story-tab\"]",
      "n": 0,
      "when": {
        "layout": "carousel"
      }
    }
  ],
  "data": [
    {
      "as": "milestones",
      "collection": "milestones",
      "kind": "milestone",
      "record": "Milestone",
      "fields": {
        "id": "id",
        "date": "metadata.date.value",
        "title": "title",
        "text": "metadata.text.value",
        "tag": "metadata.tag.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "storytabs",
      "title": {
        "$": "ui.company.storyTabs.title"
      },
      "lead": {
        "$": "ui.company.storyTabs.lead"
      },
      "badge": {
        "$": "ui.company.storyTabs.badge"
      },
      "steps": {
        "$": "milestones"
      },
      "empty": {
        "$": "ui.empty.milestones"
      },
      "active": "milestone-runtimes",
      "labels": {
        "$": "ui.company.storyTabs.labels"
      }
    }
  }
}
