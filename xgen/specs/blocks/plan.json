{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.plan",
  "name": "Plan",
  "docs": "One plan as a card.",
  "theme": "marketing",
  "group": "pricing",
  "fit": "card",
  "organism": "PricingCard",
  "axes": {
    "emphasis": [
      "auto",
      "off"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "emphasis": "auto",
    "density": "default"
  },
  "variants": [
    {
      "id": "standard",
      "set": {}
    },
    {
      "id": "flat",
      "set": {
        "emphasis": "off"
      }
    },
    {
      "id": "compact",
      "set": {
        "density": "compact"
      }
    }
  ],
  "slots": [],
  "data": [
    {
      "as": "tiers",
      "collection": "tiers",
      "kind": "plan",
      "record": "Plan",
      "fields": {
        "id": "id",
        "name": "title",
        "tagline": "metadata.tagline.value",
        "price": "metadata.price.value",
        "currency": "metadata.currency.value",
        "seats": "metadata.seats.value",
        "storage": "metadata.storage.value",
        "highlighted": "metadata.highlighted.value",
        "features": "metadata.features.value",
        "yearly": "metadata.yearly.value"
      }
    }
  ],
  "sample": {
    "props": {
      "plan": {
        "op": "pick",
        "args": [
          {
            "$": "tiers"
          },
          "tier-team"
        ]
      },
      "labels": {
        "$": "ui.pricing"
      }
    }
  }
}
