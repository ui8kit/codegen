{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.activity",
  "name": "Activity feed",
  "docs": "Recent events as a timeline or a list.",
  "theme": "dashboard",
  "group": "widgets",
  "organism": "ActivityFeed",
  "axes": {
    "layout": [
      "timeline",
      "list"
    ],
    "density": [
      "default",
      "compact"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "layout": "timeline",
    "density": "default",
    "tone": "default"
  },
  "variants": [
    {
      "id": "timeline",
      "set": {}
    },
    {
      "id": "list",
      "set": {
        "layout": "list"
      }
    },
    {
      "id": "compact",
      "set": {
        "layout": "list",
        "density": "compact"
      }
    },
    {
      "id": "muted",
      "set": {
        "tone": "muted"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "Panel",
    "Timeline"
  ],
  "data": [
    {
      "as": "activity",
      "collection": "activity",
      "kind": "event",
      "record": "Event",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "time": "metadata.time.value|ago",
        "tone": "metadata.tone.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "activity",
      "title": {
        "$": "ui.dashboard.activity.title"
      },
      "text": {
        "$": "ui.dashboard.activity.text"
      },
      "events": {
        "$": "activity"
      },
      "empty": {
        "$": "ui.empty.activity"
      }
    }
  }
}
