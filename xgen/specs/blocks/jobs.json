{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.jobs",
  "name": "Careers",
  "docs": "Open jobs as cards, grouped by department, or as a table.",
  "theme": "marketing",
  "group": "company",
  "organism": "JobBoard",
  "axes": {
    "layout": [
      "grid",
      "grouped",
      "table"
    ],
    "salary": [
      "show",
      "hide"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "layout": "grid",
    "salary": "hide",
    "tone": "default"
  },
  "variants": [
    {
      "id": "grid",
      "set": {}
    },
    {
      "id": "salary",
      "set": {
        "salary": "show"
      }
    },
    {
      "id": "grouped",
      "set": {
        "layout": "grouped"
      }
    },
    {
      "id": "table",
      "set": {
        "layout": "table",
        "salary": "show",
        "tone": "muted"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "JobCards",
    "MenuEntry",
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"item\"]",
      "n": "@jobs"
    },
    {
      "sel": "[data-testid=\"group\"]",
      "n": "@departments",
      "when": {
        "layout": "grouped"
      }
    },
    {
      "sel": "[data-testid=\"group\"]",
      "n": 0,
      "when": {
        "layout": [
          "grid",
          "table"
        ]
      }
    },
    {
      "sel": "[data-testid=\"job-table\"]",
      "n": 1,
      "when": {
        "layout": "table"
      }
    },
    {
      "sel": "[data-testid=\"job-table\"]",
      "n": 0,
      "when": {
        "layout": [
          "grid",
          "grouped"
        ]
      }
    },
    {
      "sel": "[data-testid=\"salary\"]",
      "n": "@jobs",
      "when": {
        "layout": "grid",
        "salary": "show"
      }
    },
    {
      "sel": "[data-testid=\"salary\"]",
      "n": 0,
      "when": {
        "salary": "hide"
      }
    }
  ],
  "data": [
    {
      "as": "jobs",
      "collection": "jobs",
      "kind": "job",
      "record": "Job",
      "fields": {
        "id": "id",
        "title": "title",
        "dept": "metadata.dept.value",
        "location": "metadata.location.value",
        "type": "metadata.type.value",
        "salary": "metadata.salary.value",
        "posted": "metadata.posted.value|ago-days"
      }
    },
    {
      "as": "departments",
      "collection": "departments",
      "kind": "department",
      "record": "Department",
      "fields": {
        "id": "id",
        "name": "title"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "jobs",
      "title": {
        "$": "ui.company.jobs.title"
      },
      "lead": {
        "$": "ui.company.jobs.lead"
      },
      "jobs": {
        "$": "jobs"
      },
      "empty": {
        "$": "ui.empty.jobs"
      },
      "departments": {
        "$": "departments"
      },
      "labels": {
        "$": "ui.company.jobs"
      }
    }
  }
}
