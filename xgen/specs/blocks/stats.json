{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.stats",
  "name": "Stats",
  "docs": "Key numbers as figures, cards or figures with icons.",
  "theme": "marketing",
  "group": "proof",
  "organism": "StatsBand",
  "axes": {
    "cols": [
      "2",
      "3",
      "4"
    ],
    "layout": [
      "row",
      "stack"
    ],
    "surface": [
      "none",
      "image",
      "panel"
    ],
    "item": [
      "plain",
      "card",
      "icon"
    ],
    "align": [
      "start",
      "center"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "roomy",
      "default",
      "compact"
    ]
  },
  "defaults": {
    "cols": "4",
    "layout": "row",
    "surface": "none",
    "item": "plain",
    "align": "center",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "plain4",
      "set": {}
    },
    {
      "id": "panel",
      "set": {
        "surface": "panel",
        "density": "compact"
      },
      "props": {
        "title": ""
      }
    },
    {
      "id": "stack",
      "set": {
        "layout": "stack",
        "align": "start"
      }
    },
    {
      "id": "image",
      "set": {
        "surface": "image",
        "density": "roomy"
      }
    },
    {
      "id": "cards",
      "set": {
        "cols": "3",
        "item": "card"
      },
      "props": {
        "stats": {
          "op": "list",
          "args": [
            {
              "op": "nth",
              "args": [
                {
                  "$": "stats"
                },
                0
              ]
            },
            {
              "op": "nth",
              "args": [
                {
                  "$": "stats"
                },
                1
              ]
            },
            {
              "op": "nth",
              "args": [
                {
                  "$": "stats"
                },
                2
              ]
            }
          ]
        }
      }
    },
    {
      "id": "icons",
      "set": {
        "item": "icon",
        "align": "start"
      }
    },
    {
      "id": "muted2",
      "set": {
        "cols": "2",
        "tone": "muted",
        "density": "roomy"
      }
    },
    {
      "id": "cardsCompact",
      "set": {
        "item": "card",
        "density": "compact"
      }
    }
  ],
  "slots": [
    "Backdrop",
    "EmptyState",
    "SectionFrame",
    "StatFigure"
  ],
  "data": [
    {
      "as": "stats",
      "collection": "stats",
      "kind": "stat",
      "record": "Stat",
      "fields": {
        "id": "id",
        "label": "title",
        "value": "metadata.value.value|number",
        "icon": "metadata.icon.value",
        "hint": "metadata.hint.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "stats",
      "title": {
        "$": "ui.marketing.stats.title"
      },
      "stats": {
        "$": "stats"
      },
      "empty": {
        "$": "ui.marketing.stats.empty"
      }
    }
  }
}
