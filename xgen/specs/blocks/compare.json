{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.compare",
  "name": "Comparison table",
  "docs": "Plans, or a product and its rivals, in columns, and the features in rows; yes and no as marks.",
  "theme": "marketing",
  "group": "pricing",
  "organism": "ComparisonTable",
  "axes": {
    "highlight": [
      "none",
      "middle"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "highlight": "none",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "plans",
      "set": {}
    },
    {
      "id": "highlight",
      "set": {
        "highlight": "middle"
      }
    },
    {
      "id": "rivals",
      "set": {
        "highlight": "middle",
        "tone": "muted"
      },
      "props": {
        "rows": {
          "$": "rivals"
        },
        "title": {
          "$": "ui.vibe.rivals.title"
        },
        "labels": {
          "$": "ui.vibe.rivals.labels"
        }
      }
    },
    {
      "id": "muted",
      "set": {
        "tone": "muted",
        "density": "compact"
      }
    }
  ],
  "slots": [
    "CompareMark",
    "EmptyState",
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"item\"]",
      "n": 5
    },
    {
      "sel": "th[scope=col]",
      "n": 4
    },
    {
      "sel": "[data-highlight=\"true\"]",
      "n": 1,
      "when": {
        "highlight": "middle"
      }
    },
    {
      "sel": "[data-highlight=\"true\"]",
      "n": 0,
      "when": {
        "highlight": "none"
      }
    }
  ],
  "data": [
    {
      "as": "compare",
      "collection": "compare",
      "kind": "row",
      "record": "CompareRow",
      "fields": {
        "id": "id",
        "label": "title",
        "a": "metadata.a.value",
        "b": "metadata.b.value",
        "c": "metadata.c.value"
      }
    },
    {
      "as": "rivals",
      "collection": "rivals",
      "kind": "row",
      "record": "CompareRow",
      "fields": {
        "id": "id",
        "label": "title",
        "a": "metadata.a.value",
        "b": "metadata.b.value",
        "c": "metadata.c.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "compare",
      "title": {
        "$": "ui.vibe.compare.title"
      },
      "rows": {
        "$": "compare"
      },
      "empty": {
        "$": "ui.empty.rows"
      },
      "labels": {
        "$": "ui.vibe.compare.labels"
      }
    }
  }
}
