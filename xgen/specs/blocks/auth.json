{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.auth",
  "name": "Auth card",
  "docs": "Sign in, sign up and reset password.",
  "theme": "account",
  "group": "auth",
  "fit": "card",
  "organism": "AuthCard",
  "axes": {
    "mode": [
      "signin",
      "signup",
      "reset",
      "magic"
    ],
    "layout": [
      "card",
      "plain"
    ],
    "social": [
      "none",
      "show",
      "first"
    ]
  },
  "defaults": {
    "mode": "signin",
    "layout": "card",
    "social": "none"
  },
  "variants": [
    {
      "id": "signin",
      "set": {}
    },
    {
      "id": "magic",
      "set": {
        "mode": "magic"
      },
      "props": {
        "title": {
          "$": "ui.auth.magic.title"
        },
        "text": {
          "$": "ui.auth.magic.text"
        },
        "submit": {
          "$": "ui.auth.magic.submit"
        },
        "switchText": {
          "$": "ui.auth.magic.switchText"
        },
        "switchLink": {
          "$": "ui.auth.magic.switchLink"
        }
      }
    },
    {
      "id": "socialFirst",
      "set": {
        "social": "first"
      }
    },
    {
      "id": "signup",
      "set": {
        "mode": "signup"
      },
      "props": {
        "title": {
          "$": "ui.auth.signup.title"
        },
        "text": {
          "$": "ui.auth.signup.text"
        },
        "submit": {
          "$": "ui.auth.signup.submit"
        },
        "switchText": {
          "$": "ui.auth.signup.switchText"
        },
        "switchLink": {
          "$": "ui.auth.signup.switchLink"
        }
      }
    },
    {
      "id": "reset",
      "set": {
        "mode": "reset"
      },
      "props": {
        "title": {
          "$": "ui.auth.reset.title"
        },
        "text": {
          "$": "ui.auth.reset.text"
        },
        "submit": {
          "$": "ui.auth.reset.submit"
        },
        "switchText": {
          "$": "ui.auth.reset.switchText"
        },
        "switchLink": {
          "$": "ui.auth.reset.switchLink"
        }
      }
    },
    {
      "id": "plain",
      "set": {
        "layout": "plain"
      }
    },
    {
      "id": "social",
      "set": {
        "social": "show"
      }
    },
    {
      "id": "signupSocial",
      "set": {
        "mode": "signup",
        "social": "show",
        "layout": "plain"
      },
      "props": {
        "title": {
          "$": "ui.auth.signup.title"
        },
        "text": {
          "$": "ui.auth.signup.text"
        },
        "submit": {
          "$": "ui.auth.signup.submit"
        },
        "switchText": {
          "$": "ui.auth.signup.switchText"
        },
        "switchLink": {
          "$": "ui.auth.signup.switchLink"
        }
      }
    }
  ],
  "slots": [
    "AuthForm"
  ],
  "data": [],
  "sample": {
    "props": {
      "id": "auth",
      "title": {
        "$": "ui.auth.signin.title"
      },
      "text": {
        "$": "ui.auth.signin.text"
      },
      "submit": {
        "$": "ui.auth.signin.submit"
      },
      "switchText": {
        "$": "ui.auth.signin.switchText"
      },
      "switchLink": {
        "$": "ui.auth.signin.switchLink"
      },
      "switchHref": "#/",
      "labels": {
        "$": "ui.auth.labels"
      }
    }
  }
}
