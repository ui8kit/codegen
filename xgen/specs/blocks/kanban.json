{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.kanban",
  "name": "Kanban board",
  "docs": "Work items in lanes with a count; cards with a tag and a person. Moving cards is a port contract (SortableList).",
  "theme": "dashboard",
  "group": "widgets",
  "organism": "KanbanBoard",
  "axes": {
    "card": [
      "simple",
      "detail"
    ],
    "cols": [
      "2",
      "3"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "card": "detail",
    "cols": "3",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "detail",
      "set": {}
    },
    {
      "id": "simple",
      "set": {
        "card": "simple"
      }
    },
    {
      "id": "twoCols",
      "set": {
        "cols": "2"
      }
    },
    {
      "id": "muted",
      "set": {
        "tone": "muted",
        "density": "compact"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "Pill",
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"lane\"]",
      "n": "@lanes"
    },
    {
      "sel": "[data-testid=\"lane\"] [data-testid=\"item\"]",
      "n": "@cards"
    },
    {
      "sel": "[data-slot=\"pill\"]",
      "n": "@cards",
      "when": {
        "card": "detail"
      }
    },
    {
      "sel": "[data-slot=\"pill\"]",
      "n": 0,
      "when": {
        "card": "simple"
      }
    }
  ],
  "data": [
    {
      "as": "lanes",
      "collection": "lanes",
      "kind": "lane",
      "record": "Lane",
      "fields": {
        "id": "id",
        "key": "slug",
        "title": "title"
      }
    },
    {
      "as": "cards",
      "collection": "cards",
      "kind": "card",
      "record": "BoardCard",
      "fields": {
        "id": "id",
        "lane": "metadata.lane.value",
        "title": "title",
        "tag": "metadata.tag.value",
        "who": "metadata.who.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "kanban",
      "title": {
        "$": "ui.vibe.kanban.title"
      },
      "lanes": {
        "$": "lanes"
      },
      "empty": {
        "$": "ui.empty.lanes"
      },
      "cards": {
        "$": "cards"
      },
      "countLabel": {
        "$": "ui.vibe.kanban.count"
      }
    }
  }
}
