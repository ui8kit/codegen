{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.beforeafter",
  "name": "Before and after",
  "docs": "Two sides of the same points: how it was and how it is, as two cards or as rows.",
  "theme": "marketing",
  "group": "features",
  "organism": "BeforeAfter",
  "axes": {
    "layout": [
      "cards",
      "rows"
    ],
    "icons": [
      "show",
      "hide"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "cards",
    "icons": "show",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "cards",
      "set": {}
    },
    {
      "id": "rows",
      "set": {
        "layout": "rows"
      }
    },
    {
      "id": "plain",
      "set": {
        "icons": "hide"
      }
    },
    {
      "id": "muted",
      "set": {
        "tone": "muted",
        "density": "compact"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"side\"]",
      "n": 2,
      "when": {
        "layout": "cards"
      }
    },
    {
      "sel": "[data-testid=\"item\"]",
      "n": "@beforeafter*2",
      "when": {
        "layout": "cards"
      }
    },
    {
      "sel": "[data-testid=\"item\"]",
      "n": "@beforeafter",
      "when": {
        "layout": "rows"
      }
    },
    {
      "sel": "svg",
      "n": 0,
      "when": {
        "icons": "hide"
      }
    }
  ],
  "data": [
    {
      "as": "beforeafter",
      "collection": "beforeafter",
      "kind": "point",
      "record": "Contrast",
      "fields": {
        "id": "id",
        "title": "title",
        "before": "metadata.before.value",
        "after": "metadata.after.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "beforeafter",
      "title": {
        "$": "ui.vibe.beforeafter.title"
      },
      "points": {
        "$": "beforeafter"
      },
      "empty": {
        "$": "ui.empty.points"
      },
      "labels": {
        "$": "ui.vibe.beforeafter.labels"
      }
    }
  }
}
