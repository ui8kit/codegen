{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.checklist",
  "name": "Setup checklist",
  "docs": "Tasks to finish after sign-up, with progress.",
  "theme": "onboarding",
  "group": "setup",
  "organism": "Checklist",
  "axes": {
    "layout": [
      "card",
      "plain"
    ],
    "progress": [
      "bar",
      "text",
      "none"
    ],
    "marker": [
      "check",
      "number"
    ],
    "detail": [
      "always",
      "expand"
    ],
    "tone": [
      "default",
      "muted"
    ]
  },
  "defaults": {
    "layout": "card",
    "progress": "bar",
    "marker": "check",
    "detail": "always",
    "tone": "default"
  },
  "variants": [
    {
      "id": "card",
      "set": {}
    },
    {
      "id": "expand",
      "set": {
        "detail": "expand"
      }
    },
    {
      "id": "plain",
      "set": {
        "layout": "plain"
      }
    },
    {
      "id": "text",
      "set": {
        "progress": "text"
      }
    },
    {
      "id": "none",
      "set": {
        "progress": "none",
        "layout": "plain"
      }
    },
    {
      "id": "numbered",
      "set": {
        "marker": "number"
      }
    },
    {
      "id": "muted",
      "set": {
        "marker": "number",
        "progress": "text",
        "tone": "muted"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "SectionFrame"
  ],
  "data": [
    {
      "as": "checklist",
      "collection": "checklist",
      "kind": "task",
      "record": "Task",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "done": "metadata.done.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "checklist",
      "title": {
        "$": "ui.onboarding.checklist.title"
      },
      "tasks": {
        "$": "checklist"
      },
      "empty": {
        "$": "ui.empty.tasks"
      },
      "progressLabel": {
        "$": "ui.onboarding.checklist.progress"
      }
    }
  }
}
