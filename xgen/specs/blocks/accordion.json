{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.accordion",
  "name": "Feature accordion",
  "docs": "Features as a list of disclosures, the first one open, with an optional picture.",
  "theme": "marketing",
  "group": "features",
  "organism": "FeatureAccordion",
  "axes": {
    "expand": [
      "first",
      "none"
    ],
    "media": [
      "none",
      "image"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "expand": "first",
    "media": "none",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "first",
      "set": {}
    },
    {
      "id": "closed",
      "set": {
        "expand": "none"
      }
    },
    {
      "id": "media",
      "set": {
        "media": "image"
      }
    },
    {
      "id": "muted",
      "set": {
        "tone": "muted",
        "density": "compact"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "MediaFrame",
    "SectionFrame"
  ],
  "facts": [
    {
      "sel": "details",
      "n": "@features"
    },
    {
      "sel": "details[open]",
      "n": 1,
      "when": {
        "expand": "first"
      }
    },
    {
      "sel": "details[open]",
      "n": 0,
      "when": {
        "expand": "none"
      }
    },
    {
      "sel": "[data-slot=\"media-frame\"]",
      "n": 1,
      "when": {
        "media": "image"
      }
    },
    {
      "sel": "[data-slot=\"media-frame\"]",
      "n": 0,
      "when": {
        "media": "none"
      }
    }
  ],
  "data": [
    {
      "as": "features",
      "collection": "features",
      "kind": "feature",
      "record": "Feature",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "icon": "metadata.icon.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "accordion",
      "title": {
        "$": "ui.vibe.accordion.title"
      },
      "features": {
        "$": "features"
      },
      "empty": {
        "$": "ui.empty.features"
      }
    }
  }
}
