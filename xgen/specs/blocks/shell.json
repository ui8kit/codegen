{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.shell",
  "name": "App shell",
  "docs": "The frame of a signed-in app with a first screen: a sidebar, a top bar, or three panes.",
  "theme": "dashboard",
  "group": "layout",
  "organism": "AppShell",
  "axes": {
    "layout": [
      "sidebar",
      "top",
      "panes"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "sidebar",
    "density": "default"
  },
  "variants": [
    {
      "id": "sidebar",
      "set": {}
    },
    {
      "id": "top",
      "set": {
        "layout": "top"
      }
    },
    {
      "id": "panes",
      "set": {
        "layout": "panes"
      }
    },
    {
      "id": "dense",
      "set": {
        "density": "compact"
      }
    }
  ],
  "slots": [
    "AppMain",
    "Panel"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"app-shell\"]",
      "n": 1
    },
    {
      "sel": "[data-testid=\"sidebar\"]",
      "n": 1,
      "when": {
        "layout": [
          "sidebar",
          "panes"
        ]
      }
    },
    {
      "sel": "[data-testid=\"sidebar\"]",
      "n": 0,
      "when": {
        "layout": "top"
      }
    },
    {
      "sel": "[data-testid=\"nav-bar\"]",
      "n": 1,
      "when": {
        "layout": "top"
      }
    },
    {
      "sel": "[data-testid=\"app-main\"] [data-testid=\"item\"]",
      "n": "@metrics"
    },
    {
      "sel": "[data-slot=\"bar-chart\"]",
      "n": 1
    }
  ],
  "data": [
    {
      "as": "sidenav",
      "collection": "sidenav",
      "kind": "menu_item",
      "record": "NavLink",
      "fields": {
        "id": "id",
        "name": "title",
        "icon": "metadata.icon.value",
        "href": "slug|route"
      }
    },
    {
      "as": "metrics",
      "collection": "metrics",
      "kind": "metric",
      "record": "Stat",
      "fields": {
        "id": "id",
        "label": "title",
        "value": "metadata.value.value|number",
        "icon": "metadata.icon.value",
        "hint": "metadata.hint.value"
      }
    },
    {
      "as": "series",
      "collection": "series",
      "kind": "point",
      "record": "Point",
      "fields": {
        "id": "id",
        "label": "title",
        "value": "metadata.value.value"
      }
    },
    {
      "as": "activity",
      "collection": "activity",
      "kind": "event",
      "record": "Event",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "time": "metadata.time.value|ago",
        "tone": "metadata.tone.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "shell",
      "title": {
        "$": "ui.vibe.shell.title"
      },
      "nav": {
        "label": {
          "$": "ui.vibe.sidebar.label"
        },
        "brand": {
          "$": "ui.site.header.brand"
        },
        "links": {
          "$": "sidenav"
        },
        "current": "item-overview"
      },
      "user": {
        "name": {
          "$": "ui.vibe.sidebar.userName"
        },
        "email": {
          "$": "ui.vibe.sidebar.userEmail"
        }
      },
      "search": {
        "label": {
          "$": "ui.vibe.nav.search"
        },
        "shortcut": {
          "$": "ui.vibe.nav.shortcut"
        }
      },
      "metrics": {
        "$": "metrics"
      },
      "chart": {
        "title": {
          "$": "ui.dashboard.chart.title"
        },
        "text": {
          "$": "ui.dashboard.chart.text"
        },
        "summary": {
          "$": "ui.dashboard.chart.summary"
        },
        "series": {
          "$": "series"
        }
      },
      "activity": {
        "title": {
          "$": "ui.dashboard.activity.title"
        },
        "text": {
          "$": "ui.dashboard.activity.text"
        },
        "events": {
          "$": "activity"
        }
      }
    }
  }
}
