{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.wizard",
  "name": "Sign-up wizard",
  "docs": "A sign-up in steps with a progress bar or a list of steps; back and next move between them.",
  "theme": "account",
  "group": "auth",
  "organism": "SignupWizard",
  "axes": {
    "progress": [
      "bar",
      "list"
    ],
    "layout": [
      "card",
      "plain"
    ]
  },
  "defaults": {
    "progress": "bar",
    "layout": "card"
  },
  "variants": [
    {
      "id": "bar",
      "set": {}
    },
    {
      "id": "list",
      "set": {
        "progress": "list"
      }
    },
    {
      "id": "plain",
      "set": {
        "layout": "plain"
      }
    },
    {
      "id": "second",
      "set": {
        "progress": "list",
        "layout": "plain"
      },
      "props": {
        "current": 2
      }
    }
  ],
  "slots": [
    "Field"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"wizard\"]",
      "n": 1
    },
    {
      "sel": "[data-testid=\"step\"]",
      "n": 1
    },
    {
      "sel": "[data-testid=\"step-item\"]",
      "n": "@wizard",
      "when": {
        "progress": "list"
      }
    },
    {
      "sel": "progress, [role=progressbar]",
      "n": 1,
      "when": {
        "progress": "bar"
      }
    },
    {
      "sel": "[data-testid=\"field\"]",
      "n": 2
    }
  ],
  "data": [
    {
      "as": "wizard",
      "collection": "wizard",
      "kind": "step",
      "record": "WizardStep",
      "fields": {
        "id": "id",
        "title": "title",
        "text": "metadata.text.value",
        "icon": "metadata.icon.value",
        "fieldA": "metadata.fieldA.value",
        "fieldB": "metadata.fieldB.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "wizard",
      "title": {
        "$": "ui.vibe.wizard.title"
      },
      "steps": {
        "$": "wizard"
      },
      "labels": {
        "$": "ui.vibe.wizard.labels"
      },
      "current": 1
    }
  }
}
