{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.authpage",
  "name": "Sign-in page",
  "docs": "A whole sign-in page: the card beside a picture panel, on a tinted page, or alone; with any mode of the card.",
  "theme": "account",
  "group": "auth",
  "organism": "AuthLayout",
  "axes": {
    "layout": [
      "split",
      "centered",
      "minimal"
    ],
    "side": [
      "end",
      "start"
    ],
    "mode": [
      "signin",
      "signup",
      "reset",
      "magic"
    ],
    "social": [
      "none",
      "show",
      "first"
    ]
  },
  "defaults": {
    "layout": "split",
    "side": "end",
    "mode": "signin",
    "social": "none"
  },
  "variants": [
    {
      "id": "split",
      "set": {}
    },
    {
      "id": "splitStart",
      "set": {
        "side": "start"
      }
    },
    {
      "id": "centered",
      "set": {
        "layout": "centered"
      }
    },
    {
      "id": "minimal",
      "set": {
        "layout": "minimal"
      }
    },
    {
      "id": "signup",
      "set": {
        "mode": "signup"
      },
      "props": {
        "title": {
          "$": "ui.auth.signup.title"
        },
        "text": {
          "$": "ui.auth.signup.text"
        },
        "submit": {
          "$": "ui.auth.signup.submit"
        },
        "switchTo": {
          "text": {
            "$": "ui.auth.signup.switchText"
          },
          "link": {
            "$": "ui.auth.signup.switchLink"
          }
        }
      }
    },
    {
      "id": "reset",
      "set": {
        "mode": "reset",
        "layout": "centered"
      },
      "props": {
        "title": {
          "$": "ui.auth.reset.title"
        },
        "text": {
          "$": "ui.auth.reset.text"
        },
        "submit": {
          "$": "ui.auth.reset.submit"
        },
        "switchTo": {
          "text": {
            "$": "ui.auth.reset.switchText"
          },
          "link": {
            "$": "ui.auth.reset.switchLink"
          }
        }
      }
    },
    {
      "id": "magic",
      "set": {
        "mode": "magic",
        "layout": "minimal"
      },
      "props": {
        "title": {
          "$": "ui.auth.magic.title"
        },
        "text": {
          "$": "ui.auth.magic.text"
        },
        "submit": {
          "$": "ui.auth.magic.submit"
        },
        "switchTo": {
          "text": {
            "$": "ui.auth.magic.switchText"
          },
          "link": {
            "$": "ui.auth.magic.switchLink"
          }
        }
      }
    },
    {
      "id": "social",
      "set": {
        "social": "show"
      }
    },
    {
      "id": "socialFirst",
      "set": {
        "social": "first",
        "layout": "centered"
      }
    }
  ],
  "slots": [
    "MediaFrame"
  ],
  "facts": [
    {
      "sel": "[data-testid=\"auth-layout\"]",
      "n": 1
    },
    {
      "sel": "[data-testid=\"auth-card\"]",
      "n": 1
    },
    {
      "sel": "[data-testid=\"visual\"]",
      "n": 1,
      "when": {
        "layout": "split"
      }
    },
    {
      "sel": "[data-testid=\"visual\"]",
      "n": 0,
      "when": {
        "layout": [
          "centered",
          "minimal"
        ]
      }
    },
    {
      "sel": "[data-testid=\"social\"]",
      "n": 1,
      "when": {
        "social": [
          "show",
          "first"
        ],
        "mode": [
          "signin",
          "signup"
        ]
      }
    },
    {
      "sel": "[data-testid=\"social\"]",
      "n": 0,
      "when": {
        "social": "none"
      }
    },
    {
      "sel": "[data-testid=\"field\"]",
      "n": 2,
      "when": {
        "mode": "signin"
      }
    },
    {
      "sel": "[data-testid=\"field\"]",
      "n": 3,
      "when": {
        "mode": "signup"
      }
    },
    {
      "sel": "[data-testid=\"field\"]",
      "n": 1,
      "when": {
        "mode": [
          "reset",
          "magic"
        ]
      }
    }
  ],
  "data": [],
  "sample": {
    "props": {
      "id": "authpage",
      "title": {
        "$": "ui.auth.signin.title"
      },
      "text": {
        "$": "ui.auth.signin.text"
      },
      "submit": {
        "$": "ui.auth.signin.submit"
      },
      "switchTo": {
        "text": {
          "$": "ui.auth.signin.switchText"
        },
        "link": {
          "$": "ui.auth.signin.switchLink"
        },
        "href": "#/"
      },
      "labels": {
        "$": "ui.auth.labels"
      },
      "visual": {
        "title": {
          "$": "ui.vibe.authpage.visualTitle"
        },
        "text": {
          "$": "ui.vibe.authpage.visualText"
        }
      }
    }
  }
}
