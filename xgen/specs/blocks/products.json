{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.products",
  "name": "Product grid",
  "docs": "Products as cards in a grid, a list or a rail that scrolls sideways.",
  "theme": "commerce",
  "group": "catalog",
  "organism": "ProductGrid",
  "axes": {
    "layout": [
      "grid",
      "list",
      "rail"
    ],
    "cols": [
      "1-2",
      "1-3",
      "1-4"
    ],
    "ratio": [
      "4/3",
      "1/1",
      "3/4"
    ],
    "rating": [
      "show",
      "hide"
    ],
    "action": [
      "button",
      "none"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "roomy",
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "grid",
    "cols": "1-3",
    "ratio": "4/3",
    "rating": "show",
    "action": "button",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "grid3",
      "set": {}
    },
    {
      "id": "grid4",
      "set": {
        "cols": "1-4",
        "ratio": "1/1"
      }
    },
    {
      "id": "grid2",
      "set": {
        "cols": "1-2",
        "ratio": "3/4"
      }
    },
    {
      "id": "list",
      "set": {
        "layout": "list"
      }
    },
    {
      "id": "catalog",
      "set": {
        "cols": "1-4",
        "ratio": "1/1",
        "rating": "hide",
        "density": "compact"
      }
    },
    {
      "id": "browse",
      "set": {
        "action": "none",
        "tone": "muted"
      }
    },
    {
      "id": "showcase",
      "set": {
        "ratio": "3/4",
        "density": "roomy"
      }
    },
    {
      "id": "rail",
      "set": {
        "layout": "rail"
      }
    },
    {
      "id": "railCompact",
      "set": {
        "layout": "rail",
        "ratio": "1/1",
        "rating": "hide",
        "density": "compact"
      }
    }
  ],
  "slots": [
    "EmptyState",
    "SectionFrame"
  ],
  "data": [
    {
      "as": "products",
      "collection": "products",
      "kind": "product",
      "record": "Product",
      "fields": {
        "id": "id",
        "name": "title",
        "summary": "metadata.summary.value",
        "price": "metadata.price.value",
        "currency": "metadata.currency.value",
        "rating": "metadata.rating.value",
        "reviews": "metadata.reviews.value",
        "badge": "metadata.badge.value",
        "category": "terms|term:product_category",
        "inStock": "metadata.inStock.value",
        "compareAt": "metadata.compare_at.value",
        "href": "slug|route",
        "image": "featured_media_id|media"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "products",
      "title": {
        "$": "ui.commerce.products.title"
      },
      "products": {
        "$": "products"
      },
      "labels": {
        "$": "ui.commerce.productLabels"
      },
      "badges": {
        "$": "ui.commerce.badges"
      }
    }
  }
}
