{
  "$schema": "../../schema/schemas/block.schema.json",
  "specVersion": 1,
  "id": "block.cart",
  "name": "Cart",
  "docs": "The lines of a cart as a table or as cards.",
  "theme": "commerce",
  "group": "checkout",
  "organism": "CartList",
  "axes": {
    "layout": [
      "table",
      "cards"
    ],
    "media": [
      "image",
      "none"
    ],
    "tone": [
      "default",
      "muted"
    ],
    "density": [
      "default",
      "compact"
    ]
  },
  "defaults": {
    "layout": "table",
    "media": "image",
    "tone": "default",
    "density": "default"
  },
  "variants": [
    {
      "id": "table",
      "set": {}
    },
    {
      "id": "cards",
      "set": {
        "layout": "cards"
      }
    },
    {
      "id": "tableCompact",
      "set": {
        "media": "none",
        "density": "compact"
      }
    },
    {
      "id": "cardsPlain",
      "set": {
        "layout": "cards",
        "media": "none",
        "tone": "muted"
      }
    }
  ],
  "slots": [
    "CartTable",
    "EmptyState",
    "MediaFrame",
    "NumberField",
    "SectionFrame"
  ],
  "data": [
    {
      "as": "cart",
      "collection": "cart",
      "kind": "cartline",
      "record": "CartLine",
      "fields": {
        "id": "id",
        "name": "title",
        "variant": "metadata.variant.value",
        "price": "metadata.price.value",
        "currency": "metadata.currency.value",
        "qty": "metadata.qty.value"
      }
    }
  ],
  "sample": {
    "props": {
      "id": "cart",
      "title": {
        "$": "ui.commerce.cart.title"
      },
      "lines": {
        "$": "cart"
      },
      "empty": {
        "$": "ui.empty.cart"
      },
      "labels": {
        "$": "ui.commerce.cart"
      }
    }
  }
}
