{
  "showcase": {
    "submit": {
      "props": {
        "Type": "submit",
        "Class": "bg-primary text-primary-foreground"
      }
    },
    "disabled": {
      "props": {
        "Disabled": true
      }
    },
    "form": {
      "props": {
        "Form": "f1",
        "AriaLabel": "Save"
      }
    },
    "pressed": {
      "props": {
        "AriaPressed": "true",
        "AriaExpanded": "false",
        "AriaControls": "m1"
      }
    },
    "href": {
      "props": {
        "Href": "/docs",
        "Class": "underline"
      }
    },
    "hrefDisabled": {
      "props": {
        "Href": "/x",
        "Disabled": true
      }
    },
    "toggleOn": {
      "props": {
        "Pressed": true,
        "Class": "bg-primary text-primary-foreground"
      }
    },
    "toggleOff": {
      "props": {
        "Pressed": false
      }
    },
    "menuExpanded": {
      "props": {
        "Expanded": true
      }
    },
    "menuCollapsed": {
      "props": {
        "Expanded": false
      }
    },
    "hrefExpanded": {
      "props": {
        "Href": "/menu",
        "Expanded": false
      }
    },
    "pressedOverride": {
      "props": {
        "Pressed": true,
        "AriaPressed": "mixed"
      }
    },
    "pressedBlankRaw": {
      "props": {
        "Pressed": false,
        "AriaPressed": " "
      }
    }
  }
}
